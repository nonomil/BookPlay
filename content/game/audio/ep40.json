    "dialogue:ep40-map-quiz-1:en": {
      "text": "\"Take this magic gourd to the monkey. Say his name, and he will be sucked into the gourd. After an hour he will turn into liquid.\"",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/da73bddefd2a.mp3",
      "sourceNodeId": "n014"
    },
    "dialogue:ep40-map-quiz-1:zh": {
      "text": "\"将这个神奇的葫芦交给猴子。呼唤它的名字,它便会吸入葫芦之中;一小时后,它将化为液体。\"",
      "lang": "zh-CN",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_zh/f153dd20b95c.mp3",
