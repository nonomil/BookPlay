    "dialogue:ep82-map-intro-1:en": {
      "text": "\"Oh no,\" thought Wukong. \"Yellow Brows is coming!\"",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/91a95e00b4ef.mp3",
      "sourceNodeId": "n001"
    },
    "dialogue:ep82-map-intro-1:zh": {
      "text": "\"哦不,\"悟空 thought,\"黄眉怪要来了!\"",
      "lang": "zh-CN",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_zh/aecbe204560a.mp3",
      "sourceNodeId": "n001"
    },
    "dialogue:ep82-map-intro-2:en": {
      "text": "The monkey jumped back to his feet and ran fast out of the monastery.",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/a8649ce28c0b.mp3",
      "sourceNodeId": "n002"
    },
    "dialogue:ep82-map-intro-2:zh": {
      "text": "这只猴子猛地跳起身,迅速逃离了寺院。",
      "lang": "zh-CN",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_zh/0640fae574c7.mp3",
      "sourceNodeId": "n002"
    },
    "dialogue:ep82-map-quiz-1:en": {
      "text": "The monkey leaped up to the sky just before the cloth wrapped around his companions.",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/fdd2182f3a80.mp3",
      "sourceNodeId": "n029"
    },
    "dialogue:ep82-map-quiz-1:zh": {
      "text": "就在包裹着同伴们的布料即将覆盖它们之前,这只猴子跃上了天空。",
