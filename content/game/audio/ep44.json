    "dialogue:ep44-map-intro-1:en": {
      "text": "The man walked into the Tang Monk's room.",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/5ac6ec6ee34c.mp3",
      "sourceNodeId": "n001"
    },
    "dialogue:ep44-map-intro-1:zh": {
      "text": "这位男子走进了唐僧的房间。",
      "lang": "zh-CN",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_zh/f3bccf087b8e.mp3",
      "sourceNodeId": "n001"
    },
    "dialogue:ep44-map-intro-2:en": {
      "text": "\"Wh-who are you?\" asked the Tang Monk nervously.",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/18bf4db51d89.mp3",
      "sourceNodeId": "n002"
    },
    "dialogue:ep44-map-intro-2:zh": {
      "text": "\"你是谁?\"唐僧紧张地问道。",
      "lang": "zh-CN",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_zh/9f05a089fb1a.mp3",
      "sourceNodeId": "n002"
    },
    "dialogue:ep44-map-quiz-1:en": {
      "text": "\"My kingdom suffered a horrible drought five years ago. Crops wouldn't grow, and my people were starving. One day a Daoist arrived in the kingdom. He said he had great powers and could pray for rain.\"",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/ad650fc71f8d.mp3",
      "sourceNodeId": "n004"
    },
    "dialogue:ep44-map-quiz-1:zh": {
      "text": "\"五年前,我的王国遭遇了严重的旱灾。庄稼无法生长,百姓们濒临饥饿。有一天,一位道教徒来到了这个王国。他声称自己拥有强大的法力,能够祈求降雨。\"",
      "lang": "zh-CN",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_zh/6570d513c2bc.mp3",
      "sourceNodeId": "n004"
    },
