    "dialogue:ep6-map-intro-1:en": {
      "text": "\"What's wrong with our swords and spears?\" asked the gibbon.",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/4aca64da4b8d.mp3",
      "sourceNodeId": "n001"
    },
    "dialogue:ep6-map-intro-1:zh": {
      "text": "\"我们的剑和矛有什么问题吗?\"长臂猿问。",
      "lang": "zh-CN",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_zh/bb8e196e93b0.mp3",
      "sourceNodeId": "n001"
    },
    "dialogue:ep6-map-intro-2:en": {
      "text": "\"They're fine for normal monkeys and apes,\" said Wukong.",
      "lang": "en-US",
      "kind": "static-existing",
