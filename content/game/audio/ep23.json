    "dialogue:ep23-map-intro-1:en": {
      "text": "The creature had a pig's snout and ears.",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/b35e3e6f4e57.mp3",
      "sourceNodeId": "n001"
    },
    "dialogue:ep23-map-intro-1:zh": {
      "text": "这个生物长着猪一样的口鼻和耳朵。",
      "lang": "zh-CN",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_zh/54f75ac928a0.mp3",
      "sourceNodeId": "n001"
    },
    "dialogue:ep23-map-intro-2:en": {
      "text": "But he ran on two legs like a person.",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/ab65d29e4a72.mp3",
      "sourceNodeId": "n002"
    },
    "dialogue:ep23-map-intro-2:zh": {
      "text": "但他像人一样用两条腿奔跑。",
      "lang": "zh-CN",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_zh/e775fe8d7325.mp3",
      "sourceNodeId": "n002"
    },
    "dialogue:ep23-map-quiz-1:en": {
      "text": "\"I was sent to Earth as a punishment,\" said the pig.",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/5f02bf5f9c37.mp3",
      "sourceNodeId": "n027"
    },
    "dialogue:ep23-map-quiz-1:zh": {
      "text": "\"我被派到地球来作为惩罚,\"那头猪说道。",
