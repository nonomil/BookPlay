    },
    "dialogue:ep7-map-quiz-1:en": {
      "text": "\"Hmm,\" he thought. \"This piece of iron really is magical. I bet it will do whatever I want it to do.\"",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/e4f9204795e9.mp3",
      "sourceNodeId": "n003"
    },
    "dialogue:ep7-map-quiz-1:zh": {
      "text": "\"嗯,\"他想,\"这块铁块真是神奇啊。我敢打赌,它能实现我想要的任何事情。\"",
      "lang": "zh-CN",
      "kind": "static-existing",
