      "src": "assets/adv_audio/sent_zh/5be1d7191019.mp3",
      "sourceNodeId": "n002"
    },
    "dialogue:ep38-map-quiz-1:en": {
      "text": "The monkey turned himself into a woodpecker and pecked the log.",
