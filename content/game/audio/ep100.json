  "entries": {
    "dialogue:ep100-map-intro-1:en": {
      "text": "For over a month, the travelers stayed at Squire Kou's house.",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/6146fd36c5c5.mp3",
      "sourceNodeId": "n001"
    },
    "dialogue:ep100-map-intro-1:zh": {
      "text": "一个多月来,这些旅行者一直住在寇员外的家中。",
      "lang": "zh-CN",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_zh/f96d6651eb52.mp3",
      "sourceNodeId": "n001"
    },
    "dialogue:ep100-map-intro-2:en": {
      "text": "Every time they tried to leave, the squire begged them to stay longer.",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/9068313a7f79.mp3",
      "sourceNodeId": "n002"
    },
    "dialogue:ep100-map-intro-2:zh": {
      "text": "每当他们试图离开时,家仆都会恳求他们再住一会儿。",
      "lang": "zh-CN",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_zh/a9ec391d7bd9.mp3",
      "sourceNodeId": "n002"
    },
    "dialogue:ep100-map-quiz-1:en": {
      "text": "\"Robbers broke into our house last night,\" said Lady Kou breathlessly.",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/fe4cc71cb7b3.mp3",
      "sourceNodeId": "n024"
    },
    "dialogue:ep100-map-quiz-1:zh": {
      "text": "\"昨晚有强盗闯入了我们的家,\"寇夫人气喘吁吁地说。",
      "lang": "zh-CN",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_zh/f1f03c6e2c11.mp3",
      "sourceNodeId": "n024"
    },
