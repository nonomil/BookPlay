    "dialogue:ep33-map-intro-1:en": {
      "text": "After the Tang Monk sent Wukong away, he and the others continued west.",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/9fa171417b37.mp3",
      "sourceNodeId": "n001"
    },
    "dialogue:ep33-map-intro-1:zh": {
      "text": "在唐僧将悟空送走后,他与同伴们继续向西行进。",
      "lang": "zh-CN",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_zh/84b32aa8b42c.mp3",
      "sourceNodeId": "n001"
    },
    "dialogue:ep33-map-intro-2:en": {
      "text": "Later that day they stopped to rest.",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/e9a82b8f93f1.mp3",
      "sourceNodeId": "n002"
    },
    "dialogue:ep33-map-intro-2:zh": {
      "text": "当天晚些时候,他们停下来休息了。",
      "lang": "zh-CN",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_zh/88e6e5435599.mp3",
      "sourceNodeId": "n002"
    },
    "dialogue:ep33-map-quiz-1:en": {
      "text": "The pig lay down behind some bushes.",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/24bc4fcb1fe8.mp3",
      "sourceNodeId": "n016"
    },
    "dialogue:ep33-map-quiz-1:zh": {
      "text": "猪躺在一些灌木后面。",
