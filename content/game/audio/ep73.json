    "dialogue:ep73-map-intro-1:en": {
      "text": "Wujing watched as the fake Wujing fed the horse some hay.",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/7399603c104a.mp3",
      "sourceNodeId": "n001"
    },
    "dialogue:ep73-map-intro-1:zh": {
      "text": "悟净 看着假悟净 给马喂了些干草。",
      "lang": "zh-CN",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_zh/f14e738e8969.mp3",
      "sourceNodeId": "n001"
    },
    "dialogue:ep73-map-intro-2:en": {
      "text": "\"I don't know how you made fake versions of us, Wukong,\" said the purple spirit.",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/972c2ef60a57.mp3",
      "sourceNodeId": "n002"
    },
    "dialogue:ep73-map-intro-2:zh": {
      "text": "\"我不知道你究竟是如何伪造出我们这些版本的,悟空,\"紫灵说道。",
      "lang": "zh-CN",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_zh/fa14163a7667.mp3",
      "sourceNodeId": "n002"
    },
    "dialogue:ep73-map-quiz-1:en": {
      "text": "When Wujing arrived at Mount Potalaka, he was even more shocked.",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/caba36d56426.mp3",
      "sourceNodeId": "n008"
    },
