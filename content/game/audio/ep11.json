    "dialogue:ep11-map-intro-1:en": {
      "text": "Erlang quickly tied up Wukong and brought him up to Heaven.",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/8c0bdb97d928.mp3",
      "sourceNodeId": "n001"
    },
    "dialogue:ep11-map-intro-1:zh": {
      "text": "哪咤迅速擒住悟空,并将其押送上天。",
      "lang": "zh-CN",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_zh/364cb15a25b0.mp3",
      "sourceNodeId": "n001"
    },
    "dialogue:ep11-map-intro-2:en": {
      "text": "\"I want Sun Wukong destroyed,\" said the Jade Emperor.",
