    "dialogue:ep105-map-intro-1:en": {
      "text": "The travelers walked up the Spirit Mountain.",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/5693bbc74933.mp3",
      "sourceNodeId": "n001"
    },
    "dialogue:ep105-map-intro-1:zh": {
      "text": "旅人们沿着灵山而上。",
      "lang": "zh-CN",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_zh/b1b287ee0c12.mp3",
      "sourceNodeId": "n001"
    },
    "dialogue:ep105-map-intro-2:en": {
      "text": "The mountain's slopes were covered in pine trees, bamboo, and flowers.",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/060db199eecd.mp3",
      "sourceNodeId": "n002"
    },
    "dialogue:ep105-map-intro-2:zh": {
      "text": "这座山的山坡上覆盖着松树、竹林和鲜花。",
      "lang": "zh-CN",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_zh/237b56e8e43c.mp3",
      "sourceNodeId": "n002"
    },
    "dialogue:ep105-map-quiz-1:en": {
      "text": "When the travelers were done eating, a guard led them to a large room filled with magical light and mist.",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/5b6ea09795a9.mp3",
      "sourceNodeId": "n035"
    },
    "dialogue:ep105-map-quiz-1:zh": {
      "text": "旅人们用餐完毕后,一名守卫领他们进入一间宽敞的房间,室内充盈着魔法般的光芒与薄雾。",
      "lang": "zh-CN",
      "kind": "static-existing",
