    "dialogue:ep26-map-intro-1:en": {
      "text": "\"I hope we reach the Western Paradise soon,\" said the Tang Monk one morning.",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/1ae92b098237.mp3",
      "sourceNodeId": "n001"
    },
