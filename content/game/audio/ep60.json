    "dialogue:ep60-map-intro-1:en": {
      "text": "The demon eyed the smiling boy suspiciously.",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/0f2971d981bb.mp3",
      "sourceNodeId": "n001"
    },
    "dialogue:ep60-map-intro-1:zh": {
      "text": "那个恶魔怀疑地打量着那个面带微笑的男孩。",
      "lang": "zh-CN",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_zh/b354e61371c0.mp3",
      "sourceNodeId": "n001"
    },
    "dialogue:ep60-map-intro-2:en": {
      "text": "\"Aren't you scared of me?\" asked the demon.",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/d9923b2cb611.mp3",
      "sourceNodeId": "n002"
    },
    "dialogue:ep60-map-intro-2:zh": {
      "text": "\"你不怕我吗?\"恶魔问道。",
      "lang": "zh-CN",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_zh/25aca42852a4.mp3",
      "sourceNodeId": "n002"
    },
    "dialogue:ep60-map-quiz-1:en": {
      "text": "Suddenly the boy changed into Wukong.",
