    "dialogue:ep43-map-intro-1:en": {
      "text": "Golden Horn scowled at Wukong.",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/cbf9baaac330.mp3",
      "sourceNodeId": "n001"
    },
    "dialogue:ep43-map-intro-1:zh": {
      "text": "金角对悟空皱了皱眉。",
      "lang": "zh-CN",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_zh/07b74803b2d8.mp3",
      "sourceNodeId": "n001"
    },
    "dialogue:ep43-map-intro-2:en": {
      "text": "\"I doubt you have a gourd like mine.\"",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/3b3c9bd612b8.mp3",
      "sourceNodeId": "n002"
    },
    "dialogue:ep43-map-intro-2:zh": {
      "text": "\"我怀疑你没有像我这样的葫芦。\"",
      "lang": "zh-CN",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_zh/982971d4f977.mp3",
      "sourceNodeId": "n002"
    },
