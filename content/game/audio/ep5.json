  "entries": {
    "dialogue:ep5-map-intro-1:en": {
      "text": "\"What happened here?\" Wukong asked the gibbon.",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/d507da3e6e9b.mp3",
      "sourceNodeId": "n001"
    },
    "dialogue:ep5-map-intro-1:zh": {
      "text": "\"这里发生了什么?\"悟空问着那只长臂猿。",
      "lang": "zh-CN",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_zh/2f3b7e4fca15.mp3",
      "sourceNodeId": "n001"
    },
    "dialogue:ep5-map-intro-2:en": {
      "text": "\"A demon attacked us,\" said the gibbon.",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/1a0b5f7d0eaa.mp3",
      "sourceNodeId": "n004"
    },
    "dialogue:ep5-map-intro-2:zh": {
      "text": "\"有个恶魔袭击了我们,\"长臂猿说道。",
      "lang": "zh-CN",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_zh/88e326cffdf3.mp3",
      "sourceNodeId": "n004"
    },
    "dialogue:ep5-map-quiz-1:en": {
      "text": "\"Wait here,\" Wukong ordered. \"I will handle the demon.\"",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/7b2a60dc8f29.mp3",
      "sourceNodeId": "n010"
    },
    "dialogue:ep5-map-quiz-1:zh": {
      "text": "\"请在此等候,\"悟空命令道,\"我来对付那妖怪。\"",
      "lang": "zh-CN",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_zh/b33e144a0b8a.mp3",
      "sourceNodeId": "n010"
    },
    "dialogue:ep5-story-intro-1:en": {
