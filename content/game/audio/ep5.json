    "dialogue:ep5-story-intro-2:en": {
      "text": "A few more monkeys and apes gathered around Sun Wukong and the gibbon.",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/614cee3c30dd.mp3",
      "sourceNodeId": "n002"
    },
    "dialogue:ep5-story-intro-2:zh": {
      "text": "又有几只猴子和类人猿围聚在孙悟空和长臂猿周围。",
      "lang": "zh-CN",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_zh/1b4d711f2554.mp3",
