    "dialogue:ep55-map-quiz-1:en": {
      "text": "Wukong smiled. \"I've heard of Sun Wukong. And it's true that he's very powerful. Did Venus tell you what he looks like?\"",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/f1312e931e09.mp3",
      "sourceNodeId": "n058"
    },
    "dialogue:ep55-map-quiz-1:zh": {
      "text": "悟空 smiled。\"我听说过孙悟空。他确实非常强大。太白金星是否告诉过你他长什么样?\"",
      "lang": "zh-CN",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_zh/6e8fc92fe2e6.mp3",
