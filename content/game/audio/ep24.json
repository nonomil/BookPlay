    "dialogue:ep24-map-intro-1:en": {
      "text": "Wukong and Bajie looked all around.",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/255520de7bfc.mp3",
      "sourceNodeId": "n001"
    },
    "dialogue:ep24-map-intro-1:zh": {
      "text": "悟空与猪八戒环顾四周。",
      "lang": "zh-CN",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_zh/14a48f9e4a07.mp3",
      "sourceNodeId": "n001"
    },
    "dialogue:ep24-map-intro-2:en": {
      "text": "But the Tang Monk was gone.",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/104ee2c3b91c.mp3",
      "sourceNodeId": "n002"
    },
    "dialogue:ep24-map-intro-2:zh": {
      "text": "然而,唐僧已然离去了。",
      "lang": "zh-CN",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_zh/02c9e7d657d4.mp3",
      "sourceNodeId": "n002"
    },
    "dialogue:ep24-map-quiz-1:en": {
      "text": "\"I have heard that anyone who eats the Tang Monk will live forever. Was the monk alone?\"",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/a3ae23da48e2.mp3",
      "sourceNodeId": "n014"
    },
    "dialogue:ep24-map-quiz-1:zh": {
      "text": "\"我听说,凡是吃下唐僧的人就能永生。这位僧人是独自一人吗?\"",
      "lang": "zh-CN",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_zh/541587182b0f.mp3",
      "sourceNodeId": "n014"
    },
