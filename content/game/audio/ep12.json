    "dialogue:ep12-map-intro-1:en": {
      "text": "Buddha smiled at Wukong.",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/1588072c1cb5.mp3",
      "sourceNodeId": "n001"
    },
    "dialogue:ep12-map-intro-1:zh": {
      "text": "佛陀对悟空微微一笑。",
      "lang": "zh-CN",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_zh/92a0c414452b.mp3",
      "sourceNodeId": "n001"
    },
    "dialogue:ep12-map-intro-2:en": {
      "text": "\"How did you get so powerful?\"",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/a8edee60eeaf.mp3",
      "sourceNodeId": "n002"
    },
    "dialogue:ep12-map-intro-2:zh": {
      "text": "\"你究竟是如何变得如此强大的?\"",
      "lang": "zh-CN",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_zh/3844bafbdc71.mp3",
      "sourceNodeId": "n002"
    },
    "dialogue:ep12-map-quiz-1:en": {
      "text": "\"Then let's make a bet,\" said Buddha.",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/0598fcd83b4d.mp3",
      "sourceNodeId": "n013"
    },
    "dialogue:ep12-map-quiz-1:zh": {
      "text": "\"那么,我们来打个赌吧,\"佛陀说道。",
      "lang": "zh-CN",
      "kind": "static-existing",
