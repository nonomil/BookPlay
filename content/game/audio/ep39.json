      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/ac8d80208449.mp3",
      "sourceNodeId": "n002"
    },
    "dialogue:ep39-map-intro-2:zh": {
      "text": "\"你休想伤害唐僧!\"猪大声喊道。",
