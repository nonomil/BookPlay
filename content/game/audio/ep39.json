      "kind": "static-existing",
      "src": "assets/adv_audio/sent_zh/68e841d04f96.mp3",
      "sourceNodeId": "n002"
    },
    "dialogue:ep39-map-quiz-1:en": {
      "text": "\"A tiger attacked me,\" said the old monk.",
