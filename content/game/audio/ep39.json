    "dialogue:ep39-map-intro-1:en": {
      "text": "Bajie waved his rake at the demon Golden Horn.",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/eb04aca2a9db.mp3",
      "sourceNodeId": "n001"
    },
    "dialogue:ep39-map-intro-1:zh": {
      "text": "八戒挥动着他的锄头向那头名为\"金角\"的妖兽袭去。",
      "lang": "zh-CN",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_zh/e23f46d1845c.mp3",
      "sourceNodeId": "n001"
    },
    "dialogue:ep39-map-intro-2:en": {
      "text": "\"You'll never harm the Tang Monk!\" shouted the pig.",
