    "dialogue:ep45-map-intro-1:en": {
      "text": "The Tang Monk introduced himself to the prince and then waved toward the others.",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/6e7f1887481a.mp3",
      "sourceNodeId": "n001"
    },
    "dialogue:ep45-map-intro-1:zh": {
      "text": "唐僧向王子自我介绍后,向其他众人挥手示意。",
      "lang": "zh-CN",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_zh/d7e21a6ad351.mp3",
      "sourceNodeId": "n001"
    },
    "dialogue:ep45-map-intro-2:en": {
      "text": "\"These are my companions. We're going to the Western Paradise to get scriptures from Buddha.\"",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/b17a6ed923d4.mp3",
      "sourceNodeId": "n002"
    },
    "dialogue:ep45-map-intro-2:zh": {
      "text": "\"这些是我的同伴们。我们将前往西方极乐世界取回佛经。\"",
      "lang": "zh-CN",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_zh/d0a9a0337538.mp3",
      "sourceNodeId": "n002"
    },
    "dialogue:ep45-map-quiz-1:en": {
      "text": "He told the prince everything.",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/d95629651193.mp3",
      "sourceNodeId": "n006"
    },
    "dialogue:ep45-map-quiz-1:zh": {
