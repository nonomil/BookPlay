    "dialogue:ep107-map-intro-1:en": {
      "text": "The travelers laid the soaked scrolls on some rocks.",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/2f9b9fb5201b.mp3",
      "sourceNodeId": "n001"
    },
    "dialogue:ep107-map-intro-1:zh": {
      "text": "旅人们将浸透的卷轴铺在几块岩石上。",
      "lang": "zh-CN",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_zh/b7a8978ac535.mp3",
      "sourceNodeId": "n001"
    },
    "dialogue:ep107-map-intro-2:en": {
      "text": "\"The sun will dry them out,\" said Wukong.",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/d19400b274f2.mp3",
      "sourceNodeId": "n002"
    },
    "dialogue:ep107-map-intro-2:zh": {
      "text": "\"太阳会把它们晒干的,\"悟空说道。",
      "lang": "zh-CN",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_zh/0e83e68a4709.mp3",
      "sourceNodeId": "n002"
    },
    "dialogue:ep107-map-quiz-1:en": {
      "text": "\"Nothing on Earth or in Heaven is perfect,\" said Wukong.",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/eca06ded99bc.mp3",
      "sourceNodeId": "n049"
    },
    "dialogue:ep107-map-quiz-1:zh": {
      "text": "\"无论是在人间还是在天界,都没有任何事物是完美的,\"悟空说道。",
      "lang": "zh-CN",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_zh/d32ac3bfe8b4.mp3",
