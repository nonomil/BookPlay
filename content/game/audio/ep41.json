    "dialogue:ep41-map-intro-1:en": {
      "text": "Wukong was angry at the guard at the southern gate of Heaven.",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/29520b591db7.mp3",
      "sourceNodeId": "n001"
    },
    "dialogue:ep41-map-intro-1:zh": {
      "text": "悟空对天界南门的守卫感到愤怒。",
      "lang": "zh-CN",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_zh/7b181641810e.mp3",
      "sourceNodeId": "n001"
    },
    "dialogue:ep41-map-intro-2:en": {
      "text": "\"Why can't you close the gate and dim the stars?\"",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/834bbc4a4b5e.mp3",
      "sourceNodeId": "n002"
    },
    "dialogue:ep41-map-intro-2:zh": {
      "text": "\"你为什么不能关上大门、让星光变得暗淡一些呢?\"",
      "lang": "zh-CN",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_zh/319cded787d7.mp3",
      "sourceNodeId": "n002"
    },
