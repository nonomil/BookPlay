    "dialogue:ep66-map-intro-1:en": {
      "text": "One-Horned Buffalo went back into his cave and slammed the door shut.",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/0d9058508693.mp3",
      "sourceNodeId": "n001"
    },
    "dialogue:ep66-map-intro-1:zh": {
      "text": "单角水牛回到自己的洞穴中,猛地关上了门。",
      "lang": "zh-CN",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_zh/443175796c14.mp3",
      "sourceNodeId": "n001"
    },
    "dialogue:ep66-map-intro-2:en": {
      "text": "\"He stole my iron bar!\" cried Wukong.",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/b2753cad654c.mp3",
      "sourceNodeId": "n002"
    },
    "dialogue:ep66-map-intro-2:zh": {
      "text": "\"他偷走了我的铁棒!\"悟空惊呼道。",
      "lang": "zh-CN",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_zh/0bdf115b0e05.mp3",
      "sourceNodeId": "n002"
    },
    "dialogue:ep66-map-quiz-1:en": {
      "text": "The guard sent a messenger to see if any spirits were missing from Heaven.",
      "lang": "en-US",
      "kind": "static-existing",
