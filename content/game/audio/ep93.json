      "sourceNodeId": "n001"
    },
    "dialogue:ep93-map-intro-2:en": {
      "text": "\"Sun Wukong is alive inside you,\" said the raptor.",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/cb8281e3d441.mp3",
      "sourceNodeId": "n002"
    },
    "dialogue:ep93-map-intro-2:zh": {
      "text": "\"孙悟空活在你体内,\"猛禽说道。",
      "lang": "zh-CN",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_zh/d816c1f1621d.mp3",
      "sourceNodeId": "n002"
    },
    "dialogue:ep93-map-quiz-1:en": {
      "text": "\"I'm coming out now. You'd better not try any more tricks!\"",
      "lang": "en-US",
      "kind": "static-existing",
