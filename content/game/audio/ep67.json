    "dialogue:ep67-map-intro-1:en": {
      "text": "\"What are we going to do now?\" cried Wukong.",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/dcb4baf591d7.mp3",
      "sourceNodeId": "n001"
    },
    "dialogue:ep67-map-intro-1:zh": {
      "text": "\"我们现在该怎么办?\"悟空喊道。",
      "lang": "zh-CN",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_zh/2e0d13ddc982.mp3",
      "sourceNodeId": "n001"
    },
    "dialogue:ep67-map-intro-2:en": {
      "text": "\"One-Horned Buffalo stole all our weapons!\"",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/581637d3ad87.mp3",
      "sourceNodeId": "n002"
    },
    "dialogue:ep67-map-intro-2:zh": {
      "text": "\"单角水牛偷走了我们所有的武器!\"",
      "lang": "zh-CN",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_zh/2f2a4d57b806.mp3",
      "sourceNodeId": "n002"
    },
