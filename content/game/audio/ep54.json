      "sourceNodeId": "n001"
    },
    "dialogue:ep54-map-intro-2:en": {
      "text": "\"I should have stopped Master from getting in that canoe. But whenever I warn him about someone, he doesn't believe me.\"",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/831dfe0f00f8.mp3",
      "sourceNodeId": "n002"
    },
    "dialogue:ep54-map-intro-2:zh": {
      "text": "\"我本该阻止师父登上那艘独木舟的,但每当我提醒他有陌生人时,他都不相信我。\"",
      "lang": "zh-CN",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_zh/c8cc80c6bdc5.mp3",
      "sourceNodeId": "n002"
    },
