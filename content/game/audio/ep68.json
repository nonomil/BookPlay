    "dialogue:ep68-map-intro-1:en": {
      "text": "Wukong stared at the cave door, shocked.",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/298bca1501b8.mp3",
      "sourceNodeId": "n001"
    },
    "dialogue:ep68-map-intro-1:zh": {
      "text": "悟空呆呆地盯着洞口,满脸震惊。",
      "lang": "zh-CN",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_zh/a655728dde41.mp3",
      "sourceNodeId": "n001"
    },
    "dialogue:ep68-map-intro-2:en": {
      "text": "\"I don't believe it. One-Horned Buffalo stole our weapons again!\"",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/796b11fa3ec1.mp3",
      "sourceNodeId": "n002"
    },
    "dialogue:ep68-map-intro-2:zh": {
      "text": "\"我简直不敢相信!单角水牛又偷走了我们的武器!\"",
      "lang": "zh-CN",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_zh/9f7fb85aac9e.mp3",
      "sourceNodeId": "n002"
    },
    "dialogue:ep68-map-quiz-1:en": {
      "text": "Laozi nodded. \"He's my green buffalo. I didn't realize he'd escaped.\"",
