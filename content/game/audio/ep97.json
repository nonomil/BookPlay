  "entries": {
    "dialogue:ep97-map-intro-1:en": {
      "text": "Bajie took a step back as a dark mist surrounded the people on the road.",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/f10beda77a08.mp3",
      "sourceNodeId": "n001"
    },
    "dialogue:ep97-map-intro-1:zh": {
      "text": "当一道黑雾笼罩着路旁的众人时,八戒后退了一步。",
      "lang": "zh-CN",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_zh/cc0479508863.mp3",
      "sourceNodeId": "n001"
    },
    "dialogue:ep97-map-intro-2:en": {
      "text": "When the mist cleared, he saw they were really a monster and several little demons.",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/12002e1e176b.mp3",
      "sourceNodeId": "n002"
    },
    "dialogue:ep97-map-intro-2:zh": {
      "text": "当雾气散去时,他发现那其实是一只怪物和几只小恶魔。",
      "lang": "zh-CN",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_zh/2a4617fbc566.mp3",
      "sourceNodeId": "n002"
    },
    "dialogue:ep97-map-quiz-1:en": {
      "text": "\"Yes, you <font color=\"#ffff00\"><i>are</i></font> here for the feast, Pig. We're going to eat you for lunch!\"",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/8f45bbcdcd1a.mp3",
      "sourceNodeId": "n004"
    },
    "dialogue:ep97-map-quiz-1:zh": {
      "text": "\"没错,Pig,<font color=\"#ffff00\">(i)你就是(/i)</font>来参加这场盛宴的。我们今天午餐就吃你!\"",
      "lang": "zh-CN",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_zh/a9e6f97ee220.mp3",
      "sourceNodeId": "n004"
    },
