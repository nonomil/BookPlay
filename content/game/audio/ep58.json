    "dialogue:ep58-map-intro-1:en": {
      "text": "\"I challenge you to a meditation contest,\" said the Tiger Immortal.",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/25e913ebb268.mp3",
      "sourceNodeId": "n001"
    },
    "dialogue:ep58-map-intro-1:zh": {
      "text": "\"我向你发起一场冥想竞赛!\"虎力大仙说道。",
      "lang": "zh-CN",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_zh/23eeeb0c31db.mp3",
      "sourceNodeId": "n001"
    },
    "dialogue:ep58-map-intro-2:en": {
      "text": "\"Whoever can meditate the longest without moving is the winner.\"",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/97ca47c263a1.mp3",
      "sourceNodeId": "n002"
    },
    "dialogue:ep58-map-intro-2:zh": {
      "text": "\"谁能持续冥想最长时间而不移动,谁就是获胜者。\"",
      "lang": "zh-CN",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_zh/10ee8ea81a20.mp3",
      "sourceNodeId": "n002"
    },
