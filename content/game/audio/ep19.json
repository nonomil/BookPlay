    "dialogue:ep19-map-intro-1:en": {
      "text": "The head priest called for two other priests, who quickly ran into the room.",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/92163ff7affa.mp3",
      "sourceNodeId": "n001"
    },
    "dialogue:ep19-map-intro-1:zh": {
      "text": "主祭司召来了另外两名祭司,他们迅速跑进房间。",
      "lang": "zh-CN",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_zh/44a72ad8a7df.mp3",
      "sourceNodeId": "n001"
    },
    "dialogue:ep19-map-intro-2:en": {
      "text": "\"Is everything okay, Master?\" one priest asked.",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/c3522b67ee82.mp3",
      "sourceNodeId": "n002"
    },
    "dialogue:ep19-map-intro-2:zh": {
      "text": "\"大师,一切安好吗?\"一位神父问道。",
      "lang": "zh-CN",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_zh/dde522cd35bd.mp3",
      "sourceNodeId": "n002"
    },
    "dialogue:ep19-map-quiz-1:en": {
      "text": "\"I'll bet that head priest wants to keep our robe. He's planning to kill us.\"",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/22c7f52fca10.mp3",
      "sourceNodeId": "n018"
    },
    "dialogue:ep19-map-quiz-1:zh": {
      "text": "\"我敢打赌,那位首席祭司想保留我们的法袍。他打算杀了我们。\"",
      "lang": "zh-CN",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_zh/4e885d1516a1.mp3",
      "sourceNodeId": "n018"
    },
