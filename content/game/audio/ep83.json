  "entries": {
    "dialogue:ep83-map-intro-1:en": {
      "text": "\"Are you sure you can help?\" Wukong asked the Buddha Maitreya.",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/7de62848390c.mp3",
      "sourceNodeId": "n001"
    },
    "dialogue:ep83-map-intro-1:zh": {
      "text": "\"您确定能提供帮助吗?\"悟空问弥勒佛。",
      "lang": "zh-CN",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_zh/5a31eec5f769.mp3",
      "sourceNodeId": "n001"
    },
    "dialogue:ep83-map-intro-2:en": {
      "text": "\"Yellow Brows is powerful. He captured everyone with a magic cloth. He trapped me in a pair of cymbals.\"",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/e1ceac617930.mp3",
      "sourceNodeId": "n002"
    },
    "dialogue:ep83-map-intro-2:zh": {
      "text": "\"Yellow Brows 势不可挡。他用一块魔法布吸引了所有人;他将我困在了一对镲片之中。\"",
      "lang": "zh-CN",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_zh/7d9a9300ae76.mp3",
      "sourceNodeId": "n002"
    },
    "dialogue:ep83-map-quiz-1:en": {
      "text": "Finally he held up a ripe melon.",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/34cf8cb18912.mp3",
      "sourceNodeId": "n043"
    },
    "dialogue:ep83-map-quiz-1:zh": {
      "text": "最后,他举起了一个成熟的甜瓜。",
      "lang": "zh-CN",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_zh/979599431dcf.mp3",
      "sourceNodeId": "n043"
    },
