    "dialogue:ep10-map-intro-1:en": {
      "text": "\"How will we defeat Sun Wukong?\" moaned the Jade Emperor.",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/9954bd2a1ee8.mp3",
      "sourceNodeId": "n001"
    },
    "dialogue:ep10-map-intro-1:zh": {
      "text": "\"我们该如何击败孙悟空?\"玉皇大帝哀叹道。",
      "lang": "zh-CN",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_zh/abb89b5d6bee.mp3",
      "sourceNodeId": "n001"
    },
    "dialogue:ep10-map-intro-2:en": {
      "text": "\"I sent our entire army, and they couldn't arrest him!\"",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/c0f3205315c7.mp3",
      "sourceNodeId": "n002"
    },
    "dialogue:ep10-map-intro-2:zh": {
      "text": "\"我派出了全部军队,但他们还是没能逮捕到他!\"",
      "lang": "zh-CN",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_zh/e514d1c9c10d.mp3",
      "sourceNodeId": "n002"
    },
    "dialogue:ep10-map-quiz-1:en": {
      "text": "\"Our king has just defeated an entire army from Heaven!\" said the gibbon.",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/15e15ef16bba.mp3",
      "sourceNodeId": "n008"
    },
    "dialogue:ep10-map-quiz-1:zh": {
      "text": "\"我们的国王刚刚击败了来自天界的整支军队!\"长臂猿说道。",
      "lang": "zh-CN",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_zh/417e114e928c.mp3",
      "sourceNodeId": "n008"
    },
