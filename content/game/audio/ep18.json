    "dialogue:ep18-map-intro-1:en": {
      "text": "Wukong and Guanyin flew over the ocean and back to the wide river.",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/d51ee2592184.mp3",
      "sourceNodeId": "n001"
    },
    "dialogue:ep18-map-intro-1:zh": {
      "text": "悟空与观音飞越海洋,返回宽阔的河流。",
      "lang": "zh-CN",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_zh/9dbdb8c453bf.mp3",
      "sourceNodeId": "n001"
    },
    "dialogue:ep18-map-intro-2:en": {
      "text": "From the sky Guanyin called, \"Dragon! Come out of the river at once. The Tang Monk is here!\"",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/75e62f926500.mp3",
      "sourceNodeId": "n002"
    },
    "dialogue:ep18-map-intro-2:zh": {
      "text": "从天而降的观音呼唤道:\"龙啊!快从河中现身!唐僧来了!\"",
      "lang": "zh-CN",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_zh/428640f9fe76.mp3",
      "sourceNodeId": "n002"
    },
    "dialogue:ep18-map-quiz-1:en": {
      "text": "\"From now on, you must tell people who you are. There are others waiting for you too.\"",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/92730dc2da27.mp3",
      "sourceNodeId": "n012"
    },
    "dialogue:ep18-map-quiz-1:zh": {
      "text": "\"从今往后,你必须向人们表明自己的身份。还有其他人也在等待着你。\"",
      "lang": "zh-CN",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_zh/056f2cfe8477.mp3",
      "sourceNodeId": "n012"
    },
