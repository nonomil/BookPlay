{
  "version": 1,
  "episode": 1,
  "entries": {
    "dialogue:ep1-map-intro-1:en": {
      "text": "One day the rock split open.",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/f7bd5bebf237.mp3",
      "sourceNodeId": "n003"
    },
    "dialogue:ep1-map-intro-1:zh": {
      "text": "有一天,这块岩石裂开了。",
      "lang": "zh-CN",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_zh/8292121d0429.mp3",
      "sourceNodeId": "n003"
    },
    "dialogue:ep1-map-intro-2:en": {
      "text": "Inside was a monkey.",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/d4f55221cc9d.mp3",
      "sourceNodeId": "n004"
    },
    "dialogue:ep1-map-intro-2:zh": {
      "text": "内部有一只猴子。",
      "lang": "zh-CN",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_zh/514f0f1b40a8.mp3",
      "sourceNodeId": "n004"
    },
    "dialogue:ep1-map-quiz-1:en": {
      "text": "Suddenly powerful light shot from his eyes.",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/99a2879b124a.mp3",
      "sourceNodeId": "n006"
    },
    "dialogue:ep1-map-quiz-1:zh": {
      "text": "突然,一道强光从他眼中射出。",
      "lang": "zh-CN",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_zh/b146e1966820.mp3",
      "sourceNodeId": "n006"
    },
    "dialogue:ep1-story-intro-1:en": {
      "text": "From the beginning of time, a rock had sat high on top of a mountain.",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/6835b76c0e72.mp3",
      "sourceNodeId": "n001"
    },
    "dialogue:ep1-story-intro-1:zh": {
      "text": "自古以来,一块岩石便高高耸立于山巅。",
      "lang": "zh-CN",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_zh/f7d64af4c60e.mp3",
      "sourceNodeId": "n001"
    },
    "dialogue:ep1-story-intro-2:en": {
      "text": "The sun, the moon, Heaven, and Earth all worked their magic on the rock.",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/28e3feed3675.mp3",
      "sourceNodeId": "n002"
    },
    "dialogue:ep1-story-intro-2:zh": {
      "text": "太阳、月亮、天与地共同施展了魔力,作用于这块岩石。",
      "lang": "zh-CN",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_zh/7067447449cc.mp3",
      "sourceNodeId": "n002"
    },
