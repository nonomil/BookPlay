    },
    "dialogue:ep85-map-quiz-1:en": {
      "text": "\"He has three bells. The first bell makes fire. The second bell makes smoke. And the third bell makes sand.\"",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/05b9a5001683.mp3",
      "sourceNodeId": "n029"
    },
    "dialogue:ep85-map-quiz-1:zh": {
      "text": "\"他有三口钟:第一口钟能生火,第二口钟能生烟,第三口钟则能生沙。\"",
      "lang": "zh-CN",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_zh/70532b178742.mp3",
      "sourceNodeId": "n029"
    },
