      "sourceNodeId": "n002"
    },
    "dialogue:ep21-map-quiz-1:en": {
      "text": "Guanyin sighed. \"The Tang Monk should not have shown that robe to the priest,\" she said.",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/e2babd4e2a8f.mp3",
      "sourceNodeId": "n005"
    },
    "dialogue:ep21-map-quiz-1:zh": {
      "text": "观音叹了口气:\"唐僧本不该把那件袈裟展示给那位僧人,\"她说道。",
      "lang": "zh-CN",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_zh/10d7d997f276.mp3",
