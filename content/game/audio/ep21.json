    "dialogue:ep21-map-intro-1:en": {
      "text": "Wukong stood before Guanyin.",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/51dae9050d87.mp3",
      "sourceNodeId": "n001"
    },
    "dialogue:ep21-map-intro-1:zh": {
      "text": "悟空站在观音面前。",
      "lang": "zh-CN",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_zh/1b1a4f90dd3e.mp3",
      "sourceNodeId": "n001"
    },
    "dialogue:ep21-map-intro-2:en": {
      "text": "He was telling the bodhisattva everything that had happened at the monastery.",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/99425f18ce05.mp3",
      "sourceNodeId": "n002"
    },
    "dialogue:ep21-map-intro-2:zh": {
      "text": "他向菩萨讲述了寺院里发生的一切。",
      "lang": "zh-CN",
      "kind": "static-existing",
