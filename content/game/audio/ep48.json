    "dialogue:ep48-map-intro-1:en": {
      "text": "Wukong stared at the mountains.",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/095f87274027.mp3",
      "sourceNodeId": "n001"
    },
    "dialogue:ep48-map-intro-1:zh": {
      "text": "猿猴孙悟空凝视着群山。",
      "lang": "zh-CN",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_zh/7afdd525e8cd.mp3",
      "sourceNodeId": "n001"
    },
    "dialogue:ep48-map-intro-2:en": {
      "text": "\"A red cloud keeps appearing over those mountains,\" he said.",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/fc472d33fc47.mp3",
      "sourceNodeId": "n002"
    },
    "dialogue:ep48-map-intro-2:zh": {
      "text": "\"那座山峰上总浮现出一道红云,\"他说道。",
      "lang": "zh-CN",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_zh/6f1012974ffe.mp3",
      "sourceNodeId": "n002"
    },
    "dialogue:ep48-map-quiz-1:en": {
      "text": "The group continued west, with Wukong carrying the boy on his back.",
