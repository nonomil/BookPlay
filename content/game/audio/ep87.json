    "dialogue:ep87-map-intro-1:en": {
      "text": "Wukong and his companions were walking through a forest.",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/f45b5bba5c8f.mp3",
      "sourceNodeId": "n001"
    },
    "dialogue:ep87-map-intro-1:zh": {
      "text": "悟空与他的同伴们正漫步于一片森林之中。",
      "lang": "zh-CN",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_zh/17ad0bc39949.mp3",
      "sourceNodeId": "n001"
    },
    "dialogue:ep87-map-intro-2:en": {
      "text": "\"I'm glad the road goes through this shady forest,\" said the Tang Monk.",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/073d15058f71.mp3",
      "sourceNodeId": "n002"
    },
    "dialogue:ep87-map-intro-2:zh": {
      "text": "\"很高兴这条路穿过这片阴凉的森林,\"唐僧说道。",
      "lang": "zh-CN",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_zh/a7568e007fff.mp3",
      "sourceNodeId": "n002"
    },
    "dialogue:ep87-map-quiz-1:en": {
      "text": "The three young women led the Tang Monk into their house.",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/2873516aa4d5.mp3",
      "sourceNodeId": "n043"
    },
    "dialogue:ep87-map-quiz-1:zh": {
      "text": "这三位年轻女子引领唐僧进入了她们的家中。",
