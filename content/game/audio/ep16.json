    "dialogue:ep16-map-intro-1:en": {
      "text": "Wukong looked at the Dragon King and sighed.",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/e65d0465a7bd.mp3",
      "sourceNodeId": "n001"
    },
    "dialogue:ep16-map-intro-1:zh": {
      "text": "悟空望向龙王,叹了口气。",
      "lang": "zh-CN",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_zh/889dbfb3c664.mp3",
      "sourceNodeId": "n001"
    },
    "dialogue:ep16-map-intro-2:en": {
      "text": "\"You're right,\" said the monkey.",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/06a09549d822.mp3",
      "sourceNodeId": "n002"
    },
    "dialogue:ep16-map-intro-2:zh": {
      "text": "\"你说得对,\"猴子说道。",
      "lang": "zh-CN",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_zh/5290ea2cc8a7.mp3",
      "sourceNodeId": "n002"
    },
    "dialogue:ep16-map-quiz-1:en": {
      "text": "\"The bodhisattva Guanyin taught me a spell,\" said the monk.",
      "lang": "en-US",
      "kind": "static-existing",
