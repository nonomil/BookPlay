    "dialogue:ep9-map-intro-1:en": {
      "text": "Wukong plucked a peach from a branch and bit into it.",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/72d2db86c781.mp3",
      "sourceNodeId": "n001"
    },
    "dialogue:ep9-map-intro-1:zh": {
      "text": "猿猴从树枝上摘下一颗桃子,咬了一口。",
      "lang": "zh-CN",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_zh/0ed4dfa62380.mp3",
      "sourceNodeId": "n001"
    },
    "dialogue:ep9-map-intro-2:en": {
      "text": "\"This peach tastes wonderful!\" he said.",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/7481c5e74885.mp3",
      "sourceNodeId": "n002"
    },
    "dialogue:ep9-map-intro-2:zh": {
      "text": "\"这桃子味道真棒!\"他说道。",
