    },
    "dialogue:ep4-map-quiz-1:en": {
      "text": "Subodhi smiled. \"I knew you were a worthy student. Come closer.\"",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/0731402a841f.mp3",
      "sourceNodeId": "n007"
    },
