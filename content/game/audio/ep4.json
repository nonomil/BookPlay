    "dialogue:ep4-map-intro-1:en": {
      "text": "When the other students went to bed that night, Wukong stayed awake.",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/f613d21de2e8.mp3",
      "sourceNodeId": "n001"
    },
    "dialogue:ep4-map-intro-1:zh": {
      "text": "当其他学生当晚都上床睡觉时,悟空却依然醒着。",
      "lang": "zh-CN",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_zh/c9c1257ce34f.mp3",
      "sourceNodeId": "n001"
    },
    "dialogue:ep4-map-intro-2:en": {
      "text": "At three o'clock in the morning, he crept quietly through the dark temple.",
      "lang": "en-US",
      "kind": "static-existing",
