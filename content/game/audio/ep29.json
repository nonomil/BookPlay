    "dialogue:ep29-map-intro-1:en": {
      "text": "\"I know we counted the fruit correctly,\" said one priest.",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/32f951be8371.mp3",
      "sourceNodeId": "n001"
    },
    "dialogue:ep29-map-intro-1:zh": {
      "text": "\"我知道我们数水果的数目没错,\"一位神父说道。",
      "lang": "zh-CN",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_zh/402c066db9cc.mp3",
      "sourceNodeId": "n001"
    },
    "dialogue:ep29-map-intro-2:en": {
      "text": "\"But we'll count again anyway.\"",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/5be0df766353.mp3",
      "sourceNodeId": "n002"
    },
    "dialogue:ep29-map-intro-2:zh": {
      "text": "\"不过,我们还是再数一遍吧。\"",
      "lang": "zh-CN",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_zh/35af10cdbe7b.mp3",
      "sourceNodeId": "n002"
    },
    "dialogue:ep29-map-quiz-1:en": {
      "text": "\"But the monkey was inside the whole time,\" said the other priest.",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/37354b62163b.mp3",
      "sourceNodeId": "n008"
    },
    "dialogue:ep29-map-quiz-1:zh": {
      "text": "\"但那只猴子整段时间都待在里面,\"另一位神父说道。",
      "lang": "zh-CN",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_zh/21b23347fcca.mp3",
      "sourceNodeId": "n008"
    },
