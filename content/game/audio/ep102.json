    "dialogue:ep102-map-intro-1:en": {
      "text": "Lady Kou ran into the courthouse early the next morning.",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/3cb71d69abd1.mp3",
      "sourceNodeId": "n001"
    },
    "dialogue:ep102-map-intro-1:zh": {
      "text": "寇夫人于次日清晨匆匆走进了法院。",
      "lang": "zh-CN",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_zh/60c804b95eb6.mp3",
      "sourceNodeId": "n001"
    },
    "dialogue:ep102-map-intro-2:en": {
      "text": "With tears in her eyes, she told the judge that she had lied the day before.",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/9efbced68e03.mp3",
      "sourceNodeId": "n002"
    },
    "dialogue:ep102-map-intro-2:zh": {
      "text": "她眼含泪水地向法官陈述,自己前一天曾撒过谎。",
      "lang": "zh-CN",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_zh/6ff66ed8367b.mp3",
      "sourceNodeId": "n002"
    },
    "dialogue:ep102-map-quiz-1:en": {
      "text": "\"The sage Laozi helped you that time. Will you ask him for help again?\"",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/dee8fb7c7f26.mp3",
      "sourceNodeId": "n032"
    },
    "dialogue:ep102-map-quiz-1:zh": {
      "text": "\"圣人老子当时曾帮助过你,你是否还想再次向他寻求帮助?\"",
      "lang": "zh-CN",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_zh/22f9c8954fa7.mp3",
      "sourceNodeId": "n032"
    },
