    "dialogue:ep36-map-intro-1:en": {
      "text": "\"Why won't Wukong help us?\" the horse asked Bajie.",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/aab120a65275.mp3",
      "sourceNodeId": "n001"
    },
    "dialogue:ep36-map-intro-1:zh": {
      "text": "\"悟空为什么不肯帮我们呢?\"马对八戒问道。",
      "lang": "zh-CN",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_zh/33b58ba21bbf.mp3",
      "sourceNodeId": "n001"
    },
