    "dialogue:ep50-map-intro-1:en": {
      "text": "Wukong and his companions ran back down the mountain, escaping the fire.",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/5ff8c8408867.mp3",
      "sourceNodeId": "n001"
    },
    "dialogue:ep50-map-intro-1:zh": {
      "text": "悟空与同伴们迅速沿山而下,成功逃离了火场。",
      "lang": "zh-CN",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_zh/68aec5b834f6.mp3",
      "sourceNodeId": "n001"
    },
    "dialogue:ep50-map-intro-2:en": {
      "text": "\"Red Boy's fire is powerful,\" said the monkey.",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/6fd1537f3c94.mp3",
      "sourceNodeId": "n002"
    },
    "dialogue:ep50-map-intro-2:zh": {
      "text": "\"红孩儿的火焰威力巨大,\"猴子说道。",
