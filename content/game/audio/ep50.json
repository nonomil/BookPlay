      "kind": "static-existing",
      "src": "assets/adv_audio/sent_zh/d3d1bd027a41.mp3",
      "sourceNodeId": "n002"
    },
    "dialogue:ep50-map-quiz-1:en": {
      "text": "When he returned, the Dragon King of the Eastern Sea was with him.",
      "lang": "en-US",
      "kind": "static-existing",
