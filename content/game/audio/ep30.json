    "dialogue:ep30-map-intro-1:en": {
      "text": "Wukong and his companions were tied up in a room in the abbey.",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/ae09a49011cb.mp3",
      "sourceNodeId": "n001"
    },
    "dialogue:ep30-map-intro-1:zh": {
      "text": "悟空与他的同伴们被捆绑在寺院的一间房内。",
      "lang": "zh-CN",
