    },
    "dialogue:ep30-map-intro-2:en": {
      "text": "\"I will deal with you all in the morning,\" said the Great Immortal.",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/c09aa3f78299.mp3",
      "sourceNodeId": "n002"
    },
    "dialogue:ep30-map-intro-2:zh": {
      "text": "\"我将于清晨与诸位相见,\"大仙说道。",
      "lang": "zh-CN",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_zh/9134b25d976f.mp3",
      "sourceNodeId": "n002"
    },
    "dialogue:ep30-map-quiz-1:en": {
      "text": "Back at the abbey, the Great Immortal told his priests to start a fire.",
