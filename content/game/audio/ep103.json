      "sourceNodeId": "n002"
    },
    "dialogue:ep103-map-quiz-1:en": {
      "text": "That night Squire and Lady Kou held a feast to thank Wukong.",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/33df1e7e54e3.mp3",
      "sourceNodeId": "n015"
    },
    "dialogue:ep103-map-quiz-1:zh": {
      "text": "那天晚上,寇员外与寇夫人为感谢悟空而举办了一场盛宴。",
