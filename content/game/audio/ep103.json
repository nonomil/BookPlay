    "dialogue:ep103-map-intro-1:en": {
      "text": "Wukong returned from the Land of Darkness.",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/a690d83355a5.mp3",
      "sourceNodeId": "n001"
    },
    "dialogue:ep103-map-intro-1:zh": {
      "text": "悟空从黑暗之地归来。",
      "lang": "zh-CN",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_zh/69c42c3c07cc.mp3",
      "sourceNodeId": "n001"
    },
    "dialogue:ep103-map-intro-2:en": {
      "text": "Lady Kou brought the travelers back to her house.",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/ccebfc297bfe.mp3",
      "sourceNodeId": "n002"
    },
    "dialogue:ep103-map-intro-2:zh": {
      "text": "寇夫人将旅人们接回了她的家中。",
      "lang": "zh-CN",
      "kind": "static-existing",
