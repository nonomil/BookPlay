    "dialogue:ep13-map-quiz-1:en": {
      "text": "\"They are with Buddha in the Western Paradise. Someone must travel to the Thunderclap Monastery to get them. But only a true believer may make the journey.\"",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/9ac9aefbab5e.mp3",
      "sourceNodeId": "n030"
    },
    "dialogue:ep13-map-quiz-1:zh": {
      "text": "\"他们正与佛陀一同驻守于西方极乐世界。需有人前往雷音寺将他们接回,但唯有虔诚的信徒方可踏上此番旅程。\"",
      "lang": "zh-CN",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_zh/9716cd64a6d1.mp3",
      "sourceNodeId": "n030"
    },
