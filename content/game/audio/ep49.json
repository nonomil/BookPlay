  "entries": {
    "dialogue:ep49-map-intro-1:en": {
      "text": "\"Wukong is right,\" said Bajie.",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/8a8a32b4f1c0.mp3",
      "sourceNodeId": "n001"
    },
    "dialogue:ep49-map-intro-1:zh": {
      "text": "\"悟空说得对,\"八戒说道。",
      "lang": "zh-CN",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_zh/9f8650dd9d25.mp3",
      "sourceNodeId": "n001"
    },
    "dialogue:ep49-map-intro-2:en": {
      "text": "\"We should all go home and forget about reaching the Western Paradise. I'll return to my cave and take a nice long nap.\"",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/e19137cd0407.mp3",
      "sourceNodeId": "n002"
    },
    "dialogue:ep49-map-intro-2:zh": {
      "text": "\"我们大家都该回家,别再想着抵达西方乐园了。我回我的洞穴里,好好睡个长觉吧。\"",
      "lang": "zh-CN",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_zh/457b9803ad41.mp3",
      "sourceNodeId": "n002"
    },
    "dialogue:ep49-map-quiz-1:en": {
      "text": "\"I also have a powerful weapon,\" said Red Boy.",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/f1eb1a48ba1a.mp3",
      "sourceNodeId": "n050"
    },
    "dialogue:ep49-map-quiz-1:zh": {
      "text": "\"我还拥有一件强大的武器,\"红孩儿说道。",
      "lang": "zh-CN",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_zh/a66184d68e7b.mp3",
      "sourceNodeId": "n050"
