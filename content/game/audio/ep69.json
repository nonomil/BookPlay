    "dialogue:ep69-map-intro-1:en": {
      "text": "\"That woman was a demon!\" cried Wukong.",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/c1f0b3e40f8e.mp3",
      "sourceNodeId": "n001"
    },
    "dialogue:ep69-map-intro-1:zh": {
      "text": "\"那女人简直是恶魔!\"悟空惊呼道。",
      "lang": "zh-CN",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_zh/d6e08101cf5d.mp3",
      "sourceNodeId": "n001"
    },
    "dialogue:ep69-map-intro-2:en": {
      "text": "\"And she kidnapped the Tang Monk!\"",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/a670c08facc0.mp3",
      "sourceNodeId": "n002"
    },
    "dialogue:ep69-map-intro-2:zh": {
      "text": "\"她绑架了唐僧!\"",
      "lang": "zh-CN",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_zh/ed0b07fb2d16.mp3",
      "sourceNodeId": "n002"
    },
    "dialogue:ep69-map-quiz-1:en": {
      "text": "\"That woman stabbed me in the head,\" moaned Wukong.",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/c2182f870945.mp3",
      "sourceNodeId": "n038"
    },
    "dialogue:ep69-map-quiz-1:zh": {
      "text": "\"那个女人刺了我的头,\"悟空呻吟道。",
