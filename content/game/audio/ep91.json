    "dialogue:ep91-map-intro-1:en": {
      "text": "The demon general looked at Wukong, who was still in disguise.",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/36d450d0d002.mp3",
      "sourceNodeId": "n001"
    },
    "dialogue:ep91-map-intro-1:zh": {
      "text": "邪恶将军注视着仍处于伪装状态的悟空。",
      "lang": "zh-CN",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_zh/0d64ae06c7de.mp3",
      "sourceNodeId": "n001"
    },
    "dialogue:ep91-map-intro-2:en": {
      "text": "\"The Tang Monk is heading toward our mountain?\" the general asked.",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/a1285c1c0e12.mp3",
      "sourceNodeId": "n002"
    },
    "dialogue:ep91-map-intro-2:zh": {
      "text": "\"唐僧正向我们这座山进发吗?\"将军问道。",
      "lang": "zh-CN",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_zh/3f58fac894ba.mp3",
      "sourceNodeId": "n002"
    },
    "dialogue:ep91-map-quiz-1:en": {
      "text": "\"He has fiery red eyes and sharp fangs.\"",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/38e49c344497.mp3",
      "sourceNodeId": "n015"
    },
    "dialogue:ep91-map-quiz-1:zh": {
      "text": "\"他拥有炽热的红眼和锋利的獠牙。\"",
      "lang": "zh-CN",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_zh/aa3439c0507a.mp3",
      "sourceNodeId": "n015"
