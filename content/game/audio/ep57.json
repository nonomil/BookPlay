  "entries": {
    "dialogue:ep57-map-intro-1:en": {
      "text": "\"Don't make any rain yet,\" Wukong repeated.",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/97e8dd9b615c.mp3",
      "sourceNodeId": "n001"
    },
    "dialogue:ep57-map-intro-1:zh": {
      "text": "\"现在还不到下雨的时候,\"悟空重复道。",
      "lang": "zh-CN",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_zh/b75c0b5d00bc.mp3",
      "sourceNodeId": "n001"
    },
    "dialogue:ep57-map-intro-2:en": {
      "text": "\"But we must,\" said the Old Woman of the Wind.",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/545483d7a867.mp3",
      "sourceNodeId": "n002"
    },
    "dialogue:ep57-map-intro-2:zh": {
      "text": "\"但我们必须这样做,\"风中老妇说道。",
      "lang": "zh-CN",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_zh/0bc1779d2a6e.mp3",
      "sourceNodeId": "n002"
    },
    "dialogue:ep57-map-quiz-1:en": {
      "text": "\"You will set the Buddhist monks free now, right?\"",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/48e4ea430d21.mp3",
      "sourceNodeId": "n066"
    },
    "dialogue:ep57-map-quiz-1:zh": {
      "text": "\"您现在要释放这些佛教僧侣了,对吧?\"",
      "lang": "zh-CN",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_zh/d138487e433d.mp3",
      "sourceNodeId": "n066"
    },
