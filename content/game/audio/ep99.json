      "sourceNodeId": "n001"
    },
    "dialogue:ep99-map-intro-2:en": {
      "text": "\"We ate the Tang Monk! So you might as well leave!\"",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/be637ec459ff.mp3",
      "sourceNodeId": "n002"
    },
    "dialogue:ep99-map-intro-2:zh": {
      "text": "\"我们把唐僧吃掉了!那你不如直接离开!\"",
