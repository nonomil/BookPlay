    "dialogue:ep77-map-intro-1:en": {
      "text": "For over a day, the wind from the fan carried Wukong.",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/baf7e0a91976.mp3",
      "sourceNodeId": "n001"
    },
    "dialogue:ep77-map-intro-1:zh": {
      "text": "一天来,风扇吹来的风一直将悟空吹着。",
      "lang": "zh-CN",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_zh/a7c4baea5cd0.mp3",
      "sourceNodeId": "n001"
    },
    "dialogue:ep77-map-intro-2:en": {
      "text": "When he finally landed, he was far from the Iron Immortal's mountain.",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/915e7ac5f991.mp3",
      "sourceNodeId": "n002"
    },
    "dialogue:ep77-map-intro-2:zh": {
      "text": "当他最终着陆时,他已远离那位铁扇公主所驻守的山峰。",
      "lang": "zh-CN",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_zh/a0bcf5ca9a95.mp3",
      "sourceNodeId": "n002"
    },
    "dialogue:ep77-map-quiz-1:en": {
      "text": "Wukong looked around and saw a mountain nearby.",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/7617ba8bb599.mp3",
      "sourceNodeId": "n003"
    },
