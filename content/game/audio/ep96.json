    "dialogue:ep96-map-intro-1:en": {
      "text": "\"I hope we reach the Western Paradise soon,\" said the Tang Monk.",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/e8a219980d3b.mp3",
      "sourceNodeId": "n001"
    },
    "dialogue:ep96-map-intro-1:zh": {
      "text": "\"我希望我们能尽快抵达西方极乐世界,\"唐僧说道。",
      "lang": "zh-CN",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_zh/d3707d3694e3.mp3",
      "sourceNodeId": "n001"
    },
    "dialogue:ep96-map-intro-2:en": {
      "text": "\"This journey has been very dangerous.\"",
      "lang": "en-US",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_en/2ebb08160ce9.mp3",
      "sourceNodeId": "n002"
    },
    "dialogue:ep96-map-intro-2:zh": {
      "text": "\"这次旅程非常危险。\"",
      "lang": "zh-CN",
      "kind": "static-existing",
      "src": "assets/adv_audio/sent_zh/15500cafe264.mp3",
      "sourceNodeId": "n002"
    },
    "dialogue:ep96-map-quiz-1:en": {
      "text": "\"It does give me an idea though . . .\"",
