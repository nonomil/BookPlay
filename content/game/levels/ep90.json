   "lines": [
    {
     "id": "ep90-map-quiz-1",
     "sourceNodeId": "n010",
     "speaker": "narrator",
     "textEn": "\"Yes, it's me, the spirit of the planet Venus. I came in disguise to warn you, Wukong. There are three powerful demons on the mountain up ahead. The first is a lion demon. The second is an elephant demon. And the third is a raptor demon.\"",
     "textZh": "\"没错,就是我——金星之灵。我乔装打扮前来警告你,悟空。前方山上有三只强大的魔怪:第一只是狮子魔,第二只是象魔,第三只则是猛禽魔。\"",
     "audioRef": "sent_en:\"Yes, it's me, the spirit of the planet Venus. I came in disguise to warn you, Wukong. There are three powerful demons on the mountain up ahead. The first is a lion demon. The second is an elephant demon. And the third is a raptor demon.\"",
     "audioStart": 49.13,
     "audioEnd": 69.631
    }
   ],
