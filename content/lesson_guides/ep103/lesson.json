          },
          {
            "id": "c",
            "en": "they gave them plums.",
            "zh": "他们给了他们李子。"
          }
        ],
        "answer": "a",
        "answer_evidence": [
          {
            "node_id": "n009",
            "quote": "\"Maybe the squire will thank us with a big feast.\""
          },
          {
            "node_id": "n010",
            "quote": "Squire Kou sat up and smiled."
          },
          {
            "node_id": "n015",
            "quote": "That night Squire and Lady Kou held a feast to thank Wukong."
          }
