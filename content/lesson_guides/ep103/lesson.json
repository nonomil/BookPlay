      "skills": [
        "story_comprehension"
      ],
      "prompt": {
        "en": "which is not true?",
        "zh": "哪一项是不正确的？"
      },
      "payload": {
        "choices": [
          {
            "id": "a",
            "en": "squire kou asked the travelers to stay.",
            "zh": "库尔乡绅请旅行者留下。"
          },
          {
            "id": "b",
            "en": "the travelers saw the spirit mountain.",
            "zh": "旅行者看到了灵山。"
          },
          {
            "id": "c",
            "en": "the journey was almost finished.",
            "zh": "旅程几乎结束了。"
          }
        ],
        "answer": "a",
        "answer_evidence": [
          {
            "node_id": "n015",
            "quote": "That night Squire and Lady Kou held a feast to thank Wukong."
          },
          {
            "node_id": "n016",
            "quote": "And the next morning they let the travelers leave without any argument."
          },
          {
            "node_id": "n063",
            "quote": "In the distance stood a huge mountain."
          },
          {
            "node_id": "n067",
            "quote": "\"That's the Spirit Mountain, Master. We're almost at the end of our journey.\""
          }
        ]
      },
