      "payload": {
        "choices": [
          {
            "id": "a",
            "en": "to lure the spirits away from the monk",
            "zh": "引开僧人身边的灵魂"
          },
          {
            "id": "b",
            "en": "to have a feast with wukong",
            "zh": "和悟空一起大吃一顿"
          },
          {
            "id": "c",
            "en": "to recite the tight headband spell",
            "zh": "背诵紧头巾咒语"
          }
        ],
        "answer": "a",
        "answer_evidence": [
