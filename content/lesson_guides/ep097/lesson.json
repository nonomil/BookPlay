    {
      "card_id": "ep097-official-quiz-003",
      "type": "sentence_choice",
      "stage": "episode_complete",
      "order": 3,
      "difficulty": 2,
      "grade_bands": [
        "g1_2",
        "g3_4",
        "g5_6"
      ],
      "skills": [
        "story_comprehension"
      ],
      "prompt": {
        "en": "how did the demons learn about wukong?",
        "zh": "魔鬼们是怎么知道悟空的？"
      },
      "payload": {
        "choices": [
          {
            "id": "a",
            "en": "bajie said wukong's name.",
            "zh": "八戒说了悟空的名字。"
          },
          {
            "id": "b",
            "en": "bajie talked about the tang monk.",
            "zh": "八戒谈论唐僧。"
          },
          {
            "id": "c",
            "en": "bajie showed them wukong.",
            "zh": "八戒给他们看了悟空。"
          }
        ],
        "answer": "a",
        "answer_evidence": [
          {
            "node_id": "n018",
            "quote": "\"Wukong is small—he doesn't need to eat as much as I do!\""
          },
          {
            "node_id": "n020",
            "quote": "\"You just said 'Wukong.' Are you talking about Sun Wukong, the monkey who defeated Heaven's entire army five hundred years ago?\""
          }
        ]
      },
      "sources": [
        {
          "kind": "official_quiz_pdf",
