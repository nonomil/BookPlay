      ],
      "review_status": "assistant_reviewed"
    },
    {
      "card_id": "ep097-official-quiz-002",
      "type": "sentence_choice",
      "stage": "episode_complete",
      "order": 2,
      "difficulty": 2,
      "grade_bands": [
        "g1_2",
        "g3_4",
        "g5_6"
      ],
      "skills": [
        "story_comprehension"
      ],
      "prompt": {
        "en": "why was bajie angry at wukong?",
        "zh": "八戒为什么生孙悟空的气？"
      },
      "payload": {
        "choices": [
          {
            "id": "a",
            "en": "wukong tricked him.",
            "zh": "悟空骗了他。"
          },
          {
            "id": "b",
            "en": "there was no army.",
            "zh": "没有军队。"
          },
          {
            "id": "c",
            "en": "he wasn't hungry.",
            "zh": "他不饿。"
          }
        ],
        "answer": "a",
        "answer_evidence": [
          {
            "node_id": "n007",
            "quote": "\"That rotten monkey lied to me!\" cried Bajie."
          },
          {
            "node_id": "n029",
            "quote": "\"You tricked me!\""
          },
          {
            "node_id": "n034",
            "quote": "\"Wukong told me there was a feast up ahead. But instead it was a group of demons and a monster. They tried to eat me!\""
          }
        ]
      },
      "sources": [
        {
          "kind": "official_quiz_pdf",
          "file": "G:\\Game\\BookPlay书戏\\data\\测试题\\08 英文测试题108集全.Journey to the West-quiz.pdf",
