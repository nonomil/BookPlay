  "cards": [
    {
      "card_id": "ep097-official-quiz-001",
      "type": "sentence_choice",
      "stage": "episode_complete",
      "order": 1,
      "difficulty": 2,
      "grade_bands": [
        "g1_2",
        "g3_4",
        "g5_6"
      ],
      "skills": [
        "story_comprehension"
      ],
      "prompt": {
        "en": "which is not true?",
        "zh": "哪一项是不正确的？"
      },
      "payload": {
        "choices": [
          {
            "id": "a",
            "en": "the demons wanted to eat wujing.",
            "zh": "妖怪们想吃悟净。"
          },
          {
            "id": "b",
            "en": "the demons wanted to eat bajie.",
            "zh": "魔鬼想吃八戒。"
          },
          {
            "id": "c",
            "en": "the demons wanted to eat the tang monk.",
            "zh": "妖怪们想吃唐僧。"
          }
        ],
        "answer": "a",
        "answer_evidence": [
          {
            "node_id": "n004",
            "quote": "\"Yes, you <font color=\"#ffff00\"><i>are</i></font> here for the feast, Pig. We're going to eat you for lunch!\""
          },
          {
            "node_id": "n025",
            "quote": "The monster licked his lips."
          },
          {
            "node_id": "n026",
            "quote": "\"I've heard that anyone who eats the Tang Monk will live forever.\""
          }
        ]
      },
      "sources": [
        {
          "kind": "official_quiz_pdf",
          "file": "G:\\Game\\BookPlay书戏\\data\\测试题\\08 英文测试题108集全.Journey to the West-quiz.pdf",
          "page": 117,
          "sha256": "bcc738833439415d5b2aebde6d316c75168f0d73ae87dab5e11ba8c616056929"
