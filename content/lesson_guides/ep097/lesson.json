      "prompt": {
        "en": "what did wukong say about the demons?",
        "zh": "悟空说了些什么关于那些妖怪？"
      },
      "payload": {
        "choices": [
          {
            "id": "a",
            "en": "they weren't dangerous.",
            "zh": "他们并不危险。"
          },
          {
            "id": "b",
            "en": "they were scary.",
            "zh": "他们很可怕。"
          },
          {
            "id": "c",
            "en": "they were smart.",
            "zh": "他们很聪明。"
          }
        ],
        "answer": "a",
        "answer_evidence": [
          {
            "node_id": "n048",
            "quote": "\"I admit I knew about the demons and the monster,\" said Wukong."
          },
          {
            "node_id": "n049",
            "quote": "\"But they're not dangerous.\""
          }
        ]
      },
      "sources": [
