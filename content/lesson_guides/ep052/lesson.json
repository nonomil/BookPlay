  "cards": [
    {
      "card_id": "ep052-official-quiz-001",
      "type": "sentence_choice",
      "stage": "episode_complete",
      "order": 1,
      "difficulty": 2,
      "grade_bands": [
        "g1_2",
        "g3_4",
        "g5_6"
      ],
      "skills": [
        "story_comprehension"
      ],
      "prompt": {
        "en": "which is true?",
        "zh": "哪一个是真的？"
      },
      "payload": {
        "choices": [
          {
            "id": "a",
            "en": "red boy was trapped.",
            "zh": "红孩儿被困住了。"
          },
          {
            "id": "b",
            "en": "guanyin made magic fire.",
            "zh": "观音点燃了魔法火。"
          },
          {
            "id": "c",
            "en": "wujing broke down the door.",
            "zh": "悟净撞坏了门。"
          }
        ],
        "answer": "a",
        "answer_evidence": [
          {
            "node_id": "n061",
            "quote": "Red Boy sat down on the platform."
          },
          {
            "node_id": "n062",
            "quote": "Instantly the platform turned back into swords, which surrounded the demon."
          },
          {
            "node_id": "n063",
            "quote": "Sharp points stuck at him on all sides."
          },
          {
            "node_id": "n064",
            "quote": "\"Oh no!\" cried Red Boy. \"I'm trapped!\""
          }
        ]
      },
      "sources": [
        {
          "kind": "official_quiz_pdf",
          "file": "G:\\Game\\BookPlay书戏\\data\\测试题\\08 英文测试题108集全.Journey to the West-quiz.pdf",
          "page": 61,
          "sha256": "bcc738833439415d5b2aebde6d316c75168f0d73ae87dab5e11ba8c616056929"
