      "review_status": "assistant_reviewed"
    },
    {
      "card_id": "ep052-official-quiz-003",
      "type": "sentence_choice",
      "stage": "episode_complete",
      "order": 3,
      "difficulty": 2,
      "grade_bands": [
        "g1_2",
        "g3_4",
        "g5_6"
      ],
      "skills": [
        "story_comprehension"
      ],
      "prompt": {
        "en": "what did guanyin want wukong to do?",
        "zh": "观音想让悟空做什么？"
      },
      "payload": {
        "choices": [
          {
            "id": "a",
            "en": "lead red boy to her",
            "zh": "把红孩儿带到她那里"
          },
          {
            "id": "b",
            "en": "defeat red boy",
            "zh": "击败红孩儿"
          },
          {
            "id": "c",
            "en": "chase the animals",
            "zh": "追赶动物"
          }
        ],
        "answer": "c",
        "answer_evidence": [
          {
            "node_id": "n004",
            "quote": "\"There's a lot of water in this vase—enough for an ocean. I don't want any animals harmed when I pour it out.\""
          }
        ]
      },
      "sources": [
        {
          "kind": "official_quiz_pdf",
