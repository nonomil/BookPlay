      "review_status": "machine_verified"
    },
    {
      "card_id": "ep052-official-quiz-004",
      "type": "sentence_choice",
      "stage": "episode_complete",
      "order": 4,
      "difficulty": 2,
      "grade_bands": [
        "g1_2",
        "g3_4",
        "g5_6"
      ],
      "skills": [
        "story_comprehension"
      ],
      "prompt": {
        "en": "why didn't red boy's fire magic work?",
        "zh": "红孩儿的火焰魔法为什么不起作用？"
      },
      "payload": {
        "choices": [
          {
            "id": "a",
            "en": "because of the magic water",
            "zh": "因为魔法水"
          },
          {
            "id": "b",
            "en": "because of the magic mountain",
            "zh": "因为魔法山"
          },
          {
            "id": "c",
            "en": "because of the magic animals",
            "zh": "因为魔法动物"
          }
        ],
        "answer": "a",
        "answer_evidence": [
          {
            "node_id": "n031",
            "quote": "\"Ha!\" Red Boy laughed and then punched himself in the nose. Nothing happened."
          },
          {
            "node_id": "n032",
            "quote": "\"Why didn't my fire magic work?\" asked the demon."
          },
          {
            "node_id": "n033",
            "quote": "Then he noticed the ocean surrounding his mountain."
          },
          {
            "node_id": "n034",
            "quote": "Wukong laughed. \"That is magic water, brought here by the bodhisattva Guanyin. You can't make fire anywhere near it.\""
          }
        ]
      },
      "sources": [
