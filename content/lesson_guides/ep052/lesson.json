      ],
      "review_status": "assistant_reviewed"
    },
    {
      "card_id": "ep052-official-quiz-002",
      "type": "sentence_choice",
      "stage": "episode_complete",
      "order": 2,
      "difficulty": 2,
      "grade_bands": [
        "g1_2",
        "g3_4",
        "g5_6"
      ],
      "skills": [
        "story_comprehension"
      ],
      "prompt": {
        "en": "where did the animals run?",
        "zh": "动物们跑到哪里去了？"
      },
      "payload": {
        "choices": [
          {
            "id": "a",
            "en": "away from the mountain",
            "zh": "远离山"
          },
          {
            "id": "b",
            "en": "to the mountain",
            "zh": "到山上"
          },
          {
            "id": "c",
            "en": "into the cave",
            "zh": "进入洞穴"
          }
        ],
        "answer": "a",
        "answer_evidence": [
          {
            "node_id": "n009",
            "quote": "\"Please make sure all the animals are far, far away from the mountain.\""
          },
          {
            "node_id": "n013",
            "quote": "First he saw some small animals scurry out from under bushes."
          },
          {
            "node_id": "n014",
            "quote": "Birds flew from branches."
          },
          {
            "node_id": "n015",
            "quote": "Then tigers, bears, and other large animals stampeded down the mountainside."
          },
          {
            "node_id": "n016",
            "quote": "Soon there wasn't a single animal anywhere near the mountain."
          }
        ]
      },
      "sources": [
        {
          "kind": "official_quiz_pdf",
          "file": "G:\\Game\\BookPlay书戏\\data\\测试题\\08 英文测试题108集全.Journey to the West-quiz.pdf",
