    },
    {
      "card_id": "ep053-official-quiz-004",
      "type": "sentence_choice",
      "stage": "episode_complete",
      "order": 4,
      "difficulty": 2,
      "grade_bands": [
        "g1_2",
        "g3_4",
        "g5_6"
      ],
      "skills": [
        "story_comprehension"
      ],
      "prompt": {
        "en": "who did not get in the canoe?",
        "zh": "谁没有上独木舟？"
      },
      "payload": {
        "choices": [
          {
            "id": "a",
            "en": "wukong",
            "zh": "悟空"
          },
          {
            "id": "b",
            "en": "the tang monk",
            "zh": "唐僧"
          },
          {
            "id": "c",
            "en": "bajie",
            "zh": "八戒"
          }
        ],
        "answer": "a",
        "answer_evidence": [
          {
            "node_id": "n047",
            "quote": "\"I would be happy to take you all across. But as you can see, my canoe is not very big. I can take only two passengers at a time.\""
          },
          {
            "node_id": "n050",
            "quote": "The monkey was about to say something when Bajie stepped forward."
          },
          {
            "node_id": "n051",
            "quote": "\"The Tang Monk and I will go first,\" said the pig."
          },
          {
            "node_id": "n055",
            "quote": "The monkey bit his lip as the monk and Bajie climbed into the canoe."
          },
          {
            "node_id": "n056",
            "quote": "They sat down, and the man paddled away from shore."
          }
        ]
      },
      "sources": [
        {
          "kind": "official_quiz_pdf",
          "file": "G:\\Game\\BookPlay书戏\\data\\测试题\\08 英文测试题108集全.Journey to the West-quiz.pdf",
          "page": 62,
          "sha256": "bcc738833439415d5b2aebde6d316c75168f0d73ae87dab5e11ba8c616056929"
