      "review_status": "assistant_reviewed"
    },
    {
      "card_id": "ep053-official-quiz-005",
      "type": "sentence_choice",
      "stage": "episode_complete",
      "order": 5,
      "difficulty": 2,
      "grade_bands": [
        "g1_2",
        "g3_4",
        "g5_6"
      ],
      "skills": [
        "story_comprehension"
      ],
      "prompt": {
        "en": "what did the canoe do?",
        "zh": "独木舟做了什么？"
      },
      "payload": {
        "choices": [
          {
            "id": "a",
            "en": "sink into the water",
            "zh": "沉入水中"
          },
          {
            "id": "b",
            "en": "float in the air",
            "zh": "在空中漂浮"
          },
          {
            "id": "c",
            "en": "turn into swords",
            "zh": "变成剑"
          }
        ],
        "answer": "a",
        "answer_evidence": [
          {
            "node_id": "n057",
            "quote": "Wukong watched the canoe glide across the river."
          },
          {
            "node_id": "n058",
            "quote": "When it was about halfway across, Wukong noticed something."
          },
          {
            "node_id": "n059",
            "quote": "\"Am I imagining things, or is the canoe sinking?\" asked the monkey."
          },
          {
            "node_id": "n060",
            "quote": "Wujing looked. \"You're not imagining things,\" he said."
          },
          {
            "node_id": "n061",
            "quote": "\"It is sinking!\""
          },
          {
            "node_id": "n062",
            "quote": "The two of them watched as the canoe slipped under the surface of the water."
          }
        ]
      },
      "sources": [
