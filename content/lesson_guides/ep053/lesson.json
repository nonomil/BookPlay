    {
      "card_id": "ep053-official-quiz-003",
      "type": "sentence_choice",
      "stage": "episode_complete",
      "order": 3,
      "difficulty": 2,
      "grade_bands": [
        "g1_2",
        "g3_4",
        "g5_6"
      ],
      "skills": [
        "story_comprehension"
      ],
      "prompt": {
        "en": "where did guanyin take red boy?",
        "zh": "观音把红孩儿带到哪里了？"
      },
      "payload": {
        "choices": [
          {
            "id": "a",
            "en": "to mount potalaka",
            "zh": "到波陀拉伽山"
          },
          {
            "id": "b",
            "en": "to a wide river",
            "zh": "到一条宽阔的河"
          },
          {
            "id": "c",
            "en": "to red boy's mountain",
            "zh": "去红孩儿的山"
          }
        ],
        "answer": "a",
        "answer_evidence": [
          {
            "node_id": "n020",
            "quote": "\"No, Wukong,\" said Guanyin. \"Don't hurt the demon. I will take him back to Mount Potalaka to be my student.\""
          }
        ]
      },
      "sources": [
        {
          "kind": "official_quiz_pdf",
          "file": "G:\\Game\\BookPlay书戏\\data\\测试题\\08 英文测试题108集全.Journey to the West-quiz.pdf",
