  "cards": [
    {
      "card_id": "ep053-official-quiz-001",
      "type": "sentence_choice",
      "stage": "episode_complete",
      "order": 1,
      "difficulty": 2,
      "grade_bands": [
        "g1_2",
        "g3_4",
        "g5_6"
      ],
      "skills": [
        "story_comprehension"
      ],
      "prompt": {
        "en": "which is not true?",
        "zh": "哪一项是不正确的？"
      },
      "payload": {
        "choices": [
          {
            "id": "a",
            "en": "swords didn't scare red boy.",
            "zh": "剑不会吓到红孩儿。"
          },
          {
            "id": "b",
            "en": "red boy tried to attack guanyin.",
            "zh": "红孩儿试图攻击观音。"
          },
          {
            "id": "c",
            "en": "the tang monk and bajie were kidnapped.",
            "zh": "唐僧和八戒被绑架了。"
          }
        ],
        "answer": "a",
        "answer_evidence": [
          {
            "node_id": "n002",
            "quote": "The demon was trapped by the swords, all pointed at his face."
          },
          {
            "node_id": "n003",
            "quote": "\"Get these swords away from me!\" cried the demon."
          },
          {
            "node_id": "n011",
            "quote": "Red Boy charged toward Guanyin."
          },
          {
            "node_id": "n016",
            "quote": "\"Evil demon!\" said Guanyin."
          },
          {
            "node_id": "n017",
            "quote": "\"How dare you try to attack me!\""
          },
          {
            "node_id": "n025",
            "quote": "Wukong went into Red Boy's cave and freed the Tang Monk."
          },
          {
            "node_id": "n026",
            "quote": "Then he found Bajie and freed him."
          }
        ]
      },
      "sources": [
        {
          "kind": "official_quiz_pdf",
          "file": "G:\\Game\\BookPlay书戏\\data\\测试题\\08 英文测试题108集全.Journey to the West-quiz.pdf",
          "page": 62,
          "sha256": "bcc738833439415d5b2aebde6d316c75168f0d73ae87dab5e11ba8c616056929"
        }
      ],
      "review_status": "assistant_reviewed"
    },
    {
      "card_id": "ep053-official-quiz-002",
      "type": "sentence_choice",
      "stage": "episode_complete",
      "order": 2,
      "difficulty": 2,
      "grade_bands": [
        "g1_2",
        "g3_4",
        "g5_6"
      ],
      "skills": [
        "story_comprehension"
      ],
      "prompt": {
        "en": "what did red boy promise to do?",
        "zh": "红孩儿答应做什么？"
      },
      "payload": {
        "choices": [
          {
            "id": "a",
            "en": "become a buddhist",
            "zh": "成为佛教徒"
          },
          {
            "id": "b",
            "en": "free the tang monk",
            "zh": "解救唐僧"
          },
          {
            "id": "c",
            "en": "paddle the canoe",
            "zh": "划独木舟"
          }
        ],
        "answer": "a",
        "answer_evidence": [
          {
            "node_id": "n004",
            "quote": "\"You must become a Buddhist,\" said Guanyin."
          },
          {
            "node_id": "n005",
            "quote": "\"Then I'll release you.\""
          },
          {
            "node_id": "n006",
            "quote": "\"I promise!\" cried Red Boy."
          },
          {
            "node_id": "n007",
            "quote": "\"I'll do whatever you say!\""
          }
        ]
      },
      "sources": [
        {
          "kind": "official_quiz_pdf",
          "file": "G:\\Game\\BookPlay书戏\\data\\测试题\\08 英文测试题108集全.Journey to the West-quiz.pdf",
