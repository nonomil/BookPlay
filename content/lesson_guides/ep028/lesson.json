      "prompt": {
        "en": "who went to go pick the fruit?",
        "zh": "谁去采水果了？"
      },
      "payload": {
        "choices": [
          {
            "id": "a",
            "en": "wukong",
            "zh": "悟空"
          },
          {
            "id": "b",
            "en": "bajie",
            "zh": "八戒"
          },
          {
            "id": "c",
            "en": "wujing",
            "zh": "五净"
          }
        ],
        "answer": "a",
        "answer_evidence": [
          {
            "node_id": "n013",
            "quote": "\"You two wait here,\" said Wukong."
          },
          {
            "node_id": "n014",
            "quote": "\"I'll go pick some of that fruit.\""
          },
          {
            "node_id": "n015",
            "quote": "The monkey went behind the abbey and found the giant ginseng tree."
          },
          {
            "node_id": "n017",
            "quote": "He plucked three pieces from the tree's branches and went back to the kitchen."
          }
        ]
      },
