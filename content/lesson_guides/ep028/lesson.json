      ],
      "skills": [
        "story_comprehension"
      ],
      "prompt": {
        "en": "why was wukong angry?",
        "zh": "悟空为什么生气？"
      },
      "payload": {
        "choices": [
          {
            "id": "a",
            "en": "the priests called him names.",
            "zh": "祭司们叫他名字。"
          },
          {
            "id": "b",
            "en": "the fruit didn't taste good.",
            "zh": "那个水果尝起来不好吃。"
          },
          {
            "id": "c",
            "en": "the tang monk didn't eat the fruit.",
            "zh": "唐僧没有吃那种果子。"
          }
        ],
        "answer": "a",
        "answer_evidence": [
          {
            "node_id": "n048",
            "quote": "\"You're all thieves and liars!\" cried one of the priests."
          },
          {
            "node_id": "n050",
            "quote": "The two priests yelled and yelled."
          },
          {
            "node_id": "n051",
            "quote": "They called Wukong and his companions all sorts of terrible names."
          },
          {
            "node_id": "n056",
            "quote": "\"Those priests are rude!\" he said to himself."
          },
          {
            "node_id": "n057",
            "quote": "\"So what if we ate some ginseng fruit? They have no right to call us names!\""
          },
          {
            "node_id": "n058",
            "quote": "Wukong grew very angry."
          }
        ]
      },
