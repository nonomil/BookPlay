      ],
      "skills": [
        "story_comprehension"
      ],
      "prompt": {
        "en": "which is true?",
        "zh": "哪一个是真的？"
      },
      "payload": {
        "choices": [
          {
            "id": "a",
            "en": "the tree crashed down to the ground.",
            "zh": "那棵树倒在了地上。"
          },
          {
            "id": "b",
            "en": "wukong did not eat the fruit.",
            "zh": "悟空没有吃那种果子。"
          },
          {
            "id": "c",
            "en": "the priests were polite to wukong.",
            "zh": "祭司们对悟空很礼貌。"
          }
        ],
        "answer": "a",
        "answer_evidence": [
          {
            "node_id": "n017",
            "quote": "He plucked three pieces from the tree's branches and went back to the kitchen."
          },
          {
            "node_id": "n018",
            "quote": "He handed Bajie and Wujing each a ginseng fruit."
          },
          {
            "node_id": "n020",
            "quote": "\"This fruit is delicious!\""
          },
          {
            "node_id": "n021",
            "quote": "\"Yes,\" said Wukong. \"It truly is.\""
          },
          {
            "node_id": "n050",
            "quote": "The two priests yelled and yelled."
          },
          {
            "node_id": "n051",
            "quote": "They called Wukong and his companions all sorts of terrible names."
          },
          {
            "node_id": "n060",
            "quote": "There was a loud crack, and the entire tree crashed to the ground."
          }
        ]
      },
      "sources": [
