  "cards": [
    {
      "card_id": "ep028-official-quiz-001",
      "type": "sentence_choice",
      "stage": "episode_complete",
      "order": 1,
      "difficulty": 2,
      "grade_bands": [
        "g1_2",
        "g3_4",
