      },
      "payload": {
        "choices": [
          {
            "id": "a",
            "en": "help the tang monk",
            "zh": "帮助唐僧"
          },
          {
            "id": "b",
            "en": "argue with wukong",
            "zh": "与悟空争论"
          },
          {
            "id": "c",
            "en": "attack bajie",
            "zh": "攻击八戒"
          }
        ],
        "answer": "a",
        "answer_evidence": [
          {
            "node_id": "n047",
            "quote": "\"Stop arguing,\" said Guanyin."
          },
          {
            "node_id": "n048",
            "quote": "\"Wujing, you will help the Tang Monk reach the west.\""
          },
          {
            "node_id": "n049",
            "quote": "\"Yes, Bodhisattva,\" said Wujing."
          }
        ]
      },
