      "review_status": "assistant_reviewed"
    },
    {
      "card_id": "ep026-official-quiz-002",
      "type": "sentence_choice",
      "stage": "episode_complete",
      "order": 2,
      "difficulty": 2,
      "grade_bands": [
        "g1_2",
        "g3_4",
        "g5_6"
      ],
      "skills": [
        "story_comprehension"
      ],
      "prompt": {
        "en": "why couldn't the group cross the river?",
        "zh": "为什么这群人过不了河？"
      },
      "payload": {
        "choices": [
          {
            "id": "a",
            "en": "there was a monster.",
            "zh": "有一只怪物。"
          },
          {
            "id": "b",
            "en": "there was no bridge.",
            "zh": "没有桥。"
          },
          {
            "id": "c",
            "en": "they couldn't swim.",
            "zh": "他们不会游泳。"
          }
        ],
        "answer": "a",
        "answer_evidence": [
          {
            "node_id": "n032",
            "quote": "\"We can't cross this river with the monster in there. I'll ask Guanyin for help.\""
          }
        ]
      },
      "sources": [
