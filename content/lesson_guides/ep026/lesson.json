    {
      "card_id": "ep026-official-quiz-003",
      "type": "sentence_choice",
      "stage": "episode_complete",
      "order": 3,
      "difficulty": 2,
      "grade_bands": [
        "g1_2",
        "g3_4",
        "g5_6"
      ],
      "skills": [
        "story_comprehension"
      ],
      "prompt": {
        "en": "who dived into the river?",
        "zh": "谁跳进了河里？"
      },
      "payload": {
        "choices": [
          {
            "id": "a",
            "en": "bajie",
            "zh": "八戒"
          },
          {
            "id": "b",
            "en": "wukong",
            "zh": "悟空"
          },
          {
            "id": "c",
            "en": "guanyin",
            "zh": "观音"
          }
        ],
        "answer": "a",
        "answer_evidence": [
          {
            "node_id": "n017",
            "quote": "\"Bajie, my powers aren't strong underwater,\" said Wukong."
          },
          {
            "node_id": "n018",
            "quote": "\"Dive in, and get him to chase you out of the river. Then I'll surprise him.\""
          },
          {
            "node_id": "n019",
            "quote": "\"Okay,\" said the pig."
          },
          {
            "node_id": "n021",
            "quote": "Bajie dived into the water. Wukong waited."
          }
        ]
      },
      "sources": [
