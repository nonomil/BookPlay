  "cards": [
    {
      "card_id": "ep026-official-quiz-001",
      "type": "sentence_choice",
      "stage": "episode_complete",
      "order": 1,
      "difficulty": 2,
      "grade_bands": [
        "g1_2",
        "g3_4",
        "g5_6"
      ],
      "skills": [
        "story_comprehension"
      ],
      "prompt": {
        "en": "which is true?",
        "zh": "哪一个是真的？"
      },
      "payload": {
        "choices": [
          {
            "id": "a",
            "en": "the monster was supposed to help the tang monk.",
            "zh": "这个怪物本应该帮助唐僧。"
          },
          {
            "id": "b",
            "en": "wujing believed the horse was really a dragon.",
            "zh": "悟净相信那匹马真的是一条龙。"
          },
          {
            "id": "c",
            "en": "wukong was punished for breaking a glass in heaven.",
            "zh": "悟空因为在天上打碎了一只玻璃而受到了惩罚。"
          }
        ],
        "answer": "a",
        "answer_evidence": [
          {
            "node_id": "n034",
            "quote": "\"His name is Sha Wujing,\" said Guanyin."
          },
          {
            "node_id": "n035",
            "quote": "\"He was waiting for you. He's going to help the Tang Monk reach the Western Paradise.\""
          },
          {
            "node_id": "n052",
            "quote": "\"I was being punished for breaking a glass in Heaven,\" said Wujing one day."
          },
          {
            "node_id": "n055",
            "quote": "\"So was the horse. Did you know the horse is really a dragon?\""
          },
          {
            "node_id": "n056",
            "quote": "Wujing looked doubtful."
          },
          {
            "node_id": "n057",
            "quote": "\"This horse is too slow to be a dragon.\""
          }
        ]
      },
      "sources": [
        {
          "kind": "official_quiz_pdf",
          "file": "G:\\Game\\BookPlay书戏\\data\\测试题\\08 英文测试题108集全.Journey to the West-quiz.pdf",
