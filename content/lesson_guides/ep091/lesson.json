      ],
      "skills": [
        "story_comprehension"
      ],
      "prompt": {
        "en": "what did wukong say about the demon leaders?",
        "zh": "悟空说了关于恶魔首领什么？"
      },
      "payload": {
        "choices": [
          {
            "id": "a",
            "en": "they didn't plan to share the tang monk.",
            "zh": "他们没有打算分享唐僧。"
          },
          {
            "id": "b",
            "en": "they would defeat wukong themselves.",
            "zh": "他们会亲自打败悟空。"
          },
          {
            "id": "c",
            "en": "they didn't need an army.",
            "zh": "他们不需要一支军队。"
          }
        ],
        "answer": "a",
        "answer_evidence": [
          {
            "node_id": "n035",
            "quote": "\"I heard our three leaders talking privately. They don't plan to share the Tang Monk with us. They're going to eat him themselves.\""
          }
        ]
      },
      "sources": [
        {
          "kind": "official_quiz_pdf",
