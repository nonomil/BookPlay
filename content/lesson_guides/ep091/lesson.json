      "prompt": {
        "en": "what did the demon leaders do when the army left?",
        "zh": "当军队离开时，恶魔首领们做了什么？"
      },
      "payload": {
        "choices": [
          {
            "id": "a",
            "en": "they argued with each other.",
            "zh": "他们互相争吵。"
          },
          {
            "id": "b",
            "en": "they attacked wukong.",
            "zh": "他们攻击了悟空。"
          },
          {
            "id": "c",
            "en": "they looked for the tang monk.",
            "zh": "他们寻找唐僧。"
          }
        ],
        "answer": "a",
        "answer_evidence": [
          {
            "node_id": "n055",
            "quote": "\"That monkey is powerful. We should leave the Tang Monk alone.\""
          },
          {
            "node_id": "n063",
            "quote": "As the two demons argued, Wukong began to laugh."
          }
        ]
      },
