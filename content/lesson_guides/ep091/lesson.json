      ],
      "skills": [
        "story_comprehension"
      ],
      "prompt": {
        "en": "what were the demon officers scared of?",
        "zh": "魔鬼官员害怕什么？"
      },
      "payload": {
        "choices": [
          {
            "id": "a",
            "en": "wukong",
            "zh": "悟空"
          },
          {
            "id": "b",
            "en": "the demons",
            "zh": "恶魔"
          },
          {
            "id": "c",
            "en": "the tang monk",
            "zh": "唐僧"
          }
        ],
        "answer": "a",
        "answer_evidence": [
          {
            "node_id": "n010",
            "quote": "\"The third companion is a monkey,\" said Wukong."
          },
          {
            "node_id": "n012",
            "quote": "\"I was afraid that monkey was traveling with the monk,\" the general grumbled."
          },
          {
            "node_id": "n027",
            "quote": "The demons' faces went pale."
          }
        ]
      },
      "sources": [
        {
          "kind": "official_quiz_pdf",
