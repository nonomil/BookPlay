      "skills": [
        "story_comprehension"
      ],
      "prompt": {
        "en": "which is most important from the story?",
        "zh": "故事中什么最重要？"
      },
      "payload": {
        "choices": [
          {
            "id": "a",
            "en": "wukong played a trick on the demons and their army.",
            "zh": "悟空捉弄了妖怪和他们的军队。"
          },
          {
            "id": "b",
            "en": "wukong had fiery red eyes and sharp fangs.",
            "zh": "悟空有着火红的眼睛和锋利的獠牙。"
          },
          {
            "id": "c",
            "en": "the lion demon shouted at the elephant.",
            "zh": "狮子恶魔向大象吼叫。"
          }
        ],
        "answer": "b",
        "answer_evidence": [
          {
            "node_id": "n015",
            "quote": "\"He has fiery red eyes and sharp fangs.\""
          }
        ]
      },
      "sources": [
