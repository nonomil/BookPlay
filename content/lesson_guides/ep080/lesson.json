      "prompt": {
        "en": "why did the tang monk want to go inside the monastery?",
        "zh": "唐僧为什么想进去寺庙？"
      },
      "payload": {
        "choices": [
          {
            "id": "a",
            "en": "because it was a buddhist monastery.",
            "zh": "因为它是一座佛教寺院。"
          },
          {
            "id": "b",
            "en": "because he wanted to let bajie rest.",
            "zh": "因为他想让八戒休息。"
          },
          {
            "id": "c",
            "en": "because wukong said that it was safe.",
            "zh": "因为悟空说过那是安全的。"
          }
        ],
        "answer": "a",
        "answer_evidence": [
          {
            "node_id": "n045",
            "quote": "\"It's not,\" said Wukong. \"We should really—\" \"We're going in,\" the Tang Monk said."
          },
          {
            "node_id": "n046",
            "quote": "\"This is a Buddhist monastery. We should visit it.\""
          },
          {
            "node_id": "n047",
            "quote": "The monk opened the monastery's door and entered."
          }
        ]
      },
