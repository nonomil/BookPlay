  "cards": [
    {
      "card_id": "ep080-official-quiz-001",
      "type": "sentence_choice",
      "stage": "episode_complete",
      "order": 1,
      "difficulty": 2,
      "grade_bands": [
        "g1_2",
        "g3_4",
        "g5_6"
      ],
      "skills": [
        "story_comprehension"
      ],
      "prompt": {
        "en": "what did the travelers talk about by the stream?",
        "zh": "旅行者们在小溪边谈论了什么？"
      },
      "payload": {
        "choices": [
          {
            "id": "a",
            "en": "the western paradise",
            "zh": "西方极乐世界"
          },
          {
            "id": "b",
            "en": "the buddha statue",
            "zh": "佛像"
          },
          {
            "id": "c",
            "en": "the jade emperor",
            "zh": "玉皇大帝"
          }
        ],
        "answer": "a",
        "answer_evidence": [
          {
            "node_id": "n001",
            "quote": "One afternoon Wukong and his companions were resting by a stream."
          },
          {
            "node_id": "n003",
            "quote": "\"We must be getting close to the Western Paradise,\" said the Tang Monk."
          },
          {
            "node_id": "n006",
            "quote": "\"We still have a long way to go,\" said Wukong."
          },
          {
            "node_id": "n007",
            "quote": "\"But don't worry. Eventually we'll arrive in the Western Paradise and climb up the Spirit Mountain. Buddha's home, the Thunderclap Monastery, sits halfway up the mountain.\""
          },
          {
            "node_id": "n009",
            "quote": "\"The Thunderclap Monastery must be wonderful to see.\""
          },
          {
            "node_id": "n010",
            "quote": "\"The monastery is spectacular,\" said the monkey."
          }
        ]
      },
      "sources": [
        {
          "kind": "official_quiz_pdf",
          "file": "G:\\Game\\BookPlay书戏\\data\\测试题\\08 英文测试题108集全.Journey to the West-quiz.pdf",
