        "story_comprehension"
      ],
      "prompt": {
        "en": "why did wukong say they must be careful?",
        "zh": "悟空为什么说他们必须小心？"
      },
      "payload": {
        "choices": [
          {
            "id": "a",
            "en": "he saw dark clouds over the monastery.",
            "zh": "他看见修道院上空的乌云。"
          },
          {
            "id": "b",
            "en": "he knew the western paradise was near.",
            "zh": "他知道西方极乐世界就在附近。"
          },
          {
            "id": "c",
            "en": "he saw a demon on the road.",
            "zh": "他在路上看到了一个恶魔。"
          }
        ],
        "answer": "a",
        "answer_evidence": [
          {
            "node_id": "n034",
            "quote": "The monkey peered at the monastery for a moment and then frowned."
          },
          {
            "node_id": "n035",
            "quote": "\"We must be careful—I see dark clouds over the monastery.\""
          }
        ]
      },
      "sources": [
