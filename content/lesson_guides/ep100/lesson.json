  "cards": [
    {
      "card_id": "ep100-official-quiz-001",
      "type": "sentence_choice",
      "stage": "episode_complete",
      "order": 1,
      "difficulty": 2,
      "grade_bands": [
        "g1_2",
        "g3_4",
        "g5_6"
      ],
      "skills": [
        "story_comprehension"
      ],
      "prompt": {
        "en": "which is not true?",
        "zh": "哪一项是不正确的？"
      },
      "payload": {
        "choices": [
          {
            "id": "a",
            "en": "the judge scared the robbers away.",
            "zh": "法官把抢劫犯吓跑了。"
          },
          {
            "id": "b",
            "en": "the robbers killed squire kou.",
            "zh": "强盗杀了考爵士。"
          },
          {
            "id": "c",
            "en": "lady kou blamed the travelers.",
            "zh": "寇夫人责怪了旅行者。"
          }
        ],
        "answer": "a",
        "answer_evidence": [
          {
            "node_id": "n024",
            "quote": "\"Robbers broke into our house last night,\" said Lady Kou breathlessly."
          },
          {
            "node_id": "n025",
            "quote": "\"They stole many valuable items and two of our horses. Squire Kou tried to stop them, but the robbers . . . They . . . killed my husband!\""
          },
          {
            "node_id": "n032",
            "quote": "Lady Kou gritted her teeth."
          },
          {
            "node_id": "n033",
            "quote": "\"The Tang Monk and his companions!\""
          },
          {
            "node_id": "n069",
            "quote": "The monkey grew large, and fire burned in his eyes."
          },
          {
            "node_id": "n070",
            "quote": "\"Get out of here!\" he thundered."
          },
          {
            "node_id": "n072",
            "quote": "The robbers screamed and ran away."
          }
        ]
      },
      "sources": [
        {
          "kind": "official_quiz_pdf",
