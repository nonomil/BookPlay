    {
      "card_id": "ep034-official-quiz-002",
      "type": "sentence_choice",
      "stage": "episode_complete",
      "order": 2,
      "difficulty": 2,
      "grade_bands": [
        "g1_2",
        "g3_4",
        "g5_6"
      ],
      "skills": [
        "story_comprehension"
      ],
      "prompt": {
        "en": "what did the tang monk promise to do?",
        "zh": "唐僧承诺要做什么？"
      },
      "payload": {
        "choices": [
          {
            "id": "a",
            "en": "deliver a letter",
            "zh": "递送一封信"
          },
          {
            "id": "b",
            "en": "rescue the princess",
            "zh": "拯救公主"
          },
          {
            "id": "c",
            "en": "fight the monster",
            "zh": "与怪物战斗"
          }
        ],
        "answer": "a",
        "answer_evidence": [
          {
            "node_id": "n012",
            "quote": "\"I can help you get free,\" said the young woman."
          },
          {
            "node_id": "n013",
            "quote": "\"If I do, will you deliver a letter to my parents?\""
          },
          {
            "node_id": "n014",
            "quote": "\"Of course,\" said the monk. \"Who are your parents?\""
          },
          {
            "node_id": "n015",
            "quote": "\"They're the king and queen of the Precious Image Kingdom,\" said the young woman."
          },
          {
            "node_id": "n016",
            "quote": "\"My name is Princess Hundred Flowers.\""
          }
        ]
      },
      "sources": [
        {
          "kind": "official_quiz_pdf",
          "file": "G:\\Game\\BookPlay书戏\\data\\测试题\\08 英文测试题108集全.Journey to the West-quiz.pdf",
