    {
      "card_id": "ep034-official-quiz-003",
      "type": "sentence_choice",
      "stage": "episode_complete",
      "order": 3,
      "difficulty": 2,
      "grade_bands": [
        "g1_2",
        "g3_4",
        "g5_6"
      ],
      "skills": [
        "story_comprehension"
      ],
      "prompt": {
        "en": "what did the princess ask the monster to do?",
        "zh": "公主让怪物做了什么？"
      },
      "payload": {
        "choices": [
          {
            "id": "a",
            "en": "free the tang monk",
            "zh": "解救唐僧"
          },
          {
            "id": "b",
            "en": "deliver a letter",
            "zh": "递送一封信"
          },
          {
            "id": "c",
            "en": "capture wujing",
            "zh": "抓住悟净"
          }
        ],
        "answer": "a",
        "answer_evidence": [
          {
            "node_id": "n017",
            "quote": "Bajie and Wujing were still fighting the monster when the princess ran outside."
          },
          {
            "node_id": "n018",
            "quote": "\"Monster!\" she cried. \"I must ask you a favor.\""
          },
          {
            "node_id": "n021",
            "quote": "\"There's a monk inside,\" said the princess."
          },
          {
            "node_id": "n022",
            "quote": "\"It makes me so sad to see him tied up. Won't you let him go?\""
          },
          {
            "node_id": "n024",
            "quote": "\"That monk isn't an ordinary monk. He's the—\" Princess Hundred Flowers pretended to cry."
          },
          {
            "node_id": "n026",
            "quote": "\"Okay, okay, sweetie. You know I only want you to be happy. The monk may go.\""
          }
        ]
      },
