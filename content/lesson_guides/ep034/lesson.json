  "cards": [
    {
      "card_id": "ep034-official-quiz-001",
      "type": "sentence_choice",
      "stage": "episode_complete",
      "order": 1,
      "difficulty": 2,
      "grade_bands": [
        "g1_2",
        "g3_4",
        "g5_6"
      ],
      "skills": [
        "story_comprehension"
      ],
      "prompt": {
        "en": "which is not true?",
        "zh": "哪一项是不正确的？"
      },
      "payload": {
        "choices": [
          {
            "id": "a",
            "en": "the tang monk arrived to rescue the princess.",
            "zh": "唐僧来救公主了。"
          },
          {
            "id": "b",
            "en": "the king told the general to destroy the monster.",
            "zh": "国王告诉将军去消灭怪物。"
          },
          {
            "id": "c",
            "en": "the princess was a prisoner for 13 years.",
            "zh": "公主被囚禁了13年。"
          }
        ],
        "answer": "a",
        "answer_evidence": [
          {
            "node_id": "n001",
            "quote": "The Tang Monk was tied up in a room."
          },
          {
            "node_id": "n008",
            "quote": "\"I'm a prisoner here,\" said the woman."
          },
          {
            "node_id": "n009",
            "quote": "\"That monster kidnapped me 13 years ago and won't let me leave. Will you help me?\""
          },
          {
            "node_id": "n037",
            "quote": "The king stood up, his eyes blazing with anger."
          },
          {
            "node_id": "n038",
            "quote": "He called to his general, who was standing nearby."
          },
          {
            "node_id": "n039",
            "quote": "\"Gather your troops,\" said the king."
          },
          {
            "node_id": "n040",
            "quote": "\"I want my daughter back. And I want that monster destroyed!\""
          }
        ]
      },
      "sources": [
        {
          "kind": "official_quiz_pdf",
          "file": "G:\\Game\\BookPlay书戏\\data\\测试题\\08 英文测试题108集全.Journey to the West-quiz.pdf",
