      "skills": [
        "story_comprehension"
      ],
      "prompt": {
        "en": "what did wukong do for hours?",
        "zh": "悟空做了几个小时什么？"
      },
      "payload": {
        "choices": [
          {
            "id": "a",
            "en": "try to escape the cymbals",
            "zh": "试图逃离钹"
          },
          {
            "id": "b",
            "en": "look for the tang monk",
            "zh": "寻找唐僧"
          },
          {
            "id": "c",
            "en": "pray to buddha for help",
            "zh": "向佛祖祈求帮助"
          }
        ],
        "answer": "a",
        "answer_evidence": [
          {
            "node_id": "n010",
            "quote": "The monkey punched and kicked the inside of the cymbals for hours."
          }
        ]
      },
      "sources": [
        {
          "kind": "official_quiz_pdf",
