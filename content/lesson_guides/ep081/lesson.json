      "skills": [
        "story_comprehension"
      ],
      "prompt": {
        "en": "why did wukong go back to get the bags?",
        "zh": "悟空为什么要回去取袋子？"
      },
      "payload": {
        "choices": [
          {
            "id": "a",
            "en": "the tang monk's special robe was in the bags.",
            "zh": "唐僧的法衣在袋子里。"
          },
          {
            "id": "b",
            "en": "his iron bar was in the bags.",
            "zh": "他的铁棍在包里。"
          },
          {
            "id": "c",
            "en": "bajie's food was in the bags.",
            "zh": "八戒的食物在袋子里。"
          }
        ],
        "answer": "a",
        "answer_evidence": [
          {
            "node_id": "n067",
            "quote": "Wukong looked at Bajie and frowned."
          },
          {
            "node_id": "n068",
            "quote": "\"Where are the bags?\""
          },
          {
            "node_id": "n069",
            "quote": "The pig moaned."
          },
          {
            "node_id": "n070",
            "quote": "\"I forgot them.\""
          },
          {
            "node_id": "n071",
            "quote": "\"Master's special robe is in one of those bags!\" Wukong sighed."
          },
          {
            "node_id": "n072",
            "quote": "\"Wait here. I'll go back in and get them.\""
          }
        ]
      },
