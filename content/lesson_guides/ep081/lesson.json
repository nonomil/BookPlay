    {
      "card_id": "ep081-official-quiz-003",
      "type": "sentence_choice",
      "stage": "episode_complete",
      "order": 3,
      "difficulty": 2,
      "grade_bands": [
        "g1_2",
        "g3_4",
        "g5_6"
      ],
      "skills": [
        "story_comprehension"
      ],
      "prompt": {
        "en": "who helped wukong escape from the cymbals?",
        "zh": "谁帮助悟空从钹中逃出来？"
      },
      "payload": {
        "choices": [
          {
            "id": "a",
            "en": "the gold dragon",
            "zh": "金龙"
          },
          {
            "id": "b",
            "en": "the gold demon",
            "zh": "黄金恶魔"
          },
          {
            "id": "c",
            "en": "the tang monk",
            "zh": "唐僧"
          }
        ],
        "answer": "b",
        "answer_evidence": [
          {
            "node_id": "n059",
            "quote": "\"We must escape as soon as the demon goes back to sleep. He plans to get the True Scriptures himself.\""
          }
        ]
      },
      "sources": [
        {
