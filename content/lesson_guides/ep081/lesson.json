  "cards": [
    {
      "card_id": "ep081-official-quiz-001",
      "type": "sentence_choice",
      "stage": "episode_complete",
      "order": 1,
      "difficulty": 2,
      "grade_bands": [
        "g1_2",
        "g3_4",
        "g5_6"
      ],
      "skills": [
        "story_comprehension"
      ],
      "prompt": {
        "en": "which is not true?",
        "zh": "哪一项是不正确的？"
      },
      "payload": {
        "choices": [
          {
            "id": "a",
            "en": "bajie remembered to bring the bags.",
            "zh": "八戒记得带了袋子。"
          },
          {
            "id": "b",
            "en": "wukong woke yellow brows twice.",
            "zh": "悟空叫醒了黄眉两次。"
          },
          {
            "id": "c",
            "en": "the jade emperor sent the gold dragon.",
            "zh": "玉皇大帝派来了金龙。"
          }
        ],
        "answer": "a",
        "answer_evidence": [
          {
            "node_id": "n017",
            "quote": "\"I'm the Gold Dragon,\" said the voice."
          },
          {
            "node_id": "n018",
            "quote": "\"The Jade Emperor sent me to help you. I'll wedge my horn between the cymbals and pry them apart.\""
          },
          {
            "node_id": "n033",
            "quote": "\"We have to be quiet,\" said the dragon."
          },
          {
            "node_id": "n034",
            "quote": "\"The demon is sleeping.\""
          },
          {
            "node_id": "n037",
            "quote": "<font color=\"#ffff00\"><i>Smash!</i></font> The cymbals shattered."
          },
          {
            "node_id": "n040",
            "quote": "The demon stormed into the room."
          },
          {
            "node_id": "n064",
            "quote": "\"Bajie, get the bags.\""
          },
          {
            "node_id": "n068",
            "quote": "\"Where are the bags?\""
          },
          {
            "node_id": "n069",
            "quote": "The pig moaned."
          },
          {
            "node_id": "n070",
            "quote": "\"I forgot them.\""
          },
          {
            "node_id": "n074",
            "quote": "But as he was leaving, he tripped and knocked over a statue. <font color=\"#ffff00\"><i>Bang!</i></font> From another room Yellow Brows shouted, \"What was that?\""
          }
        ]
      },
      "sources": [
        {
          "kind": "official_quiz_pdf",
          "file": "G:\\Game\\BookPlay书戏\\data\\测试题\\08 英文测试题108集全.Journey to the West-quiz.pdf",
