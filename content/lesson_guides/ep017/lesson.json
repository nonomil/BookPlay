      "prompt": {
        "en": "what made the dragon angry?",
        "zh": "是什么惹怒了龙？"
      },
      "payload": {
        "choices": [
          {
            "id": "a",
            "en": "wukong made the water rough.",
            "zh": "悟空弄得水面波涛汹涌。"
          },
          {
            "id": "b",
            "en": "the horse was in his stomach.",
            "zh": "马在他的胃里。"
          },
          {
            "id": "c",
            "en": "the monk was violent and cruel.",
            "zh": "那个和尚暴力又残忍。"
          }
        ],
        "answer": "a",
        "answer_evidence": [
          {
            "node_id": "n020",
            "quote": "The monkey swirled the water with his iron bar."
          },
          {
            "node_id": "n027",
            "quote": "\"I'm trying to take a nap!\""
          }
        ]
      },
