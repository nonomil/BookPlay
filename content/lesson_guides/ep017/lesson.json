      ],
      "prompt": {
        "en": "what stopped wukong and the monk from crossing the river?",
        "zh": "是什么阻止了悟空和和尚过河？"
      },
      "payload": {
        "choices": [
          {
            "id": "a",
            "en": "a dragon",
            "zh": "一条龙"
          },
          {
            "id": "b",
            "en": "guanyin",
            "zh": "观音"
          },
          {
            "id": "c",
            "en": "the headband",
            "zh": "头带"
          }
        ],
        "answer": "a",
        "answer_evidence": [
          {
            "node_id": "n019",
            "quote": "Wukong nodded. \"And we can't cross the river with that dragon in there. I'll try another plan.\""
          }
        ]
      },
