        "story_comprehension"
      ],
      "prompt": {
        "en": "why was the dragon being punished?",
        "zh": "为什么龙会受到惩罚？"
      },
      "payload": {
        "choices": [
          {
            "id": "a",
            "en": "he set fire to his father's palace.",
            "zh": "他点燃了他父亲的宫殿。"
          },
          {
            "id": "b",
            "en": "he couldn't reach the western paradise.",
            "zh": "他无法到达西方极乐世界。"
          },
          {
            "id": "c",
            "en": "he caused trouble in heaven.",
            "zh": "他在天堂惹事生非。"
          }
        ],
        "answer": "a",
        "answer_evidence": [
          {
            "node_id": "n058",
            "quote": "Guanyin sighed. \"That dragon was waiting for you. When I met him, he was being punished for setting fire to his father's palace. I told him to help the Tang Monk reach the Western Paradise. That way he can earn forgiveness.\""
          }
        ]
      },
      "sources": [
