  "cards": [
    {
      "card_id": "ep102-official-quiz-001",
      "type": "sentence_choice",
      "stage": "episode_complete",
      "order": 1,
      "difficulty": 2,
      "grade_bands": [
        "g1_2",
        "g3_4",
        "g5_6"
      ],
      "skills": [
        "story_comprehension"
      ],
      "prompt": {
        "en": "which is not true?",
        "zh": "哪一项是不正确的？"
      },
      "payload": {
        "choices": [
          {
            "id": "a",
            "en": "laozi helped wukong find squire kou.",
            "zh": "老子帮助悟空找到寇少爷。"
          },
          {
            "id": "b",
            "en": "wukong went to the land of darkness.",
            "zh": "悟空去了黑暗之地。"
          },
          {
            "id": "c",
            "en": "squire kou was working for dayuan.",
            "zh": "寇员外在为地藏菩萨工作。"
          }
        ],
        "answer": "a",
        "answer_evidence": [
          {
            "node_id": "n032",
            "quote": "\"The sage Laozi helped you that time. Will you ask him for help again?\""
          },
          {
            "node_id": "n033",
            "quote": "\"No,\" said Wukong."
          },
          {
            "node_id": "n034",
            "quote": "\"Laozi doesn't really like me. I'll go to the Land of Darkness and talk to the Judge of the Dead instead.\""
          },
          {
            "node_id": "n040",
            "quote": "\"Ah, yes. He died two days ago. He now works for the bodhisattva Dayuan in the Jade Palace. It's here in the Land of Darkness.\""
          },
          {
            "node_id": "n041",
            "quote": "Wukong went to the Jade Palace."
          },
          {
            "node_id": "n052",
            "quote": "Squire Kou was sitting behind a large desk, smiling, as he studied some documents."
          }
        ]
      },
      "sources": [
        {
          "kind": "official_quiz_pdf",
