    {
      "card_id": "ep076-official-quiz-005",
      "type": "sentence_choice",
      "stage": "episode_complete",
      "order": 5,
      "difficulty": 2,
      "grade_bands": [
        "g1_2",
        "g3_4",
        "g5_6"
      ],
      "skills": [
        "story_comprehension"
      ],
      "prompt": {
        "en": "where was the bull demon king?",
        "zh": "牛魔王在哪里？"
      },
      "payload": {
        "choices": [
          {
            "id": "a",
            "en": "at a banquet",
            "zh": "在宴会中"
          },
          {
            "id": "b",
            "en": "at mount potalaka",
            "zh": "在普陀洛伽山"
          },
          {
            "id": "c",
            "en": "at the mountain",
            "zh": "在山上"
          }
        ],
        "answer": "a",
        "answer_evidence": [
          {
            "node_id": "n057",
            "quote": "He isn't evil anymore.\" The Iron Immortal shrieked. \"That's even worse!\" Wukong sighed. \"Can I please just borrow your fan for a little while?\" \"No!\" said the woman. \"Well then, can I speak with the Bull Demon King?\" asked the monkey. \"He's at a banquet,\" said the Iron Immortal. \"Now leave!\" Wukong grew angry. \"I'm not leaving until I borrow your—\" <font color=\"#ffff00\"><i>Whoosh!</i></font> The Iron Immortal waved the fan. A furious wind blew, and Wukong was gone!"
          }
        ]
      },
