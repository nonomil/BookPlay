    },
    {
      "card_id": "ep076-official-quiz-003",
      "type": "sentence_choice",
      "stage": "episode_complete",
      "order": 3,
      "difficulty": 2,
      "grade_bands": [
        "g1_2",
        "g3_4",
        "g5_6"
      ],
      "skills": [
        "story_comprehension"
      ],
      "prompt": {
        "en": "what caused all of the heat?",
        "zh": "这一切的热量是由什么引起的？"
      },
      "payload": {
        "choices": [
          {
            "id": "a",
            "en": "the mountain of flames",
            "zh": "火焰山"
          },
          {
            "id": "b",
            "en": "the iron immortal",
            "zh": "铁扇公主"
          },
          {
            "id": "c",
            "en": "red boy",
            "zh": "红孩儿"
          }
        ],
        "answer": "a",
        "answer_evidence": [
          {
            "node_id": "n016",
            "quote": "\"Is it always so hot here?\" asked Bajie."
          },
          {
            "node_id": "n017",
            "quote": "The man nodded. \"The Mountain of Flames is near here. It's always burning.\""
          },
          {
            "node_id": "n026",
            "quote": "\"The Mountain of Flames is to the west,\" said the man."
          },
          {
            "node_id": "n030",
            "quote": "\"All the land around the mountain is covered in flames. The land stretches far to the north and the south. It's impossible to go around.\""
          }
        ]
      },
      "sources": [
        {
          "kind": "official_quiz_pdf",
          "file": "G:\\Game\\BookPlay书戏\\data\\测试题\\08 英文测试题108集全.Journey to the West-quiz.pdf",
