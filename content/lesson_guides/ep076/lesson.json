      "skills": [
        "story_comprehension"
      ],
      "prompt": {
        "en": "what could put out the flames?",
        "zh": "什么能扑灭火焰？"
      },
      "payload": {
        "choices": [
          {
            "id": "a",
            "en": "the iron immortal's fan",
            "zh": "铁扇公主的扇子"
          },
          {
            "id": "b",
            "en": "a strong rainstorm",
            "zh": "一场大暴雨"
          },
          {
            "id": "c",
            "en": "help from guanyin",
            "zh": "观音的帮助"
          }
        ],
        "answer": "a",
        "answer_evidence": [
          {
            "node_id": "n037",
            "quote": "\"She has a special fan that can put out the flames. It's made from a plantain leaf.\""
          },
          {
            "node_id": "n039",
            "quote": "\"Where does the Iron Immortal live? I'll demand that she put out the flames.\""
          }
        ]
      },
