  "cards": [
    {
      "card_id": "ep076-official-quiz-001",
      "type": "sentence_choice",
      "stage": "episode_complete",
      "order": 1,
      "difficulty": 2,
      "grade_bands": [
        "g1_2",
        "g3_4",
        "g5_6"
      ],
      "skills": [
        "story_comprehension"
      ],
      "prompt": {
        "en": "why did the travelers decide to stop?",
        "zh": "旅行者为什么决定停下来？"
      },
      "payload": {
        "choices": [
          {
            "id": "a",
            "en": "it was really hot.",
            "zh": "天气真的很热。"
          },
          {
            "id": "b",
            "en": "it was really cold.",
            "zh": "真的很冷。"
          },
          {
            "id": "c",
            "en": "it was raining.",
            "zh": "下雨了。"
          }
        ],
        "answer": "a",
        "answer_evidence": [
          {
            "node_id": "n005",
            "quote": "\"Can we please slow down?\" Bajie moaned."
          },
          {
            "node_id": "n006",
            "quote": "\"I'm tired and it's hot!\""
          },
          {
            "node_id": "n009",
            "quote": "Wujing wiped his brow."
          },
          {
            "node_id": "n010",
            "quote": "\"It <font color=\"#ffff00\"><i>is</i></font> hot. Maybe we should take a break.\""
          },
          {
            "node_id": "n011",
            "quote": "\"Yes,\" said the Tang Monk."
          }
        ]
      },
      "sources": [
        {
          "kind": "official_quiz_pdf",
