    {
      "card_id": "ep076-official-quiz-002",
      "type": "sentence_choice",
      "stage": "episode_complete",
      "order": 2,
      "difficulty": 2,
      "grade_bands": [
        "g1_2",
        "g3_4",
        "g5_6"
      ],
      "skills": [
        "story_comprehension"
      ],
      "prompt": {
        "en": "what did wukong promise not to do?",
        "zh": "悟空答应不做什么？"
      },
      "payload": {
        "choices": [
          {
            "id": "a",
            "en": "harm people",
            "zh": "伤害人"
          },
          {
            "id": "b",
            "en": "harm demons",
            "zh": "伤害恶魔"
          },
          {
            "id": "c",
            "en": "harm bajie",
            "zh": "伤八戒"
          }
        ],
        "answer": "a",
        "answer_evidence": [
          {
            "node_id": "n002",
            "quote": "\"Master,\" said Wukong."
          },
          {
            "node_id": "n003",
            "quote": "\"While I was at Mount Potalaka, I thought a lot. I realize now that it's wrong to harm people. I won't ever do it again.\""
          }
        ]
      },
      "sources": [
        {
          "kind": "official_quiz_pdf",
          "file": "G:\\Game\\BookPlay书戏\\data\\测试题\\08 英文测试题108集全.Journey to the West-quiz.pdf",
