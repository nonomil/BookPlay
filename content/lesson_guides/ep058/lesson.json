  "cards": [
    {
      "card_id": "ep058-official-quiz-006",
      "type": "sentence_choice",
      "stage": "episode_complete",
      "order": 6,
      "difficulty": 2,
      "grade_bands": [
        "g1_2",
        "g3_4",
        "g5_6"
      ],
      "skills": [
        "story_comprehension"
      ],
      "prompt": {
        "en": "which was not a part of the tiger immortal's contest?",
        "zh": "哪一项不是虎力大仙比赛的一部分？"
      },
      "payload": {
        "choices": [
          {
            "id": "a",
            "en": "scratching",
            "zh": "抓"
          },
          {
            "id": "b",
            "en": "meditating",
            "zh": "冥想"
          },
          {
            "id": "c",
            "en": "floating in the air",
            "zh": "漂浮在空中"
          }
        ],
        "answer": "a",
        "answer_evidence": [
          {
            "node_id": "n001",
            "quote": "\"I challenge you to a meditation contest,\" said the Tiger Immortal."
          },
          {
            "node_id": "n002",
            "quote": "\"Whoever can meditate the longest without moving is the winner.\""
          },
          {
            "node_id": "n012",
            "quote": "\"This won't be an ordinary meditation contest. We will float in the air and meditate. Can you do that?\""
          },
          {
            "node_id": "n021",
            "quote": "They sat down with their legs crossed and their palms facing up."
          },
          {
            "node_id": "n049",
            "quote": "Wukong brushed the flea away and scratched the Tang Monk's head."
          }
        ]
      },
      "sources": [
        {
          "kind": "official_quiz_pdf",
          "file": "G:\\Game\\BookPlay书戏\\data\\测试题\\08 英文测试题108集全.Journey to the West-quiz.pdf",
