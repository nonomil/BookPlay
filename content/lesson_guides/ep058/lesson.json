      "review_status": "assistant_reviewed"
    },
    {
      "card_id": "ep058-official-quiz-007",
      "type": "sentence_choice",
      "stage": "episode_complete",
      "order": 7,
      "difficulty": 2,
      "grade_bands": [
        "g1_2",
        "g3_4",
        "g5_6"
      ],
      "skills": [
        "story_comprehension"
      ],
      "prompt": {
        "en": "what did wukong help the tang monk do?",
        "zh": "悟空帮助唐僧做了什么？"
      },
      "payload": {
        "choices": [
          {
            "id": "a",
            "en": "float in the air",
            "zh": "在空中漂浮"
          },
          {
            "id": "b",
            "en": "meditate",
            "zh": "冥想"
          },
          {
            "id": "c",
            "en": "lose the contest",
            "zh": "输掉比赛"
          }
        ],
        "answer": "a",
        "answer_evidence": [
          {
            "node_id": "n023",
            "quote": "After a moment the Tiger Immortal slowly floated up into the air."
          },
          {
            "node_id": "n024",
            "quote": "\"Uh-oh,\" said Bajie. \"Master can't do that. He'll lose the contest.\""
          },
          {
            "node_id": "n025",
            "quote": "\"Don't worry,\" said Wukong."
          },
          {
            "node_id": "n026",
            "quote": "\"He just needs some help from me.\""
          },
          {
            "node_id": "n027",
            "quote": "The monkey recited a spell and then blew toward the Tang Monk."
          },
          {
            "node_id": "n028",
            "quote": "The monk lifted off the ground."
          },
          {
            "node_id": "n030",
            "quote": "Soon he was floating next to the Tiger Immortal."
          }
        ]
      },
