      "prompt": {
        "en": "who was helping wukong?",
        "zh": "谁在帮助悟空？"
      },
      "payload": {
        "choices": [
          {
            "id": "a",
            "en": "guanyin",
            "zh": "观音"
          },
          {
            "id": "b",
            "en": "the tang monk",
            "zh": "唐僧"
          },
          {
            "id": "c",
            "en": "the black wind king",
            "zh": "黑风王"
          }
        ],
        "answer": "a",
        "answer_evidence": [
          {
            "node_id": "n013",
            "quote": "\"I'll help you get back the robe,\" said Guanyin. \"Let's go.\""
          }
        ]
      },
