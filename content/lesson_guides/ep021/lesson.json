      "payload": {
        "choices": [
          {
            "id": "a",
            "en": "make the black wind king live forever",
            "zh": "让黑风王永生"
          },
          {
            "id": "b",
            "en": "keep the robe safe from harm",
            "zh": "保护长袍免受伤害"
          },
          {
            "id": "c",
            "en": "disguise the black wind king",
            "zh": "伪装黑风王"
          }
        ],
        "answer": "a",
        "answer_evidence": [
          {
            "node_id": "n025",
            "quote": "\"The Black Wind King has a new robe that is a Buddhist treasure. And I hope he likes the pill I made for him. It will make him live forever.\""
          }
        ]
      },
