    {
      "card_id": "ep021-official-quiz-004",
      "type": "sentence_choice",
      "stage": "episode_complete",
      "order": 4,
      "difficulty": 2,
      "grade_bands": [
        "g1_2",
        "g3_4",
        "g5_6"
