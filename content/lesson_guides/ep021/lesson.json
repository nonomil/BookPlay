      "skills": [
        "story_comprehension"
      ],
      "prompt": {
        "en": "what did wukong notice about the priest?",
        "zh": "悟空注意到那个和尚什么了？"
      },
      "payload": {
        "choices": [
          {
            "id": "a",
            "en": "he was a wolf spirit in disguise.",
            "zh": "他伪装成狼的灵魂。"
          },
          {
            "id": "b",
            "en": "he was really the tang monk.",
            "zh": "他真的是唐僧。"
          },
          {
            "id": "c",
            "en": "he was a bodhisattva.",
            "zh": "他是一位菩萨。"
          }
        ],
        "answer": "a",
        "answer_evidence": [
          {
            "node_id": "n026",
            "quote": "Wukong stared at the priest, using his magic sight."
          },
          {
            "node_id": "n027",
            "quote": "\"That's not a priest!\" Wukong realized."
          },
          {
            "node_id": "n028",
            "quote": "\"It's a wolf spirit dressed as a priest.\""
          }
        ]
      },
      "sources": [
