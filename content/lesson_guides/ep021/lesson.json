  "cards": [
    {
      "card_id": "ep021-official-quiz-001",
      "type": "sentence_choice",
      "stage": "episode_complete",
      "order": 1,
      "difficulty": 2,
      "grade_bands": [
        "g1_2",
        "g3_4",
        "g5_6"
      ],
      "skills": [
        "story_comprehension"
      ],
      "prompt": {
        "en": "which is not true?",
        "zh": "哪一项是不正确的？"
      },
      "payload": {
        "choices": [
          {
            "id": "a",
            "en": "guanyin was very proud of wukong and the monk.",
            "zh": "观音对悟空和和尚感到非常自豪。"
          },
          {
            "id": "b",
            "en": "the pill jumped into the black wind king's mouth.",
            "zh": "药丸跳进了黑风王的嘴里。"
          },
          {
            "id": "c",
            "en": "the priest wanted to celebrate the buddhist treasure.",
            "zh": "这位牧师想要庆祝佛教宝物。"
          }
        ],
        "answer": "a",
        "answer_evidence": [
          {
            "node_id": "n005",
            "quote": "Guanyin sighed. \"The Tang Monk should not have shown that robe to the priest,\" she said."
          },
          {
            "node_id": "n008",
            "quote": "\"I've told the Tang Monk many times not to do dumb things. But still he—\" \"And you should have put out that fire,\" Guanyin said, interrupting Wukong."
          },
          {
            "node_id": "n009",
            "quote": "\"What you did was terrible!\""
          },
          {
            "node_id": "n044",
            "quote": "\"I brought you a gift, to celebrate your new Buddhist treasure.\""
          },
          {
            "node_id": "n053",
            "quote": "As he brought the pill up to his mouth, the pill wiggled."
          },
          {
            "node_id": "n055",
            "quote": "It shot into his mouth and slid down his throat."
          }
        ]
      },
      "sources": [
        {
          "kind": "official_quiz_pdf",
          "file": "G:\\Game\\BookPlay书戏\\data\\测试题\\08 英文测试题108集全.Journey to the West-quiz.pdf",
