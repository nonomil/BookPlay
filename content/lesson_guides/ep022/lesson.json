      "skills": [
        "story_comprehension"
      ],
      "prompt": {
        "en": "which is not true?",
        "zh": "哪一项是不正确的？"
      },
      "payload": {
        "choices": [
          {
            "id": "a",
            "en": "the bear destroyed the robe.",
            "zh": "熊毁坏了长袍。"
          },
          {
            "id": "b",
            "en": "the bear tried to attack guanyin.",
            "zh": "熊试图攻击观音。"
          },
          {
            "id": "c",
            "en": "the bear will become guanyin's guardian.",
            "zh": "这只熊将成为观音的守护者。"
          }
        ],
        "answer": "a",
        "answer_evidence": [
          {
            "node_id": "n035",
            "quote": "After Wukong left to get the robe, the Black Wind King charged at Guanyin."
          },
          {
            "node_id": "n043",
            "quote": "Wukong came back with the robe."
          },
          {
            "node_id": "n049",
            "quote": "\"I will show him mercy,\" said Guanyin."
          },
          {
            "node_id": "n050",
            "quote": "\"He can be my guardian on Mount Potalaka if he behaves.\""
          }
        ]
      },
