  "cards": [
    {
      "card_id": "ep024-official-quiz-001",
      "type": "sentence_choice",
      "stage": "episode_complete",
      "order": 1,
      "difficulty": 2,
      "grade_bands": [
        "g1_2",
        "g3_4",
        "g5_6"
      ],
      "skills": [
        "story_comprehension"
      ],
      "prompt": {
        "en": "which is true?",
        "zh": "哪一个是真的？"
      },
      "payload": {
        "choices": [
          {
            "id": "a",
            "en": "yellow wind wanted to eat the tang monk.",
            "zh": "黄风怪想吃唐僧。"
          },
          {
            "id": "b",
            "en": "bajie's hair turned into dozens of little pigs.",
            "zh": "八戒的头发变成了几十只小猪。"
          },
          {
            "id": "c",
            "en": "the tang monk carried the tiger to the cave.",
            "zh": "唐僧把老虎带到洞里。"
          }
        ],
        "answer": "a",
        "answer_evidence": [
          {
            "node_id": "n014",
            "quote": "\"I have heard that anyone who eats the Tang Monk will live forever. Was the monk alone?\""
          },
          {
            "node_id": "n023",
            "quote": "\"Sun Wukong is powerful. He and that pig might come looking for the monk. They'll be angry if they find out we ate him. Let's wait until they leave the area. Then we'll be able to enjoy our meal.\""
          }
        ]
      },
      "sources": [
        {
          "kind": "official_quiz_pdf",
          "file": "G:\\Game\\BookPlay书戏\\data\\测试题\\08 英文测试题108集全.Journey to the West-quiz.pdf",
          "page": 28,
          "sha256": "bcc738833439415d5b2aebde6d316c75168f0d73ae87dab5e11ba8c616056929"
        }
      ],
      "review_status": "assistant_reviewed"
    },
    {
      "card_id": "ep024-official-quiz-002",
      "type": "sentence_choice",
      "stage": "episode_complete",
      "order": 2,
      "difficulty": 2,
      "grade_bands": [
        "g1_2",
        "g3_4",
        "g5_6"
      ],
      "skills": [
        "story_comprehension"
      ],
      "prompt": {
        "en": "what did wukong and bajie look for?",
        "zh": "悟空和八戒在找什么？"
      },
      "payload": {
        "choices": [
          {
            "id": "a",
            "en": "yellow wind's cave",
            "zh": "黄风洞"
          },
          {
            "id": "b",
            "en": "yellow wind's trident",
            "zh": "黄风的三叉戟"
          },
          {
            "id": "c",
            "en": "yellow wind's robe",
            "zh": "黄风的长袍"
          }
        ],
        "answer": "a",
        "answer_evidence": [
          {
            "node_id": "n001",
            "quote": "Wukong and Bajie looked all around."
          },
          {
            "node_id": "n002",
            "quote": "But the Tang Monk was gone."
          },
          {
            "node_id": "n008",
            "quote": "\"We have to save our master. That tiger said he works for a demon, the great king Yellow Wind. The king's cave must be nearby.\""
          }
        ]
      },
      "sources": [
        {
          "kind": "official_quiz_pdf",
          "file": "G:\\Game\\BookPlay书戏\\data\\测试题\\08 英文测试题108集全.Journey to the West-quiz.pdf",
