    {
      "card_id": "ep024-official-quiz-003",
      "type": "sentence_choice",
      "stage": "episode_complete",
      "order": 3,
      "difficulty": 2,
      "grade_bands": [
        "g1_2",
        "g3_4",
        "g5_6"
      ],
      "skills": [
        "story_comprehension"
      ],
      "prompt": {
        "en": "what surprised yellow wind?",
        "zh": "什么让黄风感到惊讶？"
      },
      "payload": {
        "choices": [
          {
            "id": "a",
            "en": "wukong was very small.",
            "zh": "悟空很小。"
          },
          {
            "id": "b",
            "en": "the tiger caused trouble in heaven.",
            "zh": "老虎在天上惹了麻烦。"
          },
          {
            "id": "c",
            "en": "the tang monk escaped.",
            "zh": "唐僧逃脱了。"
          }
        ],
        "answer": "a",
        "answer_evidence": [
          {
            "node_id": "n039",
            "quote": "He saw Wukong."
          },
          {
            "node_id": "n040",
            "quote": "\"So you're the monkey who caused all the trouble in Heaven,\" said Yellow Wind."
          },
          {
            "node_id": "n042",
            "quote": "\"I didn't know you were so small,\" said Yellow Wind."
          }
        ]
      },
      "sources": [
        {
          "kind": "official_quiz_pdf",
