      "skills": [
        "story_comprehension"
      ],
      "prompt": {
        "en": "what happened to the tiger?",
        "zh": "老虎发生了什么事？"
      },
      "payload": {
        "choices": [
          {
            "id": "a",
            "en": "bajie killed him with his rake.",
            "zh": "八戒用他的耙子杀了他。"
          },
          {
            "id": "b",
            "en": "wukong hit him with his iron bar.",
            "zh": "悟空用他的铁棒打了他。"
          },
          {
            "id": "c",
            "en": "yellow wind punished him.",
            "zh": "黄风惩罚了他。"
          }
        ],
        "answer": "a",
        "answer_evidence": [
          {
            "node_id": "n033",
            "quote": "A moment later the small demon ran back in."
          },
          {
            "node_id": "n034",
            "quote": "\"Great king, disaster!\" he cried."
          },
          {
            "node_id": "n035",
            "quote": "\"The tiger is dead! The pig killed him with his rake!\""
          }
        ]
      },
      "sources": [
