      "prompt": {
        "en": "what did yellow wind make?",
        "zh": "黄风做了什么？"
      },
      "payload": {
        "choices": [
          {
            "id": "a",
            "en": "a powerful wind",
            "zh": "一阵强风"
          },
          {
            "id": "b",
            "en": "a thick snowstorm",
            "zh": "一场大雪"
          },
          {
            "id": "c",
            "en": "a giant flood",
            "zh": "一场巨大的洪水"
          }
        ],
        "answer": "a",
        "answer_evidence": [
          {
            "node_id": "n056",
            "quote": "Yellow Wind laughed. \"I know a magic trick too!\""
          },
          {
            "node_id": "n057",
            "quote": "He looked down and blew three times."
          },
          {
            "node_id": "n058",
            "quote": "The sky grew dark."
          },
          {
            "node_id": "n059",
            "quote": "A powerful yellow wind whipped across the mountain."
          },
          {
            "node_id": "n060",
            "quote": "Trees snapped and rocks tumbled."
          }
        ]
      },
