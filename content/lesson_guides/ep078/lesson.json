      ],
      "prompt": {
        "en": "which is not true?",
        "zh": "哪一项是不正确的？"
      },
      "payload": {
        "choices": [
          {
            "id": "a",
            "en": "the iron immortal tricked her husband.",
            "zh": "铁扇公主欺骗了她的丈夫。"
          },
          {
            "id": "b",
            "en": "the bull demon king tricked wukong.",
            "zh": "牛魔王欺骗了悟空。"
          },
          {
            "id": "c",
            "en": "wukong tricked the iron immortal.",
            "zh": "悟空欺骗了铁扇公主。"
          }
        ],
        "answer": "a",
        "answer_evidence": [
          {
            "node_id": "n036",
            "quote": "Suddenly light sparkled and Wukong stood in front of her."
          },
          {
            "node_id": "n037",
            "quote": "\"I tricked you!\""
          },
          {
            "node_id": "n050",
            "quote": "\"He tricked me into giving it to him,\" said his wife."
          },
          {
            "node_id": "n051",
            "quote": "\"He made himself look like you.\""
          },
          {
            "node_id": "n069",
            "quote": "A second later the Bull Demon King stood next to Wukong."
          },
          {
            "node_id": "n071",
            "quote": "\"I tricked you, Wukong!\""
          }
        ]
      },
