        "story_comprehension"
      ],
      "prompt": {
        "en": "what did the bull demon king decide to do?",
        "zh": "牛魔王决定做什么？"
      },
      "payload": {
        "choices": [
          {
            "id": "a",
            "en": "get the fan back",
            "zh": "拿回风扇"
          },
          {
            "id": "b",
            "en": "find red boy",
            "zh": "找到红孩儿"
          },
          {
            "id": "c",
            "en": "defeat wukong",
            "zh": "击败悟空"
          }
        ],
        "answer": "a",
        "answer_evidence": [
          {
            "node_id": "n047",
            "quote": "\"He stole my fan!\""
          },
          {
            "node_id": "n049",
            "quote": "\"That fan's wind magic is powerful. How did the monkey steal it?\""
          },
          {
            "node_id": "n050",
            "quote": "\"He tricked me into giving it to him,\" said his wife."
          },
          {
            "node_id": "n053",
            "quote": "\"How dare he do that!\""
          },
          {
            "node_id": "n054",
            "quote": "He took a deep breath."
          },
          {
            "node_id": "n055",
            "quote": "\"Don't worry. I will find that rotten monkey. I'll get your fan back!\""
          }
        ]
      },
