  "cards": [
    {
      "card_id": "ep108-official-quiz-001",
      "type": "sentence_choice",
      "stage": "episode_complete",
      "order": 1,
      "difficulty": 2,
      "grade_bands": [
        "g1_2",
        "g3_4",
        "g5_6"
      ],
      "skills": [
        "story_comprehension"
      ],
      "prompt": {
        "en": "which is true?",
        "zh": "哪一个是真的？"
      },
      "payload": {
        "choices": [
          {
            "id": "a",
            "en": "buddha rewarded the travelers.",
            "zh": "佛陀奖励了旅行者。"
          },
          {
            "id": "b",
            "en": "wujing became janitor of the altars.",
            "zh": "悟净成为了祭坛的清洁工。"
          },
          {
            "id": "c",
            "en": "the emperor became a bodhisattva.",
            "zh": "皇帝成了一位菩萨。"
          }
        ],
        "answer": "a",
        "answer_evidence": [
          {
            "node_id": "n043",
            "quote": "Buddha addressed the horse first."
          },
          {
            "node_id": "n044",
            "quote": "\"You carried the Tang Monk on the journey and earned forgiveness for your crimes. You will now be a golden dragon in Heaven.\""
          },
          {
            "node_id": "n046",
            "quote": "\"Wujing,\" said Buddha."
          },
          {
            "node_id": "n047",
            "quote": "\"You too have earned forgiveness for your past crimes. You will now be a golden deity.\""
          },
          {
            "node_id": "n051",
            "quote": "\"You have earned forgiveness, Bajie,\" said Buddha."
          },
          {
            "node_id": "n052",
            "quote": "\"You will be Janitor of the Altars—an important deity who looks after Buddhist altars.\""
          },
          {
            "node_id": "n054",
            "quote": "Buddha next turned to the Tang Monk."
          },
          {
            "node_id": "n056",
            "quote": "You are now a buddha.\" Light glowed around the monk, who bowed before Buddha. \"Thank you, Buddha,\" said the monk. Finally Buddha turned to the monkey. \"And you, Wukong,\" he began. \"Your crimes long ago were terrible."
          },
          {
            "node_id": "n058",
            "quote": "You too are now a buddha.\" Wukong bowed. \"Thank you, Buddha.\" \"Hey . . .\" The monkey suddenly noticed that his head felt different. \"The headband is gone!\" Buddha smiled. \"You don't need it anymore.\" Filled with joy, Wukong and the Tang Monk joined the other buddhas and bodhisattvas. They have been in the Western Paradise ever since."
          }
        ]
      },
      "sources": [
        {
          "kind": "official_quiz_pdf",
          "file": "G:\\Game\\BookPlay书戏\\data\\测试题\\08 英文测试题108集全.Journey to the West-quiz.pdf",
          "page": 131,
          "sha256": "bcc738833439415d5b2aebde6d316c75168f0d73ae87dab5e11ba8c616056929"
