      ],
      "skills": [
        "story_comprehension"
      ],
      "prompt": {
        "en": "which is true?",
        "zh": "哪一个是真的？"
      },
      "payload": {
        "choices": [
          {
            "id": "a",
            "en": "one-horned buffalo did not escape from heaven.",
            "zh": "独角水牛没有逃离天堂。"
          },
          {
            "id": "b",
            "en": "the rain god arrested one-horned buffalo.",
            "zh": "雨神逮捕了独角水牛。"
          },
          {
            "id": "c",
            "en": "wukong went to heaven to get back his iron bar.",
            "zh": "悟空上天去取回他的铁棒。"
          }
        ],
        "answer": "a",
        "answer_evidence": [
          {
            "node_id": "n008",
            "quote": "The guard sent a messenger to see if any spirits were missing from Heaven."
          },
          {
            "node_id": "n012",
            "quote": "\"Nobody is missing from Heaven. But I will arrest One-Horned Buffalo for you.\""
          }
        ]
      },
      "sources": [
        {
          "kind": "official_quiz_pdf",
