      "skills": [
        "story_comprehension"
      ],
      "prompt": {
        "en": "what did one-horned buffalo do each time wukong and his help came back?",
        "zh": "每次悟空和他的伙伴回来时，独角水牛都会做什么？"
      },
      "payload": {
        "choices": [
          {
            "id": "a",
            "en": "he stole a weapon.",
            "zh": "他偷了一件武器。"
          },
          {
            "id": "b",
            "en": "he threw thunder.",
            "zh": "他掷出了雷。"
          },
          {
            "id": "c",
            "en": "he flew to heaven.",
            "zh": "他飞到了天堂。"
          }
        ],
        "answer": "a",
        "answer_evidence": [
          {
            "node_id": "n024",
            "quote": "\"If you don't come with me, I'll have to—\" One-Horned Buffalo held up the metal ring, and . . . <font color=\"#ffff00\"><i>whoosh!</i></font> The warrior's sword flew into it."
          },
          {
            "node_id": "n047",
            "quote": "The spear was gone."
          },
          {
            "node_id": "n065",
            "quote": "One-Horned Buffalo held up the metal ring and—<font color=\"#ffff00\"><i>whoosh!</i></font> The thunderbolt was gone."
          },
          {
            "node_id": "n067",
            "quote": "\"Thank you for all the weapons!\""
          }
        ]
      },
