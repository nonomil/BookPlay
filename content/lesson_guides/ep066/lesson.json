      "prompt": {
        "en": "whom did the jade emperor not send with wukong?",
        "zh": "玉皇大帝没有派谁和悟空一起去？"
      },
      "payload": {
        "choices": [
          {
            "id": "a",
            "en": "a water god",
            "zh": "水神"
          },
          {
            "id": "b",
