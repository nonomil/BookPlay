      "skills": [
        "story_comprehension"
      ],
      "prompt": {
        "en": "which is not true?",
        "zh": "哪一项是不正确的？"
      },
      "payload": {
        "choices": [
          {
            "id": "a",
            "en": "bajie knew how to get rid of the fake king.",
            "zh": "八戒知道如何除掉假的国王。"
          },
          {
            "id": "b",
            "en": "wukong tricked bajie into diving down the well.",
            "zh": "悟空欺骗八戒跳进了井里。"
          },
          {
            "id": "c",
            "en": "the tang monk told the prince about the daoist.",
            "zh": "唐僧告诉王子关于道士的事情。"
          }
        ],
        "answer": "a",
        "answer_evidence": [
          {
            "node_id": "n006",
            "quote": "He told the prince everything."
          },
          {
            "node_id": "n039",
            "quote": "Wukong pushed Bajie, and the pig splashed into the water."
          }
        ]
      },
      "sources": [
