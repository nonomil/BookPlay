          },
          {
            "id": "c",
            "en": "in heaven",
            "zh": "在天堂"
          }
        ],
        "answer": "a",
        "answer_evidence": [
          {
            "node_id": "n032",
            "quote": "In a small courtyard, Wukong rushed toward a well."
          },
          {
            "node_id": "n033",
            "quote": "\"The treasure is in this well,\" said the monkey, pulling the lid off."
          }
        ]
      },
