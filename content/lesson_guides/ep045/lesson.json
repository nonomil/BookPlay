      "prompt": {
        "en": "where did wukong tell bajie the treasure was?",
        "zh": "悟空告诉八戒宝藏在哪里？"
      },
      "payload": {
        "choices": [
          {
            "id": "a",
            "en": "down the well",
            "zh": "下到井里"
          },
          {
            "id": "b",
