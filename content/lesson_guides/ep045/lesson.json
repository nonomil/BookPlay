      ],
      "prompt": {
        "en": "what did the tang monk show the prince?",
        "zh": "唐僧向王子展示了什么？"
      },
      "payload": {
        "choices": [
          {
            "id": "a",
            "en": "a coin",
            "zh": "一枚硬币"
          },
          {
            "id": "b",
            "en": "a well",
            "zh": "一口井"
          },
          {
            "id": "c",
            "en": "a crown",
            "zh": "王冠"
          }
        ],
        "answer": "a",
        "answer_evidence": [
          {
            "node_id": "n009",
            "quote": "The Tang Monk reached into his robe."
          },
          {
            "node_id": "n013",
            "quote": "\"That coin belongs to my father! It's a royal treasure.\""
          }
        ]
      },
