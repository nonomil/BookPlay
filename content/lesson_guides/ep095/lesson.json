  "cards": [
    {
      "card_id": "ep095-official-quiz-001",
      "type": "sentence_choice",
      "stage": "episode_complete",
      "order": 1,
      "difficulty": 2,
      "grade_bands": [
        "g1_2",
        "g3_4",
        "g5_6"
      ],
      "skills": [
        "story_comprehension"
      ],
      "prompt": {
        "en": "which is true?",
        "zh": "哪一个是真的？"
      },
      "payload": {
        "choices": [
          {
            "id": "a",
            "en": "wukong went to the thunderclap monastery.",
            "zh": "悟空去了雷音寺。"
          },
          {
            "id": "b",
            "en": "buddha started a rumor about the demons.",
            "zh": "佛陀散布了关于恶魔的谣言。"
          },
          {
            "id": "c",
            "en": "the demons said they ate the tang monk.",
            "zh": "妖怪们说他们吃了唐僧。"
          }
        ],
        "answer": "c",
        "answer_evidence": [
          {
            "node_id": "n030",
            "quote": "\"They ate the Tang Monk, and now they'll live forever,\" said the first fiend."
          }
        ]
      },
      "sources": [
        {
          "kind": "official_quiz_pdf",
          "file": "G:\\Game\\BookPlay书戏\\data\\测试题\\08 英文测试题108集全.Journey to the West-quiz.pdf",
