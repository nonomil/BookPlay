      "review_status": "assistant_reviewed"
    },
    {
      "card_id": "ep095-official-quiz-003",
      "type": "sentence_choice",
      "stage": "episode_complete",
      "order": 3,
      "difficulty": 2,
      "grade_bands": [
        "g1_2",
        "g3_4",
        "g5_6"
      ],
      "skills": [
        "story_comprehension"
      ],
      "prompt": {
        "en": "why was wukong heartbroken?",
        "zh": "悟空为什么心碎？"
      },
      "payload": {
        "choices": [
          {
            "id": "a",
            "en": "he thought the tang monk was eaten.",
            "zh": "他以为唐僧被吃了。"
          },
          {
            "id": "b",
            "en": "he thought bajie was pickled.",
            "zh": "他认为八戒被腌了。"
          },
          {
            "id": "c",
            "en": "he couldn't defeat the demons.",
            "zh": "他无法打败这些恶魔。"
          }
        ],
        "answer": "a",
        "answer_evidence": [
          {
            "node_id": "n030",
            "quote": "\"They ate the Tang Monk, and now they'll live forever,\" said the first fiend."
          },
          {
            "node_id": "n035",
            "quote": "Wukong was heartbroken."
          },
          {
            "node_id": "n037",
            "quote": "\"I failed you, Master! I couldn't protect you, and now you'll never reach the Western Paradise!\""
          }
        ]
      },
      "sources": [
