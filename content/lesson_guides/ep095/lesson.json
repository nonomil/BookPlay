    {
      "card_id": "ep095-official-quiz-005",
      "type": "sentence_choice",
      "stage": "episode_complete",
      "order": 5,
      "difficulty": 2,
      "grade_bands": [
        "g1_2",
        "g3_4",
        "g5_6"
      ],
      "skills": [
        "story_comprehension"
      ],
      "prompt": {
        "en": "what did buddha do to the demons?",
        "zh": "佛陀对那些恶魔做了什么？"
      },
      "payload": {
        "choices": [
          {
            "id": "a",
            "en": "he turned them into ordinary animals.",
            "zh": "他把它们变成了普通的动物。"
          },
          {
            "id": "b",
            "en": "he fried them with garlic and spices.",
            "zh": "他用大蒜和香料把它们煎了。"
          },
          {
            "id": "c",
            "en": "he made them all disappear.",
            "zh": "他让他们都消失了。"
          }
        ],
        "answer": "a",
        "answer_evidence": [
          {
            "node_id": "n056",
            "quote": "The lion demon shouted, \"How dare you—\" Suddenly he looked up and saw an enormous figure. \"Buddha!\""
          },
          {
            "node_id": "n058",
            "quote": "Light flashed as Buddha turned the two demons into ordinary animals."
          },
          {
            "node_id": "n061",
            "quote": "But Buddha raised a finger, and the bird was paralyzed in midair."
          }
        ]
      },
