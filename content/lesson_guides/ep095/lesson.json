    {
      "card_id": "ep095-official-quiz-004",
      "type": "sentence_choice",
      "stage": "episode_complete",
      "order": 4,
      "difficulty": 2,
      "grade_bands": [
        "g1_2",
        "g3_4",
        "g5_6"
      ],
      "skills": [
        "story_comprehension"
      ],
      "prompt": {
        "en": "what did the demons want wukong to do?",
        "zh": "恶魔想让悟空做什么？"
      },
      "payload": {
        "choices": [
          {
            "id": "a",
            "en": "give up hope",
            "zh": "放弃希望"
          },
          {
            "id": "b",
            "en": "eat the tang monk",
            "zh": "吃唐僧"
          },
          {
            "id": "c",
            "en": "talk to buddha",
            "zh": "与佛交谈"
          }
        ],
        "answer": "a",
        "answer_evidence": [
          {
            "node_id": "n051",
            "quote": "\"I can see everything in the universe. I know exactly who those demons are and what they did. They tricked you into thinking they'd eaten the Tang Monk. They wanted you to give up hope.\""
          }
        ]
      },
      "sources": [
        {
          "kind": "official_quiz_pdf",
