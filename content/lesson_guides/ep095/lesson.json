          "sha256": "bcc738833439415d5b2aebde6d316c75168f0d73ae87dab5e11ba8c616056929"
        }
      ],
      "review_status": "machine_verified"
    },
    {
      "card_id": "ep095-official-quiz-002",
      "type": "sentence_choice",
      "stage": "episode_complete",
      "order": 2,
      "difficulty": 2,
      "grade_bands": [
        "g1_2",
        "g3_4",
        "g5_6"
      ],
      "skills": [
        "story_comprehension"
      ],
      "prompt": {
        "en": "what was the raptor's plan?",
        "zh": "捕食者的计划是什么？"
      },
      "payload": {
        "choices": [
          {
            "id": "a",
            "en": "tell every demon they ate the tang monk",
            "zh": "告诉每个恶魔他们吃了唐僧"
          },
          {
            "id": "b",
            "en": "fry the tang monk with garlic and spices",
            "zh": "用大蒜和香料炸唐僧"
          },
          {
            "id": "c",
            "en": "break the elephant's teeth",
            "zh": "打断大象的牙齿"
          }
        ],
        "answer": "a",
        "answer_evidence": [
          {
            "node_id": "n016",
            "quote": "\"Well, this time I have a plan,\" said the raptor."
          },
          {
            "node_id": "n017",
            "quote": "\"We'll start a rumor. We'll tell every demon nearby that we've already eaten the Tang Monk. When Wukong hears that, he'll give up hope and leave the area.\""
          }
        ]
      },
      "sources": [
        {
          "kind": "official_quiz_pdf",
          "file": "G:\\Game\\BookPlay书戏\\data\\测试题\\08 英文测试题108集全.Journey to the West-quiz.pdf",
