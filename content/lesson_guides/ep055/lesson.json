      "prompt": {
        "en": "which is true?",
        "zh": "哪一个是真的？"
      },
      "payload": {
        "choices": [
          {
            "id": "a",
            "en": "the daoists were in charge.",
            "zh": "道教徒负责。"
          },
          {
            "id": "b",
            "en": "the buddhists caused a drought.",
            "zh": "佛教徒引起了干旱。"
          },
          {
            "id": "c",
            "en": "venus saved the buddhists.",
            "zh": "金星拯救了佛教徒。"
          }
        ],
        "answer": "c",
        "answer_evidence": [
          {
            "node_id": "n058",
            "quote": "Wukong smiled. \"I've heard of Sun Wukong. And it's true that he's very powerful. Did Venus tell you what he looks like?\""
          }
        ]
      },
