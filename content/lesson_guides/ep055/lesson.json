      ],
      "prompt": {
        "en": "what were the monks doing?",
        "zh": "僧侣们在做什么？"
      },
      "payload": {
        "choices": [
          {
            "id": "a",
            "en": "pushing a cart up a hill",
            "zh": "推着手推车上山"
          },
          {
            "id": "b",
            "en": "yelling at the daoists",
            "zh": "对道士大喊"
          },
          {
            "id": "c",
            "en": "running away",
            "zh": "逃跑"
          }
        ],
        "answer": "a",
        "answer_evidence": [
          {
            "node_id": "n021",
            "quote": "He saw a group of Buddhist monks pushing a cart up a steep hill."
          },
          {
            "node_id": "n022",
            "quote": "The cart was loaded with big stones."
          },
          {
            "node_id": "n023",
            "quote": "The monks looked miserable."
          },
          {
            "node_id": "n025",
            "quote": "Two Daoist priests stood nearby."
          },
          {
            "node_id": "n027",
            "quote": "\"Work faster!\" yelled one of the priests."
          },
          {
            "node_id": "n029",
            "quote": "They struggled to move the cart faster."
          }
        ]
      },
