      "skills": [
        "story_comprehension"
      ],
      "prompt": {
        "en": "why did wukong go to investigate?",
        "zh": "悟空为什么去调查？"
      },
      "payload": {
        "choices": [
          {
            "id": "a",
            "en": "he heard yelling.",
            "zh": "他听到有人在喊叫。"
          },
          {
            "id": "b",
            "en": "he saw something.",
            "zh": "他看到了一些东西。"
          },
          {
            "id": "c",
            "en": "he smelled something.",
            "zh": "他闻到了一些东西。"
          }
        ],
        "answer": "a",
        "answer_evidence": [
          {
            "node_id": "n015",
            "quote": "Later that afternoon they heard yelling."
          },
          {
            "node_id": "n016",
            "quote": "\"It sounds like some people are in trouble,\" said the Tang Monk."
          },
          {
            "node_id": "n018",
            "quote": "\"You all wait here,\" said Wukong."
          },
          {
            "node_id": "n019",
            "quote": "\"I'll go and investigate.\""
          },
          {
            "node_id": "n020",
            "quote": "The monkey leaped into the air and looked around."
          },
          {
            "node_id": "n021",
            "quote": "He saw a group of Buddhist monks pushing a cart up a steep hill."
          }
        ]
      },
      "sources": [
