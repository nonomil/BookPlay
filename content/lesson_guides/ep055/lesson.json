    {
      "card_id": "ep055-official-quiz-005",
      "type": "sentence_choice",
      "stage": "episode_complete",
      "order": 5,
      "difficulty": 2,
      "grade_bands": [
        "g1_2",
        "g3_4",
        "g5_6"
      ],
      "skills": [
        "story_comprehension"
      ],
      "prompt": {
        "en": "who did venus say would save the monks?",
        "zh": "金星说谁会拯救那些僧侣？"
      },
      "payload": {
        "choices": [
          {
            "id": "a",
            "en": "wukong",
            "zh": "悟空"
          },
          {
            "id": "b",
            "en": "wujing",
            "zh": "五净"
          },
          {
            "id": "c",
            "en": "bajie",
            "zh": "八戒"
          }
        ],
        "answer": "a",
        "answer_evidence": [
          {
            "node_id": "n052",
            "quote": "\"The Daoists won't treat us this way forever,\" said a third monk."
          },
          {
            "node_id": "n053",
            "quote": "\"The spirit of the planet Venus visited us in a dream one night. He said that one day someone would come along to save us.\""
          },
          {
            "node_id": "n055",
            "quote": "\"Who is going to save you?\""
          },
          {
            "node_id": "n056",
            "quote": "\"A fierce monkey spirit,\" said the monk."
          },
          {
            "node_id": "n057",
            "quote": "\"His name is Sun Wukong. He is so powerful that Heaven's entire army couldn't defeat him!\""
          }
        ]
      },
