      "skills": [
        "story_comprehension"
      ],
      "prompt": {
        "en": "whom did curious ear tell the wukongs to see?",
        "zh": "好奇耳告诉悟空们去见谁？"
      },
      "payload": {
        "choices": [
          {
            "id": "a",
            "en": "buddha",
            "zh": "佛陀"
          },
          {
            "id": "b",
            "en": "guanyin",
            "zh": "观音"
          },
          {
            "id": "c",
            "en": "the judge of the dead",
            "zh": "死者的审判者"
          }
        ],
        "answer": "a",
        "answer_evidence": [
          {
            "node_id": "n014",
            "quote": "\"Buddha can help you,\" said Curious Ear."
          },
          {
            "node_id": "n016",
            "quote": "\"Of course!\" cried one Wukong. \"We'll go see Buddha!\""
          },
          {
            "node_id": "n020",
            "quote": "\"That's because you know Buddha is going to see who you really are.\""
          }
        ]
      },
