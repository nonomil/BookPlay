  "cards": [
    {
      "card_id": "ep075-official-quiz-001",
      "type": "sentence_choice",
      "stage": "episode_complete",
      "order": 1,
      "difficulty": 2,
      "grade_bands": [
        "g1_2",
        "g3_4",
        "g5_6"
      ],
      "skills": [
        "story_comprehension"
      ],
      "prompt": {
        "en": "which is not true?",
        "zh": "哪一项是不正确的？"
      },
      "payload": {
        "choices": [
          {
            "id": "a",
            "en": "guanyin found the fake wukong.",
            "zh": "观音找到了假的悟空。"
          },
          {
            "id": "b",
            "en": "wukong rejoined the tang monk.",
            "zh": "悟空重新加入了唐僧。"
          },
          {
            "id": "c",
            "en": "the two wukongs battled across the sky.",
            "zh": "两个悟空在天空中战斗。"
          }
        ],
        "answer": "a",
        "answer_evidence": [
          {
            "node_id": "n026",
            "quote": "Clouds swirled and thunder boomed as the two mighty spirits battled across the sky."
          },
          {
            "node_id": "n051",
            "quote": "\"And I know that <font color=\"#ffff00\"><i>you</i></font> are a fake.\""
          },
          {
            "node_id": "n054",
            "quote": "\"I've trapped the fake Wukong under this bowl,\" said Buddha."
          },
          {
            "node_id": "n062",
            "quote": "Guanyin decided it was time for Wukong to rejoin his companions on the journey."
          },
          {
            "node_id": "n063",
            "quote": "She and the monkey found the Tang Monk and the others along the road to the west."
          },
          {
            "node_id": "n065",
            "quote": "\"You must keep Wukong with you,\" explained Guanyin."
          }
        ]
      },
      "sources": [
        {
          "kind": "official_quiz_pdf",
          "file": "G:\\Game\\BookPlay书戏\\data\\测试题\\08 英文测试题108集全.Journey to the West-quiz.pdf",
