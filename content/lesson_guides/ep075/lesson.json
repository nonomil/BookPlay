      "prompt": {
        "en": "why did the monkey spirit want to become wukong?",
        "zh": "为什么猴子精想要变成悟空？"
      },
      "payload": {
        "choices": [
          {
            "id": "a",
            "en": "wukong was powerful.",
            "zh": "悟空很强大。"
          },
          {
            "id": "b",
            "en": "wukong had many friends.",
            "zh": "悟空有很多朋友。"
          },
          {
            "id": "c",
            "en": "wukong knew the tang monk.",
            "zh": "悟空认识唐僧。"
          }
        ],
        "answer": "a",
        "answer_evidence": [
          {
            "node_id": "n055",
            "quote": "When Buddha lifted the bowl, a tiny monkey spirit lay on the table."
          },
          {
            "node_id": "n057",
            "quote": "\"He was a monkey who became an evil spirit,\" said Buddha."
          },
          {
            "node_id": "n058",
            "quote": "\"He wanted to be you because you're so powerful.\""
          }
        ]
      },
