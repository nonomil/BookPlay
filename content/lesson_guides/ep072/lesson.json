  "cards": [
    {
      "card_id": "ep072-official-quiz-001",
      "type": "sentence_choice",
      "stage": "episode_complete",
      "order": 1,
      "difficulty": 2,
      "grade_bands": [
        "g1_2",
        "g3_4",
        "g5_6"
      ],
      "skills": [
        "story_comprehension"
      ],
      "prompt": {
        "en": "which did not happen at the fruit and flower mountain?",
        "zh": "在花果山没有发生什么？"
      },
      "payload": {
        "choices": [
          {
            "id": "a",
            "en": "wukong attacked the tang monk.",
            "zh": "悟空攻击了唐僧。"
          },
          {
            "id": "b",
            "en": "wukong said he didn't know wujing.",
            "zh": "悟空说他不认识悟净。"
          },
          {
            "id": "c",
            "en": "wujing saw wukong, bajie, and the tang monk.",
            "zh": "悟净看见了悟空、八戒和唐僧。"
          }
        ],
        "answer": "a",
        "answer_evidence": [
          {
            "node_id": "n028",
            "quote": "The monk sat down in the grass next to the road and closed his eyes."
          },
          {
            "node_id": "n038",
            "quote": "Before the monk could recite the spell, Wukong struck. <font color=\"#ffff00\"><i>Whap!</i></font> He knocked out the monk."
          },
          {
            "node_id": "n049",
            "quote": "\"We can't let him get away with this! He probably went home, to the Fruit and Flower Mountain.\""
          },
          {
            "node_id": "n052",
            "quote": "When Wujing arrived there, he found Wukong near the waterfall."
          },
          {
            "node_id": "n064",
            "quote": "A monk who looked exactly like the Tang Monk sat on a horse."
          }
        ]
      },
      "sources": [
        {
          "kind": "official_quiz_pdf",
          "file": "G:\\Game\\BookPlay书戏\\data\\测试题\\08 英文测试题108集全.Journey to the West-quiz.pdf",
