      "prompt": {
        "en": "what did guanyin tell wukong to do?",
        "zh": "观音告诉悟空做什么？"
      },
      "payload": {
        "choices": [
          {
            "id": "a",
            "en": "stay with her at mount potalaka for a while",
            "zh": "在普陀洛迦山与她待一会儿"
          },
          {
            "id": "b",
            "en": "beg forgiveness from the tang monk",
            "zh": "向唐僧求饶"
          },
          {
            "id": "c",
            "en": "go to the fruit and flower mountain",
            "zh": "去花果山"
          }
        ],
        "answer": "a",
        "answer_evidence": [
          {
            "node_id": "n017",
            "quote": "\"Don't cry, Wukong,\" said Guanyin."
          },
          {
            "node_id": "n018",
            "quote": "\"You will still help the Tang Monk reach the Western Paradise. He will need your help soon. In the meantime you may stay here with me.\""
          }
        ]
      },
      "sources": [
