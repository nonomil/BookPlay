            "id": "b",
            "en": "a large dragon",
            "zh": "一条大龙"
          },
          {
            "id": "c",
            "en": "a bodhisattva",
            "zh": "菩萨"
          }
        ],
        "answer": "a",
        "answer_evidence": [
          {
            "node_id": "n026",
            "quote": "\"Some people believe there's a monster in the mountains nearby,\" said the other priest."
          },
          {
            "node_id": "n027",
            "quote": "\"They say it's a black bear spirit.\""
          }
        ]
      },
