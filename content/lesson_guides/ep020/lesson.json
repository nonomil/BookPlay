  "cards": [
    {
      "card_id": "ep020-official-quiz-001",
      "type": "sentence_choice",
      "stage": "episode_complete",
      "order": 1,
      "difficulty": 2,
      "grade_bands": [
        "g1_2",
        "g3_4",
        "g5_6"
      ],
      "skills": [
        "story_comprehension"
      ],
      "prompt": {
        "en": "which is not true?",
        "zh": "哪一项是不正确的？"
      },
      "payload": {
        "choices": [
          {
            "id": "a",
            "en": "the tang monk hurt the priests.",
            "zh": "唐僧伤害了那些和尚。"
          },
          {
            "id": "b",
            "en": "wukong wanted to find the robe.",
            "zh": "悟空想找到那件长袍。"
          },
          {
            "id": "c",
            "en": "the head priest didn't have the robe.",
            "zh": "大祭司没有长袍。"
          }
        ],
        "answer": "a",
        "answer_evidence": [
          {
            "node_id": "n013",
            "quote": "The Tang Monk was quietly reciting the Tight Headband spell."
          },
          {
            "node_id": "n017",
            "quote": "\"I'm begging you! I won't hurt the priests!\""
          },
          {
            "node_id": "n023",
            "quote": "\"The head priest ran away last night. He didn't have it with him.\""
          },
          {
            "node_id": "n028",
            "quote": "\"I'll go see if the bear took the robe,\" said Wukong."
          }
        ]
      },
      "sources": [
        {
          "kind": "official_quiz_pdf",
