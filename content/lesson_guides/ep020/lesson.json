        ],
        "answer": "a",
        "answer_evidence": [
          {
            "node_id": "n034",
            "quote": "The bear laughed. \"The monastery was on fire last night. I went down to check it out and found a wonderful Buddhist robe. I think it's a Buddhist treasure. Anyway, I stole it. So tonight I'm throwing a feast to celebrate!\""
          },
          {
            "node_id": "n049",
            "quote": "\"You stole my master's robe!\" said Wukong."
          }
        ]
      },
