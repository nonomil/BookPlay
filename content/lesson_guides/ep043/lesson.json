    {
      "card_id": "ep043-official-quiz-001",
      "type": "sentence_choice",
      "stage": "episode_complete",
      "order": 1,
      "difficulty": 2,
      "grade_bands": [
        "g1_2",
        "g3_4",
        "g5_6"
      ],
      "skills": [
        "story_comprehension"
      ],
      "prompt": {
        "en": "which is not true?",
        "zh": "哪一项是不正确的？"
      },
      "payload": {
        "choices": [
          {
            "id": "a",
            "en": "buddha visited the travelers.",
            "zh": "佛陀拜访了旅行者。"
          },
          {
            "id": "b",
            "en": "the gourd wouldn't harm golden horn.",
            "zh": "葫芦不会伤害金角。"
          },
          {
            "id": "c",
            "en": "the old man was really laozi.",
            "zh": "那个老人真的是老子。"
          }
        ],
        "answer": "a",
        "answer_evidence": [
          {
            "node_id": "n051",
            "quote": "Then Laozi the sage stood before the travelers."
          },
          {
            "node_id": "n057",
            "quote": "\"Golden Horn works for me,\" said Laozi."
          },
          {
            "node_id": "n062",
            "quote": "\"The gourd won't harm him. Good-bye.\""
          }
        ]
      },
      "sources": [
        {
          "kind": "official_quiz_pdf",
