      ],
      "prompt": {
        "en": "what happened to golden horn?",
        "zh": "金角发生了什么事？"
      },
      "payload": {
        "choices": [
          {
            "id": "a",
            "en": "he was sucked into the gourd.",
            "zh": "他被吸进了葫芦里。"
          },
          {
            "id": "b",
            "en": "he ran out of the cave.",
            "zh": "他跑出了洞穴。"
          },
          {
            "id": "c",
            "en": "he went to a monastery.",
            "zh": "他去了一个修道院。"
          }
        ],
        "answer": "a",
        "answer_evidence": [
          {
            "node_id": "n020",
            "quote": "\"Let me try mine,\" said Wukong. \"Golden Horn!\""
          },
          {
            "node_id": "n021",
            "quote": "<font color=\"#ffff00\"><i>Shloomp!</i></font> Instantly the demon was sucked into the gourd."
          }
        ]
      },
