      "prompt": {
        "en": "what did laozi send golden horn to do?",
        "zh": "老子派金角去做什么？"
      },
      "payload": {
        "choices": [
          {
            "id": "a",
            "en": "cause trouble",
            "zh": "惹麻烦"
          },
          {
            "id": "b",
            "en": "travel with wukong",
            "zh": "与悟空旅行"
          },
          {
            "id": "c",
            "en": "guard the tang monk",
            "zh": "保护唐僧"
          }
        ],
        "answer": "a",
        "answer_evidence": [
          {
            "node_id": "n057",
            "quote": "\"Golden Horn works for me,\" said Laozi."
          },
          {
            "node_id": "n058",
            "quote": "\"I sent him here to cause trouble for you. Buddha wanted to make sure you are all serious about reaching the Western Paradise. You fought well, Wukong.\""
          }
        ]
      },
