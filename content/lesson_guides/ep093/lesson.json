      "skills": [
        "story_comprehension"
      ],
      "prompt": {
        "en": "which is most important from the story?",
        "zh": "故事中什么最重要？"
      },
      "payload": {
        "choices": [
          {
            "id": "a",
            "en": "wukong came out of the lion.",
            "zh": "悟空从狮子里出来了。"
          },
          {
            "id": "b",
            "en": "the lion's tooth shattered into pieces.",
            "zh": "狮子的牙齿碎成了碎片。"
          },
          {
            "id": "c",
            "en": "the demons whispered to each other.",
            "zh": "恶魔们相互低声耳语。"
          }
        ],
        "answer": "a",
        "answer_evidence": [
          {
            "node_id": "n071",
            "quote": "\"I'm coming out now. You'd better not try any more tricks!\""
          },
          {
            "node_id": "n074",
            "quote": "Wukong popped out of the lion's nose."
          }
        ]
      },
      "sources": [
