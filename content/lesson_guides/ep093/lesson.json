      "skills": [
        "story_comprehension"
      ],
      "prompt": {
        "en": "which did wukong not say he would do?",
        "zh": "悟空没有说他会做哪件事？"
      },
      "payload": {
        "choices": [
          {
            "id": "a",
            "en": "bite the lion",
            "zh": "咬狮子"
          },
          {
            "id": "b",
            "en": "cook a meal",
            "zh": "做饭"
          },
          {
            "id": "c",
            "en": "tell a story",
            "zh": "讲一个故事"
          }
        ],
        "answer": "a",
        "answer_evidence": [
          {
            "node_id": "n010",
            "quote": "\"What shall I talk about?\" Wukong called."
          },
          {
            "node_id": "n011",
            "quote": "\"Who wants to hear a story?\""
          },
          {
            "node_id": "n021",
            "quote": "Wukong laughed."
          },
          {
            "node_id": "n022",
            "quote": "\"Nice try, lion! But I'll just turn one of my hairs into a stove. I'll cook a nice meal in here!\""
          }
        ]
      },
