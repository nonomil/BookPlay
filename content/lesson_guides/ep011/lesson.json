      "prompt": {
        "en": "why couldn't wukong be harmed?",
        "zh": "为什么悟空无法受伤？"
      },
      "payload": {
        "choices": [
          {
            "id": "a",
            "en": "he ate all the peaches.",
            "zh": "他吃光了所有的桃子。"
          },
          {
            "id": "b",
            "en": "buddha protected him.",
            "zh": "佛保护了他。"
          },
          {
            "id": "c",
            "en": "erlang gave him powers.",
            "zh": "尔郎给了他能力。"
          }
        ],
        "answer": "a",
        "answer_evidence": [
          {
            "node_id": "n021",
            "quote": "\"That's because he ate all the peaches,\" said Laozi."
          },
          {
            "node_id": "n022",
            "quote": "\"Just one peach would make someone live forever. He ate every peach in the garden!\""
          }
        ]
      },
