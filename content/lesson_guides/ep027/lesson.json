    {
      "card_id": "ep027-official-quiz-003",
      "type": "sentence_choice",
      "stage": "episode_complete",
      "order": 3,
      "difficulty": 2,
      "grade_bands": [
        "g1_2",
        "g3_4",
        "g5_6"
      ],
      "skills": [
        "story_comprehension"
      ],
      "prompt": {
        "en": "where was the great immortal visiting?",
        "zh": "大圣人正在拜访哪里？"
      },
      "payload": {
        "choices": [
          {
            "id": "a",
            "en": "heaven",
            "zh": "天堂"
          },
          {
            "id": "b",
            "en": "mount potalaka",
            "zh": "波陀罗迦山"
          },
          {
            "id": "c",
            "en": "the western paradise",
            "zh": "西方极乐世界"
          }
        ],
        "answer": "a",
        "answer_evidence": [
          {
            "node_id": "n031",
            "quote": "\"Our master is visiting friends in Heaven right now. If he wasn't powerful, he wouldn't be able to do that.\""
          },
          {
            "node_id": "n032",
            "quote": "Wukong shrugged. \"I used to live in Heaven. The place isn't that great.\""
          }
        ]
      },
      "sources": [
