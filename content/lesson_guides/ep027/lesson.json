      ],
      "prompt": {
        "en": "what did the two priests decide to do with the fruit?",
        "zh": "那两位牧师决定如何处理这些水果？"
      },
      "payload": {
        "choices": [
          {
            "id": "a",
            "en": "share it",
            "zh": "分享它"
          },
          {
            "id": "b",
            "en": "throw it away",
            "zh": "把它扔掉"
          },
          {
            "id": "c",
            "en": "give it to bajie",
            "zh": "把它给八戒"
          }
        ],
        "answer": "a",
        "answer_evidence": [
          {
            "node_id": "n058",
            "quote": "The priests took the ginseng fruit out of the room and into a hallway."
          },
          {
            "node_id": "n059",
            "quote": "\"We shouldn't waste this fruit,\" said one priest."
          },
          {
            "node_id": "n060",
            "quote": "\"No,\" said the other."
          },
          {
            "node_id": "n061",
            "quote": "\"It is too delicious and valuable. Let's eat it ourselves.\""
          },
          {
            "node_id": "n062",
            "quote": "The two priests shared the ginseng fruit."
          }
        ]
      },
