        "story_comprehension"
      ],
      "prompt": {
        "en": "where do the travelers stop for the night?",
        "zh": "旅行者们晚上在哪里停宿？"
      },
      "payload": {
        "choices": [
          {
            "id": "a",
            "en": "a daoist abbey",
            "zh": "道观"
          },
          {
            "id": "b",
            "en": "a buddhist monastery",
            "zh": "一座佛教寺院"
          },
          {
            "id": "c",
            "en": "a catholic church",
            "zh": "一座天主教教堂"
          }
        ],
        "answer": "a",
        "answer_evidence": [
          {
            "node_id": "n022",
            "quote": "\"He said you would travel past our abbey someday. Please, come in.\""
          }
        ]
      },
      "sources": [
