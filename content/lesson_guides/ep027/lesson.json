  "cards": [
    {
      "card_id": "ep027-official-quiz-001",
      "type": "sentence_choice",
      "stage": "episode_complete",
      "order": 1,
      "difficulty": 2,
      "grade_bands": [
        "g1_2",
        "g3_4",
        "g5_6"
      ],
      "skills": [
        "story_comprehension"
      ],
      "prompt": {
        "en": "which is not true?",
        "zh": "哪一项是不正确的？"
      },
      "payload": {
        "choices": [
          {
            "id": "a",
            "en": "the priests offered a peach to the tang monk.",
            "zh": "僧人向唐僧献上了一只桃子。"
          },
          {
            "id": "b",
            "en": "bajie wanted to eat the ginseng fruit.",
            "zh": "八戒想吃人参果。"
          },
          {
            "id": "c",
            "en": "wukong scared off the wild animals.",
            "zh": "悟空吓跑了野生动物。"
          }
        ],
        "answer": "a",
        "answer_evidence": [
          {
            "node_id": "n005",
            "quote": "He swung his iron bar, and the animals ran back into the forest."
          },
          {
            "node_id": "n042",
            "quote": "\"There's a ginseng tree behind the abbey,\" said one priest."
          },
          {
            "node_id": "n043",
            "quote": "\"Its fruit takes ten thousand years to become ripe. According to legend, one bite of the fruit will make you live forever. Would you like one?\""
          },
          {
            "node_id": "n046",
            "quote": "\"Our master said we could give you one,\" said the other priest."
          },
          {
            "node_id": "n066",
            "quote": "\"That fruit sounds wonderful,\" said Bajie to himself."
          },
          {
            "node_id": "n067",
            "quote": "\"I want some too!\""
          }
        ]
      },
      "sources": [
        {
          "kind": "official_quiz_pdf",
          "file": "G:\\Game\\BookPlay书戏\\data\\测试题\\08 英文测试题108集全.Journey to the West-quiz.pdf",
