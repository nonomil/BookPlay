      ],
      "prompt": {
        "en": "why did the tang monk scream?",
        "zh": "唐僧为什么尖叫？"
      },
      "payload": {
        "choices": [
          {
            "id": "a",
            "en": "there was a baby on the tray.",
            "zh": "托盘上有一个婴儿。"
          },
          {
            "id": "b",
            "en": "there was a peach on the tray.",
            "zh": "托盘上有一个桃子。"
          },
          {
            "id": "c",
            "en": "there was an insect in the fruit.",
            "zh": "水果里有一只昆虫。"
          }
        ],
        "answer": "a",
        "answer_evidence": [
          {
            "node_id": "n049",
            "quote": "A moment later they came back in with a tray."
          },
          {
            "node_id": "n050",
            "quote": "The Tang Monk screamed."
          },
          {
            "node_id": "n051",
            "quote": "On the tray lay a tiny sleeping baby."
          },
          {
            "node_id": "n052",
            "quote": "\"I can't eat that,\" cried the monk. \"It—it's a baby!\""
          }
        ]
      },
      "sources": [
