{
  "episode": 1,
  "source": "assets/video/ep1.mp4",
  "vad_filter": false,
  "duration": 336.294625,
  "segments": [
    {
      "i": 1,
      "start": 21.82,
      "end": 26.38,
      "text": "From the beginning of time, a rock had sat high on top of a mountain."
    },
    {
      "i": 2,
      "start": 27.34,
      "end": 31.82,
      "text": "The sun, the moon, heaven and earth all worked their magic on the rock."
    },
    {
      "i": 3,
      "start": 33.3,
      "end": 35.42,
      "text": "One day the rock split open."
    },
    {
      "i": 4,
      "start": 38.12,
      "end": 39.82,
      "text": "Inside was a monkey."
    },
    {
      "i": 5,
      "start": 43.22,
      "end": 45.26,
      "text": "The monkey stood up and stretched."
    },
    {
      "i": 6,
      "start": 49.58,
      "end": 52.52,
      "text": "Suddenly powerful light shot from his eyes."
    },
    {
      "i": 7,
      "start": 56.58,
      "end": 59.88,
      "text": "For a moment the light reached the cloud palace in heaven."
    },
    {
      "i": 8,
      "start": 61.52,
      "end": 64.42,
      "text": "The jade emperor, ruler of heaven sat up."
    },
    {
      "i": 9,
      "start": 65.4,
      "end": 68.26,
      "text": "He turned to one of his captains who was standing nearby."
    },
    {
      "i": 10,
      "start": 69.78,
      "end": 71.5,
      "text": "Find out what caused that light."
    },
    {
      "i": 11,
      "start": 71.92,
      "end": 72.56,
      "text": "Said the emperor."
    },
    {
      "i": 12,
      "start": 73.5,
      "end": 74.18,
      "text": "Yes your majesty."
    },
    {
      "i": 13,
      "start": 74.62,
      "end": 75.36,
      "text": "Said the captain."
    },
    {
      "i": 14,
      "start": 77.34,
      "end": 79.34,
      "text": "The captain rushed out of the hall."
    },
    {
      "i": 15,
      "start": 81.22,
      "end": 85.2,
      "text": "He looked out the southern gate of heaven and saw the monkey on earth below."
    },
    {
      "i": 16,
      "start": 86.38,
      "end": 90.36,
      "text": "The light was gone, but the captain had a magical sight."
    },
    {
      "i": 17,
      "start": 91.0,
      "end": 93.52,
      "text": "He could see everything that had just happened."
    },
    {
      "i": 18,
      "start": 95.12,
      "end": 95.58,
      "text": "Interesting."
    },
    {
      "i": 19,
      "start": 96.22,
      "end": 96.74,
      "text": "Said the captain."
    },
    {
      "i": 20,
      "start": 99.26,
      "end": 99.9,
      "text": "Well."
    },
    {
      "i": 21,
      "start": 100.44,
      "end": 102.64,
      "text": "Said the jade emperor when the captain returned."
    },
    {
      "i": 22,
      "start": 103.62,
      "end": 104.58,
      "text": "What caused the light?"
    },
    {
      "i": 23,
      "start": 106.04,
      "end": 107.0,
      "text": "It was a monkey."
    },
    {
      "i": 24,
      "start": 107.46,
      "end": 107.98,
      "text": "Said the captain."
    },
    {
      "i": 25,
      "start": 109.0,
      "end": 109.78,
      "text": "A monkey."
    },
    {
      "i": 26,
      "start": 110.26,
      "end": 111.2,
      "text": "Asked the jade emperor."
    },
    {
      "i": 27,
      "start": 112.16,
      "end": 112.58,
      "text": "Yes."
    },
    {
      "i": 28,
      "start": 112.88,
      "end": 113.54,
      "text": "Said the captain."
    },
    {
      "i": 29,
      "start": 114.18,
      "end": 116.7,
      "text": "He's on the fruit and flower mountain down on earth."
    },
    {
      "i": 30,
      "start": 117.4,
      "end": 119.3,
      "text": "There had been a rock on the mountain."
    },
    {
      "i": 31,
      "start": 120.64,
      "end": 122.6,
      "text": "The monkey came from the rock."
    },
    {
      "i": 32,
      "start": 123.26,
      "end": 125.1,
      "text": "The light shone from the monkey's eyes."
    },
    {
      "i": 33,
      "start": 127.8,
      "end": 130.84,
      "text": "The emperor thought for a moment and then shrugged."
    },
    {
      "i": 34,
      "start": 132.06,
      "end": 133.36,
      "text": "I'm not surprised."
    },
    {
      "i": 35,
      "start": 133.92,
      "end": 134.34,
      "text": "He said."
    },
    {
      "i": 36,
      "start": 135.48,
      "end": 138.48,
      "text": "Amazing things happen when heaven and earth work together."
    },
    {
      "i": 37,
      "start": 151.6,
      "end": 156.36,
      "text": "As time passed monkey learned to walk run and climb."
    },
    {
      "i": 38,
      "start": 159.7,
      "end": 162.48,
      "text": "He drank from streams and ate grasses and leaves."
    },
    {
      "i": 39,
      "start": 165.3,
      "end": 168.54,
      "text": "He gathered fruit and explored caves and mountaintops."
    },
    {
      "i": 40,
      "start": 173.54,
      "end": 176.38,
      "text": "He became friends with all the other monkeys and apes."
    },
    {
      "i": 41,
      "start": 177.68,
      "end": 180.38,
      "text": "At night he slept under a cliff."
    },
    {
      "i": 42,
      "start": 181.96,
      "end": 183.42,
      "text": "One very hot morning."
    },
    {
      "i": 43,
      "start": 184.06,
      "end": 186.48,
      "text": "All the monkeys and apes were playing in the shade."
    },
    {
      "i": 44,
      "start": 187.72,
      "end": 190.04,
      "text": "It is so hot today."
    },
    {
      "i": 45,
      "start": 190.46,
      "end": 191.44,
      "text": "Cried one monkey."
    },
    {
      "i": 46,
      "start": 192.88,
      "end": 194.48,
      "text": "Let's play in the stream."
    },
    {
      "i": 47,
      "start": 195.52,
      "end": 196.2,
      "text": "Good idea."
    },
    {
      "i": 48,
      "start": 196.62,
      "end": 197.5,
      "text": "Said another monkey."
    },
    {
      "i": 49,
      "start": 198.34,
      "end": 200.28,
      "text": "The monkeys and apes ran to the stream."
    },
    {
      "i": 50,
      "start": 201.16,
      "end": 203.54,
      "text": "The water rolled and bounced over the rocks."
    },
    {
      "i": 51,
      "start": 205.4,
      "end": 207.88,
      "text": "The monkeys jumped into the cool water."
    },
    {
      "i": 52,
      "start": 210.04,
      "end": 211.76,
      "text": "Everyone splashed and played."
    },
    {
      "i": 53,
      "start": 212.68,
      "end": 215.88,
      "text": "After a few minutes one monkey scratched her head."
    },
    {
      "i": 54,
      "start": 216.56,
      "end": 218.5,
      "text": "We all love this stream."
    },
    {
      "i": 55,
      "start": 218.9,
      "end": 219.46,
      "text": "She said."
    },
    {
      "i": 56,
      "start": 220.36,
      "end": 221.72,
      "text": "We drink from it."
    },
    {
      "i": 57,
      "start": 222.18,
      "end": 222.92,
      "text": "We swim in it."
    },
    {
      "i": 58,
      "start": 223.44,
      "end": 225.88,
      "text": "We know that it flows all the way to the ocean."
    },
    {
      "i": 59,
      "start": 226.86,
      "end": 229.6,
      "text": "But does anyone know where the stream begins?"
    },
    {
      "i": 60,
      "start": 230.44,
      "end": 233.28,
      "text": "They all looked at one another and shook their heads."
    },
    {
      "i": 61,
      "start": 234.92,
      "end": 237.24,
      "text": "We have nothing to do today."
    },
    {
      "i": 62,
      "start": 237.62,
      "end": 238.62,
      "text": "The monkey continued."
    },
    {
      "i": 63,
      "start": 239.52,
      "end": 242.28,
      "text": "Why don't we follow the stream to find its source?"
    },
    {
      "i": 64,
      "start": 243.26,
      "end": 244.76,
      "text": "That sounds like fun."
    },
    {
      "i": 65,
      "start": 245.16,
      "end": 245.98,
      "text": "Said another monkey."
    },
    {
      "i": 66,
      "start": 247.0,
      "end": 247.64,
      "text": "Let's go."
    },
    {
      "i": 67,
      "start": 248.0,
      "end": 249.04,
      "text": "Said a third monkey."
    },
    {
      "i": 68,
      "start": 249.92,
      "end": 251.54,
      "text": "Everyone jumped out of the water."
    },
    {
      "i": 69,
      "start": 252.24,
      "end": 256.04,
      "text": "They ran alongside the stream and swung from tree to tree."
    },
    {
      "i": 70,
      "start": 256.76,
      "end": 259.96,
      "text": "They jumped over rocks and climbed up steep cliffs."
    },
    {
      "i": 71,
      "start": 260.94,
      "end": 266.02,
      "text": "Higher and higher they went up the mountain until they reached an enormous waterfall."
    },
    {
      "i": 72,
      "start": 266.62,
      "end": 268.26,
      "text": "Mist filled the air."
    },
    {
      "i": 73,
      "start": 269.06,
      "end": 271.6,
      "text": "The water crashed down roaring like thunder."
    },
    {
      "i": 74,
      "start": 274.52,
      "end": 276.62,
      "text": "I wonder what's behind that waterfall."
    },
    {
      "i": 75,
      "start": 277.16,
      "end": 277.98,
      "text": "Said one monkey."
    },
    {
      "i": 76,
      "start": 279.0,
      "end": 279.68,
      "text": "Me too."
    },
    {
      "i": 77,
      "start": 280.08,
      "end": 281.06,
      "text": "Said a second monkey."
    },
    {
      "i": 78,
      "start": 281.92,
      "end": 283.64,
      "text": "But nobody could jump through it."
    },
    {
      "i": 79,
      "start": 284.72,
      "end": 287.96,
      "text": "Whoever can jump through and come back alive will be our king."
    },
    {
      "i": 80,
      "start": 288.28,
      "end": 288.84,
      "text": "Said a given."
    },
    {
      "i": 81,
      "start": 289.8,
      "end": 291.4,
      "text": "Is anyone brave enough to try?"
    },
    {
      "i": 82,
      "start": 292.64,
      "end": 294.6,
      "text": "All the monkeys and apes looked at one another."
    },
    {
      "i": 83,
      "start": 295.22,
      "end": 296.62,
      "text": "They shook their heads."
    },
    {
      "i": 84,
      "start": 299.04,
      "end": 300.9,
      "text": "I'm not going to try."
    },
    {
      "i": 85,
      "start": 301.4,
      "end": 302.46,
      "text": "Said a tall monkey."
    },
    {
      "i": 86,
      "start": 304.46,
      "end": 305.58,
      "text": "Me neither."
    },
    {
      "i": 87,
      "start": 305.86,
      "end": 306.88,
      "text": "Said a short monkey."
    },
    {
      "i": 88,
      "start": 307.62,
      "end": 308.96,
      "text": "A voice called out."
    },
    {
      "i": 89,
      "start": 309.44,
      "end": 310.02,
      "text": "I'll do it."
    },
    {
      "i": 90,
      "start": 310.94,
      "end": 314.34,
      "text": "Everyone moved out of the way as the speaker stepped forward."
    },
    {
      "i": 91,
      "start": 315.24,
      "end": 316.46,
      "text": "It was monkey."
    },
    {
      "i": 92,
      "start": 317.48,
      "end": 318.48,
      "text": "Are you sure?"
    },
    {
      "i": 93,
      "start": 318.84,
      "end": 319.4,
      "text": "Asked the given."
    },
    {
      "i": 94,
      "start": 319.82,
      "end": 320.92,
      "text": "It looks dangerous."
    },
    {
      "i": 95,
      "start": 321.86,
      "end": 322.9,
      "text": "Monkey laughed."
    },
    {
      "i": 96,
      "start": 323.8,
      "end": 325.14,
      "text": "I'm not afraid of anything."
    },
    {
      "i": 97,
      "start": 325.92,
      "end": 327.9,
      "text": "And when I come back I will be king."
    },
    {
      "i": 98,
      "start": 328.74,
      "end": 332.22,
      "text": "Monkey took a deep breath and leaped into the waterfall."
    }
  ]
}