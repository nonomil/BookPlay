{
  "episode": 70,
  "source": "assets/video/ep70.mp4",
  "model": "base",
  "duration": 298.3764375,
  "segments": [
    {
      "i": 1,
      "start": 0.0,
      "end": 13.2,
      "text": "Journey to the West, Chapter 70, The Star Lord."
    },
    {
      "i": 2,
      "start": 13.2,
      "end": 15.52,
      "text": "You cannot go back to that cave."
    },
    {
      "i": 3,
      "start": 15.52,
      "end": 17.32,
      "text": "Said Guanyin."
    },
    {
      "i": 4,
      "start": 17.32,
      "end": 18.8,
      "text": "But we must go back."
    },
    {
      "i": 5,
      "start": 18.8,
      "end": 23.32,
      "text": "Said Wu Kong, that woman kidnapped the Tang monk."
    },
    {
      "i": 6,
      "start": 23.32,
      "end": 25.08,
      "text": "Guanyin shook her head."
    },
    {
      "i": 7,
      "start": 25.08,
      "end": 27.68,
      "text": "That woman is a scorpion spirit."
    },
    {
      "i": 8,
      "start": 27.68,
      "end": 30.48,
      "text": "She is very dangerous."
    },
    {
      "i": 9,
      "start": 30.48,
      "end": 31.8,
      "text": "She sure is."
    },
    {
      "i": 10,
      "start": 31.8,
      "end": 33.2,
      "text": "Cryed Bajie."
    },
    {
      "i": 11,
      "start": 33.2,
      "end": 36.16,
      "text": "What did she stab us with anyway?"
    },
    {
      "i": 12,
      "start": 36.16,
      "end": 38.2,
      "text": "It was her stinger that stabbed you."
    },
    {
      "i": 13,
      "start": 38.2,
      "end": 40.2,
      "text": "Said Guanyin."
    },
    {
      "i": 14,
      "start": 40.2,
      "end": 41.68,
      "text": "Wu Kong shuttered."
    },
    {
      "i": 15,
      "start": 41.68,
      "end": 44.2,
      "text": "Thinking about the pain he felt."
    },
    {
      "i": 16,
      "start": 44.2,
      "end": 45.8,
      "text": "I won't go near her."
    },
    {
      "i": 17,
      "start": 45.8,
      "end": 47.56,
      "text": "Said Guanyin."
    },
    {
      "i": 18,
      "start": 47.56,
      "end": 51.32,
      "text": "Even Buddha is afraid of her."
    },
    {
      "i": 19,
      "start": 51.32,
      "end": 56.64,
      "text": "He was teaching his students one day and saw that scorpion creeping toward him."
    },
    {
      "i": 20,
      "start": 56.64,
      "end": 60.32,
      "text": "He tried to move it away, but it stunned him."
    },
    {
      "i": 21,
      "start": 60.32,
      "end": 62.88,
      "text": "The pain was horrible."
    },
    {
      "i": 22,
      "start": 62.88,
      "end": 66.4,
      "text": "He told his guards to capture the scorpion."
    },
    {
      "i": 23,
      "start": 66.4,
      "end": 70.44,
      "text": "But it escaped to Earth."
    },
    {
      "i": 24,
      "start": 70.44,
      "end": 73.08,
      "text": "Wu Kong started pacing."
    },
    {
      "i": 25,
      "start": 73.08,
      "end": 75.56,
      "text": "What are we going to do then?"
    },
    {
      "i": 26,
      "start": 75.56,
      "end": 78.24,
      "text": "We must save the Tang monk."
    },
    {
      "i": 27,
      "start": 78.24,
      "end": 81.56,
      "text": "Go to heaven and ask the Star Lord for help."
    },
    {
      "i": 28,
      "start": 81.56,
      "end": 83.08,
      "text": "Said Guanyin."
    },
    {
      "i": 29,
      "start": 83.08,
      "end": 87.08,
      "text": "The Bodhisattva then disappeared in a flash of light."
    },
    {
      "i": 30,
      "start": 87.08,
      "end": 95.28,
      "text": "A little while later, Wu Kong stood at the southern gate of heaven."
    },
    {
      "i": 31,
      "start": 95.28,
      "end": 96.28,
      "text": "Greetings, Wu Kong."
    },
    {
      "i": 32,
      "start": 96.28,
      "end": 97.8,
      "text": "Said the guard."
    },
    {
      "i": 33,
      "start": 97.8,
      "end": 100.12,
      "text": "I must speak with the Star Lord."
    },
    {
      "i": 34,
      "start": 100.12,
      "end": 101.64,
      "text": "Said the monkey."
    },
    {
      "i": 35,
      "start": 101.64,
      "end": 107.36,
      "text": "The guard told Wu Kong the way to the Star Lord's palace."
    },
    {
      "i": 36,
      "start": 107.36,
      "end": 111.92,
      "text": "A few minutes later, the monkey knocked on the palace door."
    },
    {
      "i": 37,
      "start": 111.92,
      "end": 114.92,
      "text": "Wu Kong."
    },
    {
      "i": 38,
      "start": 114.92,
      "end": 116.68,
      "text": "Said the Star Lord."
    },
    {
      "i": 39,
      "start": 116.68,
      "end": 118.88,
      "text": "What can I do for you?"
    },
    {
      "i": 40,
      "start": 118.88,
      "end": 120.4,
      "text": "I need your help."
    },
    {
      "i": 41,
      "start": 120.4,
      "end": 121.92,
      "text": "Said Wu Kong."
    },
    {
      "i": 42,
      "start": 121.92,
      "end": 125.4,
      "text": "I'm traveling to the Western Paradise with the Tang monk."
    },
    {
      "i": 43,
      "start": 125.4,
      "end": 127.4,
      "text": "But he was captured by a demon."
    },
    {
      "i": 44,
      "start": 127.4,
      "end": 130.48,
      "text": "Guanyin said you can help me."
    },
    {
      "i": 45,
      "start": 130.48,
      "end": 133.48,
      "text": "The Star Lord looked confused."
    },
    {
      "i": 46,
      "start": 133.48,
      "end": 135.4,
      "text": "I don't know why you need my help."
    },
    {
      "i": 47,
      "start": 135.4,
      "end": 137.72,
      "text": "I've heard you're quite strong."
    },
    {
      "i": 48,
      "start": 137.72,
      "end": 140.2,
      "text": "What kind of demon is it?"
    },
    {
      "i": 49,
      "start": 140.2,
      "end": 142.2,
      "text": "It's a scorpion spirit."
    },
    {
      "i": 50,
      "start": 142.2,
      "end": 143.2,
      "text": "Said the monkey."
    },
    {
      "i": 51,
      "start": 143.2,
      "end": 144.2,
      "text": "Oh."
    },
    {
      "i": 52,
      "start": 144.2,
      "end": 146.72,
      "text": "Said the Star Lord nodding."
    },
    {
      "i": 53,
      "start": 146.72,
      "end": 149.28,
      "text": "I understand now."
    },
    {
      "i": 54,
      "start": 149.28,
      "end": 150.04,
      "text": "Lead the way."
    }
  ]
}
