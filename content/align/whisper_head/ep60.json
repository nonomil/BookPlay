{
  "episode": 60,
  "source": "assets/video/ep60.mp4",
  "model": "base",
  "duration": 324.01125,
  "segments": [
    {
      "i": 1,
      "start": 0.0,
      "end": 11.58,
      "text": "Journey to the West. Chapter 60. Snow."
    },
    {
      "i": 2,
      "start": 11.58,
      "end": 15.3,
      "text": "The demon eyed the smiling boy suspiciously."
    },
    {
      "i": 3,
      "start": 15.3,
      "end": 17.62,
      "text": "Or you scared of me?"
    },
    {
      "i": 4,
      "start": 17.62,
      "end": 18.82,
      "text": "Ask the demon."
    },
    {
      "i": 5,
      "start": 18.82,
      "end": 21.3,
      "text": "No, said the boy."
    },
    {
      "i": 6,
      "start": 21.3,
      "end": 24.82,
      "text": "Should I be?"
    },
    {
      "i": 7,
      "start": 24.82,
      "end": 25.82,
      "text": "Well yes."
    },
    {
      "i": 8,
      "start": 25.82,
      "end": 27.18,
      "text": "Said the demon."
    },
    {
      "i": 9,
      "start": 27.18,
      "end": 29.18,
      "text": "I planned to eat you."
    },
    {
      "i": 10,
      "start": 29.18,
      "end": 32.18,
      "text": "Doesn't that sound terrible?"
    },
    {
      "i": 11,
      "start": 32.18,
      "end": 34.18,
      "text": "The boy shrugged."
    },
    {
      "i": 12,
      "start": 34.18,
      "end": 36.18,
      "text": "Not really."
    },
    {
      "i": 13,
      "start": 36.18,
      "end": 39.18,
      "text": "The demon hesitated for a moment and then moved closer."
    },
    {
      "i": 14,
      "start": 39.18,
      "end": 43.18,
      "text": "Suddenly the boy changed into Wukong."
    },
    {
      "i": 15,
      "start": 43.18,
      "end": 47.18,
      "text": "The monkey pulled out his iron bar and swung."
    },
    {
      "i": 16,
      "start": 47.18,
      "end": 51.18,
      "text": "The demon jumped back and Wukong missed."
    },
    {
      "i": 17,
      "start": 51.18,
      "end": 53.18,
      "text": "Who are you?"
    },
    {
      "i": 18,
      "start": 53.18,
      "end": 55.18,
      "text": "Demand at the demon."
    },
    {
      "i": 19,
      "start": 55.18,
      "end": 57.18,
      "text": "I am Sun Wukong."
    },
    {
      "i": 20,
      "start": 57.18,
      "end": 58.18,
      "text": "Said the monkey."
    },
    {
      "i": 21,
      "start": 58.18,
      "end": 60.18,
      "text": "And you should be ashamed of yourself."
    },
    {
      "i": 22,
      "start": 60.18,
      "end": 63.18,
      "text": "What kind of monster eats children?"
    },
    {
      "i": 23,
      "start": 63.18,
      "end": 65.18,
      "text": "Sun Wukong."
    },
    {
      "i": 24,
      "start": 65.18,
      "end": 66.18,
      "text": "Said the demon."
    },
    {
      "i": 25,
      "start": 66.18,
      "end": 69.18,
      "text": "I thought you were trapped under a mountain."
    },
    {
      "i": 26,
      "start": 69.18,
      "end": 72.18,
      "text": "What are you doing here?"
    },
    {
      "i": 27,
      "start": 72.18,
      "end": 74.18,
      "text": "My punishment is over."
    },
    {
      "i": 28,
      "start": 74.18,
      "end": 75.18,
      "text": "Said the monkey."
    },
    {
      "i": 29,
      "start": 75.18,
      "end": 79.18,
      "text": "I'm traveling to the western paradise with the Tang Monk."
    },
    {
      "i": 30,
      "start": 79.18,
      "end": 81.18,
      "text": "The demon's eyes lit up."
    },
    {
      "i": 31,
      "start": 81.18,
      "end": 83.18,
      "text": "The Tang Monk."
    },
    {
      "i": 32,
      "start": 84.18,
      "end": 86.18,
      "text": "Wukong lunged."
    },
    {
      "i": 33,
      "start": 86.18,
      "end": 90.18,
      "text": "The demon spun around and disappeared."
    },
    {
      "i": 34,
      "start": 93.18,
      "end": 98.18,
      "text": "The monkey returned to Chen's home and told everyone what had happened."
    },
    {
      "i": 35,
      "start": 98.18,
      "end": 102.18,
      "text": "Because of you, I still have my Sun."
    },
    {
      "i": 36,
      "start": 102.18,
      "end": 103.18,
      "text": "Said Chen."
    },
    {
      "i": 37,
      "start": 103.18,
      "end": 105.18,
      "text": "Thank you."
    },
    {
      "i": 38,
      "start": 105.18,
      "end": 106.18,
      "text": "You're welcome."
    },
    {
      "i": 39,
      "start": 106.18,
      "end": 108.18,
      "text": "Said Wukong."
    },
    {
      "i": 40,
      "start": 108.18,
      "end": 112.18,
      "text": "But I believe the demon now wants to capture the Tang Monk."
    },
    {
      "i": 41,
      "start": 112.18,
      "end": 116.18,
      "text": "And in the morning we must find a boat and leave."
    },
    {
      "i": 42,
      "start": 116.18,
      "end": 120.18,
      "text": "Meanwhile, the demon was deep under the water."
    },
    {
      "i": 43,
      "start": 120.18,
      "end": 123.18,
      "text": "I must capture the Tang Monk and eat him."
    },
    {
      "i": 44,
      "start": 123.18,
      "end": 125.18,
      "text": "He said to himself."
    },
    {
      "i": 45,
      "start": 125.18,
      "end": 128.18,
      "text": "It won't be easy with that monkey around."
    },
    {
      "i": 46,
      "start": 128.18,
      "end": 131.18,
      "text": "I'll need some magic."
    },
    {
      "i": 47,
      "start": 131.18,
      "end": 136.18,
      "text": "Late that night, a cold wind blew."
    },
    {
      "i": 48,
      "start": 136.18,
      "end": 139.18,
      "text": "A snowflake drifted to the ground."
    },
    {
      "i": 49,
      "start": 140.18,
      "end": 143.18,
      "text": "Then another one fell and another."
    },
    {
      "i": 50,
      "start": 144.18,
      "end": 146.18,
      "text": "Bajay couldn't sleep."
    },
    {
      "i": 51,
      "start": 146.18,
      "end": 148.18,
      "text": "It's freezing in here."
    },
    {
      "i": 52,
      "start": 148.18,
      "end": 150.18,
      "text": "He said to himself."
    }
  ]
}
