  "duration": 329.2125,
  "segments": [
    {
      "i": 1,
      "start": 0.0,
      "end": 19.0,
      "text": "The Black Wind King took a step back. He looked confused."
    },
    {
      "i": 2,
      "start": 19.0,
      "end": 24.0,
      "text": "That pill jumped down my throat."
    },
    {
      "i": 3,
      "start": 24.0,
      "end": 31.0,
      "text": "The entire cave filled with light. The bear squeezed his eye shut."
    },
    {
      "i": 4,
      "start": 31.0,
      "end": 35.0,
      "text": "When he opened, then, Gwanyin was standing before him."
    },
    {
      "i": 5,
      "start": 35.0,
      "end": 37.0,
      "text": "Gwanyin!"
    },
    {
      "i": 6,
      "start": 37.0,
      "end": 38.0,
      "text": "The bear cried."
    },
    {
      "i": 7,
      "start": 38.0,
      "end": 41.0,
      "text": "You tricked me with a disguise!"
    },
    {
      "i": 8,
      "start": 41.0,
      "end": 43.0,
      "text": "Return the robe at once."
    },
    {
      "i": 9,
      "start": 43.0,
      "end": 45.0,
      "text": "Said Gwanyin."
    },
    {
      "i": 10,
      "start": 45.0,
      "end": 46.0,
      "text": "No!"
    },
    {
      "i": 11,
      "start": 46.0,
      "end": 50.0,
      "text": "Said the Black Wind King."
    },
    {
      "i": 12,
      "start": 51.0,
      "end": 54.0,
      "text": "I don't want to!"
    },
    {
      "i": 13,
      "start": 55.0,
      "end": 58.0,
      "text": "He held his stomach and groaned."
    },
    {
      "i": 14,
      "start": 58.0,
      "end": 60.0,
      "text": "Are you feeling okay?"
    },
    {
      "i": 15,
      "start": 60.0,
      "end": 62.0,
      "text": "Asked Wukong's voice."
    },
    {
      "i": 16,
      "start": 62.0,
      "end": 65.0,
      "text": "The bear looked around, surprised."
    },
    {
      "i": 17,
      "start": 65.0,
      "end": 68.0,
      "text": "I just heard the monkey!"
    },
    {
      "i": 18,
      "start": 68.0,
      "end": 71.0,
      "text": "He fell to his knees and groaned again."
    },
    {
      "i": 19,
      "start": 71.0,
      "end": 75.0,
      "text": "Where are you?"
    },
    {
      "i": 20,
      "start": 75.0,
      "end": 77.0,
      "text": "I'm inside you."
    },
    {
      "i": 21,
      "start": 77.0,
      "end": 78.0,
      "text": "Said Wukong."
    },
    {
      "i": 22,
      "start": 78.0,
      "end": 81.0,
      "text": "I changed myself into a pill to trick you."
    },
    {
      "i": 23,
      "start": 81.0,
      "end": 85.0,
      "text": "Now I'm going to practice some of my fighting skills."
    },
    {
      "i": 24,
      "start": 85.0,
      "end": 89.0,
      "text": "The monkey punched and kicked the bear's insides."
    },
    {
      "i": 25,
      "start": 89.0,
      "end": 90.0,
      "text": "Boom!"
    },
    {
      "i": 26,
      "start": 90.0,
      "end": 91.0,
      "text": "Pow!"
    },
    {
      "i": 27,
      "start": 91.0,
      "end": 92.0,
      "text": "Boom!"
    },
    {
      "i": 28,
      "start": 92.0,
      "end": 93.0,
      "text": "Pow!"
    },
    {
      "i": 29,
      "start": 93.0,
      "end": 95.0,
      "text": "Ahhh!"
    },
    {
      "i": 30,
      "start": 95.0,
      "end": 98.0,
      "text": "Pride the Black Wind King, rolling on the floor."
    },
    {
      "i": 31,
      "start": 98.0,
      "end": 104.0,
      "text": "Wukong jumped up and down, did flips and ran around in circles."
    },
    {
      "i": 32,
      "start": 104.0,
      "end": 106.0,
      "text": "Please, stop!"
    },
    {
      "i": 33,
      "start": 106.0,
      "end": 109.0,
      "text": "Shouting the Black Wind King."
    },
    {
      "i": 34,
      "start": 109.0,
      "end": 112.0,
      "text": "You are hurting my belly!"
    },
    {
      "i": 35,
      "start": 112.0,
      "end": 114.0,
      "text": "Give back the robe!"
    },
    {
      "i": 36,
      "start": 114.0,
      "end": 116.0,
      "text": "Said Gwanyin."
    },
    {
      "i": 37,
      "start": 116.0,
      "end": 117.0,
      "text": "I will."
    },
    {
      "i": 38,
      "start": 117.0,
      "end": 118.0,
      "text": "I promise."
    },
    {
      "i": 39,
      "start": 118.0,
      "end": 120.0,
      "text": "Said the bear."
    },
    {
      "i": 40,
      "start": 120.0,
      "end": 122.0,
      "text": "I will do anything you say."
    },
    {
      "i": 41,
      "start": 122.0,
      "end": 127.0,
      "text": "Just please tell the monkey to stop!"
    },
    {
      "i": 42,
      "start": 127.0,
      "end": 130.0,
      "text": "Gwanyin held up the metal headband."
    },
    {
      "i": 43,
      "start": 130.0,
      "end": 134.0,
      "text": "It looked just like the one on Wukong's head."
    },
    {
      "i": 44,
      "start": 134.0,
      "end": 137.0,
      "text": "She placed it on the bear's head."
    },
    {
      "i": 45,
      "start": 137.0,
      "end": 139.0,
      "text": "Wukong, come out now."
    },
    {
      "i": 46,
      "start": 139.0,
      "end": 141.0,
      "text": "Said Gwanyin."
    },
    {
      "i": 47,
      "start": 141.0,
      "end": 146.0,
      "text": "A tiny Wukong popped out of the Black Wind King's nose."
    },
    {
      "i": 48,
      "start": 146.0,
      "end": 149.0,
      "text": "He quickly grew to his normal size."
    },
    {
      "i": 49,
      "start": 149.0,
      "end": 151.0,
      "text": "Where's..."
    }
  ]
}
