{
  "episode": 93,
  "source": "assets/video/ep93.mp4",
  "model": "base",
  "duration": 349.0655625,
  "segments": [
    {
      "i": 1,
      "start": 0.0,
      "end": 12.4,
      "text": "Journey to the West, Chapter 93, up problem for the Lion Demon."
    },
    {
      "i": 2,
      "start": 12.4,
      "end": 15.32,
      "text": "The elephant and the raptor stared at the lion."
    },
    {
      "i": 3,
      "start": 15.32,
      "end": 18.84,
      "text": "Sunwoo Kong is alive inside you."
    },
    {
      "i": 4,
      "start": 18.84,
      "end": 19.84,
      "text": "Said the raptor."
    },
    {
      "i": 5,
      "start": 19.84,
      "end": 27.88,
      "text": "Aren't you worried?"
    },
    {
      "i": 6,
      "start": 27.88,
      "end": 32.88,
      "text": "The lion sat down on his throne."
    },
    {
      "i": 7,
      "start": 32.88,
      "end": 34.72,
      "text": "Said the raptor."
    },
    {
      "i": 8,
      "start": 34.72,
      "end": 37.96,
      "text": "The monkey is talking inside you."
    },
    {
      "i": 9,
      "start": 37.96,
      "end": 40.76,
      "text": "Doesn't that bother you?"
    },
    {
      "i": 10,
      "start": 40.76,
      "end": 41.76,
      "text": "Let him talk."
    },
    {
      "i": 11,
      "start": 41.76,
      "end": 44.32,
      "text": "Said the lion defiantly."
    },
    {
      "i": 12,
      "start": 44.32,
      "end": 47.28,
      "text": "It doesn't bother me at all."
    },
    {
      "i": 13,
      "start": 47.28,
      "end": 48.6,
      "text": "What shall I talk about?"
    },
    {
      "i": 14,
      "start": 48.6,
      "end": 50.32,
      "text": "Woo Kong called."
    },
    {
      "i": 15,
      "start": 50.32,
      "end": 52.64,
      "text": "Who wants to hear a story?"
    },
    {
      "i": 16,
      "start": 52.64,
      "end": 55.72,
      "text": "The elephant shook his head slowly."
    },
    {
      "i": 17,
      "start": 55.72,
      "end": 63.32,
      "text": "But if the monkey never stops talking, you'll never get any sleep."
    },
    {
      "i": 18,
      "start": 63.32,
      "end": 64.88,
      "text": "Said the lion."
    },
    {
      "i": 19,
      "start": 64.88,
      "end": 66.88,
      "text": "That would be bad."
    },
    {
      "i": 20,
      "start": 66.88,
      "end": 68.52,
      "text": "He thought for a moment."
    },
    {
      "i": 21,
      "start": 68.52,
      "end": 70.52,
      "text": "I know what to do."
    },
    {
      "i": 22,
      "start": 70.52,
      "end": 74.04,
      "text": "I'll stop eating."
    },
    {
      "i": 23,
      "start": 74.04,
      "end": 75.6,
      "text": "What will that do?"
    },
    {
      "i": 24,
      "start": 75.6,
      "end": 77.12,
      "text": "Ask the elephant."
    },
    {
      "i": 25,
      "start": 77.12,
      "end": 78.12,
      "text": "Yes."
    },
    {
      "i": 26,
      "start": 78.12,
      "end": 79.64,
      "text": "Said Woo Kong."
    },
    {
      "i": 27,
      "start": 79.64,
      "end": 81.08,
      "text": "What will that do?"
    },
    {
      "i": 28,
      "start": 81.08,
      "end": 85.44,
      "text": "If I don't eat, Woo Kong doesn't eat."
    },
    {
      "i": 29,
      "start": 85.44,
      "end": 86.44,
      "text": "Said the lion."
    },
    {
      "i": 30,
      "start": 86.44,
      "end": 90.0,
      "text": "How make him starve?"
    },
    {
      "i": 31,
      "start": 90.0,
      "end": 92.44,
      "text": "Woo Kong laughed."
    },
    {
      "i": 32,
      "start": 92.44,
      "end": 94.6,
      "text": "Nice try, lion."
    },
    {
      "i": 33,
      "start": 94.6,
      "end": 98.04,
      "text": "But I'll just turn one of my hairs into a stove."
    },
    {
      "i": 34,
      "start": 98.04,
      "end": 102.32,
      "text": "I'll cook a nice meal in here."
    },
    {
      "i": 35,
      "start": 102.32,
      "end": 103.32,
      "text": "How dear?"
    },
    {
      "i": 36,
      "start": 103.32,
      "end": 104.88,
      "text": "The raptor shook his head."
    },
    {
      "i": 37,
      "start": 104.88,
      "end": 110.32,
      "text": "If that monkey fires up a stove, it will make you very hot."
    },
    {
      "i": 38,
      "start": 110.32,
      "end": 114.08,
      "text": "Plus, it will create lots of smoke."
    },
    {
      "i": 39,
      "start": 114.08,
      "end": 116.4,
      "text": "The smoke will fill your head."
    },
    {
      "i": 40,
      "start": 116.4,
      "end": 121.28,
      "text": "And you'll never stop sneezing."
    },
    {
      "i": 41,
      "start": 121.28,
      "end": 124.92,
      "text": "At last, the lion was starting to look nervous."
    },
    {
      "i": 42,
      "start": 124.92,
      "end": 126.12,
      "text": "That would be terrible."
    },
    {
      "i": 43,
      "start": 126.12,
      "end": 127.12,
      "text": "He said."
    },
    {
      "i": 44,
      "start": 127.12,
      "end": 131.6,
      "text": "I'd better cough out, Woo Kong."
    },
    {
      "i": 45,
      "start": 131.6,
      "end": 134.12,
      "text": "The lion went to the middle of the room."
    },
    {
      "i": 46,
      "start": 134.12,
      "end": 140.16,
      "text": "He bent over and coughed."
    },
    {
      "i": 47,
      "start": 140.16,
      "end": 141.56,
      "text": "Woo Kong laughed."
    },
    {
      "i": 48,
      "start": 141.56,
      "end": 149.28,
      "text": "I'm still in here."
    },
    {
      "i": 49,
      "start": 149.28,
      "end": 150.04,
      "text": "The lion coughed."
    }
  ]
}
