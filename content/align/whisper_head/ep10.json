{
  "episode": 10,
  "source": "assets/video/ep10.mp4",
  "model": "base",
  "duration": 330.5360625,
  "segments": [
    {
      "i": 1,
      "start": 0.0,
      "end": 12.32,
      "text": "Journey to the West. Chapter 10. The Powerful Sage"
    },
    {
      "i": 2,
      "start": 12.32,
      "end": 15.0,
      "text": "How will we defeat Sunwookong?"
    },
    {
      "i": 3,
      "start": 15.0,
      "end": 17.32,
      "text": "Monde the Jade Emperor."
    },
    {
      "i": 4,
      "start": 17.32,
      "end": 21.68,
      "text": "I sent our entire army and they couldn't arrest him."
    },
    {
      "i": 5,
      "start": 21.68,
      "end": 25.6,
      "text": "Perhaps we can ask the sage Erlang to capture him."
    },
    {
      "i": 6,
      "start": 25.6,
      "end": 27.4,
      "text": "Said Guanyin."
    },
    {
      "i": 7,
      "start": 27.4,
      "end": 29.2,
      "text": "Yes."
    },
    {
      "i": 8,
      "start": 29.2,
      "end": 31.4,
      "text": "Said the Jade Emperor."
    },
    {
      "i": 9,
      "start": 31.4,
      "end": 34.04,
      "text": "Erlang is very powerful."
    },
    {
      "i": 10,
      "start": 34.04,
      "end": 36.48,
      "text": "He turned back to the messenger."
    },
    {
      "i": 11,
      "start": 36.48,
      "end": 44.52,
      "text": "Go to Plum Mountain. Ask Erlang if he'll help us."
    },
    {
      "i": 12,
      "start": 44.52,
      "end": 51.12,
      "text": "Wookong stood in front of the waterfall with his cheering subjects."
    },
    {
      "i": 13,
      "start": 51.12,
      "end": 53.76,
      "text": "Our king has just defeated an entire army from heaven."
    },
    {
      "i": 14,
      "start": 53.76,
      "end": 56.96,
      "text": "Said the given."
    },
    {
      "i": 15,
      "start": 56.96,
      "end": 59.28,
      "text": "I hope the Jade Emperor learned his lesson."
    },
    {
      "i": 16,
      "start": 59.28,
      "end": 61.08,
      "text": "Said Wookong."
    },
    {
      "i": 17,
      "start": 61.08,
      "end": 63.4,
      "text": "He and his army are no match for it."
    },
    {
      "i": 18,
      "start": 63.4,
      "end": 64.92,
      "text": "Sunwookong."
    },
    {
      "i": 19,
      "start": 64.92,
      "end": 68.24,
      "text": "A deep voice boomed."
    },
    {
      "i": 20,
      "start": 68.24,
      "end": 70.56,
      "text": "Wookong looked up."
    },
    {
      "i": 21,
      "start": 70.56,
      "end": 74.36,
      "text": "A large man was coming down from the sky."
    },
    {
      "i": 22,
      "start": 74.36,
      "end": 76.68,
      "text": "The apes and other monkeys ran and hid."
    },
    {
      "i": 23,
      "start": 80.68,
      "end": 82.0,
      "text": "I am Burla."
    },
    {
      "i": 24,
      "start": 82.0,
      "end": 83.72,
      "text": "Said the man."
    },
    {
      "i": 25,
      "start": 83.72,
      "end": 87.64,
      "text": "The Jade Emperor sent me to arrest you."
    },
    {
      "i": 26,
      "start": 87.64,
      "end": 90.52,
      "text": "Wookong laughed."
    },
    {
      "i": 27,
      "start": 90.52,
      "end": 93.96,
      "text": "The Jade Emperor's entire army couldn't defeat me."
    },
    {
      "i": 28,
      "start": 93.96,
      "end": 96.52,
      "text": "What do you think you're going to do?"
    },
    {
      "i": 29,
      "start": 96.52,
      "end": 98.96,
      "text": "I am going to take you back to heaven."
    },
    {
      "i": 30,
      "start": 98.96,
      "end": 100.6,
      "text": "Said Erlang."
    },
    {
      "i": 31,
      "start": 100.6,
      "end": 103.88,
      "text": "And you will be punished."
    },
    {
      "i": 32,
      "start": 103.88,
      "end": 105.76,
      "text": "Wading his iron bar."
    },
    {
      "i": 33,
      "start": 105.76,
      "end": 108.96,
      "text": "Wookong leaped at Erlang."
    },
    {
      "i": 34,
      "start": 108.96,
      "end": 111.36,
      "text": "Clang."
    },
    {
      "i": 35,
      "start": 111.36,
      "end": 115.88,
      "text": "Erlang blocked the bar with his sword and then struck back."
    },
    {
      "i": 36,
      "start": 115.88,
      "end": 120.32,
      "text": "Wookong jumped onto a cloud to get out of the way."
    },
    {
      "i": 37,
      "start": 120.32,
      "end": 125.2,
      "text": "Erlang leaped into the air."
    },
    {
      "i": 38,
      "start": 125.2,
      "end": 129.04,
      "text": "He shook his body and suddenly grew much bigger."
    },
    {
      "i": 39,
      "start": 129.04,
      "end": 131.6,
      "text": "Wookong laughed."
    },
    {
      "i": 40,
      "start": 131.6,
      "end": 134.12,
      "text": "I can do that too."
    },
    {
      "i": 41,
      "start": 134.12,
      "end": 137.12,
      "text": "He shook his body and grew just as big as Erlang."
    },
    {
      "i": 42,
      "start": 142.36,
      "end": 146.36,
      "text": "Clouds swirled and wind blew as the two giants"
    },
    {
      "i": 43,
      "start": 146.36,
      "end": 148.36,
      "text": "spot in the sky."
    },
    {
      "i": 44,
      "start": 148.36,
      "end": 150.36,
      "text": "Their weapons banged together all."
    }
  ]
}
