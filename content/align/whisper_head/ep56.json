{
  "episode": 56,
  "source": "assets/video/ep56.mp4",
  "model": "base",
  "duration": 305.296,
  "segments": [
    {
      "i": 1,
      "start": 0.0,
      "end": 7.0,
      "text": "Journey to the West, Chapter 56, the Tiger Immortal"
    },
    {
      "i": 2,
      "start": 14.0,
      "end": 21.0,
      "text": "Wukong led the monks to his companions. The monks told the Tang monk everything that they had told Wukong"
    },
    {
      "i": 3,
      "start": 21.0,
      "end": 23.0,
      "text": "That's terrible."
    },
    {
      "i": 4,
      "start": 23.0,
      "end": 24.0,
      "text": "Said the Tang monk"
    },
    {
      "i": 5,
      "start": 24.0,
      "end": 26.0,
      "text": "We must help you."
    },
    {
      "i": 6,
      "start": 26.0,
      "end": 27.0,
      "text": "Yes."
    },
    {
      "i": 7,
      "start": 27.0,
      "end": 28.0,
      "text": "The monkey agreed."
    },
    {
      "i": 8,
      "start": 28.0,
      "end": 31.0,
      "text": "I'll deal with the Tiger Immortal in the morning."
    },
    {
      "i": 9,
      "start": 31.0,
      "end": 35.0,
      "text": "The monks knew of an empty building nearby."
    },
    {
      "i": 10,
      "start": 35.0,
      "end": 41.0,
      "text": "They led the travelers there and everyone went to sleep for the night."
    },
    {
      "i": 11,
      "start": 41.0,
      "end": 45.0,
      "text": "The next morning, Wukong woke up early."
    },
    {
      "i": 12,
      "start": 45.0,
      "end": 50.0,
      "text": "Someone was pounding on the door of the building. A voice boomed."
    },
    {
      "i": 13,
      "start": 50.0,
      "end": 52.0,
      "text": "I am the Tiger Immortal."
    },
    {
      "i": 14,
      "start": 52.0,
      "end": 56.0,
      "text": "The Tang monk's eyes popped open."
    },
    {
      "i": 15,
      "start": 56.0,
      "end": 59.0,
      "text": "He and all the other monks trembled with fear."
    },
    {
      "i": 16,
      "start": 59.0,
      "end": 64.0,
      "text": "Wu Jing and Ba Jai drew their weapons. Wukong smiled."
    },
    {
      "i": 17,
      "start": 64.0,
      "end": 69.0,
      "text": "Don't worry everyone. I'll deal with this villain."
    },
    {
      "i": 18,
      "start": 69.0,
      "end": 74.0,
      "text": "The monkey went outside."
    },
    {
      "i": 19,
      "start": 74.0,
      "end": 76.0,
      "text": "Who are you?"
    },
    {
      "i": 20,
      "start": 76.0,
      "end": 78.0,
      "text": "Demanded the Tiger Immortal."
    },
    {
      "i": 21,
      "start": 78.0,
      "end": 80.0,
      "text": "I am Sun Wukong."
    },
    {
      "i": 22,
      "start": 80.0,
      "end": 81.0,
      "text": "Said the monkey."
    },
    {
      "i": 23,
      "start": 81.0,
      "end": 84.0,
      "text": "And you should be ashamed of yourself."
    },
    {
      "i": 24,
      "start": 84.0,
      "end": 90.0,
      "text": "Just because you're a little powerful, you think you can treat the Buddhist monks badly."
    },
    {
      "i": 25,
      "start": 90.0,
      "end": 92.0,
      "text": "A little powerful."
    },
    {
      "i": 26,
      "start": 92.0,
      "end": 94.0,
      "text": "The Tiger Immortal looked offended."
    },
    {
      "i": 27,
      "start": 94.0,
      "end": 97.0,
      "text": "I am very powerful."
    },
    {
      "i": 28,
      "start": 97.0,
      "end": 99.0,
      "text": "Wukong laughed."
    },
    {
      "i": 29,
      "start": 99.0,
      "end": 102.0,
      "text": "You're not as powerful as I am."
    },
    {
      "i": 30,
      "start": 102.0,
      "end": 106.0,
      "text": "Did you know that the Jade Emperor is afraid of me?"
    },
    {
      "i": 31,
      "start": 106.0,
      "end": 109.0,
      "text": "I once defeated his entire army."
    },
    {
      "i": 32,
      "start": 109.0,
      "end": 112.0,
      "text": "The Tiger Immortal puffed out his chest."
    },
    {
      "i": 33,
      "start": 112.0,
      "end": 115.0,
      "text": "I can summon rain."
    },
    {
      "i": 34,
      "start": 115.0,
      "end": 116.0,
      "text": "He said."
    },
    {
      "i": 35,
      "start": 116.0,
      "end": 118.0,
      "text": "I doubt you can do that."
    },
    {
      "i": 36,
      "start": 118.0,
      "end": 120.0,
      "text": "Wukong snorted."
    },
    {
      "i": 37,
      "start": 120.0,
      "end": 123.0,
      "text": "I can summon rain. It's easy."
    },
    {
      "i": 38,
      "start": 123.0,
      "end": 126.0,
      "text": "Well then, let's have a contest."
    },
    {
      "i": 39,
      "start": 126.0,
      "end": 128.0,
      "text": "Said the Tiger Immortal."
    },
    {
      "i": 40,
      "start": 128.0,
      "end": 131.0,
      "text": "Whoever summons more rain is the winner."
    },
    {
      "i": 41,
      "start": 131.0,
      "end": 135.0,
      "text": "If you win, I'll let you and all the monks go free."
    },
    {
      "i": 42,
      "start": 135.0,
      "end": 140.0,
      "text": "But if I win, you must stay here and be my slaves."
    },
    {
      "i": 43,
      "start": 141.0,
      "end": 142.0,
      "text": "You're a fool."
    },
    {
      "i": 44,
      "start": 142.0,
      "end": 143.0,
      "text": "Said Wukong."
    },
    {
      "i": 45,
      "start": 143.0,
      "end": 146.0,
      "text": "I accept your challenge."
    },
    {
      "i": 46,
      "start": 147.0,
      "end": 151.0,
      "text": "The Tiger Immortal led everyone into town."
    }
  ]
}
