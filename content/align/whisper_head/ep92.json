{
  "episode": 92,
  "source": "assets/video/ep92.mp4",
  "model": "base",
  "duration": 337.4091875,
  "segments": [
    {
      "i": 1,
      "start": 0.0,
      "end": 13.08,
      "text": "Journey to the West, Chapter 92, The Lion Demon."
    },
    {
      "i": 2,
      "start": 13.08,
      "end": 15.32,
      "text": "The elephant pointed at Wukong."
    },
    {
      "i": 3,
      "start": 15.32,
      "end": 17.32,
      "text": "He's not a demon."
    },
    {
      "i": 4,
      "start": 17.32,
      "end": 18.8,
      "text": "He's a monkey."
    },
    {
      "i": 5,
      "start": 18.8,
      "end": 21.72,
      "text": "He's not just a monkey."
    },
    {
      "i": 6,
      "start": 21.72,
      "end": 22.72,
      "text": "Said the raptor."
    },
    {
      "i": 7,
      "start": 22.72,
      "end": 24.72,
      "text": "He's a Wukong."
    },
    {
      "i": 8,
      "start": 24.72,
      "end": 26.72,
      "text": "Get him."
    },
    {
      "i": 9,
      "start": 26.72,
      "end": 30.88,
      "text": "The lion pounced."
    },
    {
      "i": 10,
      "start": 30.88,
      "end": 36.72,
      "text": "Wukong shot out of the cave as fast as he could."
    },
    {
      "i": 11,
      "start": 36.72,
      "end": 40.84,
      "text": "He didn't stop running until he was far from the cave."
    },
    {
      "i": 12,
      "start": 40.84,
      "end": 47.32,
      "text": "The monkey said to himself."
    },
    {
      "i": 13,
      "start": 47.32,
      "end": 48.72,
      "text": "That was close."
    },
    {
      "i": 14,
      "start": 48.72,
      "end": 52.12,
      "text": "I guess when I laughed, I broke my concentration."
    },
    {
      "i": 15,
      "start": 52.12,
      "end": 55.28,
      "text": "That must have made my disguise vanish."
    },
    {
      "i": 16,
      "start": 55.28,
      "end": 61.04,
      "text": "Wukong returned to his companions."
    },
    {
      "i": 17,
      "start": 61.04,
      "end": 63.08,
      "text": "Well said Wu Xing."
    },
    {
      "i": 18,
      "start": 63.08,
      "end": 65.88,
      "text": "Is there an army up ahead?"
    },
    {
      "i": 19,
      "start": 65.88,
      "end": 68.36,
      "text": "I scared away the entire army."
    },
    {
      "i": 20,
      "start": 68.36,
      "end": 70.32,
      "text": "Wukong boasted."
    },
    {
      "i": 21,
      "start": 70.32,
      "end": 73.84,
      "text": "But there are still three powerful demons on the mountain."
    },
    {
      "i": 22,
      "start": 73.84,
      "end": 78.2,
      "text": "They planned to capture Master and well eat him."
    },
    {
      "i": 23,
      "start": 78.2,
      "end": 82.44,
      "text": "Oh, cried the Tang monk nearly falling over."
    },
    {
      "i": 24,
      "start": 82.44,
      "end": 84.96,
      "text": "Wu Xing caught him."
    },
    {
      "i": 25,
      "start": 84.96,
      "end": 86.56,
      "text": "You're worry, Master."
    },
    {
      "i": 26,
      "start": 86.56,
      "end": 88.12,
      "text": "Said Wu Kong."
    },
    {
      "i": 27,
      "start": 88.12,
      "end": 90.48,
      "text": "We won't let those demons harm you."
    },
    {
      "i": 28,
      "start": 90.48,
      "end": 94.44,
      "text": "But we do have to destroy them before we cross the mountain."
    },
    {
      "i": 29,
      "start": 94.44,
      "end": 97.92,
      "text": "It's good that we discovered their plan before we went up the mountain."
    },
    {
      "i": 30,
      "start": 97.92,
      "end": 102.2,
      "text": "The Tang monk nodded, ringing his hands nervously."
    },
    {
      "i": 31,
      "start": 102.2,
      "end": 105.6,
      "text": "Wu Kong turned to Bajie and Wu Xing."
    },
    {
      "i": 32,
      "start": 105.6,
      "end": 108.28,
      "text": "Someone needs to help me get rid of the demons."
    },
    {
      "i": 33,
      "start": 108.28,
      "end": 110.2,
      "text": "I'll go with you."
    },
    {
      "i": 34,
      "start": 110.2,
      "end": 111.2,
      "text": "Said Bajie."
    },
    {
      "i": 35,
      "start": 111.2,
      "end": 114.0,
      "text": "I'll stay here and look after the Tang monk."
    },
    {
      "i": 36,
      "start": 114.0,
      "end": 116.24,
      "text": "Said Wu Xing."
    },
    {
      "i": 37,
      "start": 116.24,
      "end": 121.84,
      "text": "Wu Kong and Bajie went to the cave entrance."
    },
    {
      "i": 38,
      "start": 121.84,
      "end": 124.68,
      "text": "The monkey pulled out his iron bar."
    },
    {
      "i": 39,
      "start": 124.68,
      "end": 127.2,
      "text": "Bajie raised his rake."
    },
    {
      "i": 40,
      "start": 127.2,
      "end": 128.96,
      "text": "I'll do all the talking."
    },
    {
      "i": 41,
      "start": 128.96,
      "end": 129.96,
      "text": "Said Wu Kong."
    },
    {
      "i": 42,
      "start": 129.96,
      "end": 132.28,
      "text": "What are you going to say?"
    },
    {
      "i": 43,
      "start": 132.28,
      "end": 133.76,
      "text": "Asked Bajie."
    },
    {
      "i": 44,
      "start": 133.76,
      "end": 136.12,
      "text": "I'll just ask them nicely to leave."
    },
    {
      "i": 45,
      "start": 136.12,
      "end": 137.72,
      "text": "Said Wu Kong."
    },
    {
      "i": 46,
      "start": 137.72,
      "end": 140.6,
      "text": "He turned to the cave entrance."
    },
    {
      "i": 47,
      "start": 140.6,
      "end": 141.6,
      "text": "Demons."
    },
    {
      "i": 48,
      "start": 141.6,
      "end": 143.04,
      "text": "He shouted."
    },
    {
      "i": 49,
      "start": 143.04,
      "end": 148.16,
      "text": "This mountain now or we'll knock it down and crush all three of you."
    },
    {
      "i": 50,
      "start": 148.16,
      "end": 150.0,
      "text": "For a moment, everything was quiet."
    }
  ]
}
