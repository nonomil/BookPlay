  "segments": [
    {
      "i": 1,
      "start": 0.0,
      "end": 7.0,
      "text": "Journey to the West, Chapter 74. Curious Ear."
    },
    {
      "i": 2,
      "start": 14.0,
      "end": 17.0,
      "text": "Guanyin recited the tight headband spell."
    },
    {
      "i": 3,
      "start": 18.0,
      "end": 22.0,
      "text": "Both Wu Kong's spell to the ground, howling in pain."
    },
    {
      "i": 4,
      "start": 23.0,
      "end": 24.0,
      "text": "Please stop!"
    },
    {
      "i": 5,
      "start": 24.0,
      "end": 26.0,
      "text": "They cried."
    },
    {
      "i": 6,
      "start": 26.0,
      "end": 30.0,
      "text": "Guanyin stopped reciting the spell and the two monkeys stood back up."
    },
    {
      "i": 7,
      "start": 33.0,
      "end": 35.0,
      "text": "The Bodhisattva frowned."
    },
    {
      "i": 8,
      "start": 35.0,
      "end": 38.0,
      "text": "I still don't know which of you is the real Wu Kong."
    },
    {
      "i": 9,
      "start": 39.0,
      "end": 43.0,
      "text": "You should both go to heaven. The real Wu Kong used to live there."
    },
    {
      "i": 10,
      "start": 44.0,
      "end": 47.0,
      "text": "Maybe the Jade Emperor can tell who is who."
    },
    {
      "i": 11,
      "start": 48.0,
      "end": 49.0,
      "text": "Good idea."
    },
    {
      "i": 12,
      "start": 49.0,
      "end": 52.0,
      "text": "Said one Wu Kong. He pointed at the other."
    },
    {
      "i": 13,
      "start": 52.0,
      "end": 55.0,
      "text": "The Jade Emperor will see that this monkey is a fake."
    },
    {
      "i": 14,
      "start": 57.0,
      "end": 58.0,
      "text": "I'm not a fake!"
    },
    {
      "i": 15,
      "start": 58.0,
      "end": 60.0,
      "text": "Cryed the other monkey."
    },
    {
      "i": 16,
      "start": 60.0,
      "end": 61.0,
      "text": "You are!"
    },
    {
      "i": 17,
      "start": 63.0,
      "end": 65.0,
      "text": "He tried to strike the other Wu Kong."
    },
    {
      "i": 18,
      "start": 66.0,
      "end": 68.0,
      "text": "But that one dodged the blow and swung back."
    },
    {
      "i": 19,
      "start": 70.0,
      "end": 74.0,
      "text": "The two monkeys were still fighting when they arrived at the southern gate of heaven."
    },
    {
      "i": 20,
      "start": 77.0,
      "end": 79.0,
      "text": "The guard narrowed his eyes."
    },
    {
      "i": 21,
      "start": 80.0,
      "end": 82.0,
      "text": "Wu Kong, is that you?"
    },
    {
      "i": 22,
      "start": 83.0,
      "end": 84.0,
      "text": "Yes, it's me!"
    },
    {
      "i": 23,
      "start": 84.0,
      "end": 86.0,
      "text": "Said both of the Wu Kongs."
    },
    {
      "i": 24,
      "start": 87.0,
      "end": 89.0,
      "text": "I must speak with the Jade Emperor."
    },
    {
      "i": 25,
      "start": 89.0,
      "end": 90.0,
      "text": "Said one monkey."
    },
    {
      "i": 26,
      "start": 90.0,
      "end": 92.0,
      "text": "He pointed at the other monkey."
    },
    {
      "i": 27,
      "start": 92.0,
      "end": 94.0,
      "text": "He's a fake Wu Kong."
    },
    {
      "i": 28,
      "start": 95.0,
      "end": 97.0,
      "text": "I'm not a fake Wu Kong."
    },
    {
      "i": 29,
      "start": 97.0,
      "end": 98.0,
      "text": "Said the other monkey."
    },
    {
      "i": 30,
      "start": 99.0,
      "end": 100.0,
      "text": "I'm the real one."
    },
    {
      "i": 31,
      "start": 100.0,
      "end": 102.0,
      "text": "I must speak with the Jade Emperor."
    },
    {
      "i": 32,
      "start": 105.0,
      "end": 107.0,
      "text": "The guard allowed both Wu Kongs to enter heaven."
    },
    {
      "i": 33,
      "start": 110.0,
      "end": 112.0,
      "text": "Crash! Clang! Bang!"
    },
    {
      "i": 34,
      "start": 113.0,
      "end": 118.0,
      "text": "Spirits and gods fled as the two Wu Kongs fought all over heaven."
    },
    {
      "i": 35,
      "start": 119.0,
      "end": 122.0,
      "text": "The monkeys knocked over statues and trees."
    },
    {
      "i": 36,
      "start": 125.0,
      "end": 128.0,
      "text": "Still fighting, they stormed into the cloud palace."
    },
    {
      "i": 37,
      "start": 130.0,
      "end": 133.0,
      "text": "When the Jade Emperor saw them, he was furious."
    },
    {
      "i": 38,
      "start": 134.0,
      "end": 136.0,
      "text": "What's going on?"
    },
    {
      "i": 39,
      "start": 136.0,
      "end": 137.0,
      "text": "He boomed."
    },
    {
      "i": 40,
      "start": 138.0,
      "end": 141.0,
      "text": "Your Majesty said one of the Wu Kongs."
    },
    {
      "i": 41,
      "start": 141.0,
      "end": 144.0,
      "text": "Please punish this monkey. He's pretending to be me."
    },
    {
      "i": 42,
      "start": 145.0,
      "end": 146.0,
      "text": "Punish him!"
    },
    {
      "i": 43,
      "start": 146.0,
      "end": 149.0,
      "text": "Cry the other. He's pretending to be me."
    }
  ]
}
