{
  "episode": 25,
  "source": "assets/video/ep25.mp4",
  "model": "base",
  "duration": 335.505125,
  "segments": [
    {
      "i": 1,
      "start": 0.0,
      "end": 7.0,
      "text": "Journey to the West, Chapter 25, Powerful Wind and Magic."
    },
    {
      "i": 2,
      "start": 12.38,
      "end": 14.0,
      "text": "The wind stopped."
    },
    {
      "i": 3,
      "start": 14.0,
      "end": 18.0,
      "text": "Wukong jumped to his feet and called back the little Wukongs."
    },
    {
      "i": 4,
      "start": 23.0,
      "end": 25.0,
      "text": "Monde Bajay."
    },
    {
      "i": 5,
      "start": 25.0,
      "end": 27.0,
      "text": "I need a nap."
    },
    {
      "i": 6,
      "start": 27.0,
      "end": 28.0,
      "text": "Get up!"
    },
    {
      "i": 7,
      "start": 28.0,
      "end": 29.0,
      "text": "Yelp the monkey."
    },
    {
      "i": 8,
      "start": 29.5,
      "end": 33.0,
      "text": "We have to save the Tang monk before the demon king eats him."
    },
    {
      "i": 9,
      "start": 35.0,
      "end": 37.0,
      "text": "Bajay rubbed his head."
    },
    {
      "i": 10,
      "start": 37.0,
      "end": 39.0,
      "text": "How can we save him?"
    },
    {
      "i": 11,
      "start": 39.0,
      "end": 41.0,
      "text": "That wind was too powerful."
    },
    {
      "i": 12,
      "start": 41.0,
      "end": 44.0,
      "text": "Wukong tapped his chin and thought."
    },
    {
      "i": 13,
      "start": 44.0,
      "end": 48.0,
      "text": "I'll sneak into the cave to see what I can find out."
    },
    {
      "i": 14,
      "start": 54.0,
      "end": 57.0,
      "text": "The monkey changed into a mosquito"
    },
    {
      "i": 15,
      "start": 57.0,
      "end": 61.0,
      "text": "and squeezed through a crack in the cave's door."
    },
    {
      "i": 16,
      "start": 61.0,
      "end": 64.0,
      "text": "Deep in the cave, he heard someone crying."
    },
    {
      "i": 17,
      "start": 66.0,
      "end": 68.0,
      "text": "That's the Tang monk."
    },
    {
      "i": 18,
      "start": 68.0,
      "end": 70.0,
      "text": "Thought Wukong."
    },
    {
      "i": 19,
      "start": 73.0,
      "end": 77.0,
      "text": "The monkey found his master tied up in a dark room."
    },
    {
      "i": 20,
      "start": 77.0,
      "end": 78.0,
      "text": "Master!"
    },
    {
      "i": 21,
      "start": 78.0,
      "end": 80.0,
      "text": "cried Wukong."
    },
    {
      "i": 22,
      "start": 80.0,
      "end": 83.0,
      "text": "He landed on the monk's shoulder."
    },
    {
      "i": 23,
      "start": 83.0,
      "end": 84.0,
      "text": "Wukong."
    },
    {
      "i": 24,
      "start": 84.0,
      "end": 87.0,
      "text": "Ask the Tang monk looking around."
    },
    {
      "i": 25,
      "start": 87.0,
      "end": 89.0,
      "text": "Where are you?"
    },
    {
      "i": 26,
      "start": 89.0,
      "end": 90.0,
      "text": "I'm on your shoulder."
    },
    {
      "i": 27,
      "start": 90.0,
      "end": 91.0,
      "text": "Said Wukong."
    },
    {
      "i": 28,
      "start": 91.0,
      "end": 94.0,
      "text": "I turned myself into a mosquito."
    },
    {
      "i": 29,
      "start": 94.0,
      "end": 96.0,
      "text": "You must save me."
    },
    {
      "i": 30,
      "start": 96.0,
      "end": 97.0,
      "text": "Said the Tang monk."
    },
    {
      "i": 31,
      "start": 97.0,
      "end": 100.0,
      "text": "He started to cry again."
    },
    {
      "i": 32,
      "start": 102.0,
      "end": 103.0,
      "text": "Stop crying."
    },
    {
      "i": 33,
      "start": 103.0,
      "end": 104.0,
      "text": "Said Wukong."
    },
    {
      "i": 34,
      "start": 104.0,
      "end": 106.0,
      "text": "You'll be free soon."
    },
    {
      "i": 35,
      "start": 106.0,
      "end": 109.0,
      "text": "First, I must defeat the demon king."
    },
    {
      "i": 36,
      "start": 109.0,
      "end": 111.0,
      "text": "I'll be back."
    },
    {
      "i": 37,
      "start": 112.0,
      "end": 116.0,
      "text": "Wukong flew down a tunnel and arrived in the throne room."
    },
    {
      "i": 38,
      "start": 118.0,
      "end": 122.0,
      "text": "Yellow wind was talking to some other demons."
    },
    {
      "i": 39,
      "start": 122.0,
      "end": 126.0,
      "text": "Your wind magic blew Sun Wukong away."
    },
    {
      "i": 40,
      "start": 126.0,
      "end": 128.0,
      "text": "Said one demon."
    },
    {
      "i": 41,
      "start": 128.0,
      "end": 130.0,
      "text": "Yellow wind to laugh."
    },
    {
      "i": 42,
      "start": 130.0,
      "end": 135.0,
      "text": "Only the bodies out for Lingji can stop my wind magic."
    },
    {
      "i": 43,
      "start": 135.0,
      "end": 140.0,
      "text": "Certifier, we're having a feast tonight."
    },
    {
      "i": 44,
      "start": 140.0,
      "end": 141.0,
      "text": "Aha!"
    },
    {
      "i": 45,
      "start": 141.0,
      "end": 142.0,
      "text": "Thought Wukong."
    },
    {
      "i": 46,
      "start": 142.0,
      "end": 145.0,
      "text": "The bodhisattva Lingji lives on Mount Sumeru."
    },
    {
      "i": 47,
      "start": 145.0,
      "end": 148.0,
      "text": "I will ask him for help quickly."
    }
  ]
}
