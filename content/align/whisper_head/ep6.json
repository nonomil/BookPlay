{
  "episode": 6,
  "source": "assets/video/ep6.mp4",
  "model": "base",
  "duration": 314.4214375,
  "segments": [
    {
      "i": 1,
      "start": 0.0,
      "end": 7.0,
      "text": "Journey to the West, Chapter 6, the Dragon King."
    },
    {
      "i": 2,
      "start": 12.5,
      "end": 14.7,
      "text": "What's wrong with our swords and spears?"
    },
    {
      "i": 3,
      "start": 14.7,
      "end": 16.5,
      "text": "Ask the given."
    },
    {
      "i": 4,
      "start": 16.5,
      "end": 18.6,
      "text": "They're fine for normal monkeys and apes."
    },
    {
      "i": 5,
      "start": 18.6,
      "end": 20.5,
      "text": "Said Wu Kong."
    },
    {
      "i": 6,
      "start": 20.5,
      "end": 22.3,
      "text": "But I am very powerful."
    },
    {
      "i": 7,
      "start": 22.3,
      "end": 24.8,
      "text": "I need a much heavier weapon."
    },
    {
      "i": 8,
      "start": 24.8,
      "end": 27.6,
      "text": "The given thought for a minute."
    },
    {
      "i": 9,
      "start": 27.6,
      "end": 30.2,
      "text": "A Dragon King lives at the bottom of the eastern sea."
    },
    {
      "i": 10,
      "start": 30.2,
      "end": 31.7,
      "text": "He said."
    },
    {
      "i": 11,
      "start": 31.7,
      "end": 34.6,
      "text": "Maybe he has a weapon you can use."
    },
    {
      "i": 12,
      "start": 34.6,
      "end": 35.6,
      "text": "That's a good idea."
    },
    {
      "i": 13,
      "start": 35.6,
      "end": 37.0,
      "text": "Said Wu Kong."
    },
    {
      "i": 14,
      "start": 37.0,
      "end": 40.0,
      "text": "I'll be back soon."
    },
    {
      "i": 15,
      "start": 40.0,
      "end": 48.3,
      "text": "He said a quick spell so he could breathe underwater."
    },
    {
      "i": 16,
      "start": 48.3,
      "end": 55.3,
      "text": "Then he dived into the stream."
    },
    {
      "i": 17,
      "start": 55.3,
      "end": 62.3,
      "text": "He swam to the ocean and went deeper and deeper."
    },
    {
      "i": 18,
      "start": 62.3,
      "end": 65.7,
      "text": "Soon he arrived at a large palace."
    },
    {
      "i": 19,
      "start": 65.7,
      "end": 70.6,
      "text": "The Dragon King and the Dragon Queen were sitting at a table having tea."
    },
    {
      "i": 20,
      "start": 70.6,
      "end": 74.6,
      "text": "The Dragon King looked over when Wu Kong walked in."
    },
    {
      "i": 21,
      "start": 74.6,
      "end": 75.6,
      "text": "Who are you?"
    },
    {
      "i": 22,
      "start": 75.6,
      "end": 77.6,
      "text": "Asked the Dragon King."
    },
    {
      "i": 23,
      "start": 77.6,
      "end": 79.9,
      "text": "I'm King of the Fruit and Flower Mountain."
    },
    {
      "i": 24,
      "start": 79.9,
      "end": 81.7,
      "text": "Said Wu Kong."
    },
    {
      "i": 25,
      "start": 81.7,
      "end": 83.9,
      "text": "My name is Sun Wu Kong."
    },
    {
      "i": 26,
      "start": 83.9,
      "end": 85.5,
      "text": "It's nice to meet you."
    },
    {
      "i": 27,
      "start": 85.5,
      "end": 87.1,
      "text": "Said the Queen."
    },
    {
      "i": 28,
      "start": 87.1,
      "end": 89.7,
      "text": "Would you like some tea?"
    },
    {
      "i": 29,
      "start": 89.7,
      "end": 90.7,
      "text": "No thank you."
    },
    {
      "i": 30,
      "start": 90.7,
      "end": 91.7,
      "text": "Said Wu Kong."
    },
    {
      "i": 31,
      "start": 91.7,
      "end": 97.0,
      "text": "I need a heavy weapon because I'm as strong as a god."
    },
    {
      "i": 32,
      "start": 97.0,
      "end": 99.5,
      "text": "I want one of yours."
    },
    {
      "i": 33,
      "start": 99.5,
      "end": 100.5,
      "text": "Well."
    },
    {
      "i": 34,
      "start": 100.5,
      "end": 102.5,
      "text": "Said the Dragon King."
    },
    {
      "i": 35,
      "start": 102.5,
      "end": 105.7,
      "text": "I suppose I could find a weapon for you."
    },
    {
      "i": 36,
      "start": 105.7,
      "end": 109.7,
      "text": "The Dragon King looked at a turtle soldier."
    },
    {
      "i": 37,
      "start": 109.7,
      "end": 113.3,
      "text": "Find a heavy weapon for Sun Wu Kong."
    },
    {
      "i": 38,
      "start": 113.3,
      "end": 116.5,
      "text": "The turtle went out of the room."
    },
    {
      "i": 39,
      "start": 116.5,
      "end": 122.8,
      "text": "He soon came back, slowly dragging a huge sword."
    },
    {
      "i": 40,
      "start": 122.8,
      "end": 130.5,
      "text": "He dropped the sword and then fell down out of breath."
    },
    {
      "i": 41,
      "start": 130.5,
      "end": 134.9,
      "text": "Wu Kong picked up the sword with no trouble at all."
    },
    {
      "i": 42,
      "start": 134.9,
      "end": 136.7,
      "text": "Swish, swish."
    },
    {
      "i": 43,
      "start": 136.7,
      "end": 141.1,
      "text": "He weighed the sword through the air pretending to fight."
    },
    {
      "i": 44,
      "start": 141.1,
      "end": 142.5,
      "text": "This sword is too light."
    },
    {
      "i": 45,
      "start": 142.5,
      "end": 144.3,
      "text": "Said Wu Kong."
    },
    {
      "i": 46,
      "start": 144.3,
      "end": 147.3,
      "text": "Find me a better weapon."
    },
    {
      "i": 47,
      "start": 147.3,
      "end": 149.5,
      "text": "This monkey is rude."
    },
    {
      "i": 48,
      "start": 149.5,
      "end": 150.5,
      "text": "The Dragon."
    }
  ]
}
