{
  "episode": 84,
  "source": "assets/video/ep84.mp4",
  "model": "base",
  "duration": 336.875125,
  "segments": [
    {
      "i": 1,
      "start": 0.0,
      "end": 7.0,
      "text": "Journey to the West, Chapter 84, The Sad King."
    },
    {
      "i": 2,
      "start": 12.0,
      "end": 14.0,
      "text": "I wish I had money."
    },
    {
      "i": 3,
      "start": 14.0,
      "end": 16.0,
      "text": "Bajay moaned."
    },
    {
      "i": 4,
      "start": 16.0,
      "end": 19.0,
      "text": "All this food looks so good."
    },
    {
      "i": 5,
      "start": 19.0,
      "end": 23.0,
      "text": "The travelers were walking through a city in the Scarlet Kingdom."
    },
    {
      "i": 6,
      "start": 23.0,
      "end": 28.0,
      "text": "The streets were lined with people selling food and other goods."
    },
    {
      "i": 7,
      "start": 28.0,
      "end": 31.0,
      "text": "Stop thinking about food, Bajay."
    },
    {
      "i": 8,
      "start": 31.0,
      "end": 33.0,
      "text": "said Wu-Jing."
    },
    {
      "i": 9,
      "start": 33.0,
      "end": 35.0,
      "text": "What's going on over there?"
    },
    {
      "i": 10,
      "start": 35.0,
      "end": 37.0,
      "text": "Ask the Tang Monk."
    },
    {
      "i": 11,
      "start": 37.0,
      "end": 41.0,
      "text": "He pointed to a crowd of people reading a sign on a wall."
    },
    {
      "i": 12,
      "start": 41.0,
      "end": 45.0,
      "text": "The travelers walked over to the crowd."
    },
    {
      "i": 13,
      "start": 45.0,
      "end": 50.0,
      "text": "The sign read, the king of the Scarlet Kingdom is seeking help."
    },
    {
      "i": 14,
      "start": 50.0,
      "end": 56.0,
      "text": "Anyone who can defeat demons must report to the Royal Palace."
    },
    {
      "i": 15,
      "start": 57.0,
      "end": 59.0,
      "text": "The Tang Monk's side."
    },
    {
      "i": 16,
      "start": 59.0,
      "end": 61.0,
      "text": "I don't want to delay our journey."
    },
    {
      "i": 17,
      "start": 61.0,
      "end": 63.0,
      "text": "But you three can defeat demons."
    },
    {
      "i": 18,
      "start": 63.0,
      "end": 66.0,
      "text": "We must report to the Palace."
    },
    {
      "i": 19,
      "start": 66.0,
      "end": 68.0,
      "text": "Don't worry, Master."
    },
    {
      "i": 20,
      "start": 68.0,
      "end": 69.0,
      "text": "Said Wu-Kong."
    },
    {
      "i": 21,
      "start": 69.0,
      "end": 71.0,
      "text": "I'm great at defeating demons."
    },
    {
      "i": 22,
      "start": 71.0,
      "end": 73.0,
      "text": "This won't take long."
    },
    {
      "i": 23,
      "start": 73.0,
      "end": 75.0,
      "text": "I hope they have food at the Palace."
    },
    {
      "i": 24,
      "start": 75.0,
      "end": 77.0,
      "text": "Said Bajay."
    },
    {
      "i": 25,
      "start": 77.0,
      "end": 80.0,
      "text": "I'm starving."
    },
    {
      "i": 26,
      "start": 80.0,
      "end": 83.0,
      "text": "The travelers arrived at the Palace Gate."
    },
    {
      "i": 27,
      "start": 83.0,
      "end": 88.0,
      "text": "They spoke with a guard who then led them into the court."
    },
    {
      "i": 28,
      "start": 88.0,
      "end": 92.0,
      "text": "The king sat on his throne, looking very sad."
    },
    {
      "i": 29,
      "start": 92.0,
      "end": 93.0,
      "text": "Your Majesty."
    },
    {
      "i": 30,
      "start": 93.0,
      "end": 94.0,
      "text": "Said the guard."
    },
    {
      "i": 31,
      "start": 94.0,
      "end": 97.0,
      "text": "The Tang Monk is here to see you."
    },
    {
      "i": 32,
      "start": 97.0,
      "end": 101.0,
      "text": "He says his companions can defeat demons."
    },
    {
      "i": 33,
      "start": 101.0,
      "end": 104.0,
      "text": "The king looked up but didn't say anything."
    },
    {
      "i": 34,
      "start": 104.0,
      "end": 107.0,
      "text": "The guard whispered to the travelers."
    },
    {
      "i": 35,
      "start": 107.0,
      "end": 109.0,
      "text": "His Majesty is very upset."
    },
    {
      "i": 36,
      "start": 109.0,
      "end": 112.0,
      "text": "If you can help him, please do."
    },
    {
      "i": 37,
      "start": 113.0,
      "end": 116.0,
      "text": "Wu-Kong walked up to the king."
    },
    {
      "i": 38,
      "start": 118.0,
      "end": 120.0,
      "text": "Greetings, Your Majesty."
    },
    {
      "i": 39,
      "start": 120.0,
      "end": 125.0,
      "text": "I am Sun Wu-Kong, King of the Fruit and Flower Mountain."
    },
    {
      "i": 40,
      "start": 128.0,
      "end": 131.0,
      "text": "You need someone who can defeat demons."
    },
    {
      "i": 41,
      "start": 131.0,
      "end": 134.0,
      "text": "Well, here I am."
    },
    {
      "i": 42,
      "start": 134.0,
      "end": 140.0,
      "text": "Suddenly the king covered his face with his hands and burst out crying."
    },
    {
      "i": 43,
      "start": 140.0,
      "end": 142.0,
      "text": "Oh, it's terrible."
    },
    {
      "i": 44,
      "start": 142.0,
      "end": 145.0,
      "text": "I have no hope anymore."
    },
    {
      "i": 45,
      "start": 145.0,
      "end": 147.0,
      "text": "Wu-Kong scratched his head."
    },
    {
      "i": 46,
      "start": 147.0,
      "end": 149.0,
      "text": "What's wrong?"
    },
    {
      "i": 47,
      "start": 149.0,
      "end": 150.0,
      "text": "The Queen."
    }
  ]
}
