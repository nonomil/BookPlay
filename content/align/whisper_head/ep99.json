    },
    {
      "i": 25,
      "start": 90.0,
      "end": 93.0,
      "text": "Bajay and Wu-Jing were thrilled"
    },
    {
      "i": 26,
      "start": 93.0,
      "end": 96.0,
      "text": "Master, we thought you'd been eaten"
    },
    {
      "i": 27,
      "start": 96.0,
      "end": 98.0,
      "text": "Said Bajay"
    },
    {
      "i": 28,
      "start": 98.0,
      "end": 100.0,
      "text": "I knew he was fine"
    },
    {
      "i": 29,
      "start": 100.0,
      "end": 105.0,
      "text": "Now I'm going to make sure these villains never bother anyone again"
    },
    {
      "i": 30,
      "start": 105.0,
      "end": 110.0,
      "text": "He pulled out his iron bar"
    },
    {
      "i": 31,
      "start": 110.0,
      "end": 114.0,
      "text": "It grew until it was the size of a very tall tree"
    },
    {
      "i": 32,
      "start": 114.0,
      "end": 115.0,
      "text": "Stand back"
    },
    {
      "i": 33,
      "start": 115.0,
