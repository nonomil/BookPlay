    },
    {
      "i": 15,
      "start": 55.0,
      "end": 58.0,
      "text": "Wukong cried the Tang Munk"
    },
    {
      "i": 16,
      "start": 58.0,
      "end": 60.0,
      "text": "Shhh"
    },
    {
      "i": 17,
      "start": 60.0,
      "end": 63.0,
      "text": "The monkey untied the munk"
    },
    {
      "i": 18,
      "start": 63.0,
      "end": 66.0,
      "text": "We must be quiet"
    },
    {
      "i": 19,
      "start": 66.0,
      "end": 70.0,
      "text": "Wukong recited a spell"
    },
    {
      "i": 20,
      "start": 70.0,
      "end": 77.0,
      "text": "A moment later, the sound of snoring drifted into the room"
    },
    {
      "i": 21,
      "start": 77.0,
      "end": 80.0,
      "text": "My spell put the monster in demons to sleep"
    },
    {
