      "end": 33.0,
      "text": "Poor master"
    },
    {
      "i": 8,
      "start": 33.0,
      "end": 36.0,
      "text": "Ukong frowned at his companions"
    },
    {
      "i": 9,
      "start": 36.0,
      "end": 39.0,
      "text": "I can't believe you two believe that monster"
    },
    {
      "i": 10,
      "start": 39.0,
      "end": 41.0,
      "text": "He sighed"
    },
    {
      "i": 11,
      "start": 41.0,
      "end": 43.0,
      "text": "Wait here"
    },
    {
      "i": 12,
      "start": 43.0,
