    },
    {
      "i": 36,
      "start": 131.0,
      "end": 136.0,
      "text": "Wukong looked at the rubble and smiled"
    },
    {
      "i": 37,
      "start": 136.0,
      "end": 141.0,
      "text": "Weeks went by and the travelers arrived in a small town"
    },
    {
      "i": 38,
      "start": 141.0,
      "end": 144.0,
      "text": "Bajay's stomach growled loudly"
    },
    {
      "i": 39,
      "start": 144.0,
      "end": 146.0,
      "text": "Wukong laughed"
    },
    {
      "i": 40,
      "start": 146.0,
      "end": 149.0,
      "text": "I guess we should look for food"
    },
    {
