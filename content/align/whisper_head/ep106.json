{
  "episode": 106,
  "source": "assets/video/ep106.mp4",
  "model": "base",
  "duration": 330.2574375,
  "segments": [
    {
      "i": 1,
      "start": 0.0,
      "end": 5.56,
      "text": "Journey to the West, Chapter 106."
    },
    {
      "i": 2,
      "start": 5.56,
      "end": 12.96,
      "text": "The Question."
    },
    {
      "i": 3,
      "start": 12.96,
      "end": 16.68,
      "text": "Guanyin looked at the messenger in surprise."
    },
    {
      "i": 4,
      "start": 16.68,
      "end": 18.92,
      "text": "What is the problem, she asked?"
    },
    {
      "i": 5,
      "start": 18.92,
      "end": 21.68,
      "text": "It's about the Tang monk."
    },
    {
      "i": 6,
      "start": 21.68,
      "end": 23.68,
      "text": "Said the messenger."
    },
    {
      "i": 7,
      "start": 23.68,
      "end": 28.2,
      "text": "To become a Buddha, he needs to face 100 challenges."
    },
    {
      "i": 8,
      "start": 28.2,
      "end": 32.44,
      "text": "I was just looking at the list of challenges he's faced."
    },
    {
      "i": 9,
      "start": 32.44,
      "end": 36.32,
      "text": "There are only 99 challenges on the list."
    },
    {
      "i": 10,
      "start": 36.32,
      "end": 44.32,
      "text": "He must face one more challenge to become a Buddha."
    },
    {
      "i": 11,
      "start": 44.32,
      "end": 45.96,
      "text": "We're moving so fast."
    },
    {
      "i": 12,
      "start": 45.96,
      "end": 49.04,
      "text": "Said the Tang monk, smiling."
    },
    {
      "i": 13,
      "start": 49.04,
      "end": 51.72,
      "text": "The travelers were flying back east."
    },
    {
      "i": 14,
      "start": 51.72,
      "end": 56.72,
      "text": "The guard from the Thunder Clap monastery was using a spell to carry them."
    },
    {
      "i": 15,
      "start": 57.32,
      "end": 60.0,
      "text": "I wish the whole journey had been this easy."
    },
    {
      "i": 16,
      "start": 60.0,
      "end": 61.6,
      "text": "Said Bajie."
    },
    {
      "i": 17,
      "start": 61.6,
      "end": 63.52,
      "text": "Wukong laughed."
    },
    {
      "i": 18,
      "start": 63.52,
      "end": 67.52,
      "text": "Master was still mortal before we reached the Western Paradise."
    },
    {
      "i": 19,
      "start": 67.52,
      "end": 69.96,
      "text": "He couldn't be carried then."
    },
    {
      "i": 20,
      "start": 69.96,
      "end": 71.68,
      "text": "Wujing looked ahead."
    },
    {
      "i": 21,
      "start": 71.68,
      "end": 75.04,
      "text": "We'll reach the Tang Empire soon."
    },
    {
      "i": 22,
      "start": 75.04,
      "end": 78.52,
      "text": "Just then, a messenger caught up with them."
    },
    {
      "i": 23,
      "start": 78.52,
      "end": 82.0,
      "text": "The messenger whispered something in the guard's ear."
    },
    {
      "i": 24,
      "start": 82.0,
      "end": 85.08,
      "text": "The guard glanced quickly at the travelers."
    },
    {
      "i": 25,
      "start": 85.08,
      "end": 88.64,
      "text": "Then he looked back at the messenger and nodded."
    },
    {
      "i": 26,
      "start": 88.64,
      "end": 93.72,
      "text": "Instantly the spell broke and the travelers fell from the sky."
    },
    {
      "i": 27,
      "start": 93.72,
      "end": 94.72,
      "text": "Bam!"
    },
    {
      "i": 28,
      "start": 94.72,
      "end": 98.92,
      "text": "They slammed into the ground next to a wide river."
    },
    {
      "i": 29,
      "start": 102.12,
      "end": 106.96,
      "text": "Wukong stood up and saw the guard and messenger flying back west."
    },
    {
      "i": 30,
      "start": 106.96,
      "end": 109.16,
      "text": "The monkey shook his head."
    },
    {
      "i": 31,
      "start": 109.16,
      "end": 110.56,
      "text": "What happened?"
    },
    {
      "i": 32,
      "start": 110.56,
      "end": 114.48,
      "text": "The Tang monk stood up and brushed dirt from his robe."
    },
    {
      "i": 33,
      "start": 114.48,
      "end": 117.44,
      "text": "Why did the guard drop us?"
    },
    {
      "i": 34,
      "start": 117.44,
      "end": 118.92,
      "text": "I'll tell you why."
    },
    {
      "i": 35,
      "start": 118.92,
      "end": 120.72,
      "text": "Said Bajie."
    },
    {
      "i": 36,
      "start": 120.72,
      "end": 122.0,
      "text": "He's a villain."
    },
    {
      "i": 37,
      "start": 122.0,
      "end": 125.32,
      "text": "He thinks it's funny to drop people."
    },
    {
      "i": 38,
      "start": 125.32,
      "end": 129.76,
      "text": "The pig waved his fist at the guard who was now far away."
    },
    {
      "i": 39,
      "start": 129.76,
      "end": 131.6,
      "text": "Villain!"
    },
    {
      "i": 40,
      "start": 131.6,
      "end": 134.88,
      "text": "Wukong turned slowly to the Tang monk."
    },
    {
      "i": 41,
      "start": 134.88,
      "end": 138.0,
      "text": "I think I know why he dropped us, master."
    },
    {
      "i": 42,
      "start": 138.0,
      "end": 143.12,
      "text": "You must face 100 challenges in order to become a Buddha."
    },
    {
      "i": 43,
      "start": 143.12,
      "end": 147.36,
      "text": "You probably got to the Western Paradise before you'd faced all of them."
    },
    {
      "i": 44,
      "start": 147.36,
      "end": 148.44,
      "text": "Oh no."
    },
    {
      "i": 45,
      "start": 148.44,
      "end": 150.04,
      "text": "The monk trembled."
    }
  ]
}
