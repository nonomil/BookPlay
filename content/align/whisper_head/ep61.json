{
  "episode": 61,
  "source": "assets/video/ep61.mp4",
  "model": "base",
  "duration": 304.48325,
  "segments": [
    {
      "i": 1,
      "start": 0.0,
      "end": 7.0,
      "text": "Journey to the West Chapter 61, the Demon Under the Ice"
    },
    {
      "i": 2,
      "start": 12.0,
      "end": 19.0,
      "text": "Wukong leaped into the air. His three companions and the horse fell into the water with a splash."
    },
    {
      "i": 3,
      "start": 22.0,
      "end": 25.0,
      "text": "Bajai climbed back out coughing."
    },
    {
      "i": 4,
      "start": 26.0,
      "end": 29.0,
      "text": "Wu-jing came up next, pulling the horse behind him."
    },
    {
      "i": 5,
      "start": 32.0,
      "end": 33.0,
      "text": "Where's the Tang monk?"
    },
    {
      "i": 6,
      "start": 33.0,
      "end": 34.0,
      "text": "Khridwukong."
    },
    {
      "i": 7,
      "start": 35.0,
      "end": 40.0,
      "text": "Below the ice, the Tang monk struggled as the demon carried him deep underwater."
    },
    {
      "i": 8,
      "start": 41.0,
      "end": 43.0,
      "text": "The demon laughed."
    },
    {
      "i": 9,
      "start": 44.0,
      "end": 50.0,
      "text": "You all fell for my trick. I froze the river and waded for you to cross it."
    },
    {
      "i": 10,
      "start": 51.0,
      "end": 54.0,
      "text": "Once you were above me, I cracked the ice open."
    },
    {
      "i": 11,
      "start": 55.0,
      "end": 60.0,
      "text": "As soon as your friends leave, I will eat you and live forever."
    },
    {
      "i": 12,
      "start": 61.0,
      "end": 65.0,
      "text": "They arrived at a palace. A sign over the door read,"
    },
    {
      "i": 13,
      "start": 65.0,
      "end": 67.0,
      "text": "Residence of the River Turtle."
    },
    {
      "i": 14,
      "start": 68.0,
      "end": 71.0,
      "text": "The demon went inside and locked the monk in a stone box."
    },
    {
      "i": 15,
      "start": 73.0,
      "end": 77.0,
      "text": "Up on the ice, Wukong paced back and forth."
    },
    {
      "i": 16,
      "start": 78.0,
      "end": 80.0,
      "text": "The ice didn't crack by accident."
    },
    {
      "i": 17,
      "start": 80.0,
      "end": 81.0,
      "text": "Said the monkey."
    },
    {
      "i": 18,
      "start": 82.0,
      "end": 84.0,
      "text": "I'm sure it was the demon."
    },
    {
      "i": 19,
      "start": 85.0,
      "end": 88.0,
      "text": "The demon probably caused this strange cold weather too."
    },
    {
      "i": 20,
      "start": 90.0,
      "end": 91.0,
      "text": "He made a fest."
    },
    {
      "i": 21,
      "start": 91.0,
      "end": 94.0,
      "text": "I can't believe we fell for his trick."
    },
    {
      "i": 22,
      "start": 94.0,
      "end": 96.0,
      "text": "We must save the Tang monk."
    },
    {
      "i": 23,
      "start": 97.0,
      "end": 100.0,
      "text": "Wukong stopped pacing and looked at his companions."
    },
    {
      "i": 24,
      "start": 101.0,
      "end": 104.0,
      "text": "My powers aren't very strong underwater."
    },
    {
      "i": 25,
      "start": 104.0,
      "end": 107.0,
      "text": "You two must go down there and get the demon to come back up."
    },
    {
      "i": 26,
      "start": 108.0,
      "end": 109.0,
      "text": "I'll surprise him."
    },
    {
      "i": 27,
      "start": 110.0,
      "end": 114.0,
      "text": "Wukong and Bajay nodded and dived into the river."
    },
    {
      "i": 28,
      "start": 115.0,
      "end": 117.0,
      "text": "They soon spotted a palace."
    },
    {
      "i": 29,
      "start": 121.0,
      "end": 123.0,
      "text": "Wukong read the sign over the door."
    },
    {
      "i": 30,
      "start": 123.0,
      "end": 125.0,
      "text": "Residence of the River Turtle."
    },
    {
      "i": 31,
      "start": 125.0,
      "end": 127.0,
      "text": "I wonder if the demon is in here."
    },
    {
      "i": 32,
      "start": 128.0,
      "end": 130.0,
      "text": "Bajay knocked on the door."
    },
    {
      "i": 33,
      "start": 130.0,
      "end": 131.0,
      "text": "Open up!"
    },
    {
      "i": 34,
      "start": 131.0,
      "end": 132.0,
      "text": "He shouted."
    },
    {
      "i": 35,
      "start": 133.0,
      "end": 136.0,
      "text": "The door opened and the demon stepped out."
    },
    {
      "i": 36,
      "start": 137.0,
      "end": 139.0,
      "text": "He was holding a large hammer."
    },
    {
      "i": 37,
      "start": 140.0,
      "end": 141.0,
      "text": "What do you want?"
    },
    {
      "i": 38,
      "start": 142.0,
      "end": 143.0,
      "text": "He asked."
    },
    {
      "i": 39,
      "start": 143.0,
      "end": 145.0,
      "text": "Did you kidnap our master?"
    },
    {
      "i": 40,
      "start": 145.0,
      "end": 146.0,
      "text": "Asked Wukong."
    },
    {
      "i": 41,
      "start": 147.0,
      "end": 148.0,
      "text": "Yes."
    },
    {
      "i": 42,
      "start": 148.0,
      "end": 149.0,
      "text": "Said the demon."
    },
    {
      "i": 43,
      "start": 149.0,
      "end": 150.0,
      "text": "And I planned..."
    }
  ]
}
