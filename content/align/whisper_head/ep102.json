{
  "episode": 102,
  "source": "assets/video/ep102.mp4",
  "model": "base",
  "duration": 321.7356875,
  "segments": [
    {
      "i": 1,
      "start": 0.0,
      "end": 7.0,
      "text": "Journey to the West, Chapter 102. The prisoners are released."
    },
    {
      "i": 2,
      "start": 12.5,
      "end": 15.5,
      "text": "Lady Kuh ran into the courthouse early the next morning."
    },
    {
      "i": 3,
      "start": 17.5,
      "end": 22.0,
      "text": "With tears in her eyes, she told the judge that she had lied the day before."
    },
    {
      "i": 4,
      "start": 24.0,
      "end": 27.0,
      "text": "The Tang monk and his companions are innocent."
    },
    {
      "i": 5,
      "start": 27.3,
      "end": 28.5,
      "text": "Lady Kuh sniffed."
    },
    {
      "i": 6,
      "start": 29.0,
      "end": 30.5,
      "text": "Please release them."
    },
    {
      "i": 7,
      "start": 31.5,
      "end": 33.0,
      "text": "The judge nodded."
    },
    {
      "i": 8,
      "start": 33.5,
      "end": 36.0,
      "text": "I was going to release the prisoners this morning."
    },
    {
      "i": 9,
      "start": 36.5,
      "end": 41.0,
      "text": "He explained how the wandering spirit had visited him the night before."
    },
    {
      "i": 10,
      "start": 41.5,
      "end": 43.0,
      "text": "Lady Kuh gassed."
    },
    {
      "i": 11,
      "start": 43.5,
      "end": 45.5,
      "text": "My husband visited me last night."
    },
    {
      "i": 12,
      "start": 46.0,
      "end": 48.5,
      "text": "We must release the prisoners at once."
    },
    {
      "i": 13,
      "start": 50.0,
      "end": 52.0,
      "text": "They hurried to the Tang monk's cell."
    },
    {
      "i": 14,
      "start": 55.0,
      "end": 57.5,
      "text": "A guard swung open the cell door."
    },
    {
      "i": 15,
      "start": 58.5,
      "end": 60.5,
      "text": "I'm glad to be out of there."
    },
    {
      "i": 16,
      "start": 63.5,
      "end": 65.5,
      "text": "Said Wu-jin."
    },
    {
      "i": 17,
      "start": 67.5,
      "end": 69.5,
      "text": "Me too."
    },
    {
      "i": 18,
      "start": 70.5,
      "end": 72.5,
      "text": "Said Bajie with a yawn."
    },
    {
      "i": 19,
      "start": 73.0,
      "end": 75.5,
      "text": "The beds were very uncomfortable."
    },
    {
      "i": 20,
      "start": 76.5,
      "end": 78.5,
      "text": "Lady Kuh bowed to the Tang monk."
    },
    {
      "i": 21,
      "start": 79.5,
      "end": 81.5,
      "text": "I framed you for killing my husband."
    },
    {
      "i": 22,
      "start": 82.0,
      "end": 82.5,
      "text": "She said."
    },
    {
      "i": 23,
      "start": 83.5,
      "end": 84.5,
      "text": "Please forgive me."
    },
    {
      "i": 24,
      "start": 85.0,
      "end": 87.0,
      "text": "It was a terrible thing to do."
    },
    {
      "i": 25,
      "start": 88.0,
      "end": 89.0,
      "text": "That's right."
    },
    {
      "i": 26,
      "start": 89.0,
      "end": 90.0,
      "text": "Shattered Wu-kong."
    },
    {
      "i": 27,
      "start": 91.0,
      "end": 93.5,
      "text": "It was a really terrible thing to do."
    },
    {
      "i": 28,
      "start": 94.5,
      "end": 97.5,
      "text": "The Tang monk put his hand on the monkey's shoulder."
    },
    {
      "i": 29,
      "start": 98.5,
      "end": 99.5,
      "text": "Don't yell Wu-kong."
    },
    {
      "i": 30,
      "start": 100.0,
      "end": 101.5,
      "text": "He looked at Lady Kuh."
    },
    {
      "i": 31,
      "start": 102.5,
      "end": 103.5,
      "text": "We forgive you."
    },
    {
      "i": 32,
      "start": 104.0,
      "end": 105.5,
      "text": "The squire was a kind man."
    },
    {
      "i": 33,
      "start": 106.0,
      "end": 108.0,
      "text": "His death is a terrible tragedy."
    },
    {
      "i": 34,
      "start": 111.0,
      "end": 112.5,
      "text": "Wu-kong rubbed his chin."
    },
    {
      "i": 35,
      "start": 113.0,
      "end": 115.5,
      "text": "I can probably bring him back to life."
    },
    {
      "i": 36,
      "start": 116.5,
      "end": 119.0,
      "text": "Lady Kuh and the judge were shocked."
    },
    {
      "i": 37,
      "start": 119.5,
      "end": 121.5,
      "text": "Can you really do that?"
    },
    {
      "i": 38,
      "start": 122.0,
      "end": 123.0,
      "text": "Ask Lady Kuh."
    },
    {
      "i": 39,
      "start": 123.5,
      "end": 125.0,
      "text": "The Tang monk smiled."
    },
    {
      "i": 40,
      "start": 125.5,
      "end": 126.5,
      "text": "Yes, he can."
    },
    {
      "i": 41,
      "start": 127.0,
      "end": 130.5,
      "text": "Wu-kong brought the king of the black rooster kingdom back to life."
    },
    {
      "i": 42,
      "start": 131.0,
      "end": 132.5,
      "text": "He turned to the monkey."
    },
    {
      "i": 43,
      "start": 133.0,
      "end": 135.5,
      "text": "The sage, Lausa, helped you that time."
    },
    {
      "i": 44,
      "start": 136.0,
      "end": 137.5,
      "text": "Will you ask him for help again?"
    },
    {
      "i": 45,
      "start": 138.0,
      "end": 138.5,
      "text": "No."
    },
    {
      "i": 46,
      "start": 139.0,
      "end": 140.0,
      "text": "Said Wu-kong."
    },
    {
      "i": 47,
      "start": 140.5,
      "end": 142.0,
      "text": "Lausa doesn't really like me."
    },
    {
      "i": 48,
      "start": 142.0,
      "end": 145.5,
      "text": "I'll go to the land of darkness and talk to the judge of the dead instead."
    }
  ]
}
