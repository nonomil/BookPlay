{
  "episode": 104,
  "source": "assets/video/ep104.mp4",
  "model": "base",
  "duration": 350.66775,
  "segments": [
    {
      "i": 1,
      "start": 0.0,
      "end": 7.0,
      "text": "Journey to the West, Chapter 104, the Tang Monk and the River."
    },
    {
      "i": 2,
      "start": 14.0,
      "end": 18.0,
      "text": "Wukong and his companions walked through the western paradise."
    },
    {
      "i": 3,
      "start": 18.0,
      "end": 23.0,
      "text": "The road weaved through a field of flowers and tore the spirit mountain."
    },
    {
      "i": 4,
      "start": 23.0,
      "end": 28.0,
      "text": "Bajai looked up at the huge mountain and shook his head."
    },
    {
      "i": 5,
      "start": 28.0,
      "end": 31.0,
      "text": "It won't be easy to climb that."
    },
    {
      "i": 6,
      "start": 31.0,
      "end": 33.0,
      "text": "Wukong laughed."
    },
    {
      "i": 7,
      "start": 33.0,
      "end": 36.0,
      "text": "Don't ask me to carry you."
    },
    {
      "i": 8,
      "start": 37.0,
      "end": 42.0,
      "text": "The traveller soon arrived at a river with a strong current."
    },
    {
      "i": 9,
      "start": 42.0,
      "end": 47.0,
      "text": "Waves crashed into jagged rocks, spraying water everywhere."
    },
    {
      "i": 10,
      "start": 48.0,
      "end": 50.0,
      "text": "This river looks dangerous."
    },
    {
      "i": 11,
      "start": 50.0,
      "end": 51.0,
      "text": "Said Wu Jing."
    },
    {
      "i": 12,
      "start": 51.0,
      "end": 55.0,
      "text": "But we must cross it to get to the spirit mountain."
    },
    {
      "i": 13,
      "start": 56.0,
      "end": 57.0,
      "text": "Bajai sighed."
    },
    {
      "i": 14,
      "start": 58.0,
      "end": 62.0,
      "text": "We will never be able to cross this river safely."
    },
    {
      "i": 15,
      "start": 62.0,
      "end": 64.0,
      "text": "Let's just go home."
    },
    {
      "i": 16,
      "start": 64.0,
      "end": 66.0,
      "text": "Nonsense."
    },
    {
      "i": 17,
      "start": 66.0,
      "end": 67.0,
      "text": "Said Wukong."
    },
    {
      "i": 18,
      "start": 68.0,
      "end": 70.0,
      "text": "Look over there."
    },
    {
      "i": 19,
      "start": 70.0,
      "end": 73.0,
      "text": "The monkey pointed upstream."
    },
    {
      "i": 20,
      "start": 73.0,
      "end": 76.0,
      "text": "A thin log lay across the river."
    },
    {
      "i": 21,
      "start": 76.0,
      "end": 80.0,
      "text": "It wobbled and shook as the water rushed under it."
    },
    {
      "i": 22,
      "start": 80.0,
      "end": 83.0,
      "text": "The Tang Monk looked at the log."
    },
    {
      "i": 23,
      "start": 84.0,
      "end": 86.0,
      "text": "Don't be silly, Wukong."
    },
    {
      "i": 24,
      "start": 86.0,
      "end": 88.0,
      "text": "We can't walk across that log."
    },
    {
      "i": 25,
      "start": 88.0,
      "end": 90.0,
      "text": "It's too thin."
    },
    {
      "i": 26,
      "start": 90.0,
      "end": 92.0,
      "text": "And it looks quite slippery."
    },
    {
      "i": 27,
      "start": 92.0,
      "end": 95.0,
      "text": "But that log is the only way to reach the spirit mountain."
    },
    {
      "i": 28,
      "start": 95.0,
      "end": 97.0,
      "text": "Said Wukong."
    },
    {
      "i": 29,
      "start": 97.0,
      "end": 100.0,
      "text": "You must believe that it's safe."
    },
    {
      "i": 30,
      "start": 100.0,
      "end": 102.0,
      "text": "Watch me."
    },
    {
      "i": 31,
      "start": 102.0,
      "end": 107.0,
      "text": "The monkey hopped onto the log and ran across the river and back."
    },
    {
      "i": 32,
      "start": 114.0,
      "end": 116.0,
      "text": "See? He said."
    },
    {
      "i": 33,
      "start": 116.0,
      "end": 118.0,
      "text": "It's safe."
    },
    {
      "i": 34,
      "start": 118.0,
      "end": 120.0,
      "text": "Bajai snorted."
    },
    {
      "i": 35,
      "start": 120.0,
      "end": 123.0,
      "text": "You don't weigh much, Wukong."
    },
    {
      "i": 36,
      "start": 123.0,
      "end": 126.0,
      "text": "But if I step on that log, it will break."
    },
    {
      "i": 37,
      "start": 126.0,
      "end": 128.0,
      "text": "I believe Wukong."
    },
    {
      "i": 38,
      "start": 128.0,
      "end": 130.0,
      "text": "Said Wu Jing."
    },
    {
      "i": 39,
      "start": 130.0,
      "end": 133.0,
      "text": "We must walk across the log."
    },
    {
      "i": 40,
      "start": 134.0,
      "end": 135.0,
      "text": "Follow me, Master."
    },
    {
      "i": 41,
      "start": 135.0,
      "end": 137.0,
      "text": "Said Wukong."
    },
    {
      "i": 42,
      "start": 137.0,
      "end": 140.0,
      "text": "He pulled the Tang Monk toward the log."
    },
    {
      "i": 43,
      "start": 141.0,
      "end": 143.0,
      "text": "The Monk trembled with fear."
    },
    {
      "i": 44,
      "start": 143.0,
      "end": 145.0,
      "text": "Don't pick me up, Wukong."
    },
    {
      "i": 45,
      "start": 145.0,
      "end": 148.0,
      "text": "I'll fall into the river and drown."
    },
    {
      "i": 46,
      "start": 148.0,
      "end": 150.0,
      "text": "Let's just fly over the river."
    }
  ]
}
