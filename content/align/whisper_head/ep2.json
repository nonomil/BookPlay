{
  "episode": 2,
  "source": "assets/video/ep2.mp4",
  "model": "base",
  "duration": 313.56225,
  "segments": [
    {
      "i": 1,
      "start": 0.0,
      "end": 7.0,
      "text": "Journey to the West, Chapter 2, The Waterfall Cave"
    },
    {
      "i": 2,
      "start": 13.0,
      "end": 17.0,
      "text": "Monkey splashed through the waterfall and landed in a large cave."
    },
    {
      "i": 3,
      "start": 19.0,
      "end": 21.0,
      "text": "His eyes opened wide."
    },
    {
      "i": 4,
      "start": 22.0,
      "end": 26.0,
      "text": "The cave was filled with bamboo, trees and beautiful flowers."
    },
    {
      "i": 5,
      "start": 27.0,
      "end": 29.0,
      "text": "Moss covered the walls."
    },
    {
      "i": 6,
      "start": 31.0,
      "end": 36.0,
      "text": "A stream flowed through the cave and glowing light and mist filled the air."
    },
    {
      "i": 7,
      "start": 38.0,
      "end": 42.0,
      "text": "Monkey found a long table with bowls, cups and plates."
    },
    {
      "i": 8,
      "start": 43.0,
      "end": 45.0,
      "text": "A fireplace sat against one wall."
    },
    {
      "i": 9,
      "start": 47.0,
      "end": 51.0,
      "text": "Deeper in the cave, monkey found bedrooms with cozy beds."
    },
    {
      "i": 10,
      "start": 52.0,
      "end": 56.0,
      "text": "Outside, the other monkeys and apes were looking at the waterfall."
    },
    {
      "i": 11,
      "start": 57.0,
      "end": 58.0,
      "text": "Do you think he made it through?"
    },
    {
      "i": 12,
      "start": 59.0,
      "end": 60.0,
      "text": "Asked one monkey."
    },
    {
      "i": 13,
      "start": 61.0,
      "end": 62.0,
      "text": "No."
    },
    {
      "i": 14,
      "start": 62.0,
      "end": 63.0,
      "text": "Said another monkey."
    },
    {
      "i": 15,
      "start": 64.0,
      "end": 67.0,
      "text": "He probably got washed away down the river."
    },
    {
      "i": 16,
      "start": 68.0,
      "end": 70.0,
      "text": "Suddenly splashed."
    },
    {
      "i": 17,
      "start": 71.0,
      "end": 74.0,
      "text": "Monkey shot out of the waterfall and landed in front of the group."
    },
    {
      "i": 18,
      "start": 75.0,
      "end": 77.0,
      "text": "You're alive!"
    },
    {
      "i": 19,
      "start": 78.0,
      "end": 79.0,
      "text": "Said the monkey."
    },
    {
      "i": 20,
      "start": 80.0,
      "end": 81.0,
      "text": "Monkey laughed."
    },
    {
      "i": 21,
      "start": 81.0,
      "end": 83.0,
      "text": "Yes, and we are very lucky."
    },
    {
      "i": 22,
      "start": 84.0,
      "end": 86.0,
      "text": "I found a perfect home for all of us."
    },
    {
      "i": 23,
      "start": 87.0,
      "end": 88.0,
      "text": "Follow me."
    },
    {
      "i": 24,
      "start": 89.0,
      "end": 91.0,
      "text": "Monkey jumped back through the water."
    },
    {
      "i": 25,
      "start": 93.0,
      "end": 95.0,
      "text": "Some of the monkeys scratched their heads."
    },
    {
      "i": 26,
      "start": 96.0,
      "end": 98.0,
      "text": "It still looks dangerous."
    },
    {
      "i": 27,
      "start": 98.0,
      "end": 99.0,
      "text": "Said one monkey."
    },
    {
      "i": 28,
      "start": 101.0,
      "end": 102.0,
      "text": "Let's go."
    },
    {
      "i": 29,
      "start": 102.0,
      "end": 103.0,
      "text": "Said the given."
    },
    {
      "i": 30,
      "start": 103.0,
      "end": 105.0,
      "text": "He leaped through the waterfall."
    },
    {
      "i": 31,
      "start": 106.0,
      "end": 108.0,
      "text": "After that, another monkey jumped through."
    },
    {
      "i": 32,
      "start": 111.0,
      "end": 112.0,
      "text": "Then some more jumped."
    },
    {
      "i": 33,
      "start": 115.0,
      "end": 118.0,
      "text": "Soon, all of the monkeys and apes were in the cave."
    },
    {
      "i": 34,
      "start": 119.0,
      "end": 122.0,
      "text": "Everyone ran around to see all the wonderful things."
    },
    {
      "i": 35,
      "start": 124.0,
      "end": 125.0,
      "text": "This cave is beautiful."
    },
    {
      "i": 36,
      "start": 126.0,
      "end": 127.0,
      "text": "Said the given."
    },
    {
      "i": 37,
      "start": 128.0,
      "end": 130.0,
      "text": "Some of the monkeys and apes began fighting and arguing."
    },
    {
      "i": 38,
      "start": 131.0,
      "end": 133.0,
      "text": "They grabbed plates and bowls from one another."
    },
    {
      "i": 39,
      "start": 134.0,
      "end": 136.0,
      "text": "Others fought over the bedrooms."
    },
    {
      "i": 40,
      "start": 137.0,
      "end": 139.0,
      "text": "I saw this bed first."
    },
    {
      "i": 41,
      "start": 139.0,
      "end": 140.0,
      "text": "Yeld won monkey."
    },
    {
      "i": 42,
      "start": 141.0,
      "end": 142.0,
      "text": "No!"
    },
    {
      "i": 43,
      "start": 142.0,
      "end": 143.0,
      "text": "Yeld another monkey."
    },
    {
      "i": 44,
      "start": 144.0,
      "end": 145.0,
      "text": "I did!"
    },
    {
      "i": 45,
      "start": 145.0,
      "end": 149.0,
      "text": "Monkey watched his friends for a moment and then folded his arms."
    }
  ]
}
