{
  "episode": 36,
  "source": "assets/video/ep36.mp4",
  "model": "base",
  "duration": 329.3750625,
  "segments": [
    {
      "i": 1,
      "start": 0.0,
      "end": 5.0,
      "text": "Journey to the West, Chapter 36."
    },
    {
      "i": 2,
      "start": 5.0,
      "end": 7.0,
      "text": "Trickged again."
    },
    {
      "i": 3,
      "start": 13.0,
      "end": 15.0,
      "text": "Why won't Woo Kong help us?"
    },
    {
      "i": 4,
      "start": 15.0,
      "end": 17.0,
      "text": "The horse asked Bajay."
    },
    {
      "i": 5,
      "start": 17.0,
      "end": 20.0,
      "text": "The pig sighed."
    },
    {
      "i": 6,
      "start": 20.0,
      "end": 23.0,
      "text": "He told us not to look for him if we needed help."
    },
    {
      "i": 7,
      "start": 23.0,
      "end": 27.0,
      "text": "Plus, I kept telling Master to use the tight headband spell."
    },
    {
      "i": 8,
      "start": 27.0,
      "end": 30.0,
      "text": "I'll bet the monkey is really mad at me."
    },
    {
      "i": 9,
      "start": 30.0,
      "end": 32.0,
      "text": "That doesn't matter now."
    },
    {
      "i": 10,
      "start": 32.0,
      "end": 34.0,
      "text": "Said the horse."
    },
    {
      "i": 11,
      "start": 34.0,
      "end": 36.0,
      "text": "You must get Woo Kong to come back."
    },
    {
      "i": 12,
      "start": 36.0,
      "end": 39.0,
      "text": "Bajay hesitated for a moment."
    },
    {
      "i": 13,
      "start": 41.0,
      "end": 43.0,
      "text": "And then leaped onto a cloud."
    },
    {
      "i": 14,
      "start": 43.0,
      "end": 48.0,
      "text": "He soared through the sky and soon arrived at the fruit and flower mountain."
    },
    {
      "i": 15,
      "start": 48.0,
      "end": 52.0,
      "text": "He found Woo Kong sitting beside the big waterfall."
    },
    {
      "i": 16,
      "start": 52.0,
      "end": 55.0,
      "text": "Other monkeys and apes were nearby."
    },
    {
      "i": 17,
      "start": 55.0,
      "end": 57.0,
      "text": "They held swords and spears."
    },
    {
      "i": 18,
      "start": 57.0,
      "end": 60.0,
      "text": "They stared at Bajay silently."
    },
    {
      "i": 19,
      "start": 60.0,
      "end": 62.0,
      "text": "Hello, Woo Kong."
    },
    {
      "i": 20,
      "start": 62.0,
      "end": 64.0,
      "text": "Said the pig."
    },
    {
      "i": 21,
      "start": 64.0,
      "end": 66.0,
      "text": "This is a lovely mountain."
    },
    {
      "i": 22,
      "start": 66.0,
      "end": 68.0,
      "text": "Woo Kong scowled."
    },
    {
      "i": 23,
      "start": 68.0,
      "end": 71.0,
      "text": "What are you doing here, Bajay?"
    },
    {
      "i": 24,
      "start": 71.0,
      "end": 74.0,
      "text": "The pig looked at the ground."
    },
    {
      "i": 25,
      "start": 74.0,
      "end": 77.0,
      "text": "The tank monk would like you to come back."
    },
    {
      "i": 26,
      "start": 77.0,
      "end": 79.0,
      "text": "He mumbled."
    },
    {
      "i": 27,
      "start": 79.0,
      "end": 81.0,
      "text": "Well, that's too bad."
    },
    {
      "i": 28,
      "start": 81.0,
      "end": 83.0,
      "text": "Said Woo Kong standing up."
    },
    {
      "i": 29,
      "start": 83.0,
      "end": 85.0,
      "text": "He told me to leave."
    },
    {
      "i": 30,
      "start": 85.0,
      "end": 88.0,
      "text": "I'll never help him again."
    },
    {
      "i": 31,
      "start": 91.0,
      "end": 93.0,
      "text": "Please come back."
    },
    {
      "i": 32,
      "start": 93.0,
      "end": 94.0,
      "text": "Said Bajay."
    },
    {
      "i": 33,
      "start": 94.0,
      "end": 96.0,
      "text": "We all miss you."
    },
    {
      "i": 34,
      "start": 96.0,
      "end": 98.0,
      "text": "I don't miss you."
    },
    {
      "i": 35,
      "start": 98.0,
      "end": 99.0,
      "text": "Said Woo Kong."
    },
    {
      "i": 36,
      "start": 99.0,
      "end": 103.0,
      "text": "You told Master to use the tight headband spell."
    },
    {
      "i": 37,
      "start": 103.0,
      "end": 108.0,
      "text": "I should take out my iron bar and clobber you."
    },
    {
      "i": 38,
      "start": 108.0,
      "end": 111.0,
      "text": "Bajay forced a laugh."
    },
    {
      "i": 39,
      "start": 111.0,
      "end": 114.0,
      "text": "I was just joking, Woo Kong."
    },
    {
      "i": 40,
      "start": 114.0,
      "end": 119.0,
      "text": "I knew you were really just protecting Master."
    },
    {
      "i": 41,
      "start": 119.0,
      "end": 121.0,
      "text": "It wasn't funny."
    },
    {
      "i": 42,
      "start": 121.0,
      "end": 123.0,
      "text": "Said Woo Kong."
    },
    {
      "i": 43,
      "start": 123.0,
      "end": 126.0,
      "text": "That spell really hurts."
    },
    {
      "i": 44,
      "start": 130.0,
      "end": 132.0,
      "text": "The pig began to cry."
    },
    {
      "i": 45,
      "start": 132.0,
      "end": 134.0,
      "text": "Please come back."
    },
    {
      "i": 46,
      "start": 134.0,
      "end": 136.0,
      "text": "The tank monk is in danger."
    },
    {
      "i": 47,
      "start": 136.0,
      "end": 138.0,
      "text": "Big danger."
    },
    {
      "i": 48,
      "start": 138.0,
      "end": 140.0,
      "text": "A monster turned him into a tiger."
    },
    {
      "i": 49,
      "start": 140.0,
      "end": 143.0,
      "text": "And Woojing was captured."
    },
    {
      "i": 50,
      "start": 144.0,
      "end": 146.0,
      "text": "Woo Kong shrugged."
    },
    {
      "i": 51,
      "start": 146.0,
      "end": 150.0,
      "text": "Just tell the monster that your friends with me, the Monkey King."
    }
  ]
}
