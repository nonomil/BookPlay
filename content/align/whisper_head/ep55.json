{
  "episode": 55,
  "source": "assets/video/ep55.mp4",
  "model": "base",
  "duration": 318.2759375,
  "segments": [
    {
      "i": 1,
      "start": 0.0,
      "end": 7.0,
      "text": "Journey to the West, Chapter 55, The Monks and the Cart."
    },
    {
      "i": 2,
      "start": 18.0,
      "end": 19.5,
      "text": "Everybody, wake up!"
    },
    {
      "i": 3,
      "start": 19.5,
      "end": 21.0,
      "text": "Cold Wukong."
    },
    {
      "i": 4,
      "start": 21.0,
      "end": 24.0,
      "text": "The travelers had camped for a night in the woods."
    },
    {
      "i": 5,
      "start": 25.0,
      "end": 28.0,
      "text": "The Tang Monk woke up and stretched."
    },
    {
      "i": 6,
      "start": 29.0,
      "end": 32.0,
      "text": "Woocing opened his eyes and yawned."
    },
    {
      "i": 7,
      "start": 32.0,
      "end": 33.0,
      "text": "Bajay moaned."
    },
    {
      "i": 8,
      "start": 33.0,
      "end": 35.0,
      "text": "It's too early."
    },
    {
      "i": 9,
      "start": 35.0,
      "end": 38.0,
      "text": "Let me sleep just a few more hours."
    },
    {
      "i": 10,
      "start": 40.0,
      "end": 42.0,
      "text": "Bajay, don't be lazy."
    },
    {
      "i": 11,
      "start": 42.0,
      "end": 43.0,
      "text": "Said the Tang Monk."
    },
    {
      "i": 12,
      "start": 43.0,
      "end": 45.0,
      "text": "It's time to get up."
    },
    {
      "i": 13,
      "start": 45.0,
      "end": 47.0,
      "text": "Please start making breakfast."
    },
    {
      "i": 14,
      "start": 48.0,
      "end": 50.0,
      "text": "The pig got to his feet."
    },
    {
      "i": 15,
      "start": 51.0,
      "end": 53.0,
      "text": "All we do is work."
    },
    {
      "i": 16,
      "start": 53.0,
      "end": 54.0,
      "text": "He said."
    },
    {
      "i": 17,
      "start": 54.0,
      "end": 57.0,
      "text": "Cook food, carry bags, walk, walk, walk."
    },
    {
      "i": 18,
      "start": 59.0,
      "end": 62.0,
      "text": "We're on a noble mission."
    },
    {
      "i": 19,
      "start": 62.0,
      "end": 63.0,
      "text": "Said Wujing."
    },
    {
      "i": 20,
      "start": 63.0,
      "end": 65.0,
      "text": "Because of our difficult journey,"
    },
    {
      "i": 21,
      "start": 65.0,
      "end": 68.0,
      "text": "the Tang Empire will have the true scriptures."
    },
    {
      "i": 22,
      "start": 68.0,
      "end": 71.0,
      "text": "You should be happy to do all this work."
    },
    {
      "i": 23,
      "start": 73.0,
      "end": 77.0,
      "text": "After a quick breakfast, the group started walking."
    },
    {
      "i": 24,
      "start": 77.0,
      "end": 81.0,
      "text": "They went through a valley and over some hills."
    },
    {
      "i": 25,
      "start": 89.0,
      "end": 92.0,
      "text": "Later that afternoon, they heard yelling."
    },
    {
      "i": 26,
      "start": 92.0,
      "end": 94.0,
      "text": "It sounds like some people are in trouble."
    },
    {
      "i": 27,
      "start": 94.0,
      "end": 95.0,
      "text": "Said the Tang Monk."
    },
    {
      "i": 28,
      "start": 95.0,
      "end": 97.0,
      "text": "Woocing nodded."
    },
    {
      "i": 29,
      "start": 97.0,
      "end": 98.0,
      "text": "Yes."
    },
    {
      "i": 30,
      "start": 98.0,
      "end": 100.0,
      "text": "I wonder what's going on."
    },
    {
      "i": 31,
      "start": 100.0,
      "end": 101.0,
      "text": "You all wait here."
    },
    {
      "i": 32,
      "start": 101.0,
      "end": 102.0,
      "text": "Said Wukong."
    },
    {
      "i": 33,
      "start": 102.0,
      "end": 105.0,
      "text": "I'll go and investigate."
    },
    {
      "i": 34,
      "start": 105.0,
      "end": 109.0,
      "text": "The monkey leaped into the air and looked around."
    },
    {
      "i": 35,
      "start": 110.0,
      "end": 115.0,
      "text": "He saw a group of Buddhist monks pushing a cart up a steep hill."
    },
    {
      "i": 36,
      "start": 115.0,
      "end": 118.0,
      "text": "The cart was loaded with big stones."
    },
    {
      "i": 37,
      "start": 118.0,
      "end": 120.0,
      "text": "The monks looked miserable."
    },
    {
      "i": 38,
      "start": 120.0,
      "end": 123.0,
      "text": "Their robes were dirty and ripped."
    },
    {
      "i": 39,
      "start": 123.0,
      "end": 126.0,
      "text": "Two Dallas priests stood nearby."
    },
    {
      "i": 40,
      "start": 126.0,
      "end": 129.0,
      "text": "They were dressed in fine clothes."
    },
    {
      "i": 41,
      "start": 129.0,
      "end": 131.0,
      "text": "Work faster."
    },
    {
      "i": 42,
      "start": 131.0,
      "end": 133.0,
      "text": "Yeld one of the priests."
    },
    {
      "i": 43,
      "start": 133.0,
      "end": 135.0,
      "text": "The Buddhist looked frightened."
    },
    {
      "i": 44,
      "start": 135.0,
      "end": 139.0,
      "text": "They struggled to move the cart faster."
    },
    {
      "i": 45,
      "start": 139.0,
      "end": 141.0,
      "text": "Why are those monks pushing that cart?"
    },
    {
      "i": 46,
      "start": 141.0,
      "end": 143.0,
      "text": "Thought Wukong."
    },
    {
      "i": 47,
      "start": 143.0,
      "end": 146.0,
      "text": "And why are they scared of the Taoists?"
    }
  ]
}
