{
  "episode": 51,
  "source": "assets/video/ep51.mp4",
  "model": "base",
  "duration": 338.8255625,
  "segments": [
    {
      "i": 1,
      "start": 0.0,
      "end": 5.12,
      "text": "Journey to the West, Chapter 51."
    },
    {
      "i": 2,
      "start": 5.12,
      "end": 11.64,
      "text": "Guanyin becomes angry."
    },
    {
      "i": 3,
      "start": 11.64,
      "end": 17.16,
      "text": "Bajie didn't know Guanyin was really Red Boy in disguise."
    },
    {
      "i": 4,
      "start": 17.16,
      "end": 18.88,
      "text": "The Tang Monk is in trouble."
    },
    {
      "i": 5,
      "start": 18.88,
      "end": 21.4,
      "text": "Said the pig to the fake Guanyin."
    },
    {
      "i": 6,
      "start": 21.4,
      "end": 25.4,
      "text": "A demon named Red Boy is planning to eat him."
    },
    {
      "i": 7,
      "start": 25.4,
      "end": 27.44,
      "text": "Can you help us?"
    },
    {
      "i": 8,
      "start": 27.44,
      "end": 28.44,
      "text": "Of course."
    },
    {
      "i": 9,
      "start": 28.44,
      "end": 30.44,
      "text": "Said the fake Guanyin."
    },
    {
      "i": 10,
      "start": 30.44,
      "end": 32.36,
      "text": "I know Red Boy."
    },
    {
      "i": 11,
      "start": 32.36,
      "end": 34.2,
      "text": "He's very nice."
    },
    {
      "i": 12,
      "start": 34.2,
      "end": 39.08,
      "text": "I doubt he'll harm the Tang Monk."
    },
    {
      "i": 13,
      "start": 39.08,
      "end": 47.28,
      "text": "Let's go to Red Boy's cave and talk to him."
    },
    {
      "i": 14,
      "start": 47.28,
      "end": 53.72,
      "text": "Bajie and the fake Guanyin flew to Red Boy's cave."
    },
    {
      "i": 15,
      "start": 53.72,
      "end": 59.04,
      "text": "Bajie went in first."
    },
    {
      "i": 16,
      "start": 59.04,
      "end": 64.44,
      "text": "Red Boy returned to his normal appearance and then sneaked up behind Bajie."
    },
    {
      "i": 17,
      "start": 64.44,
      "end": 67.56,
      "text": "He threw a sack over the pig."
    },
    {
      "i": 18,
      "start": 67.56,
      "end": 69.72,
      "text": "Hey, what's going on?"
    },
    {
      "i": 19,
      "start": 69.72,
      "end": 71.72,
      "text": "Shouted Bajie."
    },
    {
      "i": 20,
      "start": 71.72,
      "end": 75.12,
      "text": "I'm not Guanyin you fool."
    },
    {
      "i": 21,
      "start": 75.12,
      "end": 76.12,
      "text": "The demon laughed."
    },
    {
      "i": 22,
      "start": 76.12,
      "end": 82.64,
      "text": "I'm Red Boy and now you're trapped."
    },
    {
      "i": 23,
      "start": 83.64,
      "end": 90.96,
      "text": "The demon locked Bajie in a room."
    },
    {
      "i": 24,
      "start": 90.96,
      "end": 93.0,
      "text": "Why isn't Bajie back yet?"
    },
    {
      "i": 25,
      "start": 93.0,
      "end": 94.64,
      "text": "Asked Wu Jing."
    },
    {
      "i": 26,
      "start": 94.64,
      "end": 96.52,
      "text": "Wu Kong crowned."
    },
    {
      "i": 27,
      "start": 96.52,
      "end": 99.12,
      "text": "He probably stopped to take a nap."
    },
    {
      "i": 28,
      "start": 99.12,
      "end": 101.88,
      "text": "That pig is so lazy."
    },
    {
      "i": 29,
      "start": 101.88,
      "end": 102.88,
      "text": "Wu Jing nodded."
    },
    {
      "i": 30,
      "start": 102.88,
      "end": 105.2,
      "text": "Yes, he's very lazy."
    },
    {
      "i": 31,
      "start": 105.2,
      "end": 106.92,
      "text": "What should we do now?"
    },
    {
      "i": 32,
      "start": 106.92,
      "end": 110.12,
      "text": "I'm going to sneak into Red Boy's cave."
    },
    {
      "i": 33,
      "start": 110.12,
      "end": 112.36,
      "text": "Said Wu Kong."
    },
    {
      "i": 34,
      "start": 112.36,
      "end": 116.0,
      "text": "I want to make sure the Tang Monk is still alive."
    },
    {
      "i": 35,
      "start": 116.0,
      "end": 118.6,
      "text": "Then I'll go to Guanyin myself."
    },
    {
      "i": 36,
      "start": 118.6,
      "end": 125.36,
      "text": "The monkey turned himself into a bee and flew up the mountain."
    },
    {
      "i": 37,
      "start": 125.36,
      "end": 130.56,
      "text": "He slipped through the cave door and flew down a long tunnel."
    },
    {
      "i": 38,
      "start": 130.56,
      "end": 135.56,
      "text": "Soon he heard the Tang Monk crying."
    },
    {
      "i": 39,
      "start": 135.56,
      "end": 136.56,
      "text": "Master is scared."
    },
    {
      "i": 40,
      "start": 136.56,
      "end": 137.88,
      "text": "Thought Wu Kong."
    },
    {
      "i": 41,
      "start": 137.88,
      "end": 141.08,
      "text": "But at least he's still alive."
    },
    {
      "i": 42,
      "start": 141.08,
      "end": 143.4,
      "text": "The monkey then heard a shout."
    },
    {
      "i": 43,
      "start": 143.4,
      "end": 144.88,
      "text": "It was Bajie."
    },
    {
      "i": 44,
      "start": 144.88,
      "end": 146.64,
      "text": "You filthy demon."
    },
    {
      "i": 45,
      "start": 146.64,
      "end": 149.56,
      "text": "How dare you make yourself look like Guanyin and fool me."
    }
  ]
}
