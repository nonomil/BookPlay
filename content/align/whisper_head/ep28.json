{
  "episode": 28,
  "source": "assets/video/ep28.mp4",
  "model": "base",
  "duration": 315.0019375,
  "segments": [
    {
      "i": 1,
      "start": 0.0,
      "end": 3.76,
      "text": "Journey to the West."
    },
    {
      "i": 2,
      "start": 3.76,
      "end": 5.32,
      "text": "Chapter 28."
    },
    {
      "i": 3,
      "start": 5.32,
      "end": 15.6,
      "text": "Wukong leaves his body."
    },
    {
      "i": 4,
      "start": 15.6,
      "end": 18.72,
      "text": "Bajai looked out the kitchen window."
    },
    {
      "i": 5,
      "start": 18.72,
      "end": 22.2,
      "text": "Wukong and Wu-Jing were outside talking."
    },
    {
      "i": 6,
      "start": 22.2,
      "end": 24.76,
      "text": "Wukong, Wu-Jing."
    },
    {
      "i": 7,
      "start": 24.76,
      "end": 26.76,
      "text": "Said the pig quietly."
    },
    {
      "i": 8,
      "start": 26.76,
      "end": 28.04,
      "text": "I'm over here."
    },
    {
      "i": 9,
      "start": 28.04,
      "end": 30.76,
      "text": "I want to tell you something."
    },
    {
      "i": 10,
      "start": 30.76,
      "end": 34.92,
      "text": "The two companions came over to the window."
    },
    {
      "i": 11,
      "start": 34.92,
      "end": 35.92,
      "text": "What is it?"
    },
    {
      "i": 12,
      "start": 35.92,
      "end": 36.92,
      "text": "Asked Wu-Jing."
    },
    {
      "i": 13,
      "start": 36.92,
      "end": 39.44,
      "text": "I heard the two priests talking."
    },
    {
      "i": 14,
      "start": 39.44,
      "end": 41.24,
      "text": "Said the pig."
    },
    {
      "i": 15,
      "start": 41.24,
      "end": 44.36,
      "text": "There's a jinsang tray at this abbey."
    },
    {
      "i": 16,
      "start": 44.36,
      "end": 48.04,
      "text": "They said it's fruit is delicious and valuable."
    },
    {
      "i": 17,
      "start": 48.04,
      "end": 49.72,
      "text": "Wukong smiled."
    },
    {
      "i": 18,
      "start": 49.72,
      "end": 52.4,
      "text": "The fruit must taste wonderful."
    },
    {
      "i": 19,
      "start": 52.4,
      "end": 53.56,
      "text": "We should eat some."
    },
    {
      "i": 20,
      "start": 53.56,
      "end": 57.16,
      "text": "Said Wu-Jing, Bajai rubbed his belly."
    },
    {
      "i": 21,
      "start": 57.16,
      "end": 58.16,
      "text": "Yes."
    },
    {
      "i": 22,
      "start": 58.16,
      "end": 59.16,
      "text": "He said."
    },
    {
      "i": 23,
      "start": 59.16,
      "end": 60.16,
      "text": "We should."
    },
    {
      "i": 24,
      "start": 60.16,
      "end": 62.0,
      "text": "You two wait here."
    },
    {
      "i": 25,
      "start": 62.0,
      "end": 63.0,
      "text": "Said Wukong."
    },
    {
      "i": 26,
      "start": 63.0,
      "end": 68.56,
      "text": "I'll go pick some of that fruit."
    },
    {
      "i": 27,
      "start": 68.56,
      "end": 73.08,
      "text": "The monkey went behind the abbey and found the giant jinsing tree."
    },
    {
      "i": 28,
      "start": 73.08,
      "end": 78.16,
      "text": "The fruit sparkled in the sunlight."
    },
    {
      "i": 29,
      "start": 78.16,
      "end": 84.68,
      "text": "He plucked three pieces from the tree's branches and went back to the kitchen."
    },
    {
      "i": 30,
      "start": 84.68,
      "end": 89.56,
      "text": "He handed Bajai and Wu-Jing each a jinsing fruit."
    },
    {
      "i": 31,
      "start": 89.56,
      "end": 93.12,
      "text": "Wu-Jing took a bite."
    },
    {
      "i": 32,
      "start": 93.12,
      "end": 95.32,
      "text": "This fruit is delicious."
    },
    {
      "i": 33,
      "start": 95.32,
      "end": 96.32,
      "text": "Yes."
    },
    {
      "i": 34,
      "start": 96.32,
      "end": 97.32,
      "text": "Said Wukong."
    },
    {
      "i": 35,
      "start": 97.32,
      "end": 100.36,
      "text": "It truly is."
    },
    {
      "i": 36,
      "start": 100.36,
      "end": 105.2,
      "text": "Bajai opened his mouth wide and threw his jinsing fruit in."
    },
    {
      "i": 37,
      "start": 105.2,
      "end": 106.2,
      "text": "Gulp."
    },
    {
      "i": 38,
      "start": 107.2,
      "end": 109.64,
      "text": "Bajai, you should be ashamed of yourself."
    },
    {
      "i": 39,
      "start": 109.64,
      "end": 111.16,
      "text": "Said Wukong."
    },
    {
      "i": 40,
      "start": 111.16,
      "end": 113.2,
      "text": "You didn't even chew."
    },
    {
      "i": 41,
      "start": 113.2,
      "end": 116.2,
      "text": "I was too hungry to chew."
    },
    {
      "i": 42,
      "start": 116.2,
      "end": 118.16,
      "text": "Said the pig."
    },
    {
      "i": 43,
      "start": 118.16,
      "end": 120.68,
      "text": "He groaned."
    },
    {
      "i": 44,
      "start": 120.68,
      "end": 123.96,
      "text": "And now I wish I had another jinsing fruit."
    },
    {
      "i": 45,
      "start": 123.96,
      "end": 127.56,
      "text": "I didn't even taste that one."
    },
    {
      "i": 46,
      "start": 127.56,
      "end": 132.84,
      "text": "At that moment, the two priests were walking past the kitchen."
    },
    {
      "i": 47,
      "start": 132.84,
      "end": 134.24,
      "text": "Did you hear what the pig said?"
    },
    {
      "i": 48,
      "start": 134.24,
      "end": 135.96,
      "text": "Whispered one priest."
    },
    {
      "i": 49,
      "start": 135.96,
      "end": 140.08,
      "text": "I think the Tang monks' companions are eating the jinsing fruit."
    },
    {
      "i": 50,
      "start": 140.08,
      "end": 145.28,
      "text": "The two priests ran outside and searched the jinsing tree."
    },
    {
      "i": 51,
      "start": 145.28,
      "end": 149.2,
      "text": "Three pieces of fruit were gone."
    },
    {
      "i": 52,
      "start": 149.2,
      "end": 149.96,
      "text": "This is terrible."
    }
  ]
}
