{
  "episode": 75,
  "source": "assets/video/ep75.mp4",
  "model": "base",
  "duration": 319.971,
  "segments": [
    {
      "i": 1,
      "start": 0.0,
      "end": 11.72,
      "text": "Journey to the West Chapter 75 Battle of the Wukongs"
    },
    {
      "i": 2,
      "start": 11.72,
      "end": 15.32,
      "text": "The two Wukongs stared at Curious Year."
    },
    {
      "i": 3,
      "start": 15.32,
      "end": 17.36,
      "text": "I'm the real Wukong!"
    },
    {
      "i": 4,
      "start": 17.36,
      "end": 18.92,
      "text": "Shattered one monkey."
    },
    {
      "i": 5,
      "start": 18.92,
      "end": 19.92,
      "text": "Right?"
    },
    {
      "i": 6,
      "start": 19.92,
      "end": 21.96,
      "text": "No, it's me!"
    },
    {
      "i": 7,
      "start": 21.96,
      "end": 23.16,
      "text": "Shattered the other monkey?"
    },
    {
      "i": 8,
      "start": 23.16,
      "end": 27.64,
      "text": "I know which of you is the fake Sun Wukong."
    },
    {
      "i": 9,
      "start": 27.64,
      "end": 29.88,
      "text": "Said Curious Year."
    },
    {
      "i": 10,
      "start": 29.88,
      "end": 33.28,
      "text": "But I won't say who it is."
    },
    {
      "i": 11,
      "start": 33.28,
      "end": 39.04,
      "text": "The fake Sun Wukong has all the same powers as the real one."
    },
    {
      "i": 12,
      "start": 39.04,
      "end": 41.88,
      "text": "If I point him out, he'll be angry."
    },
    {
      "i": 13,
      "start": 41.88,
      "end": 44.88,
      "text": "He could destroy the entire palace."
    },
    {
      "i": 14,
      "start": 44.88,
      "end": 46.64,
      "text": "It's true."
    },
    {
      "i": 15,
      "start": 46.64,
      "end": 48.48,
      "text": "Said one Wukong."
    },
    {
      "i": 16,
      "start": 48.48,
      "end": 52.36,
      "text": "I could destroy this whole palace if I wanted to."
    },
    {
      "i": 17,
      "start": 52.36,
      "end": 54.6,
      "text": "You mean I could destroy it?"
    },
    {
      "i": 18,
      "start": 54.6,
      "end": 56.16,
      "text": "Said the other Wukong."
    },
    {
      "i": 19,
      "start": 56.16,
      "end": 57.16,
      "text": "No."
    },
    {
      "i": 20,
      "start": 57.16,
      "end": 58.16,
      "text": "Yeld the other."
    },
    {
      "i": 21,
      "start": 58.16,
      "end": 59.16,
      "text": "I could."
    },
    {
      "i": 22,
      "start": 60.16,
      "end": 64.16,
      "text": "The two Wukongs began swinging their iron bars at each other."
    },
    {
      "i": 23,
      "start": 66.16,
      "end": 68.16,
      "text": "Please stop!"
    },
    {
      "i": 24,
      "start": 68.16,
      "end": 70.16,
      "text": "Cry the judge of the dead."
    },
    {
      "i": 25,
      "start": 70.16,
      "end": 73.16,
      "text": "You'll turn this whole palace down!"
    },
    {
      "i": 26,
      "start": 73.16,
      "end": 75.16,
      "text": "The monkey stopped."
    },
    {
      "i": 27,
      "start": 77.16,
      "end": 79.16,
      "text": "Boona can help you."
    },
    {
      "i": 28,
      "start": 79.16,
      "end": 81.16,
      "text": "Said Curious Year."
    },
    {
      "i": 29,
      "start": 81.16,
      "end": 85.16,
      "text": "He'll be able to see which of you is the real Wukong."
    },
    {
      "i": 30,
      "start": 86.16,
      "end": 90.16,
      "text": "And he's powerful enough to destroy the fake one."
    },
    {
      "i": 31,
      "start": 90.16,
      "end": 91.16,
      "text": "Of course!"
    },
    {
      "i": 32,
      "start": 91.16,
      "end": 93.16,
      "text": "Cryed one Wukong."
    },
    {
      "i": 33,
      "start": 93.16,
      "end": 95.16,
      "text": "Will go see Boona."
    },
    {
      "i": 34,
      "start": 95.16,
      "end": 97.16,
      "text": "Oh, um, sure."
    },
    {
      "i": 35,
      "start": 97.16,
      "end": 99.16,
      "text": "Said the other Wukong."
    },
    {
      "i": 36,
      "start": 99.16,
      "end": 101.16,
      "text": "He looked worried."
    },
    {
      "i": 37,
      "start": 101.16,
      "end": 102.16,
      "text": "You're nervous?"
    },
    {
      "i": 38,
      "start": 102.16,
      "end": 104.16,
      "text": "Said the first Wukong."
    },
    {
      "i": 39,
      "start": 104.16,
      "end": 108.16,
      "text": "That's because you know Boona is going to see who you really are."
    },
    {
      "i": 40,
      "start": 108.16,
      "end": 109.16,
      "text": "No."
    },
    {
      "i": 41,
      "start": 109.16,
      "end": 111.16,
      "text": "Shattered the other Wukong."
    },
    {
      "i": 42,
      "start": 111.16,
      "end": 114.16,
      "text": "He swung his iron bar furiously."
    },
    {
      "i": 43,
      "start": 114.16,
      "end": 116.16,
      "text": "Get out!"
    },
    {
      "i": 44,
      "start": 116.16,
      "end": 118.16,
      "text": "Cry the judge of the dead."
    },
    {
      "i": 45,
      "start": 118.16,
      "end": 121.16,
      "text": "Take your fight somewhere else!"
    },
    {
      "i": 46,
      "start": 123.16,
      "end": 127.16,
      "text": "The two Wukongs left the land of darkness."
    },
    {
      "i": 47,
      "start": 127.16,
      "end": 134.16,
      "text": "Clouds swirled and thunder boomed as the two mighty spirits battled across the sky."
    },
    {
      "i": 48,
      "start": 134.16,
      "end": 138.16,
      "text": "They soon arrived in the western paradise."
    },
    {
      "i": 49,
      "start": 139.16,
      "end": 143.16,
      "text": "A guard rushed out of the thunder-clap monastery."
    },
    {
      "i": 50,
      "start": 143.16,
      "end": 145.16,
      "text": "Stop fighting immediately."
    },
    {
      "i": 51,
      "start": 145.16,
      "end": 147.16,
      "text": "He called up to them."
    },
    {
      "i": 52,
      "start": 147.16,
      "end": 149.16,
      "text": "Tell me who you are."
    },
    {
      "i": 53,
      "start": 149.16,
      "end": 151.16,
      "text": "The two Wukong."
    }
  ]
}
