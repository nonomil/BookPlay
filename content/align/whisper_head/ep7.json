{
  "episode": 7,
  "source": "assets/video/ep7.mp4",
  "model": "base",
  "duration": 350.6445625,
  "segments": [
    {
      "i": 1,
      "start": 0.0,
      "end": 14.78,
      "text": "Journey to the West, Chapter 7, The Land of Darkness."
    },
    {
      "i": 2,
      "start": 14.78,
      "end": 19.76,
      "text": "Sun Wukong put his hand on the iron pillar."
    },
    {
      "i": 3,
      "start": 19.76,
      "end": 21.76,
      "text": "He felt it move."
    },
    {
      "i": 4,
      "start": 21.76,
      "end": 24.02,
      "text": "Hmm, he thought."
    },
    {
      "i": 5,
      "start": 24.02,
      "end": 26.8,
      "text": "This piece of iron really is magical."
    },
    {
      "i": 6,
      "start": 26.8,
      "end": 29.96,
      "text": "I bet it will do whatever I want it to do."
    },
    {
      "i": 7,
      "start": 29.96,
      "end": 30.96,
      "text": "Smaller!"
    },
    {
      "i": 8,
      "start": 30.96,
      "end": 32.84,
      "text": "Commandant Wukong."
    },
    {
      "i": 9,
      "start": 32.84,
      "end": 34.84,
      "text": "The pillar shrank."
    },
    {
      "i": 10,
      "start": 34.84,
      "end": 40.64,
      "text": "Soon it was just a little taller than Wukong."
    },
    {
      "i": 11,
      "start": 40.64,
      "end": 45.32,
      "text": "He picked it up and swung it around."
    },
    {
      "i": 12,
      "start": 45.32,
      "end": 47.32,
      "text": "This is a perfect weapon for me."
    },
    {
      "i": 13,
      "start": 47.32,
      "end": 48.32,
      "text": "He said."
    },
    {
      "i": 14,
      "start": 48.32,
      "end": 51.88,
      "text": "I can't believe he can lift it!"
    },
    {
      "i": 15,
      "start": 51.88,
      "end": 54.12,
      "text": "Said the dragon queen."
    },
    {
      "i": 16,
      "start": 54.12,
      "end": 57.6,
      "text": "Wukong made the bar even smaller."
    },
    {
      "i": 17,
      "start": 57.6,
      "end": 60.4,
      "text": "Soon it was no bigger than a pin."
    },
    {
      "i": 18,
      "start": 60.4,
      "end": 63.04,
      "text": "He placed it inside his ear."
    },
    {
      "i": 19,
      "start": 63.04,
      "end": 67.24,
      "text": "I've got what I want."
    },
    {
      "i": 20,
      "start": 67.24,
      "end": 68.24,
      "text": "Said Wukong."
    },
    {
      "i": 21,
      "start": 68.24,
      "end": 69.24,
      "text": "Goodbye."
    },
    {
      "i": 22,
      "start": 69.24,
      "end": 73.04,
      "text": "He turned around and left."
    },
    {
      "i": 23,
      "start": 73.04,
      "end": 77.04,
      "text": "He was very rude."
    },
    {
      "i": 24,
      "start": 77.04,
      "end": 79.24,
      "text": "Said the dragon queen."
    },
    {
      "i": 25,
      "start": 79.24,
      "end": 81.52,
      "text": "The dragon king clenched his fists."
    },
    {
      "i": 26,
      "start": 82.24,
      "end": 88.52,
      "text": "I'm going to report him to the Jade Emperor."
    },
    {
      "i": 27,
      "start": 88.52,
      "end": 95.88,
      "text": "Back home, the others were amazed by Wukong's new weapon."
    },
    {
      "i": 28,
      "start": 95.88,
      "end": 98.04,
      "text": "Nobody will ever attack us again."
    },
    {
      "i": 29,
      "start": 98.04,
      "end": 100.24,
      "text": "Declared Wukong."
    },
    {
      "i": 30,
      "start": 100.24,
      "end": 102.96,
      "text": "The monkeys and eights cheered."
    },
    {
      "i": 31,
      "start": 102.96,
      "end": 110.96,
      "text": "They held a big feast that lasted until late at night."
    },
    {
      "i": 32,
      "start": 110.96,
      "end": 116.04,
      "text": "Wukong went to bed happy."
    },
    {
      "i": 33,
      "start": 116.04,
      "end": 121.08,
      "text": "But as he fell asleep, two spirits grabbed him."
    },
    {
      "i": 34,
      "start": 121.08,
      "end": 122.4,
      "text": "What are you doing?"
    },
    {
      "i": 35,
      "start": 122.4,
      "end": 123.88,
      "text": "Ask Wukong."
    },
    {
      "i": 36,
      "start": 123.88,
      "end": 131.68,
      "text": "Let go of me."
    },
    {
      "i": 37,
      "start": 131.68,
      "end": 137.32,
      "text": "He kicked and struggled as the spirits dragged him out of his cave."
    },
    {
      "i": 38,
      "start": 137.32,
      "end": 140.36,
      "text": "They walked toward a dark and creepy city."
    },
    {
      "i": 39,
      "start": 140.36,
      "end": 146.04,
      "text": "A sign on the entrance gate said land of darkness."
    },
    {
      "i": 40,
      "start": 146.04,
      "end": 147.56,
      "text": "The land of darkness?"
    },
    {
      "i": 41,
      "start": 147.56,
      "end": 149.36,
      "text": "Cryed Wukong."
    },
    {
      "i": 42,
      "start": 149.36,
      "end": 150.04,
      "text": "That's where people..."
    }
  ]
}
