{
  "episode": 34,
  "source": "assets/video/ep34.mp4",
  "model": "base",
  "duration": 329.723375,
  "segments": [
    {
      "i": 1,
      "start": 0.0,
      "end": 3.92,
      "text": "Journey to the West."
    },
    {
      "i": 2,
      "start": 3.92,
      "end": 5.36,
      "text": "Chapter 34."
    },
    {
      "i": 3,
      "start": 5.36,
      "end": 12.62,
      "text": "Tricked by the Princess."
    },
    {
      "i": 4,
      "start": 12.62,
      "end": 15.44,
      "text": "The Tang Monk was tied up in a room."
    },
    {
      "i": 5,
      "start": 15.44,
      "end": 18.36,
      "text": "He heard his companions yelling at the monster."
    },
    {
      "i": 6,
      "start": 18.36,
      "end": 21.2,
      "text": "And over the Tang Monk now!"
    },
    {
      "i": 7,
      "start": 21.2,
      "end": 22.6,
      "text": "Shada Bajay."
    },
    {
      "i": 8,
      "start": 22.6,
      "end": 25.48,
      "text": "Clang!"
    },
    {
      "i": 9,
      "start": 25.48,
      "end": 28.32,
      "text": "The Tang Monk heard the sound of weapons clashing."
    },
    {
      "i": 10,
      "start": 29.04,
      "end": 30.32,
      "text": "I hope they rescue me."
    },
    {
      "i": 11,
      "start": 30.32,
      "end": 33.52,
      "text": "Said the Monk."
    },
    {
      "i": 12,
      "start": 33.52,
      "end": 37.32,
      "text": "A young woman entered the room."
    },
    {
      "i": 13,
      "start": 37.32,
      "end": 38.32,
      "text": "Who are you?"
    },
    {
      "i": 14,
      "start": 38.32,
      "end": 40.4,
      "text": "Ask the Tang Monk."
    },
    {
      "i": 15,
      "start": 40.4,
      "end": 41.88,
      "text": "I'm a prisoner here."
    },
    {
      "i": 16,
      "start": 41.88,
      "end": 43.44,
      "text": "Said the woman."
    },
    {
      "i": 17,
      "start": 43.44,
      "end": 46.52,
      "text": "That monster kidnapped me 13 years ago."
    },
    {
      "i": 18,
      "start": 46.52,
      "end": 48.68,
      "text": "And won't let me leave."
    },
    {
      "i": 19,
      "start": 48.68,
      "end": 50.68,
      "text": "Will you help me?"
    },
    {
      "i": 20,
      "start": 50.68,
      "end": 52.24,
      "text": "I wish I could help you."
    },
    {
      "i": 21,
      "start": 52.24,
      "end": 54.48,
      "text": "Said the Tang Monk."
    },
    {
      "i": 22,
      "start": 54.48,
      "end": 57.68,
      "text": "He showed the young woman his ropes."
    },
    {
      "i": 23,
      "start": 57.68,
      "end": 59.28,
      "text": "I can help you get free."
    },
    {
      "i": 24,
      "start": 59.28,
      "end": 61.0,
      "text": "Said the young woman."
    },
    {
      "i": 25,
      "start": 61.0,
      "end": 65.36,
      "text": "If I do, will you deliver a letter to my parents?"
    },
    {
      "i": 26,
      "start": 65.36,
      "end": 66.2,
      "text": "Of course."
    },
    {
      "i": 27,
      "start": 66.2,
      "end": 67.68,
      "text": "Said the Monk."
    },
    {
      "i": 28,
      "start": 67.68,
      "end": 69.92,
      "text": "Who are your parents?"
    },
    {
      "i": 29,
      "start": 69.92,
      "end": 73.56,
      "text": "They're the king and queen of the precious image kingdom."
    },
    {
      "i": 30,
      "start": 73.56,
      "end": 75.48,
      "text": "Said the young woman."
    },
    {
      "i": 31,
      "start": 75.48,
      "end": 78.72,
      "text": "My name is Princess Hundred Flowers."
    },
    {
      "i": 32,
      "start": 82.04,
      "end": 85.28,
      "text": "Bajay and Wu Jing were still fighting the monster"
    },
    {
      "i": 33,
      "start": 85.28,
      "end": 87.44,
      "text": "when the princess ran outside."
    },
    {
      "i": 34,
      "start": 90.68,
      "end": 91.84,
      "text": "Monster!"
    },
    {
      "i": 35,
      "start": 91.84,
      "end": 93.2,
      "text": "She cried."
    },
    {
      "i": 36,
      "start": 93.2,
      "end": 96.24,
      "text": "I must ask you a favor."
    },
    {
      "i": 37,
      "start": 96.24,
      "end": 98.52,
      "text": "Right away, the monster stopped fighting"
    },
    {
      "i": 38,
      "start": 98.52,
      "end": 100.88,
      "text": "and turned to the princess."
    },
    {
      "i": 39,
      "start": 100.88,
      "end": 103.84,
      "text": "What can I do for you, my sweet?"
    },
    {
      "i": 40,
      "start": 103.84,
      "end": 105.92,
      "text": "Ask the monster."
    },
    {
      "i": 41,
      "start": 105.92,
      "end": 109.2,
      "text": "There's a monk inside, said the princess."
    },
    {
      "i": 42,
      "start": 109.2,
      "end": 112.6,
      "text": "It makes me so sad to see him tied up."
    },
    {
      "i": 43,
      "start": 112.6,
      "end": 114.84,
      "text": "Won't you let him go?"
    },
    {
      "i": 44,
      "start": 114.84,
      "end": 118.08,
      "text": "The monster hesitated."
    },
    {
      "i": 45,
      "start": 118.08,
      "end": 121.56,
      "text": "That monk isn't an ordinary monk."
    },
    {
      "i": 46,
      "start": 121.56,
      "end": 123.76,
      "text": "He's the..."
    },
    {
      "i": 47,
      "start": 123.76,
      "end": 127.4,
      "text": "Princess Hundred Flowers pretended to cry."
    },
    {
      "i": 48,
      "start": 127.4,
      "end": 129.8,
      "text": "The monster held up his hands."
    },
    {
      "i": 49,
      "start": 129.8,
      "end": 132.28,
      "text": "OK, OK, sweetie."
    },
    {
      "i": 50,
      "start": 132.28,
      "end": 135.76,
      "text": "You know I only want you to be happy."
    },
    {
      "i": 51,
      "start": 135.76,
      "end": 138.52,
      "text": "The monk may go."
    },
    {
      "i": 52,
      "start": 138.52,
      "end": 142.08,
      "text": "The monster followed the princess back inside."
    },
    {
      "i": 53,
      "start": 142.12,
      "end": 146.24,
      "text": "Bajay and Wu Jing looked at each other in confusion."
    },
    {
      "i": 54,
      "start": 146.24,
      "end": 148.32,
      "text": "The monster is going to free him."
    },
    {
      "i": 55,
      "start": 148.32,
      "end": 149.92,
      "text": "Mumbled Bajay."
    }
  ]
}
