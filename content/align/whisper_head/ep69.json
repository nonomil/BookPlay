  "segments": [
    {
      "i": 1,
      "start": 0.0,
      "end": 12.8,
      "text": "Journey to the West, Chapter 69, the stabbing pain."
    },
    {
      "i": 2,
      "start": 12.8,
      "end": 14.84,
      "text": "That woman was a demon!"
    },
    {
      "i": 3,
      "start": 14.84,
      "end": 19.48,
      "text": "Cryed Wukong, and she kidnapped the Tang monk."
    },
    {
      "i": 4,
      "start": 19.48,
      "end": 24.16,
      "text": "He leaped into the air and Bajay and Wu Xing followed."
    },
    {
      "i": 5,
      "start": 24.16,
      "end": 29.4,
      "text": "In the distance, the monkey saw dark clouds speeding toward a mountain."
    },
    {
      "i": 6,
      "start": 29.4,
      "end": 30.4,
      "text": "It must be her!"
    },
    {
      "i": 7,
      "start": 30.4,
      "end": 31.4,
      "text": "Said Wu Kong."
    },
    {
      "i": 8,
      "start": 31.4,
      "end": 32.4,
      "text": "Quickly!"
    },
    {
      "i": 9,
      "start": 32.4,
      "end": 34.4,
      "text": "Said Wu Xing."
    },
    {
      "i": 10,
      "start": 34.4,
      "end": 37.52,
      "text": "We must catch her!"
    },
    {
      "i": 11,
      "start": 37.52,
      "end": 43.0,
      "text": "They raced after the cloud, which disappeared when it reached the mountain."
    },
    {
      "i": 12,
      "start": 43.0,
      "end": 47.32,
      "text": "They soon arrived at the mountain and found a cave."
    },
    {
      "i": 13,
      "start": 47.32,
      "end": 49.76,
      "text": "Its door was closed."
    },
    {
      "i": 14,
      "start": 49.76,
      "end": 52.36,
      "text": "Wu Kong pounded on the cave door."
    },
    {
      "i": 15,
      "start": 52.36,
      "end": 53.36,
      "text": "Open up!"
    },
    {
      "i": 16,
      "start": 53.36,
      "end": 54.36,
      "text": "He yelled."
    },
    {
      "i": 17,
      "start": 54.36,
      "end": 57.48,
      "text": "The door flew open, and the woman came out."
    },
    {
      "i": 18,
      "start": 58.48,
      "end": 59.48,
      "text": "Who are you?"
    },
    {
      "i": 19,
      "start": 59.48,
      "end": 61.32,
      "text": "Demanded the woman."
    },
    {
      "i": 20,
      "start": 61.32,
      "end": 64.04,
      "text": "Why are you pounding on my door?"
    },
    {
      "i": 21,
      "start": 64.04,
      "end": 65.56,
      "text": "Release our master!"
    },
    {
      "i": 22,
      "start": 65.56,
      "end": 68.48,
      "text": "Shout to Wu Kong, ignoring her questions."
    },
    {
      "i": 23,
      "start": 68.48,
      "end": 70.28,
      "text": "The woman laughed."
    },
    {
      "i": 24,
      "start": 70.28,
      "end": 76.48,
      "text": "Don't tell me what to do."
    },
    {
      "i": 25,
      "start": 76.48,
      "end": 79.72,
      "text": "The monkey attacked."
    },
    {
      "i": 26,
      "start": 79.72,
      "end": 85.64,
      "text": "The woman spun around fast, blocking his iron bar and striking back with fury."
    },
    {
      "i": 27,
      "start": 85.64,
      "end": 87.08,
      "text": "You shouldn't have come here!"
    },
    {
      "i": 28,
      "start": 87.08,
      "end": 89.08,
      "text": "She shouted as she fought."
    },
    {
      "i": 29,
      "start": 89.08,
      "end": 92.36,
      "text": "Even Buddha is afraid of me!"
    },
    {
      "i": 30,
      "start": 92.36,
      "end": 96.36,
      "text": "Bajay tried to hit her with his rake but missed."
    },
    {
      "i": 31,
      "start": 96.36,
      "end": 100.0,
      "text": "The woman was now spinning faster and faster."
    },
    {
      "i": 32,
      "start": 100.0,
      "end": 102.04,
      "text": "She's faster than a tornado!"
    },
    {
      "i": 33,
      "start": 102.04,
      "end": 103.04,
      "text": "Crite the pig."
    },
    {
      "i": 34,
      "start": 103.04,
      "end": 105.44,
      "text": "Wu Kong leaped at the woman."
    },
    {
      "i": 35,
      "start": 105.44,
      "end": 110.64,
      "text": "Suddenly he felt a stabbing pain."
    },
    {
      "i": 36,
      "start": 110.64,
      "end": 112.88,
      "text": "Crite the monkey grabbing his head."
    },
    {
      "i": 37,
      "start": 112.88,
      "end": 114.08,
      "text": "It hurts!"
    },
    {
      "i": 38,
      "start": 114.08,
      "end": 116.08,
      "text": "It hurts!"
    },
    {
      "i": 39,
      "start": 116.08,
      "end": 118.6,
      "text": "He ran down the mountain."
    },
    {
      "i": 40,
      "start": 118.6,
      "end": 123.12,
      "text": "Bajay and Wu-Jing stared after Wu-Kong and Shok."
    },
    {
      "i": 41,
      "start": 123.12,
      "end": 127.36,
      "text": "The woman went back into her cave."
    },
    {
      "i": 42,
      "start": 127.36,
      "end": 128.96,
      "text": "What happened to Wu-Kong?"
    },
    {
      "i": 43,
      "start": 128.96,
      "end": 129.96,
      "text": "Asked the pig."
    },
    {
      "i": 44,
      "start": 129.96,
      "end": 134.0,
      "text": "Nothing hurts him except for the tight headband spell."
    },
    {
      "i": 45,
      "start": 134.0,
      "end": 135.6,
      "text": "I don't know."
    },
    {
      "i": 46,
      "start": 135.6,
      "end": 139.8,
      "text": "Said Wu-Jing, scratching his head."
    },
    {
      "i": 47,
      "start": 139.8,
      "end": 144.84,
      "text": "They went down the mountain and found the monkey crouching by a stream."
    },
    {
      "i": 48,
      "start": 144.84,
      "end": 147.44,
      "text": "He was still holding his head."
    },
    {
      "i": 49,
      "start": 147.44,
      "end": 148.44,
      "text": "Are you all right?"
    },
    {
      "i": 50,
      "start": 148.44,
      "end": 149.44,
      "text": "Asked Wu-Jing."
    }
  ]
}
