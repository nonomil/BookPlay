{
  "episode": 76,
  "source": "assets/video/ep76.mp4",
  "model": "base",
  "duration": 323.1753125,
  "segments": [
    {
      "i": 1,
      "start": 0.0,
      "end": 7.0,
      "text": "Journey to the West, Chapter 76, the Iron Immortal."
    },
    {
      "i": 2,
      "start": 13.0,
      "end": 17.0,
      "text": "Wukong was once again traveling west with the Tang monk."
    },
    {
      "i": 3,
      "start": 18.0,
      "end": 20.0,
      "text": "Master said Wukong."
    },
    {
      "i": 4,
      "start": 21.0,
      "end": 24.0,
      "text": "While I was at Mount Potalaka, I thought a lot."
    },
    {
      "i": 5,
      "start": 24.0,
      "end": 27.0,
      "text": "I realize now that it's wrong to harm people."
    },
    {
      "i": 6,
      "start": 27.0,
      "end": 29.0,
      "text": "I won't ever do it again."
    },
    {
      "i": 7,
      "start": 30.0,
      "end": 31.0,
      "text": "I'm glad Wukong."
    },
    {
      "i": 8,
      "start": 31.0,
      "end": 32.0,
      "text": "Said the Tang monk."
    },
    {
      "i": 9,
      "start": 34.0,
      "end": 36.0,
      "text": "Can we please slow down?"
    },
    {
      "i": 10,
      "start": 36.0,
      "end": 37.0,
      "text": "Bajem moaned."
    },
    {
      "i": 11,
      "start": 37.0,
      "end": 39.0,
      "text": "I'm tired and it's hot."
    },
    {
      "i": 12,
      "start": 41.0,
      "end": 42.0,
      "text": "Wukong laughed."
    },
    {
      "i": 13,
      "start": 42.0,
      "end": 44.0,
      "text": "Not much has changed since I left."
    },
    {
      "i": 14,
      "start": 45.0,
      "end": 47.0,
      "text": "Bajay still complains all the time."
    },
    {
      "i": 15,
      "start": 48.0,
      "end": 50.0,
      "text": "Wuzing wiped his brow."
    },
    {
      "i": 16,
      "start": 51.0,
      "end": 52.0,
      "text": "It is hot."
    },
    {
      "i": 17,
      "start": 53.0,
      "end": 54.0,
      "text": "Maybe we should take a break."
    },
    {
      "i": 18,
      "start": 55.0,
      "end": 56.0,
      "text": "Yes."
    },
    {
      "i": 19,
      "start": 56.0,
      "end": 57.0,
      "text": "Said the Tang monk."
    },
    {
      "i": 20,
      "start": 58.0,
      "end": 60.0,
      "text": "But I don't understand why it's so hot."
    },
    {
      "i": 21,
      "start": 60.0,
      "end": 61.0,
      "text": "It's not summer."
    },
    {
      "i": 22,
      "start": 63.0,
      "end": 65.0,
      "text": "The traveller soon reached a village."
    },
    {
      "i": 23,
      "start": 67.0,
      "end": 70.0,
      "text": "An old man offered to take them in for the night."
    },
    {
      "i": 24,
      "start": 72.0,
      "end": 75.0,
      "text": "Later that evening they were all eating dinner."
    },
    {
      "i": 25,
      "start": 76.0,
      "end": 78.0,
      "text": "Isn't always so hot here."
    },
    {
      "i": 26,
      "start": 78.0,
      "end": 80.0,
      "text": "Asked Bajay."
    },
    {
      "i": 27,
      "start": 81.0,
      "end": 82.0,
      "text": "The man nodded."
    },
    {
      "i": 28,
      "start": 82.0,
      "end": 84.0,
      "text": "The mountain of flames is near here."
    },
    {
      "i": 29,
      "start": 85.0,
      "end": 87.0,
      "text": "It's always burning."
    },
    {
      "i": 30,
      "start": 88.0,
      "end": 91.0,
      "text": "Well, I'll be happy when we continue on our journey."
    },
    {
      "i": 31,
      "start": 91.0,
      "end": 93.0,
      "text": "Said the pig."
    },
    {
      "i": 32,
      "start": 94.0,
      "end": 96.0,
      "text": "Then we can get away from this heat."
    },
    {
      "i": 33,
      "start": 97.0,
      "end": 99.0,
      "text": "Where are you going?"
    },
    {
      "i": 34,
      "start": 99.0,
      "end": 100.0,
      "text": "Ask the man."
    },
    {
      "i": 35,
      "start": 101.0,
      "end": 103.0,
      "text": "We're going to the western paradise."
    },
    {
      "i": 36,
      "start": 103.0,
      "end": 104.0,
      "text": "Said the Tang monk."
    },
    {
      "i": 37,
      "start": 105.0,
      "end": 106.0,
      "text": "The man frowned."
    },
    {
      "i": 38,
      "start": 107.0,
      "end": 109.0,
      "text": "You can't travel west from here."
    },
    {
      "i": 39,
      "start": 110.0,
      "end": 113.0,
      "text": "Everyone stopped eating and looked at the old man."
    },
    {
      "i": 40,
      "start": 114.0,
      "end": 115.0,
      "text": "Why not?"
    },
    {
      "i": 41,
      "start": 115.0,
      "end": 116.0,
      "text": "Asked the Tang monk."
    },
    {
      "i": 42,
      "start": 117.0,
      "end": 119.0,
      "text": "The mountain of flames is to the west."
    },
    {
      "i": 43,
      "start": 120.0,
      "end": 121.0,
      "text": "Said the man."
    },
    {
      "i": 44,
      "start": 121.0,
      "end": 124.0,
      "text": "It's impossible to pass."
    },
    {
      "i": 45,
      "start": 124.0,
      "end": 126.0,
      "text": "We'll go around it."
    },
    {
      "i": 46,
      "start": 126.0,
      "end": 127.0,
      "text": "Said the Tang monk."
    },
    {
      "i": 47,
      "start": 128.0,
      "end": 130.0,
      "text": "The old man shook his head."
    },
    {
      "i": 48,
      "start": 132.0,
      "end": 135.0,
      "text": "All the land around the mountain is covered in flames."
    },
    {
      "i": 49,
      "start": 136.0,
      "end": 139.0,
      "text": "The land stretches far to the north and the south."
    },
    {
      "i": 50,
      "start": 140.0,
      "end": 142.0,
      "text": "It's impossible to go around."
    },
    {
      "i": 51,
      "start": 143.0,
      "end": 146.0,
      "text": "Then we must wait for a strong rain storm."
    },
    {
      "i": 52,
      "start": 146.0,
      "end": 147.0,
      "text": "Said Bajay."
    },
    {
      "i": 53,
      "start": 147.0,
      "end": 149.0,
      "text": "That will put out the flames."
    }
  ]
}
