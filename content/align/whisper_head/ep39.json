  "model": "base",
  "duration": 301.6504375,
  "segments": [
    {
      "i": 1,
      "start": 0.0,
      "end": 7.0,
      "text": "Journey to the West, Chapter 39, the injured monk."
    },
    {
      "i": 2,
      "start": 12.0,
      "end": 16.0,
      "text": "Bajai waved his rake at the demon Golden Horn."
    },
    {
      "i": 3,
      "start": 16.0,
      "end": 18.0,
      "text": "You'll never harm the Tang monk."
    },
    {
      "i": 4,
      "start": 18.0,
      "end": 19.0,
      "text": "Shout at the pig."
    },
    {
      "i": 5,
      "start": 19.0,
      "end": 21.0,
      "text": "My rake is very powerful."
    },
    {
      "i": 6,
      "start": 23.0,
      "end": 26.0,
      "text": "Bajai rushed toward Golden Horn."
    },
    {
      "i": 7,
      "start": 27.0,
      "end": 29.0,
      "text": "But the demon was strong."
    },
    {
      "i": 8,
      "start": 31.0,
      "end": 33.0,
      "text": "Bajai was knocked out."
    },
    {
      "i": 9,
      "start": 35.0,
      "end": 39.0,
      "text": "When he woke up, he was tied up in a dark cave."
    },
    {
      "i": 10,
      "start": 45.0,
      "end": 47.0,
      "text": "Bajai is taking a long time to search the mountain."
    },
    {
      "i": 11,
      "start": 47.0,
      "end": 49.0,
      "text": "Said the Tang monk."
    },
    {
      "i": 12,
      "start": 49.0,
      "end": 51.0,
      "text": "I hope he's okay."
    },
    {
      "i": 13,
      "start": 57.0,
      "end": 59.0,
      "text": "Wukong frowned."
    },
    {
      "i": 14,
      "start": 59.0,
      "end": 61.0,
      "text": "He probably went back to sleep."
    },
    {
      "i": 15,
      "start": 61.0,
      "end": 63.0,
      "text": "I should have followed him again."
    },
    {
      "i": 16,
      "start": 63.0,
      "end": 65.0,
      "text": "Let's keep walking."
    },
    {
      "i": 17,
      "start": 65.0,
      "end": 66.0,
      "text": "Said Wu Jing."
    },
    {
      "i": 18,
      "start": 66.0,
      "end": 69.0,
      "text": "We'll find Bajai along the way."
    },
    {
      "i": 19,
      "start": 69.0,
      "end": 71.0,
      "text": "We must stay alert though."
    },
    {
      "i": 20,
      "start": 71.0,
      "end": 72.0,
      "text": "Said Wukong."
    },
    {
      "i": 21,
      "start": 72.0,
      "end": 76.0,
      "text": "We still don't know if there are any demons on this mountain."
    },
    {
      "i": 22,
      "start": 76.0,
      "end": 78.0,
      "text": "The group headed up the mountain."
    },
    {
      "i": 23,
      "start": 79.0,
      "end": 81.0,
      "text": "Soon they heard a voice."
    },
    {
      "i": 24,
      "start": 81.0,
      "end": 83.0,
      "text": "Help! Help me!"
    },
    {
      "i": 25,
      "start": 83.0,
      "end": 84.0,
      "text": "Cry to man."
    },
    {
      "i": 26,
      "start": 84.0,
      "end": 85.0,
      "text": "Someone is in trouble."
    },
    {
      "i": 27,
      "start": 85.0,
      "end": 87.0,
      "text": "Said the Tang monk."
    },
    {
      "i": 28,
      "start": 87.0,
      "end": 93.0,
      "text": "He and his companions hurried ahead and found an old monk lying near the road."
    },
    {
      "i": 29,
      "start": 94.0,
      "end": 95.0,
      "text": "Thank goodness!"
    },
    {
      "i": 30,
      "start": 95.0,
      "end": 97.0,
      "text": "Cryed the old monk."
    },
    {
      "i": 31,
      "start": 97.0,
      "end": 99.0,
      "text": "You must help me!"
    },
    {
      "i": 32,
      "start": 99.0,
      "end": 102.0,
      "text": "The Tang monk got down from his horse."
    },
    {
      "i": 33,
      "start": 102.0,
      "end": 104.0,
      "text": "Of course we will help you."
    },
    {
      "i": 34,
      "start": 104.0,
      "end": 105.0,
      "text": "He said."
    },
    {
      "i": 35,
      "start": 108.0,
      "end": 110.0,
      "text": "Please stand up."
    },
    {
      "i": 36,
      "start": 110.0,
      "end": 111.0,
      "text": "I can't."
    },
    {
      "i": 37,
      "start": 111.0,
      "end": 112.0,
      "text": "Said the old man."
    },
    {
      "i": 38,
      "start": 112.0,
      "end": 114.0,
      "text": "My leg is injured."
    },
    {
      "i": 39,
      "start": 114.0,
      "end": 115.0,
      "text": "It hurts terribly."
    },
    {
      "i": 40,
      "start": 115.0,
      "end": 117.0,
      "text": "He started to cry."
    },
    {
      "i": 41,
      "start": 117.0,
      "end": 122.0,
      "text": "How will I ever get back home?"
    },
    {
      "i": 42,
      "start": 122.0,
      "end": 124.0,
      "text": "Please don't cry."
    },
    {
      "i": 43,
      "start": 124.0,
      "end": 125.0,
      "text": "Said the Tang monk."
    },
    {
      "i": 44,
      "start": 125.0,
      "end": 127.0,
      "text": "We will help you."
    },
    {
      "i": 45,
      "start": 127.0,
      "end": 129.0,
      "text": "How did your leg get hurt?"
    },
    {
      "i": 46,
      "start": 129.0,
      "end": 131.0,
      "text": "A tiger attacked me."
    },
    {
      "i": 47,
      "start": 131.0,
      "end": 133.0,
      "text": "Said the old monk."
    },
    {
      "i": 48,
      "start": 133.0,
      "end": 136.0,
      "text": "Wukong looks suspiciously at the man."
    },
    {
      "i": 49,
      "start": 136.0,
      "end": 138.0,
      "text": "He isn't really a monk."
    },
    {
      "i": 50,
      "start": 138.0,
      "end": 139.0,
      "text": "He thought."
    },
    {
      "i": 51,
      "start": 139.0,
      "end": 141.0,
      "text": "I'm sure he wants to harm master."
    },
    {
      "i": 52,
      "start": 142.0,
      "end": 144.0,
      "text": "But I can't tell master that."
    },
    {
      "i": 53,
      "start": 144.0,
      "end": 145.0,
      "text": "He won't believe me."
    },
    {
      "i": 54,
      "start": 145.0,
      "end": 146.0,
      "text": "Wukong."
    },
    {
      "i": 55,
      "start": 146.0,
      "end": 148.0,
      "text": "Said the Tang monk."
    },
    {
      "i": 56,
      "start": 148.0,
      "end": 150.0,
      "text": "Please carry this poor monk down the mountain."
    }
  ]
}
