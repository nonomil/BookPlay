{
  "episode": 3,
  "source": "assets/video/ep3.mp4",
  "model": "base",
  "duration": 323.6861875,
  "segments": [
    {
      "i": 1,
      "start": 0.0,
      "end": 4.0,
      "text": "Journey to the West."
    },
    {
      "i": 2,
      "start": 4.0,
      "end": 6.0,
      "text": "Chapter 3."
    },
    {
      "i": 3,
      "start": 6.0,
      "end": 15.0,
      "text": "Sabote."
    },
    {
      "i": 4,
      "start": 15.0,
      "end": 18.48,
      "text": "Monkey sailed over the ocean for a long time."
    },
    {
      "i": 5,
      "start": 18.48,
      "end": 22.8,
      "text": "Finally, he arrived at a new land."
    },
    {
      "i": 6,
      "start": 22.8,
      "end": 27.36,
      "text": "He walked for many years, visiting towns and meeting people."
    },
    {
      "i": 7,
      "start": 27.36,
      "end": 30.64,
      "text": "But he didn't find a sage anywhere."
    },
    {
      "i": 8,
      "start": 30.64,
      "end": 36.08,
      "text": "Eventually, he came to mountains covered in thick forest."
    },
    {
      "i": 9,
      "start": 36.08,
      "end": 41.08,
      "text": "He headed up a steep mountain trail and soon heard chopping."
    },
    {
      "i": 10,
      "start": 41.08,
      "end": 44.68,
      "text": "A woodcutter was chopping firewood."
    },
    {
      "i": 11,
      "start": 44.68,
      "end": 45.68,
      "text": "Hello."
    },
    {
      "i": 12,
      "start": 45.68,
      "end": 46.68,
      "text": "Said Monkey."
    },
    {
      "i": 13,
      "start": 46.68,
      "end": 49.08,
      "text": "Are there any sages in these mountains?"
    },
    {
      "i": 14,
      "start": 49.08,
      "end": 52.56,
      "text": "The woodcutter dropped his axe."
    },
    {
      "i": 15,
      "start": 52.56,
      "end": 54.76,
      "text": "You're a monkey."
    },
    {
      "i": 16,
      "start": 54.76,
      "end": 56.56,
      "text": "He said."
    },
    {
      "i": 17,
      "start": 56.56,
      "end": 58.4,
      "text": "And you're talking."
    },
    {
      "i": 18,
      "start": 58.4,
      "end": 59.56,
      "text": "Yes, I am."
    },
    {
      "i": 19,
      "start": 59.56,
      "end": 61.12,
      "text": "Said Monkey."
    },
    {
      "i": 20,
      "start": 61.12,
      "end": 62.88,
      "text": "And I want to live forever."
    },
    {
      "i": 21,
      "start": 62.88,
      "end": 65.36,
      "text": "Do you know where I can find a sage?"
    },
    {
      "i": 22,
      "start": 65.36,
      "end": 67.56,
      "text": "The woodcutter scratched his head."
    },
    {
      "i": 23,
      "start": 67.56,
      "end": 68.8,
      "text": "Well, yes."
    },
    {
      "i": 24,
      "start": 68.8,
      "end": 70.2,
      "text": "He said."
    },
    {
      "i": 25,
      "start": 70.2,
      "end": 73.36,
      "text": "A sage named Sabote lives on this mountain."
    },
    {
      "i": 26,
      "start": 73.36,
      "end": 75.72,
      "text": "He's very wise."
    },
    {
      "i": 27,
      "start": 75.72,
      "end": 77.52,
      "text": "Monkey was excited."
    },
    {
      "i": 28,
      "start": 77.52,
      "end": 79.36,
      "text": "Where can I find him?"
    },
    {
      "i": 29,
      "start": 79.36,
      "end": 82.4,
      "text": "Just follow this trail and you will come to his home."
    },
    {
      "i": 30,
      "start": 82.4,
      "end": 84.28,
      "text": "Said the woodcutter."
    },
    {
      "i": 31,
      "start": 84.28,
      "end": 85.0,
      "text": "Thank you."
    },
    {
      "i": 32,
      "start": 85.0,
      "end": 89.36,
      "text": "Said Monkey."
    },
    {
      "i": 33,
      "start": 89.36,
      "end": 93.28,
      "text": "He waved goodbye to the woodcutter and ran up the trail."
    },
    {
      "i": 34,
      "start": 93.28,
      "end": 98.16,
      "text": "Soon he saw a temple built into the side of the mountain."
    },
    {
      "i": 35,
      "start": 98.16,
      "end": 100.88,
      "text": "Sabote was sitting with the students in the main room"
    },
    {
      "i": 36,
      "start": 100.88,
      "end": 102.64,
      "text": "of his temple."
    },
    {
      "i": 37,
      "start": 102.64,
      "end": 105.8,
      "text": "He looked at his older student."
    },
    {
      "i": 38,
      "start": 105.8,
      "end": 107.04,
      "text": "Please go to the door."
    },
    {
      "i": 39,
      "start": 107.04,
      "end": 108.84,
      "text": "Said Sabote."
    },
    {
      "i": 40,
      "start": 108.84,
      "end": 111.0,
      "text": "A new student is about to arrive."
    },
    {
      "i": 41,
      "start": 111.0,
      "end": 112.52,
      "text": "Let him in."
    },
    {
      "i": 42,
      "start": 112.52,
      "end": 114.84,
      "text": "The student looked confused."
    },
    {
      "i": 43,
      "start": 114.84,
      "end": 116.16,
      "text": "OK, master."
    },
    {
      "i": 44,
      "start": 116.16,
      "end": 118.0,
      "text": "He said."
    },
    {
      "i": 45,
      "start": 118.0,
      "end": 120.64,
      "text": "The student got up and went to the door of the temple."
    },
    {
      "i": 46,
      "start": 124.96,
      "end": 127.4,
      "text": "He looked outside."
    },
    {
      "i": 47,
      "start": 127.4,
      "end": 128.0,
      "text": "Hello."
    },
    {
      "i": 48,
      "start": 128.0,
      "end": 129.48,
      "text": "Called Monkey."
    },
    {
      "i": 49,
      "start": 129.48,
      "end": 133.2,
      "text": "I'm here to see Sabote."
    },
    {
      "i": 50,
      "start": 133.2,
      "end": 137.52,
      "text": "A moment later, Monkey was standing in front of the sage."
    },
    {
      "i": 51,
      "start": 137.52,
      "end": 139.04,
      "text": "I want to be your student."
    },
    {
      "i": 52,
      "start": 139.04,
      "end": 140.6,
      "text": "Said Monkey."
    },
    {
      "i": 53,
      "start": 140.6,
      "end": 141.88,
      "text": "But you're just a monkey."
    },
    {
      "i": 54,
      "start": 141.88,
      "end": 143.4,
      "text": "Said Sabote."
    },
    {
      "i": 55,
      "start": 143.4,
      "end": 146.0,
      "text": "How can you be my student?"
    },
    {
      "i": 56,
      "start": 146.0,
      "end": 148.28,
      "text": "Monkey left."
    },
    {
      "i": 57,
      "start": 148.28,
      "end": 149.36,
      "text": "I might be a monkey."
    }
  ]
}
