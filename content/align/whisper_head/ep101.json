{
  "episode": 101,
  "source": "assets/video/ep101.mp4",
  "model": "base",
  "duration": 320.226375,
  "segments": [
    {
      "i": 1,
      "start": 0.0,
      "end": 7.0,
      "text": "Journey to the West, Chapter 101, arrested."
    },
    {
      "i": 2,
      "start": 13.5,
      "end": 15.0,
      "text": "This is ridiculous."
    },
    {
      "i": 3,
      "start": 15.0,
      "end": 16.5,
      "text": "Said the Tang Monk."
    },
    {
      "i": 4,
      "start": 16.5,
      "end": 19.0,
      "text": "Why are we under arrest?"
    },
    {
      "i": 5,
      "start": 19.0,
      "end": 23.0,
      "text": "Soldiers were bringing the travelers back to the town."
    },
    {
      "i": 6,
      "start": 23.0,
      "end": 26.0,
      "text": "You robbed Squire Koo's house last night."
    },
    {
      "i": 7,
      "start": 26.0,
      "end": 28.0,
      "text": "Said one of the soldiers."
    },
    {
      "i": 8,
      "start": 28.0,
      "end": 29.0,
      "text": "What?"
    },
    {
      "i": 9,
      "start": 29.0,
      "end": 30.0,
      "text": "Pride Bajay."
    },
    {
      "i": 10,
      "start": 30.0,
      "end": 33.0,
      "text": "We would never rob somebody."
    },
    {
      "i": 11,
      "start": 33.0,
      "end": 35.0,
      "text": "Especially not the Squire."
    },
    {
      "i": 12,
      "start": 35.0,
      "end": 37.0,
      "text": "He was kind to us."
    },
    {
      "i": 13,
      "start": 37.0,
      "end": 39.0,
      "text": "You had all the stolen items."
    },
    {
      "i": 14,
      "start": 39.0,
      "end": 41.0,
      "text": "Replyed the soldier."
    },
    {
      "i": 15,
      "start": 41.0,
      "end": 45.0,
      "text": "You also had the two horses that were stolen from his stable."
    },
    {
      "i": 16,
      "start": 45.0,
      "end": 47.0,
      "text": "We got everything from the real robbers."
    },
    {
      "i": 17,
      "start": 47.0,
      "end": 49.0,
      "text": "Said the Tang Monk."
    },
    {
      "i": 18,
      "start": 49.0,
      "end": 53.0,
      "text": "We were going to return it all to Squire Koo."
    },
    {
      "i": 19,
      "start": 53.0,
      "end": 55.0,
      "text": "The soldier laughed."
    },
    {
      "i": 20,
      "start": 55.0,
      "end": 59.0,
      "text": "Oh, you got everything from the real robbers."
    },
    {
      "i": 21,
      "start": 59.0,
      "end": 63.0,
      "text": "Tell me, where are the real robbers now?"
    },
    {
      "i": 22,
      "start": 63.0,
      "end": 66.0,
      "text": "Wukong sighed."
    },
    {
      "i": 23,
      "start": 66.0,
      "end": 69.0,
      "text": "I let them go."
    },
    {
      "i": 24,
      "start": 69.0,
      "end": 71.0,
      "text": "The soldier laughed again."
    },
    {
      "i": 25,
      "start": 71.0,
      "end": 74.0,
      "text": "Oh, that was very kind of you."
    },
    {
      "i": 26,
      "start": 74.0,
      "end": 78.0,
      "text": "Wukong could tell that the soldier didn't believe him."
    },
    {
      "i": 27,
      "start": 78.0,
      "end": 83.0,
      "text": "By now they had reached the town."
    },
    {
      "i": 28,
      "start": 83.0,
      "end": 87.0,
      "text": "A crowd of people had gathered to watch."
    },
    {
      "i": 29,
      "start": 87.0,
      "end": 91.0,
      "text": "The soldiers brought the travelers into the courthouse."
    },
    {
      "i": 30,
      "start": 91.0,
      "end": 94.0,
      "text": "The judge frowned at the monk and the others."
    },
    {
      "i": 31,
      "start": 94.0,
      "end": 96.0,
      "text": "Lock them up."
    },
    {
      "i": 32,
      "start": 96.0,
      "end": 98.0,
      "text": "This is a mistake."
    },
    {
      "i": 33,
      "start": 98.0,
      "end": 100.0,
      "text": "The Tang Monk pleaded."
    },
    {
      "i": 34,
      "start": 100.0,
      "end": 102.0,
      "text": "We can't go to jail."
    },
    {
      "i": 35,
      "start": 102.0,
      "end": 105.0,
      "text": "We're making an important journey to visit Buddha."
    },
    {
      "i": 36,
      "start": 105.0,
      "end": 107.0,
      "text": "The judge shook his head."
    },
    {
      "i": 37,
      "start": 107.0,
      "end": 111.0,
      "text": "Buddha doesn't allow killers in the Western paradise."
    },
    {
      "i": 38,
      "start": 111.0,
      "end": 112.0,
      "text": "Killers."
    },
    {
      "i": 39,
      "start": 112.0,
      "end": 114.0,
      "text": "Said Wu Xing."
    },
    {
      "i": 40,
      "start": 114.0,
      "end": 116.0,
      "text": "What are you talking about?"
    },
    {
      "i": 41,
      "start": 116.0,
      "end": 118.0,
      "text": "You killed Squire Koo."
    },
    {
      "i": 42,
      "start": 118.0,
      "end": 120.0,
      "text": "Said the judge."
    },
    {
      "i": 43,
      "start": 120.0,
      "end": 122.0,
      "text": "The Tang Monk's face went pale."
    },
    {
      "i": 44,
      "start": 122.0,
      "end": 124.0,
      "text": "The Squire is dead."
    },
    {
      "i": 45,
      "start": 124.0,
      "end": 127.0,
      "text": "The judge narrowed his eyes at the monk."
    },
    {
      "i": 46,
      "start": 127.0,
      "end": 128.0,
      "text": "Yes."
    },
    {
      "i": 47,
      "start": 128.0,
      "end": 131.0,
      "text": "And Lady Koo saw you do it."
    },
    {
      "i": 48,
      "start": 134.0,
      "end": 137.0,
      "text": "The travelers were shoved into a jail cell."
    },
    {
      "i": 49,
      "start": 137.0,
      "end": 139.0,
      "text": "And the door was slammed shut."
    },
    {
      "i": 50,
      "start": 140.0,
      "end": 143.0,
      "text": "The Tang Monk started to cry."
    },
    {
      "i": 51,
      "start": 143.0,
      "end": 146.0,
      "text": "This is terrible."
    },
    {
      "i": 52,
      "start": 146.0,
      "end": 149.0,
      "text": "Bajay made a fist."
    },
    {
      "i": 53,
      "start": 149.0,
      "end": 151.0,
      "text": "Lady Koo!"
    }
  ]
}
