{
  "episode": 29,
  "source": "assets/video/ep29.mp4",
  "model": "base",
  "duration": 307.7340625,
  "segments": [
    {
      "i": 1,
      "start": 0.0,
      "end": 3.92,
      "text": "Journey to the West."
    },
    {
      "i": 2,
      "start": 3.92,
      "end": 5.48,
      "text": "Chapter 29."
    },
    {
      "i": 3,
      "start": 5.48,
      "end": 12.68,
      "text": "The Magic Sleeve."
    },
    {
      "i": 4,
      "start": 12.68,
      "end": 15.24,
      "text": "I know we counted the fruit correctly."
    },
    {
      "i": 5,
      "start": 15.24,
      "end": 17.04,
      "text": "Said one priest."
    },
    {
      "i": 6,
      "start": 17.04,
      "end": 19.84,
      "text": "But we'll count again anyway."
    },
    {
      "i": 7,
      "start": 19.84,
      "end": 26.92,
      "text": "The two angry priests went outside and gasped."
    },
    {
      "i": 8,
      "start": 26.92,
      "end": 30.56,
      "text": "The ginseng tree was lying on the ground."
    },
    {
      "i": 9,
      "start": 30.56,
      "end": 34.96,
      "text": "It was gray and all its leaves were gone."
    },
    {
      "i": 10,
      "start": 34.96,
      "end": 36.16,
      "text": "The tree is dead."
    },
    {
      "i": 11,
      "start": 36.16,
      "end": 37.92,
      "text": "Cride one priest."
    },
    {
      "i": 12,
      "start": 37.92,
      "end": 41.32,
      "text": "That monkey must have done this."
    },
    {
      "i": 13,
      "start": 41.32,
      "end": 43.24,
      "text": "But the monkey was inside the whole time."
    },
    {
      "i": 14,
      "start": 43.24,
      "end": 45.32,
      "text": "Said the other priest."
    },
    {
      "i": 15,
      "start": 45.32,
      "end": 48.76,
      "text": "How could he have been out here also?"
    },
    {
      "i": 16,
      "start": 48.76,
      "end": 49.76,
      "text": "He's a spirit."
    },
    {
      "i": 17,
      "start": 49.76,
      "end": 51.36,
      "text": "Said the first priest."
    },
    {
      "i": 18,
      "start": 51.36,
      "end": 54.32,
      "text": "He must have used magic."
    },
    {
      "i": 19,
      "start": 54.32,
      "end": 57.04,
      "text": "He looked at the tree and shook his head."
    },
    {
      "i": 20,
      "start": 57.04,
      "end": 59.36,
      "text": "This tree was older than heaven and earth."
    },
    {
      "i": 21,
      "start": 59.36,
      "end": 62.44,
      "text": "The monkey must be very powerful."
    },
    {
      "i": 22,
      "start": 62.44,
      "end": 64.56,
      "text": "It would be dangerous for us to fight him."
    },
    {
      "i": 23,
      "start": 64.56,
      "end": 66.48,
      "text": "Said the other priest."
    },
    {
      "i": 24,
      "start": 66.48,
      "end": 72.72,
      "text": "Let's wait for our master, the great immortal to return."
    },
    {
      "i": 25,
      "start": 72.72,
      "end": 77.88,
      "text": "Inside the abbey, the Tang monk was scolding his companions."
    },
    {
      "i": 26,
      "start": 77.88,
      "end": 79.32,
      "text": "We are guests here."
    },
    {
      "i": 27,
      "start": 79.32,
      "end": 80.8,
      "text": "He said."
    },
    {
      "i": 28,
      "start": 80.8,
      "end": 85.12,
      "text": "I am very upset you stole fruit from our hosts."
    },
    {
      "i": 29,
      "start": 85.12,
      "end": 88.84,
      "text": "The priest came back in."
    },
    {
      "i": 30,
      "start": 88.84,
      "end": 90.52,
      "text": "We owe you an apology."
    },
    {
      "i": 31,
      "start": 90.52,
      "end": 92.4,
      "text": "Said one."
    },
    {
      "i": 32,
      "start": 92.4,
      "end": 95.36,
      "text": "None of the ginseng fruit is missing after all."
    },
    {
      "i": 33,
      "start": 95.36,
      "end": 96.36,
      "text": "Oh."
    },
    {
      "i": 34,
      "start": 96.36,
      "end": 98.0,
      "text": "Said the Tang monk."
    },
    {
      "i": 35,
      "start": 98.0,
      "end": 100.36,
      "text": "I'm glad to hear that."
    },
    {
      "i": 36,
      "start": 100.36,
      "end": 102.04,
      "text": "Thank you for your apology."
    },
    {
      "i": 37,
      "start": 102.04,
      "end": 103.8,
      "text": "Said Bajay."
    },
    {
      "i": 38,
      "start": 103.8,
      "end": 107.48,
      "text": "Wukong gave the priest a suspicious look."
    },
    {
      "i": 39,
      "start": 107.48,
      "end": 112.96,
      "text": "He knew they were lying, but he didn't know why."
    },
    {
      "i": 40,
      "start": 112.96,
      "end": 115.0,
      "text": "You're all welcome to spend the night."
    },
    {
      "i": 41,
      "start": 115.0,
      "end": 116.92,
      "text": "Said one of the priests."
    },
    {
      "i": 42,
      "start": 116.92,
      "end": 119.72,
      "text": "Follow us."
    },
    {
      "i": 43,
      "start": 119.72,
      "end": 124.08,
      "text": "The priest led the group to a small room in the abbey."
    },
    {
      "i": 44,
      "start": 124.08,
      "end": 128.24,
      "text": "The Tang monk and his companions went inside."
    },
    {
      "i": 45,
      "start": 128.24,
      "end": 129.72,
      "text": "This is a nice room."
    },
    {
      "i": 46,
      "start": 129.72,
      "end": 131.36,
      "text": "Said Bajay."
    },
    {
      "i": 47,
      "start": 131.36,
      "end": 134.84,
      "text": "Wukong noticed that the priest didn't come in."
    },
    {
      "i": 48,
      "start": 134.84,
      "end": 139.96,
      "text": "He was about to say something when one priest slammed the door shut."
    },
    {
      "i": 49,
      "start": 139.96,
      "end": 142.68,
      "text": "A lock clicked."
    },
    {
      "i": 50,
      "start": 142.68,
      "end": 143.68,
      "text": "Wait!"
    },
    {
      "i": 51,
      "start": 143.68,
      "end": 144.68,
      "text": "Cried Bajay."
    },
    {
      "i": 52,
      "start": 144.68,
      "end": 148.56,
      "text": "What kind of hosts are you?"
    },
    {
      "i": 53,
      "start": 148.56,
      "end": 149.52,
      "text": "You locked us in!"
    }
  ]
}
