{
  "episode": 48,
  "source": "assets/video/ep48.mp4",
  "model": "base",
  "duration": 311.8208125,
  "segments": [
    {
      "i": 1,
      "start": 0.0,
      "end": 12.8,
      "text": "Journey to the West, Chapter 48, The Scared Boy."
    },
    {
      "i": 2,
      "start": 12.8,
      "end": 15.32,
      "text": "Wukong stared at the mountains."
    },
    {
      "i": 3,
      "start": 15.32,
      "end": 18.36,
      "text": "A red cloud keeps appearing over those mountains."
    },
    {
      "i": 4,
      "start": 18.36,
      "end": 23.04,
      "text": "He said, there must be a demon ahead."
    },
    {
      "i": 5,
      "start": 23.04,
      "end": 25.24,
      "text": "The road leads right into those mountains."
    },
    {
      "i": 6,
      "start": 25.24,
      "end": 27.96,
      "text": "Said the Tang monk nervously."
    },
    {
      "i": 7,
      "start": 27.96,
      "end": 29.2,
      "text": "Wukong nodded."
    },
    {
      "i": 8,
      "start": 29.2,
      "end": 31.96,
      "text": "We must be careful."
    },
    {
      "i": 9,
      "start": 31.96,
      "end": 35.64,
      "text": "He pulled out his iron bar and held it up."
    },
    {
      "i": 10,
      "start": 35.64,
      "end": 41.36,
      "text": "Wu-jing held up his spear, and Bajie held up his rake."
    },
    {
      "i": 11,
      "start": 41.36,
      "end": 44.76,
      "text": "The group walked cautiously."
    },
    {
      "i": 12,
      "start": 44.76,
      "end": 50.84,
      "text": "A red demon sat on a mountain peak, watching the traveler's approach."
    },
    {
      "i": 13,
      "start": 50.84,
      "end": 54.08,
      "text": "The Tang monk is finally arrived in my mountain."
    },
    {
      "i": 14,
      "start": 54.08,
      "end": 59.16,
      "text": "The demon said to himself, I've heard that eating just one bite of him"
    },
    {
      "i": 15,
      "start": 59.16,
      "end": 62.68,
      "text": "will make me live forever."
    },
    {
      "i": 16,
      "start": 62.68,
      "end": 65.68,
      "text": "The demon looked at the travelers again."
    },
    {
      "i": 17,
      "start": 65.68,
      "end": 72.0,
      "text": "Uh-oh, the monk's companions have their weapons out."
    },
    {
      "i": 18,
      "start": 72.0,
      "end": 74.12,
      "text": "They probably saw my red cloud."
    },
    {
      "i": 19,
      "start": 74.12,
      "end": 78.0,
      "text": "I'll have to trick them with the disguise."
    },
    {
      "i": 20,
      "start": 78.0,
      "end": 83.36,
      "text": "The demon made himself look like a scared little boy."
    },
    {
      "i": 21,
      "start": 83.36,
      "end": 90.08,
      "text": "When he went down to the road, sat alongside it and waited."
    },
    {
      "i": 22,
      "start": 90.08,
      "end": 92.32,
      "text": "Soon the travelers approached."
    },
    {
      "i": 23,
      "start": 92.32,
      "end": 99.2,
      "text": "The Tang monk saw the boy and got down from his horse."
    },
    {
      "i": 24,
      "start": 99.2,
      "end": 100.8,
      "text": "Master, that's a demon."
    },
    {
      "i": 25,
      "start": 100.8,
      "end": 102.04,
      "text": "Wukong warned."
    },
    {
      "i": 26,
      "start": 102.04,
      "end": 105.24,
      "text": "The Tang monk scowled at the monkey."
    },
    {
      "i": 27,
      "start": 105.24,
      "end": 107.98,
      "text": "He's just a scared little boy."
    },
    {
      "i": 28,
      "start": 107.98,
      "end": 110.04,
      "text": "He turned back to the boy."
    },
    {
      "i": 29,
      "start": 110.04,
      "end": 111.76,
      "text": "What's wrong?"
    },
    {
      "i": 30,
      "start": 111.76,
      "end": 114.56,
      "text": "My family was attacked by robbers."
    },
    {
      "i": 31,
      "start": 114.56,
      "end": 116.24,
      "text": "Said the boy."
    },
    {
      "i": 32,
      "start": 116.24,
      "end": 117.4,
      "text": "Please help me."
    },
    {
      "i": 33,
      "start": 117.4,
      "end": 119.72,
      "text": "I know what you are."
    },
    {
      "i": 34,
      "start": 119.72,
      "end": 121.4,
      "text": "Shattered Wukong."
    },
    {
      "i": 35,
      "start": 121.4,
      "end": 122.4,
      "text": "You're a demon."
    },
    {
      "i": 36,
      "start": 122.4,
      "end": 124.88,
      "text": "I won't let you eat the Tang monk."
    },
    {
      "i": 37,
      "start": 124.88,
      "end": 127.68,
      "text": "The boy looked horrified."
    },
    {
      "i": 38,
      "start": 127.68,
      "end": 128.68,
      "text": "Wukong."
    },
    {
      "i": 39,
      "start": 128.68,
      "end": 130.24,
      "text": "Snap the Tang monk."
    },
    {
      "i": 40,
      "start": 130.24,
      "end": 132.24,
      "text": "You're scaring him."
    },
    {
      "i": 41,
      "start": 132.24,
      "end": 133.24,
      "text": "Uh-uh."
    },
    {
      "i": 42,
      "start": 133.24,
      "end": 136.68,
      "text": "Master, you're being a fool again."
    },
    {
      "i": 43,
      "start": 136.68,
      "end": 138.24,
      "text": "Cried the monkey."
    },
    {
      "i": 44,
      "start": 138.24,
      "end": 143.0,
      "text": "You always fall for demon's tricks and you never believe me."
    },
    {
      "i": 45,
      "start": 143.0,
      "end": 144.48,
      "text": "Be quiet, Wukong."
    },
    {
      "i": 46,
      "start": 144.48,
      "end": 146.0,
      "text": "Said the Tang monk."
    },
    {
      "i": 47,
      "start": 146.0,
      "end": 149.84,
      "text": "Or I'll recite the tight headband spell."
    },
    {
      "i": 48,
      "start": 149.84,
      "end": 149.96,
      "text": "Wukong."
    }
  ]
}
