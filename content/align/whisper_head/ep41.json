  "segments": [
    {
      "i": 1,
      "start": 0.0,
      "end": 4.0,
      "text": "Journey to the West"
    },
    {
      "i": 2,
      "start": 4.0,
      "end": 7.0,
      "text": "Chapter 41, a trade"
    },
    {
      "i": 3,
      "start": 7.0,
      "end": 16.0,
      "text": "Wukong was angry at the guard at the southern gate of heaven."
    },
    {
      "i": 4,
      "start": 16.0,
      "end": 19.0,
      "text": "Why can't you close the gate and din the stars?"
    },
    {
      "i": 5,
      "start": 19.0,
      "end": 21.0,
      "text": "The guard looked nervous."
    },
    {
      "i": 6,
      "start": 21.0,
      "end": 25.0,
      "text": "I can do that only if I have permission from the Jade Emperor."
    },
    {
      "i": 7,
      "start": 25.0,
      "end": 29.0,
      "text": "I'm trying to save the Tang monk!"
    },
    {
      "i": 8,
      "start": 29.0,
      "end": 30.0,
      "text": "cried Wukong."
    },
    {
      "i": 9,
      "start": 30.0,
      "end": 33.0,
      "text": "But demon is planning to eat him!"
    },
    {
      "i": 10,
      "start": 33.0,
      "end": 34.0,
      "text": "I'm sorry."
    },
    {
      "i": 11,
      "start": 34.0,
      "end": 36.0,
      "text": "Said the guard."
    },
    {
      "i": 12,
      "start": 36.0,
      "end": 39.0,
      "text": "But I can't help you."
    },
    {
      "i": 13,
      "start": 39.0,
      "end": 42.0,
      "text": "Wukong's eyes became dark and angry."
    },
    {
      "i": 14,
      "start": 42.0,
      "end": 49.0,
      "text": "He pulled the iron bar out of his ear."
    },
    {
      "i": 15,
      "start": 49.0,
      "end": 53.0,
      "text": "A messenger ran into the cloud palace and bowed."
    },
    {
      "i": 16,
      "start": 53.0,
      "end": 56.0,
      "text": "Sun Wukong is at the southern gate of heaven, your majesty."
    },
    {
      "i": 17,
      "start": 56.0,
      "end": 60.0,
      "text": "He's going to destroy heaven if we don't do what he says."
    },
    {
      "i": 18,
      "start": 60.0,
      "end": 63.0,
      "text": "The Jade Emperor slammed his fist down."
    },
    {
      "i": 19,
      "start": 63.0,
      "end": 65.0,
      "text": "That rotten monkey."
    },
    {
      "i": 20,
      "start": 65.0,
      "end": 66.0,
      "text": "What does he want?"
    },
    {
      "i": 21,
      "start": 66.0,
      "end": 70.0,
      "text": "He wants us to close the gate and din the stars."
    },
    {
      "i": 22,
      "start": 70.0,
      "end": 72.0,
      "text": "Said the messenger."
    },
    {
      "i": 23,
      "start": 72.0,
      "end": 73.0,
      "text": "Why?"
    },
    {
      "i": 24,
      "start": 73.0,
      "end": 75.0,
      "text": "Ask the emperor."
    },
    {
      "i": 25,
      "start": 75.0,
      "end": 78.0,
      "text": "He wants to pretend heaven got sucked into a gourd."
    },
    {
      "i": 26,
      "start": 78.0,
      "end": 80.0,
      "text": "Said the messenger."
    },
    {
      "i": 27,
      "start": 80.0,
      "end": 83.0,
      "text": "The Jade Emperor looked confused."
    },
    {
      "i": 28,
      "start": 83.0,
      "end": 85.0,
      "text": "Why does he want to do that?"
    },
    {
      "i": 29,
      "start": 85.0,
      "end": 86.0,
      "text": "He didn't say."
    },
    {
      "i": 30,
      "start": 86.0,
      "end": 87.0,
      "text": "Said the messenger."
    },
    {
      "i": 31,
      "start": 87.0,
      "end": 91.0,
      "text": "He just said he's trying to save the Tang monk."
    },
    {
      "i": 32,
      "start": 91.0,
      "end": 94.0,
      "text": "The Jade Emperor sighed."
    },
    {
      "i": 33,
      "start": 94.0,
      "end": 97.0,
      "text": "You have my permission to close the gate and din the stars."
    },
    {
      "i": 34,
      "start": 97.0,
      "end": 102.0,
      "text": "I don't want any more trouble from that monkey."
    },
    {
      "i": 35,
      "start": 102.0,
      "end": 105.0,
      "text": "The messenger returned to the gate."
    },
    {
      "i": 36,
      "start": 105.0,
      "end": 107.0,
      "text": "We will close the gate and din the stars."
    },
    {
      "i": 37,
      "start": 107.0,
      "end": 109.0,
      "text": "He said."
    },
    {
      "i": 38,
      "start": 109.0,
      "end": 110.0,
      "text": "Good!"
    },
    {
      "i": 39,
      "start": 110.0,
      "end": 111.0,
      "text": "Said Wukong."
    },
    {
      "i": 40,
      "start": 111.0,
      "end": 114.0,
      "text": "He put the iron bar back in his ear."
    },
    {
      "i": 41,
      "start": 114.0,
      "end": 116.0,
      "text": "Wait until I say heaven."
    },
    {
      "i": 42,
      "start": 121.0,
      "end": 123.0,
      "text": "Wukong returned to his body,"
    },
    {
      "i": 43,
      "start": 123.0,
      "end": 126.0,
      "text": "which was still in disguise as a demon."
    },
    {
      "i": 44,
      "start": 126.0,
      "end": 128.0,
      "text": "Now I will call to heaven."
    },
    {
      "i": 45,
      "start": 128.0,
      "end": 130.0,
      "text": "Said the monkey to the demon."
    },
    {
      "i": 46,
      "start": 130.0,
      "end": 133.0,
      "text": "The whole place will get sucked into this gourd."
    },
    {
      "i": 47,
      "start": 133.0,
      "end": 135.0,
      "text": "He held up the gourd."
    },
    {
      "i": 48,
      "start": 135.0,
      "end": 137.0,
      "text": "Heaven!"
    },
    {
      "i": 49,
      "start": 138.0,
      "end": 141.0,
      "text": "Right away the sky went dark."
    },
    {
      "i": 50,
      "start": 142.0,
      "end": 144.0,
      "text": "Amazing!"
    },
    {
      "i": 51,
      "start": 144.0,
      "end": 146.0,
      "text": "Cry the demon."
    },
    {
      "i": 52,
      "start": 146.0,
      "end": 149.0,
      "text": "All of heaven is now in that gourd."
    },
    {
      "i": 53,
      "start": 149.0,
      "end": 151.0,
      "text": "Yeah."
    }
  ]
}
