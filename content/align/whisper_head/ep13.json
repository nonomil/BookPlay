{
  "episode": 13,
  "source": "assets/video/ep13.mp4",
  "model": "base",
  "duration": 347.1615625,
  "segments": [
    {
      "i": 1,
      "start": 0.0,
      "end": 7.0,
      "text": "Journey to the West, Chapter 13, the true scriptures."
    },
    {
      "i": 2,
      "start": 13.0,
      "end": 15.0,
      "text": "500 years passed,"
    },
    {
      "i": 3,
      "start": 16.0,
      "end": 19.0,
      "text": "Wukong stayed trapped under the mountain."
    },
    {
      "i": 4,
      "start": 20.0,
      "end": 23.0,
      "text": "A thick layer of moss covered the monkey."
    },
    {
      "i": 5,
      "start": 24.0,
      "end": 30.0,
      "text": "One day, Buddha sat in the thunder-clap monastery in the western paradise."
    },
    {
      "i": 6,
      "start": 31.0,
      "end": 33.0,
      "text": "He was talking to his students."
    },
    {
      "i": 7,
      "start": 34.0,
      "end": 38.0,
      "text": "The people in the east, in the Tang Empire, need our help."
    },
    {
      "i": 8,
      "start": 39.0,
      "end": 40.0,
      "text": "Said Buddha."
    },
    {
      "i": 9,
      "start": 41.0,
      "end": 43.0,
      "text": "They lie, cheat and steal."
    },
    {
      "i": 10,
      "start": 44.0,
      "end": 47.0,
      "text": "They are greedy and constantly fighting."
    },
    {
      "i": 11,
      "start": 48.0,
      "end": 51.0,
      "text": "He held up a bundle of scrolls."
    },
    {
      "i": 12,
      "start": 52.0,
      "end": 54.0,
      "text": "These are the true scriptures."
    },
    {
      "i": 13,
      "start": 55.0,
      "end": 58.0,
      "text": "They will teach the people in the east to act better."
    },
    {
      "i": 14,
      "start": 59.0,
      "end": 60.0,
      "text": "Wonderful."
    },
    {
      "i": 15,
      "start": 60.0,
      "end": 61.0,
      "text": "Said one student."
    },
    {
      "i": 16,
      "start": 62.0,
      "end": 64.0,
      "text": "Let's bring the scriptures to the Tang Empire."
    },
    {
      "i": 17,
      "start": 65.0,
      "end": 66.0,
      "text": "Buddha shook his head."
    },
    {
      "i": 18,
      "start": 67.0,
      "end": 68.0,
      "text": "No."
    },
    {
      "i": 19,
      "start": 68.0,
      "end": 69.0,
      "text": "He said."
    },
    {
      "i": 20,
      "start": 70.0,
      "end": 74.0,
      "text": "A true believer, a monk, needs to come here to get them."
    },
    {
      "i": 21,
      "start": 75.0,
      "end": 79.0,
      "text": "Will anyone go to the east to find a worthy monk?"
    },
    {
      "i": 22,
      "start": 80.0,
      "end": 82.0,
      "text": "Gwan Yin stepped forward."
    },
    {
      "i": 23,
      "start": 83.0,
      "end": 85.0,
      "text": "I will go."
    },
    {
      "i": 24,
      "start": 88.0,
      "end": 93.0,
      "text": "The Tang Emperor smiled as his head monk read to a small group of people."
    },
    {
      "i": 25,
      "start": 94.0,
      "end": 97.0,
      "text": "The monk was reading old religious texts."
    },
    {
      "i": 26,
      "start": 98.0,
      "end": 100.0,
      "text": "A woman interrupted the monk."
    },
    {
      "i": 27,
      "start": 101.0,
      "end": 103.0,
      "text": "Why are you reading those old texts?"
    },
    {
      "i": 28,
      "start": 104.0,
      "end": 105.0,
      "text": "She asked."
    },
    {
      "i": 29,
      "start": 106.0,
      "end": 108.0,
      "text": "Don't you know about the true scriptures?"
    },
    {
      "i": 30,
      "start": 110.0,
      "end": 112.0,
      "text": "The Emperor stood up."
    },
    {
      "i": 31,
      "start": 113.0,
      "end": 115.0,
      "text": "How dare you interrupt my..."
    },
    {
      "i": 32,
      "start": 116.0,
      "end": 117.0,
      "text": "It's okay."
    },
    {
      "i": 33,
      "start": 118.0,
      "end": 119.0,
      "text": "Said the monk."
    },
    {
      "i": 34,
      "start": 120.0,
      "end": 122.0,
      "text": "He walked over to the woman."
    },
    {
      "i": 35,
      "start": 129.0,
      "end": 131.0,
      "text": "What are the true scriptures?"
    },
    {
      "i": 36,
      "start": 132.0,
      "end": 134.0,
      "text": "The woman looked at the monk carefully."
    },
    {
      "i": 37,
      "start": 135.0,
      "end": 137.0,
      "text": "They contain many lessons."
    },
    {
      "i": 38,
      "start": 138.0,
      "end": 142.0,
      "text": "People who learn the lessons never have to suffer again."
    },
    {
      "i": 39,
      "start": 143.0,
      "end": 144.0,
      "text": "Do you have them here?"
    },
    {
      "i": 40,
      "start": 144.0,
      "end": 145.0,
      "text": "Ask the monk."
    },
    {
      "i": 41,
      "start": 146.0,
      "end": 147.0,
      "text": "No."
    },
    {
      "i": 42,
      "start": 147.0,
      "end": 148.0,
      "text": "Said the woman."
    },
    {
      "i": 43,
      "start": 148.0,
      "end": 150.0,
      "text": "They are with Buddha."
    }
  ]
}
