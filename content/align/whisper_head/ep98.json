{
  "episode": 98,
  "source": "assets/video/ep98.mp4",
  "model": "base",
  "duration": 316.09325,
  "segments": [
    {
      "i": 1,
      "start": 0.0,
      "end": 5.08,
      "text": "Journey to the West, Chapter 98."
    },
    {
      "i": 2,
      "start": 5.08,
      "end": 13.72,
      "text": "Three Fights."
    },
    {
      "i": 3,
      "start": 13.72,
      "end": 17.56,
      "text": "Wukong and his companions walked on the mountain road."
    },
    {
      "i": 4,
      "start": 17.56,
      "end": 21.4,
      "text": "The monkey watched carefully for the monster in demons."
    },
    {
      "i": 5,
      "start": 21.4,
      "end": 25.2,
      "text": "Suddenly, a demon charged toward the group."
    },
    {
      "i": 6,
      "start": 25.2,
      "end": 29.48,
      "text": "Stay here, everyone."
    },
    {
      "i": 7,
      "start": 29.48,
      "end": 36.68,
      "text": "The pig swung his rake."
    },
    {
      "i": 8,
      "start": 36.68,
      "end": 42.0,
      "text": "The demons stepped off the road and headed down the slope of the mountain."
    },
    {
      "i": 9,
      "start": 42.0,
      "end": 47.0,
      "text": "Bajai raced after the demon and was soon out of sight."
    },
    {
      "i": 10,
      "start": 47.0,
      "end": 51.0,
      "text": "Wukong heard grunts and clashing weapons."
    },
    {
      "i": 11,
      "start": 51.0,
      "end": 53.76,
      "text": "But he couldn't see the fight."
    },
    {
      "i": 12,
      "start": 53.76,
      "end": 60.16,
      "text": "A moment later, the demon climbed back onto the road."
    },
    {
      "i": 13,
      "start": 60.16,
      "end": 61.16,
      "text": "Stay here, Wu Jing."
    },
    {
      "i": 14,
      "start": 61.16,
      "end": 62.72,
      "text": "Shout at Wukong."
    },
    {
      "i": 15,
      "start": 62.72,
      "end": 65.24,
      "text": "Protect the Tang monk."
    },
    {
      "i": 16,
      "start": 65.24,
      "end": 68.36,
      "text": "The monkey charged toward the demon."
    },
    {
      "i": 17,
      "start": 68.36,
      "end": 69.36,
      "text": "Clang!"
    },
    {
      "i": 18,
      "start": 69.36,
      "end": 71.68,
      "text": "Their weapons clashed."
    },
    {
      "i": 19,
      "start": 71.68,
      "end": 76.16,
      "text": "Wukong fought with all his strength."
    },
    {
      "i": 20,
      "start": 76.16,
      "end": 80.08,
      "text": "Again the demon left the road and headed down the mountain."
    },
    {
      "i": 21,
      "start": 80.08,
      "end": 82.08,
      "text": "Wukong chased him."
    },
    {
      "i": 22,
      "start": 82.08,
      "end": 86.76,
      "text": "The monkey and the demon disappeared down the slope of the mountain."
    },
    {
      "i": 23,
      "start": 86.76,
      "end": 88.72,
      "text": "Do you think Wukong can defeat that demon?"
    },
    {
      "i": 24,
      "start": 88.72,
      "end": 91.56,
      "text": "Ask the Tang monk nervously."
    },
    {
      "i": 25,
      "start": 91.56,
      "end": 92.56,
      "text": "Definitely."
    },
    {
      "i": 26,
      "start": 92.56,
      "end": 93.8,
      "text": "Said Wu Jing."
    },
    {
      "i": 27,
      "start": 93.8,
      "end": 96.24,
      "text": "I wonder what happened to Bajai, though."
    },
    {
      "i": 28,
      "start": 96.24,
      "end": 99.4,
      "text": "I hope he's okay."
    },
    {
      "i": 29,
      "start": 99.4,
      "end": 102.76,
      "text": "Suddenly, the demon was back."
    },
    {
      "i": 30,
      "start": 102.76,
      "end": 104.24,
      "text": "Wu Jing was shocked."
    },
    {
      "i": 31,
      "start": 104.24,
      "end": 106.76,
      "text": "How did you get past Wukong?"
    },
    {
      "i": 32,
      "start": 106.76,
      "end": 112.08,
      "text": "Without waiting for an answer, Wu Jing raised his spear and attacked the demon."
    },
    {
      "i": 33,
      "start": 112.08,
      "end": 115.68,
      "text": "The two fought, kicking up dust and rocks."
    },
    {
      "i": 34,
      "start": 115.68,
      "end": 118.88,
      "text": "Wu Jing struck the demon across the legs."
    },
    {
      "i": 35,
      "start": 118.88,
      "end": 122.24,
      "text": "The demon tumbled down the mountain side."
    },
    {
      "i": 36,
      "start": 122.24,
      "end": 124.6,
      "text": "Wu Jing ran after him."
    },
    {
      "i": 37,
      "start": 124.6,
      "end": 127.4,
      "text": "The Tang monk stood in the road."
    },
    {
      "i": 38,
      "start": 127.4,
      "end": 130.68,
      "text": "For a moment, everything was quiet."
    },
    {
      "i": 39,
      "start": 130.68,
      "end": 133.32,
      "text": "Then he heard footsteps behind him."
    },
    {
      "i": 40,
      "start": 133.32,
      "end": 137.0,
      "text": "The monk turned around and gasped."
    },
    {
      "i": 41,
      "start": 137.0,
      "end": 143.08,
      "text": "A huge fat monster was smiling wickedly at him."
    },
    {
      "i": 42,
      "start": 143.08,
      "end": 147.92,
      "text": "When Wu Kong returned to the road, he found Bajai alone."
    },
    {
      "i": 43,
      "start": 147.92,
      "end": 149.16,
      "text": "The pig looked upset."
    }
  ]
}
