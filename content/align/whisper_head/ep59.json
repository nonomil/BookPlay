{
  "episode": 59,
  "source": "assets/video/ep59.mp4",
  "model": "base",
  "duration": 312.98175,
  "segments": [
    {
      "i": 1,
      "start": 0.0,
      "end": 5.0,
      "text": "Journey to the West, Chapter 59."
    },
    {
      "i": 2,
      "start": 5.0,
      "end": 12.0,
      "text": "Scared Villagers."
    },
    {
      "i": 3,
      "start": 12.0,
      "end": 17.0,
      "text": "Can we please stop to rest?"
    },
    {
      "i": 4,
      "start": 17.0,
      "end": 20.0,
      "text": "Moond Bajay one day."
    },
    {
      "i": 5,
      "start": 20.0,
      "end": 25.0,
      "text": "The group had spent the morning walking down a long mountain trail."
    },
    {
      "i": 6,
      "start": 25.0,
      "end": 27.0,
      "text": "My knees feel weak."
    },
    {
      "i": 7,
      "start": 27.0,
      "end": 29.0,
      "text": "Crite the pig."
    },
    {
      "i": 8,
      "start": 29.0,
      "end": 31.0,
      "text": "We'll rest in a little while, Bajay."
    },
    {
      "i": 9,
      "start": 31.0,
      "end": 33.0,
      "text": "Said the Tang Monk."
    },
    {
      "i": 10,
      "start": 33.0,
      "end": 38.0,
      "text": "As they walked, the traveller started to hear the sound of rushing water."
    },
    {
      "i": 11,
      "start": 38.0,
      "end": 41.0,
      "text": "It grew louder and louder."
    },
    {
      "i": 12,
      "start": 41.0,
      "end": 43.0,
      "text": "We're approaching a river."
    },
    {
      "i": 13,
      "start": 43.0,
      "end": 44.0,
      "text": "Said Wu Jing."
    },
    {
      "i": 14,
      "start": 44.0,
      "end": 47.0,
      "text": "The trail went around a hill."
    },
    {
      "i": 15,
      "start": 47.0,
      "end": 52.0,
      "text": "A moment later, the traveller saw the river."
    },
    {
      "i": 16,
      "start": 52.0,
      "end": 54.0,
      "text": "How will we cross this river?"
    },
    {
      "i": 17,
      "start": 54.0,
      "end": 56.0,
      "text": "Said the Tang Monk."
    },
    {
      "i": 18,
      "start": 56.0,
      "end": 59.0,
      "text": "It's so wide, I can't see the other side."
    },
    {
      "i": 19,
      "start": 59.0,
      "end": 65.0,
      "text": "Wu Kong leaped into the air and looked around."
    },
    {
      "i": 20,
      "start": 65.0,
      "end": 67.0,
      "text": "There's a small village nearby."
    },
    {
      "i": 21,
      "start": 67.0,
      "end": 68.0,
      "text": "He said."
    },
    {
      "i": 22,
      "start": 68.0,
      "end": 72.0,
      "text": "Maybe someone there has a boat."
    },
    {
      "i": 23,
      "start": 72.0,
      "end": 74.0,
      "text": "The group walked to the village."
    },
    {
      "i": 24,
      "start": 74.0,
      "end": 77.0,
      "text": "The street was deserted."
    },
    {
      "i": 25,
      "start": 77.0,
      "end": 82.0,
      "text": "A few villagers peaked out of windows and from behind doors."
    },
    {
      "i": 26,
      "start": 82.0,
      "end": 84.0,
      "text": "They looked scared."
    },
    {
      "i": 27,
      "start": 84.0,
      "end": 87.0,
      "text": "A man was getting water from a well."
    },
    {
      "i": 28,
      "start": 87.0,
      "end": 88.0,
      "text": "Hello."
    },
    {
      "i": 29,
      "start": 88.0,
      "end": 90.0,
      "text": "Said Wu Kong."
    },
    {
      "i": 30,
      "start": 90.0,
      "end": 96.0,
      "text": "Startled, the man dropped his bucket down the well and spun around."
    },
    {
      "i": 31,
      "start": 96.0,
      "end": 98.0,
      "text": "Who are you?"
    },
    {
      "i": 32,
      "start": 98.0,
      "end": 100.0,
      "text": "The Tang Monk stepped forward."
    },
    {
      "i": 33,
      "start": 100.0,
      "end": 102.0,
      "text": "I'm from the Tang Empire."
    },
    {
      "i": 34,
      "start": 102.0,
      "end": 107.0,
      "text": "We're traveling to the western paradise to get scriptures from Buddha."
    },
    {
      "i": 35,
      "start": 107.0,
      "end": 109.0,
      "text": "The man relaxed a bit."
    },
    {
      "i": 36,
      "start": 109.0,
      "end": 111.0,
      "text": "That's wonderful."
    },
    {
      "i": 37,
      "start": 111.0,
      "end": 113.0,
      "text": "We need a boat to get across the river."
    },
    {
      "i": 38,
      "start": 113.0,
      "end": 115.0,
      "text": "Said Bajai."
    },
    {
      "i": 39,
      "start": 115.0,
      "end": 116.0,
      "text": "I don't have a boat."
    },
    {
      "i": 40,
      "start": 116.0,
      "end": 117.0,
      "text": "Said the man."
    },
    {
      "i": 41,
      "start": 117.0,
      "end": 119.0,
      "text": "But someone in the village might."
    },
    {
      "i": 42,
      "start": 119.0,
      "end": 120.0,
      "text": "Please come with me."
    },
    {
      "i": 43,
      "start": 120.0,
      "end": 122.0,
      "text": "I'll make some tea."
    },
    {
      "i": 44,
      "start": 122.0,
      "end": 124.0,
      "text": "My name is Chen."
    },
    {
      "i": 45,
      "start": 126.0,
      "end": 130.0,
      "text": "The traveller followed Chen to his home."
    },
    {
      "i": 46,
      "start": 130.0,
      "end": 134.0,
      "text": "Inside, they sat down as Chen boiled water for tea."
    },
    {
      "i": 47,
      "start": 134.0,
      "end": 137.0,
      "text": "Why does everyone in this village seem so scared?"
    },
    {
      "i": 48,
      "start": 137.0,
      "end": 140.0,
      "text": "Ask the Tang Monk."
    },
    {
      "i": 49,
      "start": 140.0,
      "end": 143.0,
      "text": "Chen sat down."
    },
    {
      "i": 50,
      "start": 143.0,
      "end": 146.0,
      "text": "He started to cry."
    },
    {
      "i": 51,
      "start": 146.0,
      "end": 148.0,
      "text": "My dear man."
    },
    {
      "i": 52,
      "start": 148.0,
      "end": 150.0,
      "text": "Said the Tang Monk."
    }
  ]
}
