{
  "episode": 62,
  "source": "assets/video/ep62.mp4",
  "model": "base",
  "duration": 305.0173125,
  "segments": [
    {
      "i": 1,
      "start": 0.0,
      "end": 7.0,
      "text": "Journey to the West, Chapter 62, the Goldfish in the Baskin."
    },
    {
      "i": 2,
      "start": 13.0,
      "end": 16.0,
      "text": "Wukong landed on Mount Potolaka."
    },
    {
      "i": 3,
      "start": 16.0,
      "end": 19.0,
      "text": "A young man was meditating in the garden."
    },
    {
      "i": 4,
      "start": 19.0,
      "end": 21.0,
      "text": "Waskwan Yin."
    },
    {
      "i": 5,
      "start": 21.0,
      "end": 22.0,
      "text": "Asked the monkey."
    },
    {
      "i": 6,
      "start": 22.0,
      "end": 24.0,
      "text": "She's making a basket."
    },
    {
      "i": 7,
      "start": 24.0,
      "end": 25.0,
      "text": "Said the man."
    },
    {
      "i": 8,
      "start": 25.0,
      "end": 27.0,
      "text": "He glanced up at the monkey."
    },
    {
      "i": 9,
      "start": 27.0,
      "end": 29.0,
      "text": "It's good to see you again, Wukong."
    },
    {
      "i": 10,
      "start": 29.0,
      "end": 31.0,
      "text": "Wukong was puzzled."
    },
    {
      "i": 11,
      "start": 31.0,
      "end": 33.0,
      "text": "How do you know my name?"
    },
    {
      "i": 12,
      "start": 33.0,
      "end": 35.0,
      "text": "Don't you recognize me?"
    },
    {
      "i": 13,
      "start": 35.0,
      "end": 36.0,
      "text": "Said the man."
    },
    {
      "i": 14,
      "start": 38.0,
      "end": 41.0,
      "text": "Wukong stared for a moment and then gasped."
    },
    {
      "i": 15,
      "start": 41.0,
      "end": 43.0,
      "text": "You're a red boy."
    },
    {
      "i": 16,
      "start": 43.0,
      "end": 46.0,
      "text": "You look like a kind spirit now."
    },
    {
      "i": 17,
      "start": 46.0,
      "end": 47.0,
      "text": "Yes."
    },
    {
      "i": 18,
      "start": 47.0,
      "end": 48.0,
      "text": "Said red boy."
    },
    {
      "i": 19,
      "start": 48.0,
      "end": 50.0,
      "text": "I'm not an evil demon anymore."
    },
    {
      "i": 20,
      "start": 50.0,
      "end": 53.0,
      "text": "And I have you to thank for that."
    },
    {
      "i": 21,
      "start": 53.0,
      "end": 55.0,
      "text": "You brought Guanyin to me."
    },
    {
      "i": 22,
      "start": 55.0,
      "end": 57.0,
      "text": "She has taught me all about Buddhism."
    },
    {
      "i": 23,
      "start": 57.0,
      "end": 59.0,
      "text": "And now I'm very happy."
    },
    {
      "i": 24,
      "start": 59.0,
      "end": 60.0,
      "text": "You're welcome."
    },
    {
      "i": 25,
      "start": 60.0,
      "end": 62.0,
      "text": "Said Wukong."
    },
    {
      "i": 26,
      "start": 62.0,
      "end": 64.0,
      "text": "You and I have a lot in common."
    },
    {
      "i": 27,
      "start": 64.0,
      "end": 68.0,
      "text": "We were both evil causing all sorts of problems."
    },
    {
      "i": 28,
      "start": 68.0,
      "end": 70.0,
      "text": "Now we're both Buddhists."
    },
    {
      "i": 29,
      "start": 70.0,
      "end": 74.0,
      "text": "Guanyin came over holding a basket."
    },
    {
      "i": 30,
      "start": 74.0,
      "end": 75.0,
      "text": "Hello, Wukong."
    },
    {
      "i": 31,
      "start": 75.0,
      "end": 77.0,
      "text": "Said the Bodhisattva."
    },
    {
      "i": 32,
      "start": 77.0,
      "end": 79.0,
      "text": "I knew you would come here today."
    },
    {
      "i": 33,
      "start": 79.0,
      "end": 83.0,
      "text": "I've been working on this basket all morning."
    },
    {
      "i": 34,
      "start": 84.0,
      "end": 87.0,
      "text": "A look of confusion spread across the monkey's face."
    },
    {
      "i": 35,
      "start": 87.0,
      "end": 91.0,
      "text": "That's a nice basket, Bodhisattva."
    },
    {
      "i": 36,
      "start": 91.0,
      "end": 94.0,
      "text": "But what is it for?"
    },
    {
      "i": 37,
      "start": 94.0,
      "end": 97.0,
      "text": "This basket has magical powers."
    },
    {
      "i": 38,
      "start": 97.0,
      "end": 98.0,
      "text": "Said Guanyin."
    },
    {
      "i": 39,
      "start": 98.0,
      "end": 100.0,
      "text": "I will catch the demon with it."
    },
    {
      "i": 40,
      "start": 100.0,
      "end": 102.0,
      "text": "Let's go."
    },
    {
      "i": 41,
      "start": 109.0,
      "end": 112.0,
      "text": "Wukong returned to the river with Guanyin."
    },
    {
      "i": 42,
      "start": 112.0,
      "end": 117.0,
      "text": "The Bodhisattva used a rope to lower the basket into the river."
    },
    {
      "i": 43,
      "start": 117.0,
      "end": 121.0,
      "text": "She recited a spell and then waited."
    },
    {
      "i": 44,
      "start": 121.0,
      "end": 125.0,
      "text": "After a moment, she pulled the basket out of the water."
    },
    {
      "i": 45,
      "start": 128.0,
      "end": 131.0,
      "text": "Wukong looked in the basket."
    },
    {
      "i": 46,
      "start": 131.0,
      "end": 135.0,
      "text": "A small goldfish was flopping around in it."
    },
    {
      "i": 47,
      "start": 135.0,
      "end": 137.0,
      "text": "The monkey laughed."
    },
    {
      "i": 48,
      "start": 137.0,
      "end": 140.0,
      "text": "I guess you need to try again, Bodhisattva."
    },
    {
      "i": 49,
      "start": 140.0,
      "end": 142.0,
      "text": "That's not the demon."
    },
    {
      "i": 50,
      "start": 142.0,
      "end": 146.0,
      "text": "This is my goldfish, said Guanyin."
    },
    {
      "i": 51,
      "start": 146.0,
      "end": 150.0,
      "text": "It usually lives in my lotus pond."
    }
  ]
}
