{
  "episode": 87,
  "source": "assets/video/ep87.mp4",
  "model": "base",
  "duration": 333.29925,
  "segments": [
    {
      "i": 1,
      "start": 0.0,
      "end": 7.0,
      "text": "Journey to the West. Chapter 87, the three young women."
    },
    {
      "i": 2,
      "start": 14.5,
      "end": 18.0,
      "text": "Bukong and his companions were walking through a forest."
    },
    {
      "i": 3,
      "start": 18.5,
      "end": 21.5,
      "text": "I'm glad the road goes through the shady forest."
    },
    {
      "i": 4,
      "start": 21.5,
      "end": 23.0,
      "text": "Said the Tang monk."
    },
    {
      "i": 5,
      "start": 23.0,
      "end": 25.5,
      "text": "The sun is very hot this morning."
    },
    {
      "i": 6,
      "start": 25.5,
      "end": 27.0,
      "text": "Wu Xing nodded."
    },
    {
      "i": 7,
      "start": 27.0,
      "end": 29.5,
      "text": "It's nice to walk in the shade."
    },
    {
      "i": 8,
      "start": 30.0,
      "end": 32.5,
      "text": "Wu Kong looked around suspiciously."
    },
    {
      "i": 9,
      "start": 33.0,
      "end": 36.5,
      "text": "He knew that forests were often filled with dangers."
    },
    {
      "i": 10,
      "start": 37.0,
      "end": 40.5,
      "text": "Suddenly, Baje fell flat on his face."
    },
    {
      "i": 11,
      "start": 42.5,
      "end": 46.0,
      "text": "He climbed back to his feet and rubbed his nose."
    },
    {
      "i": 12,
      "start": 46.0,
      "end": 47.0,
      "text": "I'm okay."
    },
    {
      "i": 13,
      "start": 47.0,
      "end": 48.0,
      "text": "He said."
    },
    {
      "i": 14,
      "start": 48.0,
      "end": 50.0,
      "text": "I tripped on a rock."
    },
    {
      "i": 15,
      "start": 53.0,
      "end": 57.0,
      "text": "The traveler soon came to a wall running along the road."
    },
    {
      "i": 16,
      "start": 57.5,
      "end": 60.5,
      "text": "Behind the wall, they could see the roof of a house."
    },
    {
      "i": 17,
      "start": 60.5,
      "end": 63.0,
      "text": "Up ahead was a gate."
    },
    {
      "i": 18,
      "start": 64.0,
      "end": 65.5,
      "text": "I wonder who lives here."
    },
    {
      "i": 19,
      "start": 65.5,
      "end": 66.5,
      "text": "Said Wu Xing."
    },
    {
      "i": 20,
      "start": 68.5,
      "end": 69.0,
      "text": "Shhh."
    },
    {
      "i": 21,
      "start": 69.0,
      "end": 70.5,
      "text": "Said Wu Kong."
    },
    {
      "i": 22,
      "start": 70.5,
      "end": 71.5,
      "text": "I hear laughter."
    },
    {
      "i": 23,
      "start": 71.5,
      "end": 74.0,
      "text": "The monkey peaked over the wall."
    },
    {
      "i": 24,
      "start": 74.5,
      "end": 78.5,
      "text": "Three young women were laughing and kicking them all around."
    },
    {
      "i": 25,
      "start": 79.5,
      "end": 82.5,
      "text": "I see three young women said Wu Kong."
    },
    {
      "i": 26,
      "start": 83.0,
      "end": 84.5,
      "text": "Let's ask them for some food."
    },
    {
      "i": 27,
      "start": 84.5,
      "end": 86.0,
      "text": "Said Wu Xing."
    },
    {
      "i": 28,
      "start": 86.5,
      "end": 87.5,
      "text": "That's a good idea."
    },
    {
      "i": 29,
      "start": 87.5,
      "end": 88.5,
      "text": "Said Baje."
    },
    {
      "i": 30,
      "start": 88.5,
      "end": 90.5,
      "text": "I'll go talk to them."
    },
    {
      "i": 31,
      "start": 90.5,
      "end": 92.5,
      "text": "The pig headed toward the gate."
    },
    {
      "i": 32,
      "start": 92.5,
      "end": 95.0,
      "text": "Baje wait here."
    },
    {
      "i": 33,
      "start": 95.0,
      "end": 96.5,
      "text": "Said the Tang monk."
    },
    {
      "i": 34,
      "start": 96.5,
      "end": 98.5,
      "text": "He looked at his companions."
    },
    {
      "i": 35,
      "start": 99.5,
      "end": 101.0,
      "text": "I will speak to the women."
    },
    {
      "i": 36,
      "start": 101.0,
      "end": 103.0,
      "text": "You three might frighten them."
    },
    {
      "i": 37,
      "start": 103.0,
      "end": 104.5,
      "text": "frighten them."
    },
    {
      "i": 38,
      "start": 104.5,
      "end": 106.0,
      "text": "Baje echoed."
    },
    {
      "i": 39,
      "start": 106.0,
      "end": 107.0,
      "text": "Yes."
    },
    {
      "i": 40,
      "start": 107.0,
      "end": 108.5,
      "text": "Said the Tang monk."
    },
    {
      "i": 41,
      "start": 108.5,
      "end": 112.5,
      "text": "After all, Baje, you're a large talking pig."
    },
    {
      "i": 42,
      "start": 112.5,
      "end": 115.0,
      "text": "Wu Xing, you're big and purple."
    },
    {
      "i": 43,
      "start": 116.0,
      "end": 119.0,
      "text": "And Wu Kong, you're scary sometimes."
    },
    {
      "i": 44,
      "start": 120.5,
      "end": 122.0,
      "text": "The monkey shrugged."
    },
    {
      "i": 45,
      "start": 123.0,
      "end": 124.0,
      "text": "Wu Xing nodded."
    },
    {
      "i": 46,
      "start": 126.0,
      "end": 127.0,
      "text": "Fine."
    },
    {
      "i": 47,
      "start": 127.0,
      "end": 128.0,
      "text": "snapped Baje."
    },
    {
      "i": 48,
      "start": 132.0,
      "end": 134.0,
      "text": "The Tang monk opened the gate and went through."
    },
    {
      "i": 49,
      "start": 136.5,
      "end": 138.0,
      "text": "He approached the women."
    },
    {
      "i": 50,
      "start": 140.0,
      "end": 141.0,
      "text": "Look."
    },
    {
      "i": 51,
      "start": 141.0,
      "end": 142.0,
      "text": "Said one woman."
    },
    {
      "i": 52,
      "start": 142.0,
      "end": 144.0,
      "text": "We have a visitor."
    },
    {
      "i": 53,
      "start": 144.0,
      "end": 145.0,
      "text": "He's a monk."
    },
    {
      "i": 54,
      "start": 145.0,
      "end": 147.0,
      "text": "Said another woman."
    },
    {
      "i": 55,
      "start": 147.0,
      "end": 149.0,
      "text": "What can we do for you?"
    },
    {
      "i": 56,
      "start": 149.0,
      "end": 150.0,
      "text": "Ask the third."
    }
  ]
}
