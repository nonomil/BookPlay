  "model": "base",
  "duration": 326.4029375,
  "segments": [
    {
      "i": 1,
      "start": 0.0,
      "end": 3.84,
      "text": "Journey to the West."
    },
    {
      "i": 2,
      "start": 3.84,
      "end": 5.36,
      "text": "Chapter 4."
    },
    {
      "i": 3,
      "start": 5.36,
      "end": 14.04,
      "text": "Secret Formulas."
    },
    {
      "i": 4,
      "start": 14.04,
      "end": 19.04,
      "text": "When the other students went to bed that night, Wukong stayed awake."
    },
    {
      "i": 5,
      "start": 19.04,
      "end": 24.04,
      "text": "At three o'clock in the morning, he crept quietly through the dark temple."
    },
    {
      "i": 6,
      "start": 24.04,
      "end": 28.88,
      "text": "He entered Sabote's room."
    },
    {
      "i": 7,
      "start": 28.88,
      "end": 30.88,
      "text": "What are you doing here?"
    },
    {
      "i": 8,
      "start": 30.88,
      "end": 32.88,
      "text": "Ask the sage."
    },
    {
      "i": 9,
      "start": 32.88,
      "end": 34.84,
      "text": "I understood your secret message."
    },
    {
      "i": 10,
      "start": 34.84,
      "end": 36.8,
      "text": "Said the monkey."
    },
    {
      "i": 11,
      "start": 36.8,
      "end": 39.8,
      "text": "You hit me on the head three times."
    },
    {
      "i": 12,
      "start": 39.8,
      "end": 42.56,
      "text": "That meant you wanted me to visit you at three o'clock."
    },
    {
      "i": 13,
      "start": 42.56,
      "end": 46.0,
      "text": "Now, will you teach me how to live forever?"
    },
    {
      "i": 14,
      "start": 46.0,
      "end": 48.04,
      "text": "Sabote smiled."
    },
    {
      "i": 15,
      "start": 48.04,
      "end": 50.48,
      "text": "I knew you were a worthy student."
    },
    {
      "i": 16,
      "start": 50.48,
      "end": 54.96,
      "text": "Come closer."
    },
    {
      "i": 17,
      "start": 54.96,
      "end": 58.32,
      "text": "Sabote whispered into Wukong's ear."
    },
    {
      "i": 18,
      "start": 58.32,
      "end": 64.28,
      "text": "The sage whispered prayers as well as secret formulas about the universe and nature."
    },
    {
      "i": 19,
      "start": 64.28,
      "end": 72.04,
      "text": "As the monkey listened to his teacher's words, powerful light filled the room."
    },
    {
      "i": 20,
      "start": 72.04,
      "end": 78.24,
      "text": "Now Wukong knew how to live forever."
    },
    {
      "i": 21,
      "start": 78.24,
      "end": 83.6,
      "text": "For the next few years, Wukong meditated and practiced the secret formulas."
    },
    {
      "i": 22,
      "start": 83.6,
      "end": 88.32,
      "text": "While the other students slept at night, Wukong stayed up."
    },
    {
      "i": 23,
      "start": 88.32,
      "end": 95.4,
      "text": "Soon his mind and body were powerful, and he could change shape or size."
    },
    {
      "i": 24,
      "start": 95.4,
      "end": 106.24,
      "text": "He could turn into other animals and soar through the sky on clouds."
    },
    {
      "i": 25,
      "start": 106.24,
      "end": 110.68,
      "text": "One day, all the students were sitting outside."
    },
    {
      "i": 26,
      "start": 110.68,
      "end": 112.88,
      "text": "Wukong said one student."
    },
    {
      "i": 27,
      "start": 112.88,
      "end": 114.88,
      "text": "You have been busy lately."
    },
    {
      "i": 28,
      "start": 114.88,
      "end": 115.88,
      "text": "It's true."
    },
    {
      "i": 29,
      "start": 115.88,
      "end": 117.44,
      "text": "Said another student."
    },
    {
      "i": 30,
      "start": 117.44,
      "end": 118.84,
      "text": "What have you been doing?"
    },
    {
      "i": 31,
      "start": 118.84,
      "end": 122.64,
      "text": "I've been meditating and practicing secret formulas."
    },
    {
      "i": 32,
      "start": 122.64,
      "end": 124.56,
      "text": "Said Wukong."
    },
    {
      "i": 33,
      "start": 124.56,
      "end": 125.8,
      "text": "Secret formulas."
    },
    {
      "i": 34,
      "start": 125.8,
      "end": 127.96,
      "text": "Said the first student."
    },
    {
      "i": 35,
      "start": 127.96,
      "end": 130.6,
      "text": "Everyone looked very interested."
    },
    {
      "i": 36,
      "start": 130.6,
      "end": 133.12,
      "text": "They leaned in closer to Wukong."
    },
    {
      "i": 37,
      "start": 133.12,
      "end": 134.12,
      "text": "Yes."
    },
    {
      "i": 38,
      "start": 134.12,
      "end": 135.8,
      "text": "Said the monkey."
    },
    {
      "i": 39,
      "start": 135.8,
      "end": 138.72,
      "text": "Our master told them to me."
    },
    {
      "i": 40,
      "start": 138.72,
      "end": 139.72,
      "text": "He did."
    },
    {
      "i": 41,
      "start": 139.72,
      "end": 141.2,
      "text": "Said a student."
    },
    {
      "i": 42,
      "start": 141.2,
      "end": 142.72,
      "text": "You must be special."
    },
    {
      "i": 43,
      "start": 142.72,
      "end": 145.36,
      "text": "He doesn't tell everyone those formulas."
    },
    {
      "i": 44,
      "start": 145.36,
      "end": 147.2,
      "text": "What did he teach you?"
    },
    {
      "i": 45,
      "start": 147.2,
      "end": 149.0,
      "text": "Wukong smiled."
    },
    {
      "i": 46,
      "start": 149.0,
      "end": 150.0,
      "text": "He taught me how to live."
    }
  ]
}
