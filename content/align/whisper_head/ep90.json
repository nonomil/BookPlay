{
  "episode": 90,
  "source": "assets/video/ep90.mp4",
  "model": "base",
  "duration": 318.04375,
  "segments": [
    {
      "i": 1,
      "start": 0.0,
      "end": 11.8,
      "text": "Journey to the West, Chapter 90, The Demon's Plan."
    },
    {
      "i": 2,
      "start": 11.8,
      "end": 15.26,
      "text": "The man on the road continued to wave a warning."
    },
    {
      "i": 3,
      "start": 15.26,
      "end": 19.16,
      "text": "Trembling with fear, the tank monk fell from his horse."
    },
    {
      "i": 4,
      "start": 19.16,
      "end": 22.2,
      "text": "Wu Xing rushed over to help him stand up."
    },
    {
      "i": 5,
      "start": 22.2,
      "end": 24.2,
      "text": "I'll be right back."
    },
    {
      "i": 6,
      "start": 24.2,
      "end": 26.2,
      "text": "Said Wu Kong."
    },
    {
      "i": 7,
      "start": 26.2,
      "end": 29.88,
      "text": "I'll ask that man what sort of danger is up ahead."
    },
    {
      "i": 8,
      "start": 29.88,
      "end": 37.4,
      "text": "The monkey walked toward the man."
    },
    {
      "i": 9,
      "start": 37.4,
      "end": 43.2,
      "text": "Looking closely, Wu Kong could tell that he was not an ordinary man."
    },
    {
      "i": 10,
      "start": 43.2,
      "end": 45.6,
      "text": "Hello, Venus."
    },
    {
      "i": 11,
      "start": 45.6,
      "end": 47.84,
      "text": "Said Wu Kong with a smile."
    },
    {
      "i": 12,
      "start": 47.84,
      "end": 49.24,
      "text": "The man smiled back."
    },
    {
      "i": 13,
      "start": 49.24,
      "end": 50.56,
      "text": "Yes, it's me."
    },
    {
      "i": 14,
      "start": 50.56,
      "end": 53.04,
      "text": "The spirit of the planet Venus."
    },
    {
      "i": 15,
      "start": 53.04,
      "end": 56.6,
      "text": "I came into skies to warn you, Wu Kong."
    },
    {
      "i": 16,
      "start": 56.6,
      "end": 61.04,
      "text": "There are three powerful demons on the mountain up ahead."
    },
    {
      "i": 17,
      "start": 61.04,
      "end": 63.52,
      "text": "The first is a lion demon."
    },
    {
      "i": 18,
      "start": 63.52,
      "end": 66.28,
      "text": "The second is an elephant demon."
    },
    {
      "i": 19,
      "start": 66.28,
      "end": 69.92,
      "text": "And the third is a raptor demon."
    },
    {
      "i": 20,
      "start": 69.92,
      "end": 70.92,
      "text": "The monkey shrugged."
    },
    {
      "i": 21,
      "start": 70.92,
      "end": 73.08,
      "text": "Thanks for the warning, Venus."
    },
    {
      "i": 22,
      "start": 73.08,
      "end": 77.28,
      "text": "But I'm not worried about three silly demons."
    },
    {
      "i": 23,
      "start": 77.28,
      "end": 78.56,
      "text": "Venus shook his head."
    },
    {
      "i": 24,
      "start": 78.56,
      "end": 80.2,
      "text": "You should be worried."
    },
    {
      "i": 25,
      "start": 80.2,
      "end": 84.32,
      "text": "Three demons command a demon army."
    },
    {
      "i": 26,
      "start": 84.32,
      "end": 86.76,
      "text": "Wu Kong rubbed his chin."
    },
    {
      "i": 27,
      "start": 86.76,
      "end": 89.0,
      "text": "Once again, thank you for the warning."
    },
    {
      "i": 28,
      "start": 89.0,
      "end": 94.04,
      "text": "But even an entire army of demons doesn't worry me."
    },
    {
      "i": 29,
      "start": 94.04,
      "end": 95.04,
      "text": "Venus nodded."
    },
    {
      "i": 30,
      "start": 95.04,
      "end": 96.92,
      "text": "Very well, Wu Kong."
    },
    {
      "i": 31,
      "start": 96.92,
      "end": 98.84,
      "text": "Good luck."
    },
    {
      "i": 32,
      "start": 98.84,
      "end": 101.08,
      "text": "The spirit vanished."
    },
    {
      "i": 33,
      "start": 101.08,
      "end": 104.68,
      "text": "The monkey walked back to his companions."
    },
    {
      "i": 34,
      "start": 104.68,
      "end": 105.68,
      "text": "Well."
    },
    {
      "i": 35,
      "start": 105.68,
      "end": 109.28,
      "text": "Said Bajie."
    },
    {
      "i": 36,
      "start": 109.28,
      "end": 110.88,
      "text": "What did the man say?"
    },
    {
      "i": 37,
      "start": 110.88,
      "end": 113.04,
      "text": "Is there danger up ahead?"
    },
    {
      "i": 38,
      "start": 113.04,
      "end": 114.2,
      "text": "Are there demons?"
    },
    {
      "i": 39,
      "start": 114.2,
      "end": 116.44,
      "text": "Asked the Tang monks still scared."
    },
    {
      "i": 40,
      "start": 116.44,
      "end": 118.52,
      "text": "Actually, yes."
    },
    {
      "i": 41,
      "start": 118.52,
      "end": 120.2,
      "text": "Said Wu Kong."
    },
    {
      "i": 42,
      "start": 120.2,
      "end": 121.88,
      "text": "There's an army of demons."
    },
    {
      "i": 43,
      "start": 121.88,
      "end": 124.72,
      "text": "But I'm not worried."
    },
    {
      "i": 44,
      "start": 124.72,
      "end": 127.76,
      "text": "The Tang monks jaw dropped."
    },
    {
      "i": 45,
      "start": 127.76,
      "end": 130.28,
      "text": "How can you not be worried?"
    },
    {
      "i": 46,
      "start": 130.28,
      "end": 131.88,
      "text": "Wu Kong laughed."
    },
    {
      "i": 47,
      "start": 131.88,
      "end": 133.84,
      "text": "Master, have you forgotten?"
    },
    {
      "i": 48,
      "start": 133.84,
      "end": 137.48,
      "text": "I once defeated heaven's entire army."
    },
    {
      "i": 49,
      "start": 137.48,
      "end": 138.96,
      "text": "Wishing frowned."
    },
    {
      "i": 50,
      "start": 138.96,
      "end": 142.52,
      "text": "Yes, we all know about that, Wu Kong."
    },
    {
      "i": 51,
      "start": 142.52,
      "end": 144.4,
      "text": "But this is different."
    },
    {
      "i": 52,
      "start": 144.4,
      "end": 145.88,
      "text": "The Tang monk is with us."
    },
    {
      "i": 53,
      "start": 145.88,
      "end": 148.4,
      "text": "We must keep him safe."
    },
    {
      "i": 54,
      "start": 148.4,
      "end": 149.72,
      "text": "Bajie nodded."
    },
    {
      "i": 55,
      "start": 149.72,
      "end": 150.0,
      "text": "Yes."
    }
  ]
}
