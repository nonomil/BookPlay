{
  "episode": 16,
  "source": "assets/video/ep16.mp4",
  "model": "base",
  "duration": 312.308375,
  "segments": [
    {
      "i": 1,
      "start": 0.0,
      "end": 3.66,
      "text": "Journey to the West."
    },
    {
      "i": 2,
      "start": 3.66,
      "end": 5.32,
      "text": "Chapter 16."
    },
    {
      "i": 3,
      "start": 5.32,
      "end": 12.36,
      "text": "Wukong gets tricked."
    },
    {
      "i": 4,
      "start": 12.36,
      "end": 15.56,
      "text": "Wukong looked at the Dragon King and sigh."
    },
    {
      "i": 5,
      "start": 15.56,
      "end": 17.32,
      "text": "You're right."
    },
    {
      "i": 6,
      "start": 17.32,
      "end": 18.72,
      "text": "Said the monkey."
    },
    {
      "i": 7,
      "start": 18.72,
      "end": 21.56,
      "text": "I did make a promise to Gwanyin."
    },
    {
      "i": 8,
      "start": 21.56,
      "end": 25.44,
      "text": "He put down his tea cup and stood up."
    },
    {
      "i": 9,
      "start": 25.44,
      "end": 26.72,
      "text": "Thank you my friend."
    },
    {
      "i": 10,
      "start": 26.72,
      "end": 29.12,
      "text": "I will visit again soon."
    },
    {
      "i": 11,
      "start": 29.12,
      "end": 33.36,
      "text": "The Dragon King smiled."
    },
    {
      "i": 12,
      "start": 33.36,
      "end": 40.76,
      "text": "The monkey hurried out of the Dragon King's palace."
    },
    {
      "i": 13,
      "start": 40.76,
      "end": 44.92,
      "text": "He found the Tang monk traveling alongside his stream."
    },
    {
      "i": 14,
      "start": 44.92,
      "end": 46.56,
      "text": "Master, I have returned."
    },
    {
      "i": 15,
      "start": 46.56,
      "end": 50.64,
      "text": "He called."
    },
    {
      "i": 16,
      "start": 50.64,
      "end": 51.96,
      "text": "I'm glad you're back, Wukong."
    },
    {
      "i": 17,
      "start": 51.96,
      "end": 54.84,
      "text": "Said the monk."
    },
    {
      "i": 18,
      "start": 54.84,
      "end": 56.88,
      "text": "I'm hungry."
    },
    {
      "i": 19,
      "start": 56.88,
      "end": 59.28,
      "text": "I'll find a village in beg for some food for you."
    },
    {
      "i": 20,
      "start": 59.28,
      "end": 61.32,
      "text": "Said the monkey."
    },
    {
      "i": 21,
      "start": 61.32,
      "end": 62.56,
      "text": "You don't need to do that."
    },
    {
      "i": 22,
      "start": 62.56,
      "end": 64.36,
      "text": "Said the monk."
    },
    {
      "i": 23,
      "start": 64.36,
      "end": 65.64,
      "text": "There's rice in the bag."
    },
    {
      "i": 24,
      "start": 65.64,
      "end": 67.52,
      "text": "You can cook that."
    },
    {
      "i": 25,
      "start": 67.52,
      "end": 73.68,
      "text": "The monk got down from the horse."
    },
    {
      "i": 26,
      "start": 73.68,
      "end": 76.28,
      "text": "Wukong opened the bag."
    },
    {
      "i": 27,
      "start": 76.28,
      "end": 80.12,
      "text": "When he looked inside, his eyes opened wide."
    },
    {
      "i": 28,
      "start": 80.12,
      "end": 83.8,
      "text": "He pulled out the headband."
    },
    {
      "i": 29,
      "start": 83.8,
      "end": 85.84,
      "text": "This headband is marvelous."
    },
    {
      "i": 30,
      "start": 85.84,
      "end": 86.84,
      "text": "Said Wukong."
    },
    {
      "i": 31,
      "start": 86.84,
      "end": 87.84,
      "text": "Oh?"
    },
    {
      "i": 32,
      "start": 87.84,
      "end": 91.2,
      "text": "Said the monk watching the monkey closely."
    },
    {
      "i": 33,
      "start": 91.2,
      "end": 92.6,
      "text": "Do you like it?"
    },
    {
      "i": 34,
      "start": 92.6,
      "end": 93.6,
      "text": "Yes!"
    },
    {
      "i": 35,
      "start": 93.6,
      "end": 94.6,
      "text": "Said Wukong."
    },
    {
      "i": 36,
      "start": 94.6,
      "end": 95.6,
      "text": "Try it on."
    },
    {
      "i": 37,
      "start": 95.6,
      "end": 97.4,
      "text": "Said the monk."
    },
    {
      "i": 38,
      "start": 97.4,
      "end": 98.4,
      "text": "Really?"
    },
    {
      "i": 39,
      "start": 98.4,
      "end": 100.8,
      "text": "Asked Wukong."
    },
    {
      "i": 40,
      "start": 100.8,
      "end": 102.28,
      "text": "The monk nodded."
    },
    {
      "i": 41,
      "start": 102.28,
      "end": 109.6,
      "text": "Wukong put the headband on."
    },
    {
      "i": 42,
      "start": 109.6,
      "end": 112.92,
      "text": "He looked at his reflection in a stream."
    },
    {
      "i": 43,
      "start": 112.92,
      "end": 114.36,
      "text": "I look handsome."
    },
    {
      "i": 44,
      "start": 114.36,
      "end": 115.36,
      "text": "Said Wukong."
    },
    {
      "i": 45,
      "start": 115.6,
      "end": 116.6,
      "text": "Thanks for..."
    },
    {
      "i": 46,
      "start": 116.6,
      "end": 118.36,
      "text": "Ah!"
    },
    {
      "i": 47,
      "start": 118.36,
      "end": 122.12,
      "text": "The monkey grabbed the sides of his head and fell over."
    },
    {
      "i": 48,
      "start": 122.12,
      "end": 123.12,
      "text": "His eyes bulged."
    },
    {
      "i": 49,
      "start": 123.12,
      "end": 126.56,
      "text": "My head's going to explode."
    },
    {
      "i": 50,
      "start": 126.56,
      "end": 129.08,
      "text": "He cried."
    },
    {
      "i": 51,
      "start": 129.08,
      "end": 132.76,
      "text": "He saw the Tang monk talking quietly."
    },
    {
      "i": 52,
      "start": 132.76,
      "end": 133.76,
      "text": "What?"
    },
    {
      "i": 53,
      "start": 133.76,
      "end": 135.08,
      "text": "What are you saying?"
    },
    {
      "i": 54,
      "start": 135.08,
      "end": 136.96,
      "text": "cried Wukong."
    },
    {
      "i": 55,
      "start": 136.96,
      "end": 141.2,
      "text": "The Tang monk stopped talking and the pain stopped."
    },
    {
      "i": 56,
      "start": 141.2,
      "end": 143.6,
      "text": "The Buddha's at Vaguanian taught me a spell."
    },
    {
      "i": 57,
      "start": 143.6,
      "end": 145.24,
      "text": "Said the monk."
    },
    {
      "i": 58,
      "start": 145.24,
      "end": 148.16,
      "text": "He gave me the headband to force you to be good."
    },
    {
      "i": 59,
      "start": 148.16,
      "end": 150.0,
      "text": "Wukong pulled up the headband."
    }
  ]
}
