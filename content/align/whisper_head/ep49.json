{
  "episode": 49,
  "source": "assets/video/ep49.mp4",
  "model": "base",
  "duration": 292.3624375,
  "segments": [
    {
      "i": 1,
      "start": 0.0,
      "end": 7.0,
      "text": "Journey to the West, Chapter 49, Red Boy."
    },
    {
      "i": 2,
      "start": 13.0,
      "end": 14.0,
      "text": "Wolfgang is right."
    },
    {
      "i": 3,
      "start": 14.0,
      "end": 15.0,
      "text": "Said, Bajé."
    },
    {
      "i": 4,
      "start": 15.0,
      "end": 22.0,
      "text": "We should all go home and forget about reaching the Western Paradise."
    },
    {
      "i": 5,
      "start": 22.0,
      "end": 26.0,
      "text": "I'll return to my cave and take a nice long nap."
    },
    {
      "i": 6,
      "start": 26.0,
      "end": 29.0,
      "text": "Bajé started to walk away."
    },
    {
      "i": 7,
      "start": 29.0,
      "end": 31.0,
      "text": "Woojin grabbed him."
    },
    {
      "i": 8,
      "start": 31.0,
      "end": 32.0,
      "text": "Are you crazy?"
    },
    {
      "i": 9,
      "start": 32.0,
      "end": 34.0,
      "text": "He looked at Wukong."
    },
    {
      "i": 10,
      "start": 34.0,
      "end": 36.0,
      "text": "We can't go home."
    },
    {
      "i": 11,
      "start": 36.0,
      "end": 38.0,
      "text": "I know that."
    },
    {
      "i": 12,
      "start": 38.0,
      "end": 39.0,
      "text": "Said the monkey."
    },
    {
      "i": 13,
      "start": 39.0,
      "end": 42.0,
      "text": "I wasn't serious about going home."
    },
    {
      "i": 14,
      "start": 42.0,
      "end": 44.0,
      "text": "But I'm angry with Master."
    },
    {
      "i": 15,
      "start": 44.0,
      "end": 48.0,
      "text": "How many times have I warned him about demons?"
    },
    {
      "i": 16,
      "start": 48.0,
      "end": 51.0,
      "text": "He never believes me."
    },
    {
      "i": 17,
      "start": 51.0,
      "end": 55.0,
      "text": "If he had listened to me earlier, he wouldn't have been kidnapped."
    },
    {
      "i": 18,
      "start": 55.0,
      "end": 58.0,
      "text": "Wukong sighed."
    },
    {
      "i": 19,
      "start": 58.0,
      "end": 61.0,
      "text": "We need to figure out where the demon took him."
    },
    {
      "i": 20,
      "start": 61.0,
      "end": 63.0,
      "text": "I'll summon a local spirit."
    },
    {
      "i": 21,
      "start": 63.0,
      "end": 67.0,
      "text": "The monkey closed his eyes and muttered some words."
    },
    {
      "i": 22,
      "start": 67.0,
      "end": 72.0,
      "text": "A soft breeze blew and then a spirit appeared."
    },
    {
      "i": 23,
      "start": 72.0,
      "end": 74.0,
      "text": "Hello, son, Wukong."
    },
    {
      "i": 24,
      "start": 74.0,
      "end": 76.0,
      "text": "Said the spirit."
    },
    {
      "i": 25,
      "start": 76.0,
      "end": 79.0,
      "text": "I am the spirit of this mountain."
    },
    {
      "i": 26,
      "start": 79.0,
      "end": 81.0,
      "text": "Our Master was kidnapped by a demon."
    },
    {
      "i": 27,
      "start": 81.0,
      "end": 82.0,
      "text": "Said, Wukong."
    },
    {
      "i": 28,
      "start": 82.0,
      "end": 86.0,
      "text": "We think the demon lives near here but we don't know where."
    },
    {
      "i": 29,
      "start": 86.0,
      "end": 87.0,
      "text": "Oh dear."
    },
    {
      "i": 30,
      "start": 87.0,
      "end": 89.0,
      "text": "Said the spirit."
    },
    {
      "i": 31,
      "start": 89.0,
      "end": 90.0,
      "text": "He looked nervous."
    },
    {
      "i": 32,
      "start": 90.0,
      "end": 96.0,
      "text": "Your Master was probably kidnapped by Red Boy, a very nasty demon."
    },
    {
      "i": 33,
      "start": 96.0,
      "end": 99.0,
      "text": "His cave is near the peak of that mountain."
    },
    {
      "i": 34,
      "start": 99.0,
      "end": 103.0,
      "text": "The spirit pointed to a nearby mountain."
    },
    {
      "i": 35,
      "start": 103.0,
      "end": 105.0,
      "text": "You shouldn't go there though."
    },
    {
      "i": 36,
      "start": 105.0,
      "end": 107.0,
      "text": "The spirit continued."
    },
    {
      "i": 37,
      "start": 107.0,
      "end": 109.0,
      "text": "Red Boy is very powerful."
    },
    {
      "i": 38,
      "start": 109.0,
      "end": 115.0,
      "text": "His father is the Gold Demon King, one of the most horrible demons ever."
    },
    {
      "i": 39,
      "start": 116.0,
      "end": 122.0,
      "text": "A smile spread across Wukong's face and he began to laugh."
    },
    {
      "i": 40,
      "start": 122.0,
      "end": 124.0,
      "text": "That is good news."
    },
    {
      "i": 41,
      "start": 124.0,
      "end": 128.0,
      "text": "Everyone looked at the monkey and surprise."
    },
    {
      "i": 42,
      "start": 128.0,
      "end": 130.0,
      "text": "Why is that good news?"
    },
    {
      "i": 43,
      "start": 130.0,
      "end": 131.0,
      "text": "Asked Wu Jing."
    },
    {
      "i": 44,
      "start": 131.0,
      "end": 134.0,
      "text": "The Gold Demon King is an old friend of mine."
    },
    {
      "i": 45,
      "start": 134.0,
      "end": 136.0,
      "text": "Said Wukong."
    },
    {
      "i": 46,
      "start": 136.0,
      "end": 141.0,
      "text": "Before I caused trouble in heaven, I was friends with a group of demon kings."
    },
    {
      "i": 47,
      "start": 141.0,
      "end": 143.0,
      "text": "The Gold Demon King was one of them."
    },
    {
      "i": 48,
      "start": 143.0,
      "end": 149.0,
      "text": "When I tell Red Boy who I am, he'll release the Tang Monk right away."
    }
  ]
}
