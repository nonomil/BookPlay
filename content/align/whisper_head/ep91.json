{
  "episode": 91,
  "source": "assets/video/ep91.mp4",
  "model": "base",
  "duration": 335.133625,
  "segments": [
    {
      "i": 1,
      "start": 0.0,
      "end": 12.0,
      "text": "Journey to the West, Chapter 91, the Demon Officers."
    },
    {
      "i": 2,
      "start": 12.0,
      "end": 16.54,
      "text": "The demon general looked at Wukong, who was still in disguise."
    },
    {
      "i": 3,
      "start": 16.54,
      "end": 18.96,
      "text": "The Tang monk is heading toward our mountain."
    },
    {
      "i": 4,
      "start": 18.96,
      "end": 20.46,
      "text": "The general asked."
    },
    {
      "i": 5,
      "start": 20.46,
      "end": 21.46,
      "text": "Yes!"
    },
    {
      "i": 6,
      "start": 21.46,
      "end": 22.78,
      "text": "Said Wukong."
    },
    {
      "i": 7,
      "start": 22.78,
      "end": 25.56,
      "text": "That is great news!"
    },
    {
      "i": 8,
      "start": 25.56,
      "end": 27.4,
      "text": "Said a demon captain."
    },
    {
      "i": 9,
      "start": 27.6,
      "end": 30.82,
      "text": "Unfortunately, there's also some bad news."
    },
    {
      "i": 10,
      "start": 30.82,
      "end": 33.52,
      "text": "Wukong pretended to look worried."
    },
    {
      "i": 11,
      "start": 33.52,
      "end": 36.84,
      "text": "The Tang monk has three companions."
    },
    {
      "i": 12,
      "start": 36.84,
      "end": 39.36,
      "text": "One is a big purple fellow."
    },
    {
      "i": 13,
      "start": 39.36,
      "end": 44.44,
      "text": "Another is a pig who appears to be quite lazy."
    },
    {
      "i": 14,
      "start": 44.44,
      "end": 47.72,
      "text": "The general narrowed his eyes at Wukong."
    },
    {
      "i": 15,
      "start": 47.72,
      "end": 50.68,
      "text": "And the third companion."
    },
    {
      "i": 16,
      "start": 50.68,
      "end": 52.6,
      "text": "The third companion is a monkey."
    },
    {
      "i": 17,
      "start": 52.6,
      "end": 54.2,
      "text": "Said Wukong."
    },
    {
      "i": 18,
      "start": 54.2,
      "end": 58.8,
      "text": "I believe he is Sun Wukong."
    },
    {
      "i": 19,
      "start": 58.8,
      "end": 61.92,
      "text": "I was afraid that monkey was traveling with the monk."
    },
    {
      "i": 20,
      "start": 61.92,
      "end": 63.92,
      "text": "The general grumbled."
    },
    {
      "i": 21,
      "start": 63.92,
      "end": 66.92,
      "text": "What does Sun Wukong look like?"
    },
    {
      "i": 22,
      "start": 66.92,
      "end": 68.76,
      "text": "He's huge!"
    },
    {
      "i": 23,
      "start": 68.76,
      "end": 72.68,
      "text": "Wukong pretended to shiver."
    },
    {
      "i": 24,
      "start": 72.68,
      "end": 76.16,
      "text": "He has fiery red eyes and sharp fangs."
    },
    {
      "i": 25,
      "start": 76.16,
      "end": 78.16,
      "text": "Oh dear."
    },
    {
      "i": 26,
      "start": 78.16,
      "end": 79.96,
      "text": "Said a captain."
    },
    {
      "i": 27,
      "start": 79.96,
      "end": 83.48,
      "text": "There's no need to worry about some silly monkey."
    },
    {
      "i": 28,
      "start": 83.48,
      "end": 84.68,
      "text": "I said the Colonel."
    },
    {
      "i": 29,
      "start": 84.68,
      "end": 87.28,
      "text": "I don't care what he did 500 years ago."
    },
    {
      "i": 30,
      "start": 87.28,
      "end": 90.28,
      "text": "We have a powerful army."
    },
    {
      "i": 31,
      "start": 90.28,
      "end": 92.24,
      "text": "I heard the monkey talking."
    },
    {
      "i": 32,
      "start": 92.24,
      "end": 93.76,
      "text": "Said Wukong."
    },
    {
      "i": 33,
      "start": 93.76,
      "end": 98.6,
      "text": "He said he hopes there's an entire demon army on this mountain."
    },
    {
      "i": 34,
      "start": 98.6,
      "end": 99.6,
      "text": "What?"
    },
    {
      "i": 35,
      "start": 99.6,
      "end": 102.0,
      "text": "The general looked confused."
    },
    {
      "i": 36,
      "start": 102.0,
      "end": 104.84,
      "text": "He hopes there's an army."
    },
    {
      "i": 37,
      "start": 104.84,
      "end": 106.0,
      "text": "Wukong nodded."
    },
    {
      "i": 38,
      "start": 106.0,
      "end": 110.24,
      "text": "He said destroying demons is good exercise."
    },
    {
      "i": 39,
      "start": 110.24,
      "end": 112.64,
      "text": "He has a magic iron bar."
    },
    {
      "i": 40,
      "start": 112.64,
      "end": 117.72,
      "text": "He can make it big enough to crush our entire army with one strike."
    },
    {
      "i": 41,
      "start": 117.72,
      "end": 120.48,
      "text": "But he doesn't plan to do that."
    },
    {
      "i": 42,
      "start": 120.48,
      "end": 121.48,
      "text": "No."
    },
    {
      "i": 43,
      "start": 121.48,
      "end": 122.48,
      "text": "A captain gulped."
    },
    {
      "i": 44,
      "start": 122.48,
      "end": 125.64,
      "text": "What does he plan to do?"
    },
    {
      "i": 45,
      "start": 125.64,
      "end": 128.64,
      "text": "He pledged to crush one demon at a time."
    },
    {
      "i": 46,
      "start": 128.64,
      "end": 130.16,
      "text": "Said Wukong."
    },
    {
      "i": 47,
      "start": 130.16,
      "end": 133.56,
      "text": "That way he'll get more exercise."
    },
    {
      "i": 48,
      "start": 133.56,
      "end": 136.32,
      "text": "The demon's faces went pale."
    },
    {
      "i": 49,
      "start": 136.32,
      "end": 138.36,
      "text": "This is bad news."
    },
    {
      "i": 50,
      "start": 138.36,
      "end": 139.96,
      "text": "Said the general."
    },
    {
      "i": 51,
      "start": 139.96,
      "end": 143.64,
      "text": "The other demons nodded in agreement."
    },
    {
      "i": 52,
      "start": 143.64,
      "end": 146.0,
      "text": "You can all stick around if you want to."
    },
    {
      "i": 53,
      "start": 146.0,
      "end": 147.8,
      "text": "Said Wukong."
    },
    {
      "i": 54,
      "start": 147.8,
      "end": 148.92,
      "text": "But I'm leaving."
    }
  ]
}
