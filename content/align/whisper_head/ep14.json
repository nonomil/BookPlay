{
  "episode": 14,
  "source": "assets/video/ep14.mp4",
  "model": "base",
  "duration": 324.0345,
  "segments": [
    {
      "i": 1,
      "start": 0.0,
      "end": 7.0,
      "text": "Journey to the West. Chapter 14. A Promise to Protect."
    },
    {
      "i": 2,
      "start": 12.8,
      "end": 17.8,
      "text": "The Tang Monk trembled with fear. The angry voice spoke again."
    },
    {
      "i": 3,
      "start": 17.8,
      "end": 20.8,
      "text": "Who is walking on my mountain?"
    },
    {
      "i": 4,
      "start": 20.8,
      "end": 22.3,
      "text": "Ah!"
    },
    {
      "i": 5,
      "start": 22.3,
      "end": 27.3,
      "text": "Cryed the Tang Monk. He fell off his horse and tumbled down the mountain."
    },
    {
      "i": 6,
      "start": 31.0,
      "end": 35.0,
      "text": "At the bottom, he saw a crack between the rocks."
    },
    {
      "i": 7,
      "start": 36.0,
      "end": 42.0,
      "text": "The monk looked in and saw a moss covered a monkey peering out at him."
    },
    {
      "i": 8,
      "start": 42.5,
      "end": 44.5,
      "text": "My name is Sun Wukong."
    },
    {
      "i": 9,
      "start": 44.5,
      "end": 45.5,
      "text": "Said the monkey."
    },
    {
      "i": 10,
      "start": 45.5,
      "end": 49.0,
      "text": "I am king of the fruit and flower mountain."
    },
    {
      "i": 11,
      "start": 49.5,
      "end": 51.0,
      "text": "Why are you in there?"
    },
    {
      "i": 12,
      "start": 51.0,
      "end": 54.0,
      "text": "Ask the Tang Monk. He stood up."
    },
    {
      "i": 13,
      "start": 55.0,
      "end": 56.0,
      "text": "Buddha put me here."
    },
    {
      "i": 14,
      "start": 56.0,
      "end": 57.5,
      "text": "Said Wukong."
    },
    {
      "i": 15,
      "start": 57.5,
      "end": 60.5,
      "text": "I am being punished for causing trouble in heaven."
    },
    {
      "i": 16,
      "start": 60.5,
      "end": 61.5,
      "text": "Who are you?"
    },
    {
      "i": 17,
      "start": 62.5,
      "end": 63.5,
      "text": "I'm just a monk."
    },
    {
      "i": 18,
      "start": 63.5,
      "end": 64.5,
      "text": "Said the Tang Monk."
    },
    {
      "i": 19,
      "start": 65.5,
      "end": 68.5,
      "text": "I'm going to the Western Paradise to get scriptures from Buddha."
    },
    {
      "i": 20,
      "start": 69.5,
      "end": 70.5,
      "text": "Wukong gassed."
    },
    {
      "i": 21,
      "start": 71.5,
      "end": 72.5,
      "text": "You're the Tang Monk!"
    },
    {
      "i": 22,
      "start": 72.5,
      "end": 73.5,
      "text": "He cried."
    },
    {
      "i": 23,
      "start": 74.5,
      "end": 75.5,
      "text": "I'm supposed to go with you."
    },
    {
      "i": 24,
      "start": 77.5,
      "end": 79.5,
      "text": "The Tang Monk took a step back."
    },
    {
      "i": 25,
      "start": 80.5,
      "end": 82.5,
      "text": "Was this strange monkey telling the truth?"
    },
    {
      "i": 26,
      "start": 84.5,
      "end": 85.5,
      "text": "The Bodhisattva Guanyin visited me."
    },
    {
      "i": 27,
      "start": 85.5,
      "end": 87.5,
      "text": "Wukong went on."
    },
    {
      "i": 28,
      "start": 88.5,
      "end": 91.5,
      "text": "She said I'd be said free if I promised to protect you on the journey."
    },
    {
      "i": 29,
      "start": 92.5,
      "end": 94.5,
      "text": "Set me free and I'll go with you to the West."
    },
    {
      "i": 30,
      "start": 95.5,
      "end": 97.5,
      "text": "The Tang Monk relaxed."
    },
    {
      "i": 31,
      "start": 98.5,
      "end": 99.5,
      "text": "He looked at the rocks."
    },
    {
      "i": 32,
      "start": 100.5,
      "end": 101.5,
      "text": "How can I free you?"
    },
    {
      "i": 33,
      "start": 102.5,
      "end": 104.5,
      "text": "There's a small piece of paper on top of this mountain."
    },
    {
      "i": 34,
      "start": 105.5,
      "end": 106.5,
      "text": "Said Wukong."
    },
    {
      "i": 35,
      "start": 106.5,
      "end": 108.5,
      "text": "You must remove it."
    },
    {
      "i": 36,
      "start": 108.5,
      "end": 114.5,
      "text": "The Tang Monk went back up the mountain."
    },
    {
      "i": 37,
      "start": 115.5,
      "end": 120.5,
      "text": "He pushed aside shrubs and brambles and pulled himself over large boulders."
    },
    {
      "i": 38,
      "start": 127.5,
      "end": 129.5,
      "text": "Finally, he reached the mountain's peak."
    },
    {
      "i": 39,
      "start": 135.5,
      "end": 137.5,
      "text": "The Monk picked up the paper."
    },
    {
      "i": 40,
      "start": 138.5,
      "end": 141.5,
      "text": "Right away, a breeze swept it from his hand."
    },
    {
      "i": 41,
      "start": 142.5,
      "end": 145.5,
      "text": "The paper floated up and then disappeared among the clouds."
    },
    {
      "i": 42,
      "start": 147.5,
      "end": 149.5,
      "text": "The Monk carried back down the mountain."
    }
  ]
}
