{
  "episode": 33,
  "source": "assets/video/ep33.mp4",
  "model": "base",
  "duration": 356.194125,
  "segments": [
    {
      "i": 1,
      "start": 0.0,
      "end": 19.0,
      "text": "After the Tang Monk sent Wu Kong away, he and the others continued west."
    },
    {
      "i": 2,
      "start": 19.0,
      "end": 27.0,
      "text": "Later that day, they stopped to rest."
    },
    {
      "i": 3,
      "start": 27.0,
      "end": 31.0,
      "text": "Bajie sat down in the grass next to the road."
    },
    {
      "i": 4,
      "start": 31.0,
      "end": 35.0,
      "text": "He let out a great big yawn."
    },
    {
      "i": 5,
      "start": 35.0,
      "end": 38.0,
      "text": "Bajie said the Tang Monk."
    },
    {
      "i": 6,
      "start": 38.0,
      "end": 41.0,
      "text": "Why don't you go find us some food?"
    },
    {
      "i": 7,
      "start": 41.0,
      "end": 43.0,
      "text": "Wu Qing and I will wait here."
    },
    {
      "i": 8,
      "start": 43.0,
      "end": 45.0,
      "text": "The pig moaned."
    },
    {
      "i": 9,
      "start": 45.0,
      "end": 49.0,
      "text": "I just sat down."
    },
    {
      "i": 10,
      "start": 49.0,
      "end": 52.0,
      "text": "He got back up."
    },
    {
      "i": 11,
      "start": 52.0,
      "end": 54.0,
      "text": "This journey is too difficult."
    },
    {
      "i": 12,
      "start": 54.0,
      "end": 59.0,
      "text": "He said, then he wandered off."
    },
    {
      "i": 13,
      "start": 59.0,
      "end": 64.0,
      "text": "After a few minutes of walking, Bajie looked around."
    },
    {
      "i": 14,
      "start": 64.0,
      "end": 67.0,
      "text": "He was all alone."
    },
    {
      "i": 15,
      "start": 67.0,
      "end": 69.0,
      "text": "I'm too tired to look for food."
    },
    {
      "i": 16,
      "start": 69.0,
      "end": 71.0,
      "text": "He said to himself."
    },
    {
      "i": 17,
      "start": 71.0,
      "end": 75.0,
      "text": "But if I go back now, master will be angry."
    },
    {
      "i": 18,
      "start": 75.0,
      "end": 78.0,
      "text": "He yomed."
    },
    {
      "i": 19,
      "start": 78.0,
      "end": 80.0,
      "text": "I'll take a nap."
    },
    {
      "i": 20,
      "start": 80.0,
      "end": 83.0,
      "text": "When I wake up, I'll go back to master."
    },
    {
      "i": 21,
      "start": 83.0,
      "end": 88.0,
      "text": "I'll tell him I searched everywhere, but couldn't find any food."
    },
    {
      "i": 22,
      "start": 96.0,
      "end": 101.0,
      "text": "The pig laid down behind some bushes."
    },
    {
      "i": 23,
      "start": 101.0,
      "end": 107.0,
      "text": "Soon he was snoring loudly."
    },
    {
      "i": 24,
      "start": 108.0,
      "end": 114.0,
      "text": "An hour later, the Tang Monk and Wu Qing were still waiting by the road."
    },
    {
      "i": 25,
      "start": 114.0,
      "end": 117.0,
      "text": "What is taking Bajie so long?"
    },
    {
      "i": 26,
      "start": 117.0,
      "end": 121.0,
      "text": "Ask the monk. Wu Qing looked annoyed."
    },
    {
      "i": 27,
      "start": 121.0,
      "end": 125.0,
      "text": "He probably found food and is now eating it all himself."
    },
    {
      "i": 28,
      "start": 125.0,
      "end": 129.0,
      "text": "I'll go and look for him."
    },
    {
      "i": 29,
      "start": 129.0,
      "end": 134.0,
      "text": "Wu Qing got up and headed down the road."
    },
    {
      "i": 30,
      "start": 137.0,
      "end": 140.0,
      "text": "Said a voice suddenly."
    },
    {
      "i": 31,
      "start": 140.0,
      "end": 142.0,
      "text": "Yummy noodles."
    },
    {
      "i": 32,
      "start": 142.0,
      "end": 144.0,
      "text": "Wu Qing frowned."
    },
    {
      "i": 33,
      "start": 144.0,
      "end": 146.0,
      "text": "That's Bajie."
    },
    {
      "i": 34,
      "start": 146.0,
      "end": 151.0,
      "text": "He did find food and he's not sharing it with us."
    }
  ]
}
