{
  "episode": 15,
  "source": "assets/video/ep15.mp4",
  "model": "base",
  "duration": 321.2713125,
  "segments": [
    {
      "i": 1,
      "start": 0.0,
      "end": 7.0,
      "text": "Journey to the West Chapter 15. Tea with a Dragon"
    },
    {
      "i": 2,
      "start": 13.0,
      "end": 18.0,
      "text": "The Tang monk looked at the robbers. He was shaking."
    },
    {
      "i": 3,
      "start": 18.0,
      "end": 19.0,
      "text": "I'm sorry."
    },
    {
      "i": 4,
      "start": 19.0,
      "end": 20.0,
      "text": "He said."
    },
    {
      "i": 5,
      "start": 20.0,
      "end": 25.0,
      "text": "But we're just monks. We don't have any money."
    },
    {
      "i": 6,
      "start": 25.0,
      "end": 27.0,
      "text": "They give us whatever else you have."
    },
    {
      "i": 7,
      "start": 27.0,
      "end": 31.0,
      "text": "Said one robber. He came closer."
    },
    {
      "i": 8,
      "start": 31.0,
      "end": 32.0,
      "text": "Please sir."
    },
    {
      "i": 9,
      "start": 32.0,
      "end": 33.0,
      "text": "Said the monk."
    },
    {
      "i": 10,
      "start": 33.0,
      "end": 34.0,
      "text": "We."
    },
    {
      "i": 11,
      "start": 34.0,
      "end": 36.0,
      "text": "Wu Kong put up his hand."
    },
    {
      "i": 12,
      "start": 36.0,
      "end": 39.0,
      "text": "I'll deal with these robbers master."
    },
    {
      "i": 13,
      "start": 39.0,
      "end": 45.0,
      "text": "Wu Kong approached the men. They all laughed."
    },
    {
      "i": 14,
      "start": 45.0,
      "end": 47.0,
      "text": "Look at the little monkey."
    },
    {
      "i": 15,
      "start": 47.0,
      "end": 49.0,
      "text": "Said one of them."
    },
    {
      "i": 16,
      "start": 49.0,
      "end": 52.0,
      "text": "Wu Kong laughed too."
    },
    {
      "i": 17,
      "start": 52.0,
      "end": 54.0,
      "text": "Yes, I am a monkey."
    },
    {
      "i": 18,
      "start": 54.0,
      "end": 57.0,
      "text": "And I am rather small. It's true."
    },
    {
      "i": 19,
      "start": 57.0,
      "end": 60.0,
      "text": "He removed the iron bar from his ear."
    },
    {
      "i": 20,
      "start": 60.0,
      "end": 63.0,
      "text": "But you should be scared of me anyway."
    },
    {
      "i": 21,
      "start": 63.0,
      "end": 69.0,
      "text": "His iron bar grew and his eyes flashed red with anger."
    },
    {
      "i": 22,
      "start": 69.0,
      "end": 71.0,
      "text": "The monkey is a spirit."
    },
    {
      "i": 23,
      "start": 71.0,
      "end": 73.0,
      "text": "Pride one man."
    },
    {
      "i": 24,
      "start": 73.0,
      "end": 74.0,
      "text": "Run!"
    },
    {
      "i": 25,
      "start": 74.0,
      "end": 76.0,
      "text": "Pride another."
    },
    {
      "i": 26,
      "start": 76.0,
      "end": 80.0,
      "text": "The robbers tripped over one another trying to get away."
    },
    {
      "i": 27,
      "start": 80.0,
      "end": 84.0,
      "text": "Wu Kong raised the iron bar ready to strike."
    },
    {
      "i": 28,
      "start": 84.0,
      "end": 85.0,
      "text": "Stop Wu Kong."
    },
    {
      "i": 29,
      "start": 85.0,
      "end": 87.0,
      "text": "Pride the Tang monk."
    },
    {
      "i": 30,
      "start": 87.0,
      "end": 88.0,
      "text": "Don't hurt them."
    },
    {
      "i": 31,
      "start": 88.0,
      "end": 91.0,
      "text": "Wu Kong turned around as the men ran away."
    },
    {
      "i": 32,
      "start": 91.0,
      "end": 92.0,
      "text": "Why not?"
    },
    {
      "i": 33,
      "start": 92.0,
      "end": 93.0,
      "text": "He asked."
    },
    {
      "i": 34,
      "start": 93.0,
      "end": 95.0,
      "text": "They were going to hurt us."
    },
    {
      "i": 35,
      "start": 95.0,
      "end": 98.0,
      "text": "A Buddhist monk never hurts people."
    },
    {
      "i": 36,
      "start": 98.0,
      "end": 99.0,
      "text": "Said the monk."
    },
    {
      "i": 37,
      "start": 99.0,
      "end": 103.0,
      "text": "I would rather get hurt than hurt someone else."
    },
    {
      "i": 38,
      "start": 103.0,
      "end": 105.0,
      "text": "Wu Kong laughed."
    },
    {
      "i": 39,
      "start": 105.0,
      "end": 107.0,
      "text": "That's ridiculous."
    },
    {
      "i": 40,
      "start": 107.0,
      "end": 109.0,
      "text": "We should have beaten them up."
    },
    {
      "i": 41,
      "start": 109.0,
      "end": 112.0,
      "text": "The Tang monk shook his head."
    },
    {
      "i": 42,
      "start": 112.0,
      "end": 115.0,
      "text": "You are cruel and violent, Wu Kong."
    },
    {
      "i": 43,
      "start": 115.0,
      "end": 117.0,
      "text": "Wu Kong was angry."
    },
    {
      "i": 44,
      "start": 117.0,
      "end": 118.0,
      "text": "I just saved your life."
    },
    {
      "i": 45,
      "start": 118.0,
      "end": 119.0,
      "text": "He cried."
    },
    {
      "i": 46,
      "start": 119.0,
      "end": 122.0,
      "text": "How dare you scold me?"
    },
    {
      "i": 47,
      "start": 122.0,
      "end": 124.0,
      "text": "He paused."
    },
    {
      "i": 48,
      "start": 124.0,
      "end": 126.0,
      "text": "I don't have to accept this treatment."
    },
    {
      "i": 49,
      "start": 126.0,
      "end": 128.0,
      "text": "I'm leaving."
    },
    {
      "i": 50,
      "start": 128.0,
      "end": 133.0,
      "text": "Wu Kong leaped into the air and was gone."
    },
    {
      "i": 51,
      "start": 134.0,
      "end": 140.0,
      "text": "The Tang monk sighed and then continued his journey."
    },
    {
      "i": 52,
      "start": 142.0,
      "end": 145.0,
      "text": "Later that day, he saw an old woman."
    },
    {
      "i": 53,
      "start": 145.0,
      "end": 147.0,
      "text": "Monk said the woman."
    },
    {
      "i": 54,
      "start": 147.0,
      "end": 150.0,
      "text": "Where are you going?"
    }
  ]
}
