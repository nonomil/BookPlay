{
  "episode": 32,
  "source": "assets/video/ep32.mp4",
  "model": "base",
  "duration": 332.92775,
  "segments": [
    {
      "i": 1,
      "start": 0.0,
      "end": 7.0,
      "text": "Journey to the West, Chapter 32, Lady Whitebone."
    },
    {
      "i": 2,
      "start": 12.0,
      "end": 17.0,
      "text": "Lady Whitebone sat by the road and sniffed the air again."
    },
    {
      "i": 3,
      "start": 18.0,
      "end": 22.0,
      "text": "The Tang Mung has some powerful companions."
    },
    {
      "i": 4,
      "start": 22.0,
      "end": 24.0,
      "text": "She said,"
    },
    {
      "i": 5,
      "start": 24.0,
      "end": 27.0,
      "text": "I need a disguise."
    },
    {
      "i": 6,
      "start": 31.0,
      "end": 35.0,
      "text": "Bajay dropped the bags."
    },
    {
      "i": 7,
      "start": 35.0,
      "end": 37.0,
      "text": "I'm tired and hungry."
    },
    {
      "i": 8,
      "start": 37.0,
      "end": 40.0,
      "text": "Let's stop for lunch."
    },
    {
      "i": 9,
      "start": 41.0,
      "end": 44.0,
      "text": "Using his magic sight,"
    },
    {
      "i": 10,
      "start": 44.0,
      "end": 48.0,
      "text": "Wukong saw a peach orchard thousands of miles away."
    },
    {
      "i": 11,
      "start": 49.0,
      "end": 51.0,
      "text": "I'll be back in a minute."
    },
    {
      "i": 12,
      "start": 51.0,
      "end": 52.0,
      "text": "He said,"
    },
    {
      "i": 13,
      "start": 52.0,
      "end": 54.0,
      "text": "soon after the monkey had left,"
    },
    {
      "i": 14,
      "start": 54.0,
      "end": 57.0,
      "text": "a young woman came down the road."
    },
    {
      "i": 15,
      "start": 58.0,
      "end": 60.0,
      "text": "She held out a bowl."
    },
    {
      "i": 16,
      "start": 61.0,
      "end": 63.0,
      "text": "Are you the Tang Mung?"
    },
    {
      "i": 17,
      "start": 63.0,
      "end": 64.0,
      "text": "She asked,"
    },
    {
      "i": 18,
      "start": 64.0,
      "end": 66.0,
      "text": "I have food for you."
    },
    {
      "i": 19,
      "start": 66.0,
      "end": 69.0,
      "text": "Bajay reached for the bowl."
    },
    {
      "i": 20,
      "start": 69.0,
      "end": 71.0,
      "text": "Thank you."
    },
    {
      "i": 21,
      "start": 72.0,
      "end": 73.0,
      "text": "Don't eat that!"
    },
    {
      "i": 22,
      "start": 73.0,
      "end": 76.0,
      "text": "Wukong was flying fast back to the group."
    },
    {
      "i": 23,
      "start": 76.0,
      "end": 80.0,
      "text": "He dropped all the peaches and pulled out his iron bar."
    },
    {
      "i": 24,
      "start": 81.0,
      "end": 84.0,
      "text": "When he struck at the young woman,"
    },
    {
      "i": 25,
      "start": 84.0,
      "end": 86.0,
      "text": "before he hit her,"
    },
    {
      "i": 26,
      "start": 86.0,
      "end": 88.0,
      "text": "she disappeared."
    },
    {
      "i": 27,
      "start": 90.0,
      "end": 92.0,
      "text": "Why did you do that?"
    },
    {
      "i": 28,
      "start": 92.0,
      "end": 94.0,
      "text": "Cry the Tang Mung."
    },
    {
      "i": 29,
      "start": 94.0,
      "end": 96.0,
      "text": "You're a human, master."
    },
    {
      "i": 30,
      "start": 96.0,
      "end": 97.0,
      "text": "Said Wukong,"
    },
    {
      "i": 31,
      "start": 97.0,
      "end": 101.0,
      "text": "you couldn't see that the woman was really a spirit who wanted to harm you."
    },
    {
      "i": 32,
      "start": 101.0,
      "end": 104.0,
      "text": "Unfortunately, she got away."
    },
    {
      "i": 33,
      "start": 104.0,
      "end": 106.0,
      "text": "Why are you so cruel?"
    },
    {
      "i": 34,
      "start": 106.0,
      "end": 108.0,
      "text": "Ask the Mung."
    },
    {
      "i": 35,
      "start": 108.0,
      "end": 110.0,
      "text": "She was giving us food."
    },
    {
      "i": 36,
      "start": 110.0,
      "end": 112.0,
      "text": "It's not food."
    },
    {
      "i": 37,
      "start": 112.0,
      "end": 114.0,
      "text": "She was the monkey."
    },
    {
      "i": 38,
      "start": 116.0,
      "end": 119.0,
      "text": "See? He held up the bowl,"
    },
    {
      "i": 39,
      "start": 119.0,
      "end": 122.0,
      "text": "which was filled with worms."
    },
    {
      "i": 40,
      "start": 122.0,
      "end": 124.0,
      "text": "Don't believe Wukong."
    },
    {
      "i": 41,
      "start": 124.0,
      "end": 126.0,
      "text": "Said Bajay."
    },
    {
      "i": 42,
      "start": 126.0,
      "end": 129.0,
      "text": "He used magic to turn the food into worms."
    },
    {
      "i": 43,
      "start": 129.0,
      "end": 134.0,
      "text": "The pig looked at the ground where the woman had been and shook his head."
    },
    {
      "i": 44,
      "start": 134.0,
      "end": 139.0,
      "text": "Wukong hit her so hard there isn't anything left of her."
    },
    {
      "i": 45,
      "start": 139.0,
      "end": 141.0,
      "text": "That's ridiculous."
    },
    {
      "i": 46,
      "start": 141.0,
      "end": 143.0,
      "text": "Said Wukong."
    },
    {
      "i": 47,
      "start": 143.0,
      "end": 145.0,
      "text": "I..."
    },
    {
      "i": 48,
      "start": 145.0,
      "end": 151.0,
      "text": "The monkey rolled on the ground as the Tang Mung."
    }
  ]
}
