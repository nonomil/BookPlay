{
  "episode": 27,
  "source": "assets/video/ep27.mp4",
  "model": "base",
  "duration": 296.6349375,
  "segments": [
    {
      "i": 1,
      "start": 0.0,
      "end": 4.0,
      "text": "Journey to the West."
    },
    {
      "i": 2,
      "start": 4.0,
      "end": 5.56,
      "text": "Chapter 27."
    },
    {
      "i": 3,
      "start": 5.56,
      "end": 14.56,
      "text": "The Jin-Sing Fruit."
    },
    {
      "i": 4,
      "start": 14.56,
      "end": 17.32,
      "text": "The Tang monk trembled with fear."
    },
    {
      "i": 5,
      "start": 17.32,
      "end": 20.8,
      "text": "The animals showed their fangs."
    },
    {
      "i": 6,
      "start": 20.8,
      "end": 23.16,
      "text": "Faster, pride will come."
    },
    {
      "i": 7,
      "start": 23.16,
      "end": 25.76,
      "text": "The monkey was running fast."
    },
    {
      "i": 8,
      "start": 25.76,
      "end": 32.56,
      "text": "He swung his iron bar and the animals ran back into the forest."
    },
    {
      "i": 9,
      "start": 32.56,
      "end": 34.32,
      "text": "Wukong smiled."
    },
    {
      "i": 10,
      "start": 34.32,
      "end": 37.44,
      "text": "Sorry for making the horse run, master."
    },
    {
      "i": 11,
      "start": 37.44,
      "end": 40.52,
      "text": "I thought it would be funny."
    },
    {
      "i": 12,
      "start": 40.52,
      "end": 42.0,
      "text": "The Tang monk frowned."
    },
    {
      "i": 13,
      "start": 42.0,
      "end": 44.96,
      "text": "It wasn't funny at all."
    },
    {
      "i": 14,
      "start": 44.96,
      "end": 47.6,
      "text": "Those beasts were going to attack me."
    },
    {
      "i": 15,
      "start": 47.6,
      "end": 48.6,
      "text": "Nonsense."
    },
    {
      "i": 16,
      "start": 48.6,
      "end": 50.28,
      "text": "Said Wukong."
    },
    {
      "i": 17,
      "start": 50.28,
      "end": 53.08,
      "text": "You never have to fear any wild animals."
    },
    {
      "i": 18,
      "start": 53.08,
      "end": 56.56,
      "text": "You have three powerful companions."
    },
    {
      "i": 19,
      "start": 56.56,
      "end": 61.64,
      "text": "Bajai and Wuji soon caught up to them."
    },
    {
      "i": 20,
      "start": 61.64,
      "end": 64.56,
      "text": "They all continued along the road."
    },
    {
      "i": 21,
      "start": 64.56,
      "end": 68.6,
      "text": "The Tang monk pointed to a building up ahead."
    },
    {
      "i": 22,
      "start": 68.6,
      "end": 70.92,
      "text": "That looks like a dauest abbey."
    },
    {
      "i": 23,
      "start": 70.92,
      "end": 74.08,
      "text": "I'm sure the abbey's priests will let us rest for a while."
    },
    {
      "i": 24,
      "start": 74.08,
      "end": 77.0,
      "text": "Said Wuji."
    },
    {
      "i": 25,
      "start": 77.0,
      "end": 82.16,
      "text": "When they reached the abbey, Bajai knocked on the door."
    },
    {
      "i": 26,
      "start": 82.16,
      "end": 84.6,
      "text": "Two priests opened it."
    },
    {
      "i": 27,
      "start": 84.6,
      "end": 86.4,
      "text": "I'm here with the Tang monk."
    },
    {
      "i": 28,
      "start": 86.4,
      "end": 87.96,
      "text": "Said the pig."
    },
    {
      "i": 29,
      "start": 87.96,
      "end": 89.76,
      "text": "May we come in?"
    },
    {
      "i": 30,
      "start": 89.76,
      "end": 92.88,
      "text": "The priests looked at the Tang monk."
    },
    {
      "i": 31,
      "start": 92.88,
      "end": 94.64,
      "text": "Our master told us about you."
    },
    {
      "i": 32,
      "start": 94.64,
      "end": 96.16,
      "text": "Said one of them."
    },
    {
      "i": 33,
      "start": 96.16,
      "end": 98.72,
      "text": "He said you would travel past our abbey someday."
    },
    {
      "i": 34,
      "start": 98.72,
      "end": 101.72,
      "text": "Please come in."
    },
    {
      "i": 35,
      "start": 101.72,
      "end": 102.8,
      "text": "Who's your master?"
    },
    {
      "i": 36,
      "start": 102.8,
      "end": 104.52,
      "text": "Ask the Tang monk."
    },
    {
      "i": 37,
      "start": 104.52,
      "end": 106.76,
      "text": "How did he know about me?"
    },
    {
      "i": 38,
      "start": 106.76,
      "end": 108.76,
      "text": "Our master is the great immortal."
    },
    {
      "i": 39,
      "start": 108.76,
      "end": 110.44,
      "text": "Said the first priest."
    },
    {
      "i": 40,
      "start": 110.44,
      "end": 114.64,
      "text": "He is very wise and powerful."
    },
    {
      "i": 41,
      "start": 114.64,
      "end": 115.64,
      "text": "Wukong laughed."
    },
    {
      "i": 42,
      "start": 115.64,
      "end": 117.44,
      "text": "I've never heard of him."
    },
    {
      "i": 43,
      "start": 117.44,
      "end": 120.24,
      "text": "I doubt he's very powerful."
    },
    {
      "i": 44,
      "start": 120.24,
      "end": 123.4,
      "text": "The Tang monk scowled."
    },
    {
      "i": 45,
      "start": 123.4,
      "end": 125.16,
      "text": "Show some respect, Wukong."
    },
    {
      "i": 46,
      "start": 125.16,
      "end": 127.04,
      "text": "He whispered."
    },
    {
      "i": 47,
      "start": 127.04,
      "end": 129.44,
      "text": "The priests looked annoyed."
    },
    {
      "i": 48,
      "start": 129.44,
      "end": 133.44,
      "text": "Our master is visiting friends in heaven right now."
    },
    {
      "i": 49,
      "start": 133.44,
      "end": 137.84,
      "text": "If he wasn't powerful, he wouldn't be able to do that."
    },
    {
      "i": 50,
      "start": 137.84,
      "end": 139.68,
      "text": "Wukong shrugged."
    },
    {
      "i": 51,
      "start": 139.68,
      "end": 142.12,
      "text": "I used to live in heaven."
    },
    {
      "i": 52,
      "start": 142.12,
      "end": 146.48,
      "text": "The place isn't that great."
    },
    {
      "i": 53,
      "start": 146.48,
      "end": 149.32,
      "text": "Wukong said the Tang monk."
    },
    {
      "i": 54,
      "start": 149.32,
      "end": 150.0,
      "text": "Please go outside."
    }
  ]
}
