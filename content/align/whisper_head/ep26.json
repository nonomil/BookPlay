{
  "episode": 26,
  "source": "assets/video/ep26.mp4",
  "model": "base",
  "duration": 308.082375,
  "segments": [
    {
      "i": 1,
      "start": 0.0,
      "end": 7.0,
      "text": "Journey to the West, Chapter 26, the monster in the river."
    },
    {
      "i": 2,
      "start": 15.0,
      "end": 17.0,
      "text": "I hope we reach the Western Paradise soon."
    },
    {
      "i": 3,
      "start": 17.0,
      "end": 19.0,
      "text": "Said the Tang monk one morning."
    },
    {
      "i": 4,
      "start": 19.0,
      "end": 23.0,
      "text": "Wilkong and his companions were eating breakfast."
    },
    {
      "i": 5,
      "start": 25.0,
      "end": 27.0,
      "text": "The monkey laughed."
    },
    {
      "i": 6,
      "start": 27.0,
      "end": 29.0,
      "text": "The journey will take many years, Master."
    },
    {
      "i": 7,
      "start": 30.0,
      "end": 33.0,
      "text": "And you must face many challenges along the way."
    },
    {
      "i": 8,
      "start": 34.0,
      "end": 38.0,
      "text": "Buddha doesn't give the true scriptures to just anyone."
    },
    {
      "i": 9,
      "start": 38.0,
      "end": 43.0,
      "text": "You must prove you're worthy by surviving a long and difficult journey."
    },
    {
      "i": 10,
      "start": 44.0,
      "end": 46.0,
      "text": "The monk sighed."
    },
    {
      "i": 11,
      "start": 46.0,
      "end": 48.0,
      "text": "Bajay put down his bowl."
    },
    {
      "i": 12,
      "start": 49.0,
      "end": 51.0,
      "text": "I'm tired of this journey."
    },
    {
      "i": 13,
      "start": 51.0,
      "end": 52.0,
      "text": "He cried."
    },
    {
      "i": 14,
      "start": 53.0,
      "end": 56.0,
      "text": "My legs hurt and we never have enough food."
    },
    {
      "i": 15,
      "start": 57.0,
      "end": 59.0,
      "text": "Stop thinking about food, Bajay."
    },
    {
      "i": 16,
      "start": 59.0,
      "end": 60.0,
      "text": "Said Wilkong."
    },
    {
      "i": 17,
      "start": 61.0,
      "end": 63.0,
      "text": "We're Buddhist monks now."
    },
    {
      "i": 18,
      "start": 63.0,
      "end": 67.0,
      "text": "We should think only about reaching the Western Paradise."
    },
    {
      "i": 19,
      "start": 69.0,
      "end": 71.0,
      "text": "The pig sighed."
    },
    {
      "i": 20,
      "start": 71.0,
      "end": 76.0,
      "text": "After he washed the bowls, the three companions headed down the road."
    },
    {
      "i": 21,
      "start": 76.0,
      "end": 79.0,
      "text": "They soon reached a river."
    },
    {
      "i": 22,
      "start": 80.0,
      "end": 84.0,
      "text": "The water splashed and a purple monster leaped from the waves."
    },
    {
      "i": 23,
      "start": 86.0,
      "end": 88.0,
      "text": "Master, stay back."
    },
    {
      "i": 24,
      "start": 88.0,
      "end": 89.0,
      "text": "Shattered Wilkong."
    },
    {
      "i": 25,
      "start": 89.0,
      "end": 93.0,
      "text": "He pulled out his iron bar and blocked the monster's spear."
    },
    {
      "i": 26,
      "start": 93.0,
      "end": 95.0,
      "text": "Clang!"
    },
    {
      "i": 27,
      "start": 95.0,
      "end": 99.0,
      "text": "Bajay lunged at the monster, swinging his rake."
    },
    {
      "i": 28,
      "start": 100.0,
      "end": 103.0,
      "text": "The monster died back into the river."
    },
    {
      "i": 29,
      "start": 103.0,
      "end": 106.0,
      "text": "Bajay, my powers aren't strong underwater."
    },
    {
      "i": 30,
      "start": 106.0,
      "end": 107.0,
      "text": "Said Wilkong."
    },
    {
      "i": 31,
      "start": 107.0,
      "end": 110.0,
      "text": "Dive in and get him to chase you out of the river."
    },
    {
      "i": 32,
      "start": 110.0,
      "end": 112.0,
      "text": "Then I'll surprise him."
    },
    {
      "i": 33,
      "start": 112.0,
      "end": 113.0,
      "text": "Okay."
    },
    {
      "i": 34,
      "start": 113.0,
      "end": 114.0,
      "text": "Said the pig."
    },
    {
      "i": 35,
      "start": 114.0,
      "end": 118.0,
      "text": "Let's wait until he comes all the way up on shore though."
    },
    {
      "i": 36,
      "start": 118.0,
      "end": 122.0,
      "text": "Then I'll block his path so he can't go back in the river."
    },
    {
      "i": 37,
      "start": 122.0,
      "end": 125.0,
      "text": "Bajay dived into the water."
    },
    {
      "i": 38,
      "start": 125.0,
      "end": 127.0,
      "text": "Wilkong waited."
    },
    {
      "i": 39,
      "start": 127.0,
      "end": 131.0,
      "text": "A moment later, the pig was back with the monster following."
    },
    {
      "i": 40,
      "start": 131.0,
      "end": 135.0,
      "text": "The monkey swung his iron bar and missed."
    },
    {
      "i": 41,
      "start": 135.0,
      "end": 139.0,
      "text": "The monster dived back underwater."
    },
    {
      "i": 42,
      "start": 140.0,
      "end": 143.0,
      "text": "You didn't wait until he was on shore."
    },
    {
      "i": 43,
      "start": 143.0,
      "end": 144.0,
      "text": "Said Bajay."
    },
    {
      "i": 44,
      "start": 144.0,
      "end": 146.0,
      "text": "You're too impatient."
    },
    {
      "i": 45,
      "start": 146.0,
      "end": 148.0,
      "text": "Wilkong shrugged and laughed."
    },
    {
      "i": 46,
      "start": 148.0,
      "end": 150.0,
      "text": "Let's y-"
    }
  ]
}
