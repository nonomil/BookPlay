{
  "episode": 52,
  "source": "assets/video/ep52.mp4",
  "model": "base",
  "duration": 305.156625,
  "segments": [
    {
      "i": 1,
      "start": 0.0,
      "end": 11.14,
      "text": "Journey to the West, Chapter 52, an ocean from a vase."
    },
    {
      "i": 2,
      "start": 11.14,
      "end": 15.7,
      "text": "Wukong and Gwanyan stood on the lotus platform above Red Boy's mountain."
    },
    {
      "i": 3,
      "start": 15.7,
      "end": 18.6,
      "text": "Let's attack Red Boy now!"
    },
    {
      "i": 4,
      "start": 18.6,
      "end": 20.34,
      "text": "Said the monkey."
    },
    {
      "i": 5,
      "start": 20.34,
      "end": 21.34,
      "text": "Wait Wukong."
    },
    {
      "i": 6,
      "start": 21.34,
      "end": 23.98,
      "text": "Said Gwanyan, holding up a hand."
    },
    {
      "i": 7,
      "start": 23.98,
      "end": 28.64,
      "text": "There's a lot of water in this vase, enough for an ocean."
    },
    {
      "i": 8,
      "start": 28.64,
      "end": 32.64,
      "text": "I don't want any animals harmed when I pour it out."
    },
    {
      "i": 9,
      "start": 32.64,
      "end": 35.2,
      "text": "She recited a quick spell."
    },
    {
      "i": 10,
      "start": 35.2,
      "end": 40.5,
      "text": "A moment later, the local spirit arrived."
    },
    {
      "i": 11,
      "start": 40.5,
      "end": 41.5,
      "text": "Bordezatva."
    },
    {
      "i": 12,
      "start": 41.5,
      "end": 43.04,
      "text": "Said the spirit."
    },
    {
      "i": 13,
      "start": 43.04,
      "end": 45.44,
      "text": "What can I do for you?"
    },
    {
      "i": 14,
      "start": 45.44,
      "end": 49.36,
      "text": "I'm going to pour magic water around Red Boy's mountain."
    },
    {
      "i": 15,
      "start": 49.36,
      "end": 51.04,
      "text": "Said Gwanyan."
    },
    {
      "i": 16,
      "start": 51.04,
      "end": 56.04,
      "text": "Please make sure all the animals are far, far away from the mountain."
    },
    {
      "i": 17,
      "start": 56.04,
      "end": 57.34,
      "text": "Yes, Bordezatva."
    },
    {
      "i": 18,
      "start": 57.34,
      "end": 59.22,
      "text": "Said the spirit."
    },
    {
      "i": 19,
      "start": 59.22,
      "end": 62.58,
      "text": "The spirit flew down to Earth."
    },
    {
      "i": 20,
      "start": 62.58,
      "end": 65.62,
      "text": "Wukong watched the ground below."
    },
    {
      "i": 21,
      "start": 65.62,
      "end": 70.38,
      "text": "First he saw some small animals scurry out from under bushes."
    },
    {
      "i": 22,
      "start": 70.38,
      "end": 74.14,
      "text": "Bordez flew from branches."
    },
    {
      "i": 23,
      "start": 74.14,
      "end": 79.58,
      "text": "Then tigers, bears and other large animals stampede it down the mountain side."
    },
    {
      "i": 24,
      "start": 79.58,
      "end": 84.98,
      "text": "Soon there wasn't a single animal anywhere near the mountain."
    },
    {
      "i": 25,
      "start": 84.98,
      "end": 87.5,
      "text": "Now I can pour the water out."
    },
    {
      "i": 26,
      "start": 87.5,
      "end": 88.74,
      "text": "Said Gwanyan."
    },
    {
      "i": 27,
      "start": 88.74,
      "end": 93.58,
      "text": "She tipped the vase and rolling waves of water poured out."
    },
    {
      "i": 28,
      "start": 93.58,
      "end": 97.14,
      "text": "The waves washed down the slopes of the mountain."
    },
    {
      "i": 29,
      "start": 97.14,
      "end": 101.98,
      "text": "The water level rose higher and higher, forming an ocean."
    },
    {
      "i": 30,
      "start": 101.98,
      "end": 105.98,
      "text": "Only the top of the mountain was above water."
    },
    {
      "i": 31,
      "start": 105.98,
      "end": 109.58,
      "text": "Wukong, go down there and get the demon to come out."
    },
    {
      "i": 32,
      "start": 109.58,
      "end": 111.14,
      "text": "Said Gwanyan."
    },
    {
      "i": 33,
      "start": 111.14,
      "end": 113.98,
      "text": "Fight him, but don't defeat him."
    },
    {
      "i": 34,
      "start": 113.98,
      "end": 117.58,
      "text": "Instead, lead him up here to me."
    },
    {
      "i": 35,
      "start": 117.58,
      "end": 121.46,
      "text": "Wukong jumped down to the mountain."
    },
    {
      "i": 36,
      "start": 121.46,
      "end": 124.98,
      "text": "He pulled out his iron bar and swung it."
    },
    {
      "i": 37,
      "start": 124.98,
      "end": 126.14,
      "text": "Smash!"
    },
    {
      "i": 38,
      "start": 126.14,
      "end": 129.46,
      "text": "The door to the cave exploded."
    },
    {
      "i": 39,
      "start": 129.46,
      "end": 133.7,
      "text": "Red boy ran out of the cave looking furious."
    },
    {
      "i": 40,
      "start": 133.7,
      "end": 135.94,
      "text": "You smashed my front door."
    },
    {
      "i": 41,
      "start": 135.94,
      "end": 137.26,
      "text": "He shouted."
    },
    {
      "i": 42,
      "start": 137.26,
      "end": 138.86,
      "text": "That's right."
    },
    {
      "i": 43,
      "start": 138.86,
      "end": 139.86,
      "text": "Said the monkey."
    },
    {
      "i": 44,
      "start": 139.86,
      "end": 143.94,
      "text": "And I'll smash you if you don't release my friends."
    },
    {
      "i": 45,
      "start": 144.5,
      "end": 147.46,
      "text": "Red boy laughed and then punched himself in the nose."
    },
    {
      "i": 46,
      "start": 147.46,
      "end": 149.46,
      "text": "No."
    },
    {
      "i": 47,
      "start": 149.46,
      "end": 149.98,
      "text": "No."
    }
  ]
}
