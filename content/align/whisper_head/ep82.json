  "duration": 304.9476875,
  "segments": [
    {
      "i": 1,
      "start": 0.0,
      "end": 7.0,
      "text": "Journey to the West, Chapter 82, The Magic Cloth."
    },
    {
      "i": 2,
      "start": 14.0,
      "end": 15.0,
      "text": "Oh no!"
    },
    {
      "i": 3,
      "start": 15.0,
      "end": 16.0,
      "text": "Thought Wu Kong?"
    },
    {
      "i": 4,
      "start": 16.0,
      "end": 19.0,
      "text": "Yellow Brows is coming!"
    },
    {
      "i": 5,
      "start": 19.0,
      "end": 23.0,
      "text": "The monkey jumped back to his feet and ran fast out of the monastery."
    },
    {
      "i": 6,
      "start": 23.0,
      "end": 27.0,
      "text": "When he got outside, everyone was waiting for him."
    },
    {
      "i": 7,
      "start": 28.0,
      "end": 29.0,
      "text": "Where are the bags?"
    },
    {
      "i": 8,
      "start": 29.0,
      "end": 31.0,
      "text": "Asked Wu-Jing."
    },
    {
      "i": 9,
      "start": 31.0,
      "end": 33.0,
      "text": "The monkey looked at his empty hands."
    },
    {
      "i": 10,
      "start": 33.0,
      "end": 35.0,
      "text": "He slapped his forehead."
    },
    {
      "i": 11,
      "start": 35.0,
      "end": 37.0,
      "text": "I must have dropped them."
    },
    {
      "i": 12,
      "start": 37.0,
      "end": 41.0,
      "text": "He heard footsteps approaching from inside the monastery."
    },
    {
      "i": 13,
      "start": 41.0,
      "end": 43.0,
      "text": "We can't worry about the bags now."
    },
    {
      "i": 14,
      "start": 43.0,
      "end": 44.0,
      "text": "Whispered Wu Kong?"
    },
    {
      "i": 15,
      "start": 44.0,
      "end": 46.0,
      "text": "Yellow Brows is coming!"
    },
    {
      "i": 16,
      "start": 46.0,
      "end": 47.0,
      "text": "We have to go!"
    },
    {
      "i": 17,
      "start": 47.0,
      "end": 48.0,
      "text": "Quickly!"
    },
    {
      "i": 18,
      "start": 51.0,
      "end": 54.0,
      "text": "He helped the Tang Monk up onto the horse."
    },
    {
      "i": 19,
      "start": 54.0,
      "end": 56.0,
      "text": "The group hurried down the road."
    },
    {
      "i": 20,
      "start": 57.0,
      "end": 59.0,
      "text": "Run faster, Barje!"
    },
    {
      "i": 21,
      "start": 59.0,
      "end": 60.0,
      "text": "Hist Wu-Jing?"
    },
    {
      "i": 22,
      "start": 60.0,
      "end": 63.0,
      "text": "Zubarje breathed heavily."
    },
    {
      "i": 23,
      "start": 63.0,
      "end": 66.0,
      "text": "I don't like running."
    },
    {
      "i": 24,
      "start": 66.0,
      "end": 71.0,
      "text": "They hadn't gotten far before Yellow Brows flew over them."
    },
    {
      "i": 25,
      "start": 71.0,
      "end": 74.0,
      "text": "You can't escape from me!"
    },
    {
      "i": 26,
      "start": 74.0,
      "end": 76.0,
      "text": "Shattered the demon."
    },
    {
      "i": 27,
      "start": 76.0,
      "end": 79.0,
      "text": "And you will not be going to the West."
    },
    {
      "i": 28,
      "start": 79.0,
      "end": 81.0,
      "text": "I will not be going to the West."
    },
    {
      "i": 29,
      "start": 81.0,
      "end": 83.0,
      "text": "I will not be going to the West."
    },
    {
      "i": 30,
      "start": 83.0,
      "end": 85.0,
      "text": "I am a true Buddhist."
    },
    {
      "i": 31,
      "start": 85.0,
      "end": 89.0,
      "text": "And I will be the one to get the true scriptures!"
    },
    {
      "i": 32,
      "start": 89.0,
      "end": 94.0,
      "text": "Wu Kong, Barje, and Wu-Jing pulled out their weapons."
    },
    {
      "i": 33,
      "start": 94.0,
      "end": 97.0,
      "text": "The gold dragon veered its claws."
    },
    {
      "i": 34,
      "start": 101.0,
      "end": 103.0,
      "text": "Yellow Brow scoffed."
    },
    {
      "i": 35,
      "start": 103.0,
      "end": 107.0,
      "text": "Do you really think you can fight me?"
    },
    {
      "i": 36,
      "start": 107.0,
      "end": 111.0,
      "text": "He reached into his robe and pulled out the cloth."
    },
    {
      "i": 37,
      "start": 111.0,
      "end": 114.0,
      "text": "Barje lowered his rake and laughed."
    },
    {
      "i": 38,
      "start": 114.0,
      "end": 117.0,
      "text": "We have powerful weapons."
    },
    {
      "i": 39,
      "start": 117.0,
      "end": 120.0,
      "text": "And all you have is a piece of cloth."
    },
    {
      "i": 40,
      "start": 120.0,
      "end": 122.0,
      "text": "That's not an ordinary cloth."
    },
    {
      "i": 41,
      "start": 122.0,
      "end": 124.0,
      "text": "Worn the dragon."
    },
    {
      "i": 42,
      "start": 124.0,
      "end": 128.0,
      "text": "Yellow Brows threw the cloth toward the group."
    },
    {
      "i": 43,
      "start": 128.0,
      "end": 130.0,
      "text": "Look out!"
    },
    {
      "i": 44,
      "start": 130.0,
      "end": 132.0,
      "text": "Cryed Wu Kong."
    },
    {
      "i": 45,
      "start": 132.0,
      "end": 137.0,
      "text": "The monkey leaped up to the sky just before the cloth wrapped around his companions."
    },
    {
      "i": 46,
      "start": 137.0,
      "end": 140.0,
      "text": "Quickly, the monkey was taken to the West."
    },
    {
      "i": 47,
      "start": 140.0,
      "end": 144.0,
      "text": "Quickly, the demon grabbed the cloth with the group in it."
    },
    {
      "i": 48,
      "start": 144.0,
      "end": 148.0,
      "text": "He ran back into his monastery and slammed the door shut."
    },
    {
      "i": 49,
      "start": 148.0,
      "end": 151.0,
      "text": "Wu Kong sat down."
    }
  ]
}
