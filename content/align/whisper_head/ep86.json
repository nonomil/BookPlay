{
  "episode": 86,
  "source": "assets/video/ep86.mp4",
  "model": "base",
  "duration": 337.4788125,
  "segments": [
    {
      "i": 1,
      "start": 0.0,
      "end": 7.0,
      "text": "Journey to the West, Chapter 86, Magic Bells."
    },
    {
      "i": 2,
      "start": 11.0,
      "end": 14.0,
      "text": "Wukong shouted outside the cave."
    },
    {
      "i": 3,
      "start": 14.0,
      "end": 18.0,
      "text": "He shouted all kinds of insults about the demon of power."
    },
    {
      "i": 4,
      "start": 18.0,
      "end": 21.0,
      "text": "Inside the cave, the guard woke up."
    },
    {
      "i": 5,
      "start": 21.0,
      "end": 24.0,
      "text": "He ran to the demon's bedroom."
    },
    {
      "i": 6,
      "start": 25.0,
      "end": 26.0,
      "text": "Master!"
    },
    {
      "i": 7,
      "start": 26.0,
      "end": 27.0,
      "text": "cried the guard."
    },
    {
      "i": 8,
      "start": 27.0,
      "end": 29.0,
      "text": "The monkey is back."
    },
    {
      "i": 9,
      "start": 31.0,
      "end": 33.0,
      "text": "It's the middle of the night."
    },
    {
      "i": 10,
      "start": 33.0,
      "end": 34.0,
      "text": "said the demon."
    },
    {
      "i": 11,
      "start": 34.0,
      "end": 36.0,
      "text": "What does he want?"
    },
    {
      "i": 12,
      "start": 36.0,
      "end": 39.0,
      "text": "He said we must return the queen."
    },
    {
      "i": 13,
      "start": 39.0,
      "end": 40.0,
      "text": "said the guard."
    },
    {
      "i": 14,
      "start": 40.0,
      "end": 43.0,
      "text": "If we don't, he'll smash our entire mountain."
    },
    {
      "i": 15,
      "start": 43.0,
      "end": 46.0,
      "text": "He also yelled some terrible things about you."
    },
    {
      "i": 16,
      "start": 48.0,
      "end": 52.0,
      "text": "The demon of power climbed out of bed and grabbed the fake bells."
    },
    {
      "i": 17,
      "start": 53.0,
      "end": 58.0,
      "text": "How'd she's the monkey away with my fire smoke and sand again?"
    },
    {
      "i": 18,
      "start": 58.0,
      "end": 61.0,
      "text": "He tied the bells around his neck and went outside."
    },
    {
      "i": 19,
      "start": 63.0,
      "end": 65.0,
      "text": "The demon glared at Wukong."
    },
    {
      "i": 20,
      "start": 65.0,
      "end": 66.0,
      "text": "Go away."
    },
    {
      "i": 21,
      "start": 66.0,
      "end": 68.0,
      "text": "I'm sleeping."
    },
    {
      "i": 22,
      "start": 69.0,
      "end": 71.0,
      "text": "Return the queen."
    },
    {
      "i": 23,
      "start": 71.0,
      "end": 72.0,
      "text": "shouted the monkey."
    },
    {
      "i": 24,
      "start": 73.0,
      "end": 74.0,
      "text": "Never!"
    },
    {
      "i": 25,
      "start": 74.0,
      "end": 75.0,
      "text": "said the demon."
    },
    {
      "i": 26,
      "start": 75.0,
      "end": 78.0,
      "text": "He reached for the bells around his neck."
    },
    {
      "i": 27,
      "start": 78.0,
      "end": 80.0,
      "text": "Wukong pretended to be surprised."
    },
    {
      "i": 28,
      "start": 81.0,
      "end": 82.0,
      "text": "Oh!"
    },
    {
      "i": 29,
      "start": 82.0,
      "end": 83.0,
      "text": "He said."
    },
    {
      "i": 30,
      "start": 83.0,
      "end": 85.0,
      "text": "I have bells just like those."
    },
    {
      "i": 31,
      "start": 86.0,
      "end": 89.0,
      "text": "The demon squinted at the monkey."
    },
    {
      "i": 32,
      "start": 89.0,
      "end": 92.0,
      "text": "I doubt your bells are like mine."
    },
    {
      "i": 33,
      "start": 92.0,
      "end": 94.0,
      "text": "Let me see them."
    },
    {
      "i": 34,
      "start": 94.0,
      "end": 97.0,
      "text": "Wukong held up the bells."
    },
    {
      "i": 35,
      "start": 97.0,
      "end": 100.0,
      "text": "The demon peered at them for a moment."
    },
    {
      "i": 36,
      "start": 100.0,
      "end": 103.0,
      "text": "Those bells do look like mine."
    },
    {
      "i": 37,
      "start": 103.0,
      "end": 107.0,
      "text": "But my bells are magic."
    },
    {
      "i": 38,
      "start": 108.0,
      "end": 109.0,
      "text": "So are mine."
    },
    {
      "i": 39,
      "start": 109.0,
      "end": 110.0,
      "text": "Said Wukong."
    },
    {
      "i": 40,
      "start": 112.0,
      "end": 117.0,
      "text": "My bells can make fire, smoke and sand."
    },
    {
      "i": 41,
      "start": 117.0,
      "end": 119.0,
      "text": "Said the demon."
    },
    {
      "i": 42,
      "start": 119.0,
      "end": 120.0,
      "text": "That's interesting."
    },
    {
      "i": 43,
      "start": 120.0,
      "end": 122.0,
      "text": "Wukong smiled."
    },
    {
      "i": 44,
      "start": 122.0,
      "end": 124.0,
      "text": "My bells can do that too."
    },
    {
      "i": 45,
      "start": 124.0,
      "end": 126.0,
      "text": "Really?"
    },
    {
      "i": 46,
      "start": 126.0,
      "end": 129.0,
      "text": "The demon of power looks surprised."
    },
    {
      "i": 47,
      "start": 129.0,
      "end": 133.0,
      "text": "Let's compare bells to see whose work better."
    },
    {
      "i": 48,
      "start": 133.0,
      "end": 134.0,
      "text": "Okay."
    },
    {
      "i": 49,
      "start": 134.0,
      "end": 135.0,
      "text": "Said Wukong."
    },
    {
      "i": 50,
      "start": 135.0,
      "end": 136.0,
      "text": "You go first."
    },
    {
      "i": 51,
      "start": 137.0,
      "end": 140.0,
      "text": "I was planning to."
    },
    {
      "i": 52,
      "start": 140.0,
      "end": 141.0,
      "text": "Said the demon."
    },
    {
      "i": 53,
      "start": 141.0,
      "end": 143.0,
      "text": "He shook his bells."
    },
    {
      "i": 54,
      "start": 145.0,
      "end": 147.0,
      "text": "Nothing happened."
    },
    {
      "i": 55,
      "start": 149.0,
      "end": 150.0,
      "text": "He shook the bells again."
    }
  ]
}
