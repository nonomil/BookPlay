{
  "episode": 17,
  "source": "assets/video/ep17.mp4",
  "model": "base",
  "duration": 309.452375,
  "segments": [
    {
      "i": 1,
      "start": 0.0,
      "end": 7.0,
      "text": "Journey to the West Chapter 17, the Dragon in the River"
    },
    {
      "i": 2,
      "start": 14.0,
      "end": 15.0,
      "text": "That dragon ate my horse!"
    },
    {
      "i": 3,
      "start": 15.0,
      "end": 18.0,
      "text": "Said the monk, he fell to his knees"
    },
    {
      "i": 4,
      "start": 18.0,
      "end": 21.0,
      "text": "How will I ever get to the Western Paradise?"
    },
    {
      "i": 5,
      "start": 21.0,
      "end": 24.0,
      "text": "There are so many dangers along the way"
    },
    {
      "i": 6,
      "start": 24.0,
      "end": 26.0,
      "text": "Wukong laughed"
    },
    {
      "i": 7,
      "start": 27.0,
      "end": 29.0,
      "text": "Master, you worry too much"
    },
    {
      "i": 8,
      "start": 29.0,
      "end": 32.0,
      "text": "There will be many dangers on your journey"
    },
    {
      "i": 9,
      "start": 32.0,
      "end": 36.0,
      "text": "But you have me, the Monkey King, to protect you"
    },
    {
      "i": 10,
      "start": 36.0,
      "end": 39.0,
      "text": "All of heaven's soldiers couldn't defeat me"
    },
    {
      "i": 11,
      "start": 39.0,
      "end": 41.0,
      "text": "So why worry about a dragon?"
    },
    {
      "i": 12,
      "start": 47.0,
      "end": 52.0,
      "text": "The monkey stepped into the water and pulled out his iron bar"
    },
    {
      "i": 13,
      "start": 53.0,
      "end": 56.0,
      "text": "I'll get the dragon to come out of the water"
    },
    {
      "i": 14,
      "start": 56.0,
      "end": 58.0,
      "text": "He looked down at the water"
    },
    {
      "i": 15,
      "start": 58.0,
      "end": 59.0,
      "text": "Dragon!"
    },
    {
      "i": 16,
      "start": 59.0,
      "end": 62.0,
      "text": "Get up here right now!"
    },
    {
      "i": 17,
      "start": 63.0,
      "end": 66.0,
      "text": "The dragon leaked from the water"
    },
    {
      "i": 18,
      "start": 66.0,
      "end": 69.0,
      "text": "Oh dear, you'll get out like me"
    },
    {
      "i": 19,
      "start": 69.0,
      "end": 72.0,
      "text": "Who are you?"
    },
    {
      "i": 20,
      "start": 72.0,
      "end": 74.0,
      "text": "It doesn't matter who I am"
    },
    {
      "i": 21,
      "start": 74.0,
      "end": 76.0,
      "text": "Shout it, Wukong"
    },
    {
      "i": 22,
      "start": 76.0,
      "end": 78.0,
      "text": "Give that horse back"
    },
    {
      "i": 23,
      "start": 79.0,
      "end": 82.0,
      "text": "The monkey attacked the dragon with his iron bar"
    },
    {
      "i": 24,
      "start": 85.0,
      "end": 88.0,
      "text": "The dragon spun around blocking the bar with his tail"
    },
    {
      "i": 25,
      "start": 88.0,
      "end": 92.0,
      "text": "Then with the splash he died back underwater"
    },
    {
      "i": 26,
      "start": 92.0,
      "end": 95.0,
      "text": "Wukong stumped his foot and yelled at the river"
    },
    {
      "i": 27,
      "start": 95.0,
      "end": 97.0,
      "text": "Coward!"
    },
    {
      "i": 28,
      "start": 99.0,
      "end": 100.0,
      "text": "What will we do?"
    },
    {
      "i": 29,
      "start": 100.0,
      "end": 102.0,
      "text": "Ask the Tang monk"
    },
    {
      "i": 30,
      "start": 102.0,
      "end": 104.0,
      "text": "I have no horse"
    },
    {
      "i": 31,
      "start": 105.0,
      "end": 106.0,
      "text": "Wukong nodded"
    },
    {
      "i": 32,
      "start": 107.0,
      "end": 110.0,
      "text": "And we can't cross the river with that dragon in there"
    },
    {
      "i": 33,
      "start": 110.0,
      "end": 113.0,
      "text": "I'll try another plan"
    },
    {
      "i": 34,
      "start": 113.0,
      "end": 116.0,
      "text": "The monkey swirled the water with his iron bar"
    },
    {
      "i": 35,
      "start": 116.0,
      "end": 121.0,
      "text": "The water became rough, waves crashed and churned"
    },
    {
      "i": 36,
      "start": 121.0,
      "end": 125.0,
      "text": "The water dragged up dirt from the river bottom"
    },
    {
      "i": 37,
      "start": 125.0,
      "end": 128.0,
      "text": "Soon the river was brown and muddy"
    },
    {
      "i": 38,
      "start": 128.0,
      "end": 131.0,
      "text": "The dragon appeared again"
    },
    {
      "i": 39,
      "start": 131.0,
      "end": 134.0,
      "text": "What on earth are you doing now?"
    },
    {
      "i": 40,
      "start": 134.0,
      "end": 136.0,
      "text": "He cried"
    },
    {
      "i": 41,
      "start": 136.0,
      "end": 139.0,
      "text": "I'm trying to take a nap"
    },
    {
      "i": 42,
      "start": 139.0,
      "end": 141.0,
      "text": "Give us back our horse"
    },
    {
      "i": 43,
      "start": 141.0,
      "end": 143.0,
      "text": "Demanded Wukong"
    },
    {
      "i": 44,
      "start": 143.0,
      "end": 144.0,
      "text": "I can't"
    },
    {
      "i": 45,
      "start": 144.0,
      "end": 146.0,
      "text": "Cryed the dragon"
    },
    {
      "i": 46,
      "start": 146.0,
      "end": 148.0,
      "text": "It's in my stomach"
    },
    {
      "i": 47,
      "start": 149.0,
      "end": 151.0,
      "text": "The monkey attacked"
    }
  ]
}
