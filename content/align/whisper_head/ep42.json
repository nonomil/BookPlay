{
  "episode": 42,
  "source": "assets/video/ep42.mp4",
  "model": "base",
  "duration": 331.76675,
  "segments": [
    {
      "i": 1,
      "start": 0.0,
      "end": 7.0,
      "text": "Journey to the West, Chapter 42, Sun Kong Wu."
    },
    {
      "i": 2,
      "start": 12.0,
      "end": 16.0,
      "text": "Wukong struggled to free himself from the Golden Robe."
    },
    {
      "i": 3,
      "start": 16.0,
      "end": 19.0,
      "text": "The Gord fell from his robe."
    },
    {
      "i": 4,
      "start": 19.0,
      "end": 22.0,
      "text": "My magic Gord."
    },
    {
      "i": 5,
      "start": 22.0,
      "end": 25.0,
      "text": "Said Golden Horn, picking it up."
    },
    {
      "i": 6,
      "start": 26.0,
      "end": 30.0,
      "text": "He dragged Wukong to a dark room in the cave and locked him in."
    },
    {
      "i": 7,
      "start": 36.0,
      "end": 39.0,
      "text": "Right away, Wukong made himself tiny and escaped."
    },
    {
      "i": 8,
      "start": 41.0,
      "end": 45.0,
      "text": "He flew down a tunnel and squeezed through the cave's main door."
    },
    {
      "i": 9,
      "start": 46.0,
      "end": 50.0,
      "text": "Once he was outside, he returned to his normal size."
    },
    {
      "i": 10,
      "start": 52.0,
      "end": 54.0,
      "text": "He banged on the cave door."
    },
    {
      "i": 11,
      "start": 55.0,
      "end": 56.0,
      "text": "Now!"
    },
    {
      "i": 12,
      "start": 57.0,
      "end": 60.0,
      "text": "The door flew open and Golden Horn appeared."
    },
    {
      "i": 13,
      "start": 61.0,
      "end": 64.0,
      "text": "Sun Wukong shouted the demon."
    },
    {
      "i": 14,
      "start": 65.0,
      "end": 67.0,
      "text": "How did you escape?"
    },
    {
      "i": 15,
      "start": 67.0,
      "end": 69.0,
      "text": "I'm not Sun Wukong."
    },
    {
      "i": 16,
      "start": 69.0,
      "end": 71.0,
      "text": "The monkey lied."
    },
    {
      "i": 17,
      "start": 72.0,
      "end": 74.0,
      "text": "What do you look just like him?"
    },
    {
      "i": 18,
      "start": 74.0,
      "end": 76.0,
      "text": "Said Golden Horn."
    },
    {
      "i": 19,
      "start": 77.0,
      "end": 78.0,
      "text": "Yes, I do."
    },
    {
      "i": 20,
      "start": 78.0,
      "end": 79.0,
      "text": "Said Wukong."
    },
    {
      "i": 21,
      "start": 80.0,
      "end": 82.0,
      "text": "Sun Wukong is my twin brother."
    },
    {
      "i": 22,
      "start": 83.0,
      "end": 85.0,
      "text": "My name is Sun Kong Wu."
    },
    {
      "i": 23,
      "start": 86.0,
      "end": 89.0,
      "text": "Why are you here, Sun Kong Wu?"
    },
    {
      "i": 24,
      "start": 89.0,
      "end": 91.0,
      "text": "Asked Golden Horn."
    },
    {
      "i": 25,
      "start": 92.0,
      "end": 93.0,
      "text": "I know you captured my brother."
    },
    {
      "i": 26,
      "start": 93.0,
      "end": 94.0,
      "text": "Said Wukong."
    },
    {
      "i": 27,
      "start": 95.0,
      "end": 96.0,
      "text": "Said him free."
    },
    {
      "i": 28,
      "start": 100.0,
      "end": 102.0,
      "text": "Golden Horn laughed."
    },
    {
      "i": 29,
      "start": 102.0,
      "end": 105.0,
      "text": "I'm not going to do that."
    },
    {
      "i": 30,
      "start": 106.0,
      "end": 107.0,
      "text": "Oh, that's too bad."
    },
    {
      "i": 31,
      "start": 107.0,
      "end": 110.0,
      "text": "Said Wukong pretending to feel bad."
    },
    {
      "i": 32,
      "start": 111.0,
      "end": 114.0,
      "text": "I was hoping to solve this problem without violence."
    },
    {
      "i": 33,
      "start": 115.0,
      "end": 118.0,
      "text": "He took the iron bar out of his ear."
    },
    {
      "i": 34,
      "start": 120.0,
      "end": 124.0,
      "text": "Golden Horn had been holding the gourd behind his back the whole time."
    },
    {
      "i": 35,
      "start": 125.0,
      "end": 127.0,
      "text": "He quickly held it up and shouted."
    },
    {
      "i": 36,
      "start": 127.0,
      "end": 129.0,
      "text": "Sun Kong Wu."
    },
    {
      "i": 37,
      "start": 132.0,
      "end": 133.0,
      "text": "Shroom?"
    },
    {
      "i": 38,
      "start": 134.0,
      "end": 136.0,
      "text": "Wukong was sucked into the gourd."
    },
    {
      "i": 39,
      "start": 137.0,
      "end": 141.0,
      "text": "Golden Horn put a cap on the gourd and went back into his cave."
    },
    {
      "i": 40,
      "start": 143.0,
      "end": 146.0,
      "text": "Inside the gourd, Wukong stamped his foot."
    },
    {
      "i": 41,
      "start": 147.0,
      "end": 149.0,
      "text": "How will I get out of here?"
    }
  ]
}
