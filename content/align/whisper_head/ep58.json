{
  "episode": 58,
  "source": "assets/video/ep58.mp4",
  "model": "base",
  "duration": 301.20925,
  "segments": [
    {
      "i": 1,
      "start": 0.0,
      "end": 7.0,
      "text": "Journey to the West, Chapter 58, the Meditation Contest."
    },
    {
      "i": 2,
      "start": 14.0,
      "end": 17.0,
      "text": "I challenge you to a meditation contest."
    },
    {
      "i": 3,
      "start": 17.0,
      "end": 19.0,
      "text": "Said the Tiger Immortal."
    },
    {
      "i": 4,
      "start": 19.0,
      "end": 23.0,
      "text": "Whoever can meditate the longest without moving is the winner."
    },
    {
      "i": 5,
      "start": 23.0,
      "end": 25.0,
      "text": "Wukong Gold."
    },
    {
      "i": 6,
      "start": 25.0,
      "end": 28.0,
      "text": "I used to meditate a lot, he thought."
    },
    {
      "i": 7,
      "start": 28.0,
      "end": 30.0,
      "text": "I haven't done it lately."
    },
    {
      "i": 8,
      "start": 30.0,
      "end": 32.0,
      "text": "I'm terrible at sitting still."
    },
    {
      "i": 9,
      "start": 32.0,
      "end": 35.0,
      "text": "The Tang Monk stepped forward."
    },
    {
      "i": 10,
      "start": 35.0,
      "end": 37.0,
      "text": "I accept your challenge."
    },
    {
      "i": 11,
      "start": 37.0,
      "end": 39.0,
      "text": "Master, are you sure?"
    },
    {
      "i": 12,
      "start": 39.0,
      "end": 40.0,
      "text": "Ask Wu-Jing."
    },
    {
      "i": 13,
      "start": 40.0,
      "end": 42.0,
      "text": "The Tang Monk nodded."
    },
    {
      "i": 14,
      "start": 42.0,
      "end": 44.0,
      "text": "I've spent many years meditating."
    },
    {
      "i": 15,
      "start": 44.0,
      "end": 47.0,
      "text": "This contest will be easy for me."
    },
    {
      "i": 16,
      "start": 47.0,
      "end": 49.0,
      "text": "The Tiger Immortal Grinned."
    },
    {
      "i": 17,
      "start": 49.0,
      "end": 52.0,
      "text": "This won't be an ordinary meditation contest."
    },
    {
      "i": 18,
      "start": 52.0,
      "end": 55.0,
      "text": "We will float in the air and meditate."
    },
    {
      "i": 19,
      "start": 55.0,
      "end": 57.0,
      "text": "Can you do that?"
    },
    {
      "i": 20,
      "start": 58.0,
      "end": 61.0,
      "text": "Now the Tang Monk looked nervous."
    },
    {
      "i": 21,
      "start": 61.0,
      "end": 65.0,
      "text": "But before the monk could answer, Wu-Kong collapsed him on the back."
    },
    {
      "i": 22,
      "start": 65.0,
      "end": 68.0,
      "text": "Of course the Tang Monk can float in the air."
    },
    {
      "i": 23,
      "start": 68.0,
      "end": 70.0,
      "text": "The monk he replied."
    },
    {
      "i": 24,
      "start": 70.0,
      "end": 72.0,
      "text": "Then he whispered into the monk's ear."
    },
    {
      "i": 25,
      "start": 72.0,
      "end": 74.0,
      "text": "Don't worry, Master."
    },
    {
      "i": 26,
      "start": 74.0,
      "end": 75.0,
      "text": "You just meditate."
    },
    {
      "i": 27,
      "start": 75.0,
      "end": 78.0,
      "text": "I'll handle everything else."
    },
    {
      "i": 28,
      "start": 78.0,
      "end": 80.0,
      "text": "What are you babbling about?"
    },
    {
      "i": 29,
      "start": 80.0,
      "end": 82.0,
      "text": "Snap the Tiger Immortal."
    },
    {
      "i": 30,
      "start": 82.0,
      "end": 85.0,
      "text": "Let's start the contest."
    },
    {
      "i": 31,
      "start": 85.0,
      "end": 90.0,
      "text": "The Tiger Immortal and the Tang Monk went in front of the crowd."
    },
    {
      "i": 32,
      "start": 90.0,
      "end": 94.0,
      "text": "They sat down with their legs crossed and their palms facing up."
    },
    {
      "i": 33,
      "start": 94.0,
      "end": 98.0,
      "text": "They closed their eyes and started meditating."
    },
    {
      "i": 34,
      "start": 98.0,
      "end": 103.0,
      "text": "After a moment, the Tiger Immortal slowly floated up into the air."
    },
    {
      "i": 35,
      "start": 103.0,
      "end": 104.0,
      "text": "Uh-oh."
    },
    {
      "i": 36,
      "start": 104.0,
      "end": 106.0,
      "text": "Said Bod-J."
    },
    {
      "i": 37,
      "start": 106.0,
      "end": 109.0,
      "text": "Master can't do that. He'll lose the contest."
    },
    {
      "i": 38,
      "start": 109.0,
      "end": 110.0,
      "text": "Don't worry."
    },
    {
      "i": 39,
      "start": 110.0,
      "end": 111.0,
      "text": "Said Wu-Kong."
    },
    {
      "i": 40,
      "start": 111.0,
      "end": 114.0,
      "text": "You just need some help from me."
    },
    {
      "i": 41,
      "start": 114.0,
      "end": 119.0,
      "text": "The monkey recited a spell and then blew toward the Tang Monk."
    },
    {
      "i": 42,
      "start": 119.0,
      "end": 122.0,
      "text": "The monk lifted off the ground."
    },
    {
      "i": 43,
      "start": 122.0,
      "end": 125.0,
      "text": "His eyes remained closed."
    },
    {
      "i": 44,
      "start": 125.0,
      "end": 129.0,
      "text": "Soon he was floating next to the Tiger Immortal."
    },
    {
      "i": 45,
      "start": 129.0,
      "end": 132.0,
      "text": "I think Master will win this contest."
    },
    {
      "i": 46,
      "start": 132.0,
      "end": 134.0,
      "text": "Said Wu-Jing."
    },
    {
      "i": 47,
      "start": 134.0,
      "end": 136.0,
      "text": "I'm pretty good at meditating too."
    },
    {
      "i": 48,
      "start": 136.0,
      "end": 138.0,
      "text": "Said Bod-J."
    },
    {
      "i": 49,
      "start": 138.0,
      "end": 140.0,
      "text": "I could have competed in this contest."
    },
    {
      "i": 50,
      "start": 140.0,
      "end": 142.0,
      "text": "Wu-Kong's smirked."
    },
    {
      "i": 51,
      "start": 142.0,
      "end": 146.0,
      "text": "It would take a lot of magic to lift you, Bod-J."
    },
    {
      "i": 52,
      "start": 146.0,
      "end": 147.0,
      "text": "The pig snorted."
    }
  ]
}
