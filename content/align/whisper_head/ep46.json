  "duration": 325.2419375,
  "segments": [
    {
      "i": 1,
      "start": 0.0,
      "end": 4.64,
      "text": "Journey to the West, Chapter 46."
    },
    {
      "i": 2,
      "start": 4.64,
      "end": 6.64,
      "text": "1,000 pills."
    },
    {
      "i": 3,
      "start": 11.28,
      "end": 14.28,
      "text": "The Tang Monk glared at Wukong."
    },
    {
      "i": 4,
      "start": 14.28,
      "end": 16.76,
      "text": "Bajie says you can bring the king back to life."
    },
    {
      "i": 5,
      "start": 16.76,
      "end": 18.76,
      "text": "Said the monk."
    },
    {
      "i": 6,
      "start": 18.76,
      "end": 20.56,
      "text": "Please do so now."
    },
    {
      "i": 7,
      "start": 20.56,
      "end": 27.76,
      "text": "Wukong shoulda looked at Bajie, who's trying not to laugh."
    },
    {
      "i": 8,
      "start": 28.12,
      "end": 30.8,
      "text": "Master, use the tight headband spell."
    },
    {
      "i": 9,
      "start": 30.8,
      "end": 32.76,
      "text": "Said the pig."
    },
    {
      "i": 10,
      "start": 32.76,
      "end": 33.4,
      "text": "Pooch!"
    },
    {
      "i": 11,
      "start": 33.4,
      "end": 34.64,
      "text": "Cryed Wukong."
    },
    {
      "i": 12,
      "start": 34.64,
      "end": 36.96,
      "text": "LS Glauza for help."
    },
    {
      "i": 13,
      "start": 36.96,
      "end": 39.8,
      "text": "He makes pills that can make people live forever."
    },
    {
      "i": 14,
      "start": 39.8,
      "end": 43.32,
      "text": "Maybe he makes pills that can bring people back to life."
    },
    {
      "i": 15,
      "start": 46.44,
      "end": 49.52,
      "text": "Laosah was busy working on a potion."
    },
    {
      "i": 16,
      "start": 49.52,
      "end": 54.0,
      "text": "Steam rose from the bubbling cauldron."
    },
    {
      "i": 17,
      "start": 54.0,
      "end": 56.68,
      "text": "Suddenly Wukong burst into the room."
    },
    {
      "i": 18,
      "start": 56.72,
      "end": 58.84,
      "text": "Hello, Laosah."
    },
    {
      "i": 19,
      "start": 61.64,
      "end": 63.12,
      "text": "Laosah groaned."
    },
    {
      "i": 20,
      "start": 63.12,
      "end": 65.52,
      "text": "What are you doing here, Wukong?"
    },
    {
      "i": 21,
      "start": 65.52,
      "end": 70.6,
      "text": "You're supposed to be helping the Tang Monk reach the Western paradise."
    },
    {
      "i": 22,
      "start": 70.6,
      "end": 75.6,
      "text": "Wukong walked around the room, looking at all the bottles and equipment."
    },
    {
      "i": 23,
      "start": 75.6,
      "end": 77.52,
      "text": "I'm still helping the Tang Monk."
    },
    {
      "i": 24,
      "start": 77.52,
      "end": 81.52,
      "text": "He said, we're helping a king right now, though."
    },
    {
      "i": 25,
      "start": 81.52,
      "end": 85.44,
      "text": "He poked a blue bottle filled with liquid."
    },
    {
      "i": 26,
      "start": 85.44,
      "end": 87.92,
      "text": "Laosah looked up from his potion."
    },
    {
      "i": 27,
      "start": 87.92,
      "end": 89.52,
      "text": "Don't touch anything."
    },
    {
      "i": 28,
      "start": 89.52,
      "end": 91.88,
      "text": "Just tell me why you're here."
    },
    {
      "i": 29,
      "start": 94.12,
      "end": 96.44,
      "text": "I need pills that will bring someone back to life."
    },
    {
      "i": 30,
      "start": 96.44,
      "end": 97.96,
      "text": "Said Wukong."
    },
    {
      "i": 31,
      "start": 97.96,
      "end": 101.36,
      "text": "Give me 1,000 of them."
    },
    {
      "i": 32,
      "start": 101.36,
      "end": 105.28,
      "text": "Laosah stopped what he was doing and walked over to Wukong."
    },
    {
      "i": 33,
      "start": 109.6,
      "end": 112.72,
      "text": "How dare you tell me to give you 1,000 pills?"
    },
    {
      "i": 34,
      "start": 112.72,
      "end": 113.92,
      "text": "He said."
    },
    {
      "i": 35,
      "start": 113.92,
      "end": 116.32,
      "text": "Get out of here right now."
    },
    {
      "i": 36,
      "start": 116.32,
      "end": 118.48,
      "text": "The monkey laughed."
    },
    {
      "i": 37,
      "start": 118.48,
      "end": 120.08,
      "text": "I'm kidding."
    },
    {
      "i": 38,
      "start": 120.08,
      "end": 122.84,
      "text": "I don't really need 1,000 pills."
    },
    {
      "i": 39,
      "start": 122.84,
      "end": 125.48,
      "text": "Just give me 100, not a leave."
    },
    {
      "i": 40,
      "start": 125.48,
      "end": 128.84,
      "text": "Laosah squeezed his hands into fists."
    },
    {
      "i": 41,
      "start": 128.84,
      "end": 130.68,
      "text": "I'm not giving you any pills."
    },
    {
      "i": 42,
      "start": 130.68,
      "end": 132.68,
      "text": "Now get out of here."
    },
    {
      "i": 43,
      "start": 132.68,
      "end": 136.28,
      "text": "Wukong scratched his head, pretending to think."
    },
    {
      "i": 44,
      "start": 136.28,
      "end": 140.84,
      "text": "Now that I think about it, I don't need 100 pills."
    },
    {
      "i": 45,
      "start": 140.84,
      "end": 143.84,
      "text": "Just give me 10."
    },
    {
      "i": 46,
      "start": 143.84,
      "end": 146.28,
      "text": "You are rude and disrespectful."
    },
    {
      "i": 47,
      "start": 146.28,
      "end": 147.8,
      "text": "Yeld Laosah."
    },
    {
      "i": 48,
      "start": 147.8,
      "end": 149.8,
      "text": "Get out."
    }
  ]
}
