{
  "episode": 71,
  "source": "assets/video/ep71.mp4",
  "model": "base",
  "duration": 323.43075,
  "segments": [
    {
      "i": 1,
      "start": 0.0,
      "end": 17.36,
      "text": "I'm hungry."
    },
    {
      "i": 2,
      "start": 17.36,
      "end": 20.4,
      "text": "Bajay moaned."
    },
    {
      "i": 3,
      "start": 20.4,
      "end": 23.6,
      "text": "His stomach grumbled loudly."
    },
    {
      "i": 4,
      "start": 23.6,
      "end": 26.24,
      "text": "Can we stop walking?"
    },
    {
      "i": 5,
      "start": 26.24,
      "end": 27.92,
      "text": "We'll stop for lunch soon."
    },
    {
      "i": 6,
      "start": 27.92,
      "end": 29.52,
      "text": "Said the Tang monk."
    },
    {
      "i": 7,
      "start": 29.52,
      "end": 32.44,
      "text": "The weather is nice and the road is smooth."
    },
    {
      "i": 8,
      "start": 32.44,
      "end": 33.94,
      "text": "I want to keep moving."
    },
    {
      "i": 9,
      "start": 33.94,
      "end": 36.52,
      "text": "I'm eager to reach the western paradise."
    },
    {
      "i": 10,
      "start": 36.52,
      "end": 39.12,
      "text": "Woo-kong laughed."
    },
    {
      "i": 11,
      "start": 39.12,
      "end": 43.36,
      "text": "Master, I don't know why you're still going there."
    },
    {
      "i": 12,
      "start": 43.36,
      "end": 46.92,
      "text": "You should have married that scorpion spirit instead."
    },
    {
      "i": 13,
      "start": 46.92,
      "end": 48.92,
      "text": "The Tang monk frowned."
    },
    {
      "i": 14,
      "start": 48.92,
      "end": 51.12,
      "text": "That's not funny, Woo-kong."
    },
    {
      "i": 15,
      "start": 51.12,
      "end": 52.96,
      "text": "I agree with Woo-kong."
    },
    {
      "i": 16,
      "start": 52.96,
      "end": 54.2,
      "text": "Said Bajay."
    },
    {
      "i": 17,
      "start": 54.2,
      "end": 57.2,
      "text": "I would have gladly married her."
    },
    {
      "i": 18,
      "start": 57.2,
      "end": 59.08,
      "text": "Woo-ching raised an eyebrow."
    },
    {
      "i": 19,
      "start": 59.08,
      "end": 62.36,
      "text": "I doubt she would have married you."
    },
    {
      "i": 20,
      "start": 62.36,
      "end": 63.36,
      "text": "Why not?"
    },
    {
      "i": 21,
      "start": 63.36,
      "end": 65.8,
      "text": "Bajay puffed out his chest."
    },
    {
      "i": 22,
      "start": 65.8,
      "end": 68.84,
      "text": "I'm very handsome."
    },
    {
      "i": 23,
      "start": 68.84,
      "end": 74.08,
      "text": "Everybody laughed, including Bajay."
    },
    {
      "i": 24,
      "start": 74.08,
      "end": 79.0,
      "text": "They had continued for another hour when the pig complained again."
    },
    {
      "i": 25,
      "start": 79.0,
      "end": 81.28,
      "text": "My legs are tired."
    },
    {
      "i": 26,
      "start": 81.28,
      "end": 85.04,
      "text": "He said, we'll stop at the next village."
    },
    {
      "i": 27,
      "start": 85.04,
      "end": 87.72,
      "text": "Said the Tang monk."
    },
    {
      "i": 28,
      "start": 87.72,
      "end": 88.72,
      "text": "Bajay sighed."
    },
    {
      "i": 29,
      "start": 88.72,
      "end": 92.04,
      "text": "I hope we reach the next village soon."
    },
    {
      "i": 30,
      "start": 92.04,
      "end": 95.32,
      "text": "I know how we can get there soon."
    },
    {
      "i": 31,
      "start": 95.32,
      "end": 98.2,
      "text": "Said Woo-kong with a laugh."
    },
    {
      "i": 32,
      "start": 98.2,
      "end": 101.56,
      "text": "The monkeys smacked the horse with shock forward."
    },
    {
      "i": 33,
      "start": 101.56,
      "end": 110.32,
      "text": "Woo-kong cried the Tang monk hanging on tightly."
    },
    {
      "i": 34,
      "start": 110.32,
      "end": 116.96,
      "text": "When the horse finally stopped running, the monk was far ahead of his companions."
    },
    {
      "i": 35,
      "start": 116.96,
      "end": 121.44,
      "text": "A group of nasty looking men stood in front of him."
    },
    {
      "i": 36,
      "start": 121.44,
      "end": 123.2,
      "text": "Give us all your money."
    },
    {
      "i": 37,
      "start": 123.2,
      "end": 124.96,
      "text": "Said a man with an axe."
    },
    {
      "i": 38,
      "start": 124.96,
      "end": 127.96,
      "text": "The Tang monk shook with fear."
    },
    {
      "i": 39,
      "start": 127.96,
      "end": 130.76,
      "text": "Woo-kong was already running over."
    },
    {
      "i": 40,
      "start": 130.76,
      "end": 133.12,
      "text": "Don't you dare harm my master."
    },
    {
      "i": 41,
      "start": 133.12,
      "end": 136.44,
      "text": "Shattered the monkey."
    },
    {
      "i": 42,
      "start": 136.44,
      "end": 139.44,
      "text": "Who are you?"
    },
    {
      "i": 43,
      "start": 139.44,
      "end": 141.04,
      "text": "Ask the man."
    },
    {
      "i": 44,
      "start": 141.04,
      "end": 146.32,
      "text": "My name is Sun Woo-kong."
    },
    {
      "i": 45,
      "start": 146.32,
      "end": 148.92,
      "text": "My dear money, Sun Woo-kong."
    },
    {
      "i": 46,
      "start": 148.92,
      "end": 149.72,
      "text": "Said the man."
    }
  ]
}
