{
  "episode": 45,
  "source": "assets/video/ep45.mp4",
  "model": "base",
  "duration": 327.981875,
  "segments": [
    {
      "i": 1,
      "start": 0.0,
      "end": 17.0,
      "text": "The Tang Monk introduced himself to the Prince and then waved toward the others."
    },
    {
      "i": 2,
      "start": 17.0,
      "end": 19.0,
      "text": "These are my companions."
    },
    {
      "i": 3,
      "start": 19.0,
      "end": 23.0,
      "text": "We're going to the Western Paradise to get scriptures from Buddha."
    },
    {
      "i": 4,
      "start": 23.0,
      "end": 24.0,
      "text": "What's going on?"
    },
    {
      "i": 5,
      "start": 24.0,
      "end": 25.0,
      "text": "Ask the Prince."
    },
    {
      "i": 6,
      "start": 25.0,
      "end": 28.0,
      "text": "Why did the monkey lead me here?"
    },
    {
      "i": 7,
      "start": 28.0,
      "end": 32.0,
      "text": "The man ruling the Black Rooster Kingdom is not really the king."
    },
    {
      "i": 8,
      "start": 32.0,
      "end": 33.0,
      "text": "Set the monk."
    },
    {
      "i": 9,
      "start": 35.0,
      "end": 38.0,
      "text": "He told the Prince everything."
    },
    {
      "i": 10,
      "start": 38.0,
      "end": 42.0,
      "text": "When the Tang Monk story was finished, the Prince was furious."
    },
    {
      "i": 11,
      "start": 42.0,
      "end": 47.0,
      "text": "You're lying. I will have you arrested for making up such a story."
    },
    {
      "i": 12,
      "start": 47.0,
      "end": 53.0,
      "text": "The Tang Monk reached into his robe. He pulled out the Jade coin."
    },
    {
      "i": 13,
      "start": 53.0,
      "end": 56.0,
      "text": "Your father told me to show you this."
    },
    {
      "i": 14,
      "start": 57.0,
      "end": 58.0,
      "text": "The Prince gasped."
    },
    {
      "i": 15,
      "start": 58.0,
      "end": 63.0,
      "text": "That coin belongs to my father. It's a royal treasure."
    },
    {
      "i": 16,
      "start": 63.0,
      "end": 65.0,
      "text": "He began to cry."
    },
    {
      "i": 17,
      "start": 68.0,
      "end": 72.0,
      "text": "Your story must be true. My poor father."
    },
    {
      "i": 18,
      "start": 72.0,
      "end": 76.0,
      "text": "All this time, people thought that evil Taoist was him."
    },
    {
      "i": 19,
      "start": 76.0,
      "end": 79.0,
      "text": "Don't worry, said Wukong."
    },
    {
      "i": 20,
      "start": 79.0,
      "end": 82.0,
      "text": "We'll get rid of that baked king."
    },
    {
      "i": 21,
      "start": 83.0,
      "end": 86.0,
      "text": "Late that night, Wukong lay awake."
    },
    {
      "i": 22,
      "start": 87.0,
      "end": 89.0,
      "text": "The Taoist will deny everything."
    },
    {
      "i": 23,
      "start": 89.0,
      "end": 93.0,
      "text": "He thought we need proof that he killed the real king."
    },
    {
      "i": 24,
      "start": 94.0,
      "end": 97.0,
      "text": "He poked Bajie who was fast asleep."
    },
    {
      "i": 25,
      "start": 97.0,
      "end": 99.0,
      "text": "Bajie, wake up."
    },
    {
      "i": 26,
      "start": 99.0,
      "end": 101.0,
      "text": "The pig rolled over."
    },
    {
      "i": 27,
      "start": 101.0,
      "end": 103.0,
      "text": "Lay me alone."
    },
    {
      "i": 28,
      "start": 104.0,
      "end": 106.0,
      "text": "Sleeping."
    },
    {
      "i": 29,
      "start": 106.0,
      "end": 109.0,
      "text": "We need to do something, said Wukong."
    },
    {
      "i": 30,
      "start": 109.0,
      "end": 111.0,
      "text": "Not now."
    },
    {
      "i": 31,
      "start": 111.0,
      "end": 113.0,
      "text": "Mumbled Bajie."
    },
    {
      "i": 32,
      "start": 114.0,
      "end": 116.0,
      "text": "I know where there's treasure."
    },
    {
      "i": 33,
      "start": 116.0,
      "end": 118.0,
      "text": "The monkey lied."
    },
    {
      "i": 34,
      "start": 118.0,
      "end": 120.0,
      "text": "Bajie's eyes popped open."
    },
    {
      "i": 35,
      "start": 120.0,
      "end": 123.0,
      "text": "Where is the treasure?"
    },
    {
      "i": 36,
      "start": 123.0,
      "end": 126.0,
      "text": "Follow me, said Wukong."
    },
    {
      "i": 37,
      "start": 126.0,
      "end": 131.0,
      "text": "They went outside and flew to the palace."
    },
    {
      "i": 38,
      "start": 131.0,
      "end": 137.0,
      "text": "In a small courtyard, Wukong rushed toward a well."
    },
    {
      "i": 39,
      "start": 137.0,
      "end": 142.0,
      "text": "The treasure is in this well, said the monkey, pulling the lid off."
    },
    {
      "i": 40,
      "start": 142.0,
      "end": 146.0,
      "text": "Bajie peered down into the darkness."
    },
    {
      "i": 41,
      "start": 146.0,
      "end": 150.0,
      "text": "Is this the well the king was pushed until?"
    }
  ]
}
