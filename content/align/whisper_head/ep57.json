  "segments": [
    {
      "i": 1,
      "start": 0.0,
      "end": 7.0,
      "text": "Journey to the West, Chapter 57, a guessing game."
    },
    {
      "i": 2,
      "start": 13.0,
      "end": 15.0,
      "text": "Don't make any rain yet."
    },
    {
      "i": 3,
      "start": 15.0,
      "end": 17.0,
      "text": "Wukong repeated."
    },
    {
      "i": 4,
      "start": 17.0,
      "end": 19.0,
      "text": "But we must."
    },
    {
      "i": 5,
      "start": 19.0,
      "end": 21.0,
      "text": "Said the old woman of the wind."
    },
    {
      "i": 6,
      "start": 21.0,
      "end": 25.0,
      "text": "Someone on Earth just prayed for it."
    },
    {
      "i": 7,
      "start": 25.0,
      "end": 29.0,
      "text": "And the Jade Emperor heard the prayers."
    },
    {
      "i": 8,
      "start": 29.0,
      "end": 32.0,
      "text": "The dragon king of the eastern sea."
    },
    {
      "i": 9,
      "start": 32.0,
      "end": 35.0,
      "text": "The person who recited the prayers is bad."
    },
    {
      "i": 10,
      "start": 35.0,
      "end": 36.0,
      "text": "Said Wukong."
    },
    {
      "i": 11,
      "start": 36.0,
      "end": 38.0,
      "text": "He's the tiger immortal."
    },
    {
      "i": 12,
      "start": 38.0,
      "end": 41.0,
      "text": "And he plans to make the Tang Munk a slave."
    },
    {
      "i": 13,
      "start": 41.0,
      "end": 44.0,
      "text": "The dragon king looked concerned."
    },
    {
      "i": 14,
      "start": 44.0,
      "end": 46.0,
      "text": "That's terrible."
    },
    {
      "i": 15,
      "start": 46.0,
      "end": 51.0,
      "text": "We all want the Tang Munk to reach the Western Paradise."
    },
    {
      "i": 16,
      "start": 51.0,
      "end": 56.0,
      "text": "But we must obey the Jade Emperor's orders."
    },
    {
      "i": 17,
      "start": 56.0,
      "end": 57.0,
      "text": "Said the woman."
    },
    {
      "i": 18,
      "start": 57.0,
      "end": 59.0,
      "text": "Just wait a moment."
    },
    {
      "i": 19,
      "start": 59.0,
      "end": 60.0,
      "text": "Said the monkey."
    },
    {
      "i": 20,
      "start": 60.0,
      "end": 62.0,
      "text": "I'll go back down to the ground now."
    },
    {
      "i": 21,
      "start": 62.0,
      "end": 66.0,
      "text": "When I raise my iron bar, you can make it rain."
    },
    {
      "i": 22,
      "start": 66.0,
      "end": 71.0,
      "text": "The woman and the dragon king agreed to wait a moment."
    },
    {
      "i": 23,
      "start": 71.0,
      "end": 75.0,
      "text": "Wukong returned to his body."
    },
    {
      "i": 24,
      "start": 75.0,
      "end": 76.0,
      "text": "The sky cleared."
    },
    {
      "i": 25,
      "start": 76.0,
      "end": 80.0,
      "text": "And the tiger immortal shook with anger."
    },
    {
      "i": 26,
      "start": 80.0,
      "end": 82.0,
      "text": "Why didn't my spell work?"
    },
    {
      "i": 27,
      "start": 82.0,
      "end": 83.0,
      "text": "He cried."
    },
    {
      "i": 28,
      "start": 83.0,
      "end": 85.0,
      "text": "Bajai laughed at him."
    },
    {
      "i": 29,
      "start": 86.0,
      "end": 88.0,
      "text": "Some rain."
    },
    {
      "i": 30,
      "start": 88.0,
      "end": 91.0,
      "text": "You couldn't leave it some in one drop."
    },
    {
      "i": 31,
      "start": 91.0,
      "end": 93.0,
      "text": "I'll try again."
    },
    {
      "i": 32,
      "start": 93.0,
      "end": 95.0,
      "text": "Said the tiger immortal."
    },
    {
      "i": 33,
      "start": 95.0,
      "end": 97.0,
      "text": "No, you won't."
    },
    {
      "i": 34,
      "start": 97.0,
      "end": 98.0,
      "text": "Said Wukong."
    },
    {
      "i": 35,
      "start": 98.0,
      "end": 100.0,
      "text": "You had a chance to summon rain."
    },
    {
      "i": 36,
      "start": 100.0,
      "end": 102.0,
      "text": "And you obviously can't."
    },
    {
      "i": 37,
      "start": 102.0,
      "end": 104.0,
      "text": "Now it's my turn."
    },
    {
      "i": 38,
      "start": 104.0,
      "end": 107.0,
      "text": "The monkey raised his iron bar into the air."
    },
    {
      "i": 39,
      "start": 107.0,
      "end": 110.0,
      "text": "Instantly clouds move back in."
    },
    {
      "i": 40,
      "start": 110.0,
      "end": 112.0,
      "text": "And thunder boomed."
    },
    {
      "i": 41,
      "start": 112.0,
      "end": 114.0,
      "text": "Rain began to pour down."
    },
    {
      "i": 42,
      "start": 114.0,
      "end": 117.0,
      "text": "The crowd cheered."
    },
    {
      "i": 43,
      "start": 117.0,
      "end": 120.0,
      "text": "The Tang monks sighed."
    },
    {
      "i": 44,
      "start": 120.0,
      "end": 121.0,
      "text": "Wonderful."
    },
    {
      "i": 45,
      "start": 121.0,
      "end": 124.0,
      "text": "Now all the Buddhist monks will be free."
    },
    {
      "i": 46,
      "start": 124.0,
      "end": 127.0,
      "text": "And we can continue our journey."
    },
    {
      "i": 47,
      "start": 127.0,
      "end": 131.0,
      "text": "The tiger immortal stumped over to Wukong."
    },
    {
      "i": 48,
      "start": 131.0,
      "end": 134.0,
      "text": "I want another contest."
    },
    {
      "i": 49,
      "start": 134.0,
      "end": 136.0,
      "text": "Wukong laughed."
    },
    {
      "i": 50,
      "start": 136.0,
      "end": 139.0,
      "text": "Why would you want another contest?"
    },
    {
      "i": 51,
      "start": 139.0,
      "end": 141.0,
      "text": "You only lose again."
    },
    {
      "i": 52,
      "start": 142.0,
      "end": 145.0,
      "text": "The tiger immortal ignored the monkey's question."
    },
    {
      "i": 53,
      "start": 145.0,
      "end": 149.0,
      "text": "I challenge the Tang monk to a guessing game."
    },
    {
      "i": 54,
      "start": 149.0,
      "end": 151.0,
      "text": "The Tang..."
    }
  ]
}
