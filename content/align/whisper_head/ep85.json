{
  "episode": 85,
  "source": "assets/video/ep85.mp4",
  "model": "base",
  "duration": 313.7945,
  "segments": [
    {
      "i": 1,
      "start": 0.0,
      "end": 7.0,
      "text": "Journey to the West, Chapter 85, Fire, Smoke and Sand."
    },
    {
      "i": 2,
      "start": 12.0,
      "end": 15.0,
      "text": "Wukong landed on another mountain peak."
    },
    {
      "i": 3,
      "start": 18.0,
      "end": 20.0,
      "text": "The monkey groaned."
    },
    {
      "i": 4,
      "start": 21.0,
      "end": 23.0,
      "text": "That fire and smoke were awful!"
    },
    {
      "i": 5,
      "start": 24.0,
      "end": 26.0,
      "text": "And the sand went right in!"
    },
    {
      "i": 6,
      "start": 26.0,
      "end": 28.0,
      "text": "Ah, ah, ah!"
    },
    {
      "i": 7,
      "start": 28.0,
      "end": 30.0,
      "text": "Kling knows!"
    },
    {
      "i": 8,
      "start": 30.0,
      "end": 33.0,
      "text": "He looked at the demon of Powers Mountain."
    },
    {
      "i": 9,
      "start": 33.0,
      "end": 36.0,
      "text": "The fire and smoke were now gone."
    },
    {
      "i": 10,
      "start": 36.0,
      "end": 39.0,
      "text": "Wukong was about to return to that mountain."
    },
    {
      "i": 11,
      "start": 40.0,
      "end": 42.0,
      "text": "But then he hesitated."
    },
    {
      "i": 12,
      "start": 43.0,
      "end": 45.0,
      "text": "The demon will just use the same trick again!"
    },
    {
      "i": 13,
      "start": 45.0,
      "end": 47.0,
      "text": "Thought the monkey?"
    },
    {
      "i": 14,
      "start": 47.0,
      "end": 49.0,
      "text": "Ossnick into his cave and look around."
    },
    {
      "i": 15,
      "start": 49.0,
      "end": 53.0,
      "text": "Maybe I can find out how he created the fire's smoke and sand."
    },
    {
      "i": 16,
      "start": 54.0,
      "end": 59.0,
      "text": "Wukong turned into a bug and flew back to the demon's mountain."
    },
    {
      "i": 17,
      "start": 64.0,
      "end": 68.0,
      "text": "He went into the cave and flew down a long dark tunnel."
    },
    {
      "i": 18,
      "start": 71.0,
      "end": 77.0,
      "text": "He soon found a brightly lit bedroom filled with nice furniture and fancy decorations."
    },
    {
      "i": 19,
      "start": 78.0,
      "end": 81.0,
      "text": "In a corner, a woman sat in a chair."
    },
    {
      "i": 20,
      "start": 82.0,
      "end": 84.0,
      "text": "She was crying."
    },
    {
      "i": 21,
      "start": 85.0,
      "end": 86.0,
      "text": "Poof!"
    },
    {
      "i": 22,
      "start": 86.0,
      "end": 88.0,
      "text": "Wukong turned back into himself."
    },
    {
      "i": 23,
      "start": 89.0,
      "end": 90.0,
      "text": "Oh!"
    },
    {
      "i": 24,
      "start": 90.0,
      "end": 91.0,
      "text": "Cried the woman."
    },
    {
      "i": 25,
      "start": 91.0,
      "end": 92.0,
      "text": "Who are you?"
    },
    {
      "i": 26,
      "start": 93.0,
      "end": 95.0,
      "text": "My name is Sun Wukong."
    },
    {
      "i": 27,
      "start": 95.0,
      "end": 96.0,
      "text": "Said the monkey."
    },
    {
      "i": 28,
      "start": 96.0,
      "end": 98.0,
      "text": "Are you the queen?"
    },
    {
      "i": 29,
      "start": 98.0,
      "end": 100.0,
      "text": "The woman nodded."
    },
    {
      "i": 30,
      "start": 100.0,
      "end": 102.0,
      "text": "Your husband sent me to rescue you."
    },
    {
      "i": 31,
      "start": 102.0,
      "end": 103.0,
      "text": "Said Wukong."
    },
    {
      "i": 32,
      "start": 104.0,
      "end": 107.0,
      "text": "The queen's face broke into a smile."
    },
    {
      "i": 33,
      "start": 107.0,
      "end": 109.0,
      "text": "Oh please do!"
    },
    {
      "i": 34,
      "start": 109.0,
      "end": 111.0,
      "text": "The demon who kidnapped me is horrible."
    },
    {
      "i": 35,
      "start": 111.0,
      "end": 112.0,
      "text": "Nasty."
    },
    {
      "i": 36,
      "start": 112.0,
      "end": 113.0,
      "text": "Ugly."
    },
    {
      "i": 37,
      "start": 113.0,
      "end": 114.0,
      "text": "Smelly."
    },
    {
      "i": 38,
      "start": 114.0,
      "end": 116.0,
      "text": "The queen shivered."
    },
    {
      "i": 39,
      "start": 116.0,
      "end": 118.0,
      "text": "He said he loves me and wants to..."
    },
    {
      "i": 40,
      "start": 118.0,
      "end": 120.0,
      "text": "Marry me!"
    },
    {
      "i": 41,
      "start": 120.0,
      "end": 123.0,
      "text": "The queen started to cry again."
    },
    {
      "i": 42,
      "start": 123.0,
      "end": 125.0,
      "text": "Don't worry your majesty."
    },
    {
      "i": 43,
      "start": 125.0,
      "end": 126.0,
      "text": "Said Wukong."
    },
    {
      "i": 44,
      "start": 126.0,
      "end": 128.0,
      "text": "I'll defeat the demon."
    },
    {
      "i": 45,
      "start": 128.0,
      "end": 133.0,
      "text": "But first I must figure out how he creates the fire's smoke and sand."
    },
    {
      "i": 46,
      "start": 133.0,
      "end": 134.0,
      "text": "That's simple."
    },
    {
      "i": 47,
      "start": 134.0,
      "end": 136.0,
      "text": "The queen sniffed."
    },
    {
      "i": 48,
      "start": 136.0,
      "end": 138.0,
      "text": "He has three bells."
    },
    {
      "i": 49,
      "start": 138.0,
      "end": 140.0,
      "text": "The first bell makes fire."
    },
    {
      "i": 50,
      "start": 140.0,
      "end": 142.0,
      "text": "The second bell makes smoke."
    },
    {
      "i": 51,
      "start": 142.0,
      "end": 145.0,
      "text": "And the third bell makes sand."
    },
    {
      "i": 52,
      "start": 145.0,
      "end": 147.0,
      "text": "I saw the bells."
    },
    {
      "i": 53,
      "start": 147.0,
      "end": 148.0,
      "text": "Said Wukong."
    },
    {
      "i": 54,
      "start": 148.0,
      "end": 150.0,
      "text": "He wears them around his neck."
    }
  ]
}
