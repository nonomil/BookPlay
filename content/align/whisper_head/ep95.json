{
  "episode": 95,
  "source": "assets/video/ep95.mp4",
  "model": "base",
  "duration": 328.167625,
  "segments": [
    {
      "i": 1,
      "start": 0.0,
      "end": 12.96,
      "text": "Journey to the West, Chapter 95, The Raptor Demon."
    },
    {
      "i": 2,
      "start": 12.96,
      "end": 17.8,
      "text": "The Tang Monk and Wu Xing were tied up inside the demons cave."
    },
    {
      "i": 3,
      "start": 17.8,
      "end": 23.12,
      "text": "Baje was also tied up, floating in the tub of saltwater again."
    },
    {
      "i": 4,
      "start": 23.12,
      "end": 26.44,
      "text": "The three demons talked in another room."
    },
    {
      "i": 5,
      "start": 26.44,
      "end": 29.84,
      "text": "That pig will taste wonderful once he's pickled."
    },
    {
      "i": 6,
      "start": 29.84,
      "end": 31.64,
      "text": "Said the elephant."
    },
    {
      "i": 7,
      "start": 31.64,
      "end": 33.04,
      "text": "I agree."
    },
    {
      "i": 8,
      "start": 33.04,
      "end": 34.2,
      "text": "Said the lion."
    },
    {
      "i": 9,
      "start": 34.2,
      "end": 37.24,
      "text": "But the main course is a Tang Monk."
    },
    {
      "i": 10,
      "start": 37.24,
      "end": 40.64,
      "text": "It will be nice to live forever."
    },
    {
      "i": 11,
      "start": 40.64,
      "end": 42.12,
      "text": "The elephant nodded."
    },
    {
      "i": 12,
      "start": 42.12,
      "end": 44.72,
      "text": "Let's fry the monk with garlic and spices."
    },
    {
      "i": 13,
      "start": 44.72,
      "end": 48.2,
      "text": "I'll go see what we have in the kitchen."
    },
    {
      "i": 14,
      "start": 48.2,
      "end": 49.2,
      "text": "Wait a minute."
    },
    {
      "i": 15,
      "start": 49.2,
      "end": 50.2,
      "text": "Said the Raptor."
    },
    {
      "i": 16,
      "start": 50.2,
      "end": 52.2,
      "text": "We need a plan."
    },
    {
      "i": 17,
      "start": 52.6,
      "end": 56.6,
      "text": "Wu Kong will certainly try to rescue his friends."
    },
    {
      "i": 18,
      "start": 56.6,
      "end": 57.6,
      "text": "You're right."
    },
    {
      "i": 19,
      "start": 57.6,
      "end": 59.12,
      "text": "Said the lion."
    },
    {
      "i": 20,
      "start": 59.12,
      "end": 61.6,
      "text": "He felt his broken tooth."
    },
    {
      "i": 21,
      "start": 61.6,
      "end": 64.64,
      "text": "I don't want that to happen."
    },
    {
      "i": 22,
      "start": 64.64,
      "end": 67.0,
      "text": "The elephant looked at his bruise trunk."
    },
    {
      "i": 23,
      "start": 67.0,
      "end": 69.12,
      "text": "Me neither."
    },
    {
      "i": 24,
      "start": 69.12,
      "end": 71.24,
      "text": "Well, this time I have a plan."
    },
    {
      "i": 25,
      "start": 71.24,
      "end": 73.08,
      "text": "Said the Raptor."
    },
    {
      "i": 26,
      "start": 73.08,
      "end": 75.04,
      "text": "We'll start a rumor."
    },
    {
      "i": 27,
      "start": 75.04,
      "end": 80.68,
      "text": "We'll tell every demon nearby that we've already eaten the Tang Monk."
    },
    {
      "i": 28,
      "start": 80.68,
      "end": 85.68,
      "text": "When Wu Kong hears that, he'll give up hope and leave the area."
    },
    {
      "i": 29,
      "start": 85.68,
      "end": 86.88,
      "text": "Brilliant."
    },
    {
      "i": 30,
      "start": 86.88,
      "end": 88.44,
      "text": "Said the lion."
    },
    {
      "i": 31,
      "start": 88.44,
      "end": 90.0,
      "text": "The elephant smiled."
    },
    {
      "i": 32,
      "start": 90.0,
      "end": 92.24,
      "text": "It's the perfect plan."
    },
    {
      "i": 33,
      "start": 94.76,
      "end": 99.64,
      "text": "Wu Kong sat next to the road thinking about what to do."
    },
    {
      "i": 34,
      "start": 99.64,
      "end": 101.68,
      "text": "Those demons keep tricking me."
    },
    {
      "i": 35,
      "start": 101.68,
      "end": 104.12,
      "text": "The monkey said to himself."
    },
    {
      "i": 36,
      "start": 104.12,
      "end": 105.72,
      "text": "Well, no more."
    },
    {
      "i": 37,
      "start": 105.72,
      "end": 108.8,
      "text": "I'll go into that cave and rescue my friends."
    },
    {
      "i": 38,
      "start": 108.8,
      "end": 113.8,
      "text": "When the demons attack, I'll co-op her with my iron bar."
    },
    {
      "i": 39,
      "start": 113.8,
      "end": 118.28,
      "text": "Even if they cry and promise not to hurt us, I won't believe them."
    },
    {
      "i": 40,
      "start": 118.28,
      "end": 120.32,
      "text": "The monkey stood up."
    },
    {
      "i": 41,
      "start": 120.32,
      "end": 124.08,
      "text": "He saw two fiends coming down the road."
    },
    {
      "i": 42,
      "start": 124.08,
      "end": 125.28,
      "text": "I wonder who they are."
    },
    {
      "i": 43,
      "start": 125.28,
      "end": 127.8,
      "text": "Thought the monkey."
    },
    {
      "i": 44,
      "start": 127.8,
      "end": 132.68,
      "text": "He hid behind a rock and waited for the fiends to pass by."
    },
    {
      "i": 45,
      "start": 132.68,
      "end": 135.2,
      "text": "Those demons are lucky."
    },
    {
      "i": 46,
      "start": 135.2,
      "end": 137.68,
      "text": "Said one fiend."
    },
    {
      "i": 47,
      "start": 137.68,
      "end": 139.28,
      "text": "Said the other."
    },
    {
      "i": 48,
      "start": 139.28,
      "end": 141.6,
      "text": "They ate the Tang Monk."
    },
    {
      "i": 49,
      "start": 141.6,
      "end": 143.92,
      "text": "And now they'll live forever."
    },
    {
      "i": 50,
      "start": 143.92,
      "end": 145.88,
      "text": "Said the first fiend."
    },
    {
      "i": 51,
      "start": 145.88,
      "end": 147.88,
      "text": "He sighed."
    },
    {
      "i": 52,
      "start": 147.88,
      "end": 150.4,
      "text": "It would be nice to live forever."
    }
  ]
}
