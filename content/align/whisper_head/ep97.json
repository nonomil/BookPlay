{
  "episode": 97,
  "source": "assets/video/ep97.mp4",
  "model": "base",
  "duration": 319.1583125,
  "segments": [
    {
      "i": 1,
      "start": 0.0,
      "end": 7.0,
      "text": "Journey to the West, Chapter 97, Bajay and the Monster."
    },
    {
      "i": 2,
      "start": 13.0,
      "end": 18.0,
      "text": "Bajay took a step back as a dark mist surrounded the people on the road."
    },
    {
      "i": 3,
      "start": 20.0,
      "end": 26.0,
      "text": "When the mist cleared, he saw they were really a monster and several little demons."
    },
    {
      "i": 4,
      "start": 26.0,
      "end": 28.0,
      "text": "The monster grinned at him."
    },
    {
      "i": 5,
      "start": 28.0,
      "end": 32.0,
      "text": "Yes, you are here for the feast pig."
    },
    {
      "i": 6,
      "start": 32.0,
      "end": 36.0,
      "text": "We're going to eat you for lunch."
    },
    {
      "i": 7,
      "start": 38.0,
      "end": 39.0,
      "text": "What?"
    },
    {
      "i": 8,
      "start": 39.0,
      "end": 43.0,
      "text": "Bajay raised his rake and swung as the monster approached."
    },
    {
      "i": 9,
      "start": 44.0,
      "end": 47.0,
      "text": "The demons rushed toward the pig from all sides."
    },
    {
      "i": 10,
      "start": 48.0,
      "end": 51.0,
      "text": "That rotten monkey lied to me!"
    },
    {
      "i": 11,
      "start": 51.0,
      "end": 52.0,
      "text": "Pride, Bajay."
    },
    {
      "i": 12,
      "start": 52.0,
      "end": 56.0,
      "text": "He spun around and knocked over two demons with his rake."
    },
    {
      "i": 13,
      "start": 56.0,
      "end": 58.0,
      "text": "The monster threw a punch."
    },
    {
      "i": 14,
      "start": 58.0,
      "end": 61.0,
      "text": "Bajay blocked the punch with his rake."
    },
    {
      "i": 15,
      "start": 61.0,
      "end": 65.0,
      "text": "Pride the monster rubbing his hand."
    },
    {
      "i": 16,
      "start": 65.0,
      "end": 69.0,
      "text": "Bajay kicked a demon sneaking up behind him."
    },
    {
      "i": 17,
      "start": 69.0,
      "end": 73.0,
      "text": "That monkey is always causing problems."
    },
    {
      "i": 18,
      "start": 73.0,
      "end": 74.0,
      "text": "The pig muttered."
    },
    {
      "i": 19,
      "start": 74.0,
      "end": 78.0,
      "text": "He slammed the rake down on another demon."
    },
    {
      "i": 20,
      "start": 78.0,
      "end": 80.0,
      "text": "So what if I'd like to eat?"
    },
    {
      "i": 21,
      "start": 80.0,
      "end": 83.0,
      "text": "Did he really have to trick me?"
    },
    {
      "i": 22,
      "start": 84.0,
      "end": 86.0,
      "text": "The monster attacked again."
    },
    {
      "i": 23,
      "start": 86.0,
      "end": 91.0,
      "text": "Bajay thrust his rake toward him, still complaining about Wukong."
    },
    {
      "i": 24,
      "start": 91.0,
      "end": 93.0,
      "text": "Wukong is small."
    },
    {
      "i": 25,
      "start": 93.0,
      "end": 96.0,
      "text": "He doesn't need to eat as much as I do."
    },
    {
      "i": 26,
      "start": 96.0,
      "end": 101.0,
      "text": "The monster suddenly stopped fighting and looked at Bajay curiously."
    },
    {
      "i": 27,
      "start": 101.0,
      "end": 104.0,
      "text": "You just said Wukong."
    },
    {
      "i": 28,
      "start": 104.0,
      "end": 107.0,
      "text": "Are you talking about Sun Wukong?"
    },
    {
      "i": 29,
      "start": 107.0,
      "end": 112.0,
      "text": "The monkey who defeated Heaven's entire army 500 years ago."
    },
    {
      "i": 30,
      "start": 113.0,
      "end": 114.0,
      "text": "Yes."
    },
    {
      "i": 31,
      "start": 114.0,
      "end": 115.0,
      "text": "Said Bajay."
    },
    {
      "i": 32,
      "start": 115.0,
      "end": 117.0,
      "text": "Do you know him?"
    },
    {
      "i": 33,
      "start": 117.0,
      "end": 121.0,
      "text": "I've heard he's traveling with the Chang monk."
    },
    {
      "i": 34,
      "start": 121.0,
      "end": 122.0,
      "text": "Said the monster."
    },
    {
      "i": 35,
      "start": 122.0,
      "end": 126.0,
      "text": "You must be traveling with the Chang monk too."
    },
    {
      "i": 36,
      "start": 126.0,
      "end": 129.0,
      "text": "Why are you interested in the monk?"
    },
    {
      "i": 37,
      "start": 129.0,
      "end": 131.0,
      "text": "Asked Bajay suspiciously."
    },
    {
      "i": 38,
      "start": 131.0,
      "end": 134.0,
      "text": "The monster licked his lips."
    },
    {
      "i": 39,
      "start": 134.0,
      "end": 140.0,
      "text": "I've heard that anyone who eats the Chang monk will live forever."
    },
    {
      "i": 40,
      "start": 140.0,
      "end": 141.0,
      "text": "Panit."
    },
    {
      "i": 41,
      "start": 141.0,
      "end": 145.0,
      "text": "Bajay ran from the demons and back to his companions."
    },
    {
      "i": 42,
      "start": 145.0,
      "end": 147.0,
      "text": "He pointed at Wukong."
    },
    {
      "i": 43,
      "start": 147.0,
      "end": 149.0,
      "text": "You tricked me."
    },
    {
      "i": 44,
      "start": 149.0,
      "end": 151.0,
      "text": "The monkey was..."
    }
  ]
}
