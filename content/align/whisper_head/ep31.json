{
  "episode": 31,
  "source": "assets/video/ep31.mp4",
  "model": "base",
  "duration": 317.9973125,
  "segments": [
    {
      "i": 1,
      "start": 0.0,
      "end": 24.0,
      "text": "The two priests pushed the Tang monk toward the enormous frying pan."
    },
    {
      "i": 2,
      "start": 24.0,
      "end": 31.0,
      "text": "The priest stopped. The great immortal looked around."
    },
    {
      "i": 3,
      "start": 31.0,
      "end": 35.0,
      "text": "The king appeared and landed on the floor."
    },
    {
      "i": 4,
      "start": 35.0,
      "end": 37.0,
      "text": "You came back!"
    },
    {
      "i": 5,
      "start": 37.0,
      "end": 41.0,
      "text": "I was here the whole time."
    },
    {
      "i": 6,
      "start": 41.0,
      "end": 45.0,
      "text": "He gave Bajan nasty look."
    },
    {
      "i": 7,
      "start": 45.0,
      "end": 48.0,
      "text": "I didn't escape without you."
    },
    {
      "i": 8,
      "start": 48.0,
      "end": 51.0,
      "text": "The king turned to the great immortal."
    },
    {
      "i": 9,
      "start": 51.0,
      "end": 53.0,
      "text": "Please don't harm the Tang monk."
    },
    {
      "i": 10,
      "start": 53.0,
      "end": 56.0,
      "text": "He said, I will fix your ginseng tree."
    },
    {
      "i": 11,
      "start": 56.0,
      "end": 58.0,
      "text": "But I need to get help."
    },
    {
      "i": 12,
      "start": 58.0,
      "end": 60.0,
      "text": "He's lying."
    },
    {
      "i": 13,
      "start": 60.0,
      "end": 61.0,
      "text": "Said Bajan."
    },
    {
      "i": 14,
      "start": 61.0,
      "end": 64.0,
      "text": "He doesn't know how to fix the tree."
    },
    {
      "i": 15,
      "start": 64.0,
      "end": 66.0,
      "text": "Be quiet, Bajan."
    },
    {
      "i": 16,
      "start": 66.0,
      "end": 67.0,
      "text": "Said Wukong."
    },
    {
      "i": 17,
      "start": 67.0,
      "end": 69.0,
      "text": "I'm not lying."
    },
    {
      "i": 18,
      "start": 69.0,
      "end": 73.0,
      "text": "The great immortal thought for a moment."
    },
    {
      "i": 19,
      "start": 73.0,
      "end": 75.0,
      "text": "Okay, Wukong."
    },
    {
      "i": 20,
      "start": 75.0,
      "end": 79.0,
      "text": "I will give you until the end of the day to fix my ginseng tree."
    },
    {
      "i": 21,
      "start": 80.0,
      "end": 84.0,
      "text": "If you can't, the Tang monk goes into the frying pan."
    },
    {
      "i": 22,
      "start": 84.0,
      "end": 87.0,
      "text": "The monk shook with fear."
    },
    {
      "i": 23,
      "start": 87.0,
      "end": 89.0,
      "text": "Don't worry, master."
    },
    {
      "i": 24,
      "start": 89.0,
      "end": 90.0,
      "text": "Said the monkey."
    },
    {
      "i": 25,
      "start": 90.0,
      "end": 93.0,
      "text": "I will find help. I'll be back as soon as I can."
    },
    {
      "i": 26,
      "start": 93.0,
      "end": 97.0,
      "text": "Wukong shot out of the abbey and was gone."
    },
    {
      "i": 27,
      "start": 97.0,
      "end": 100.0,
      "text": "Bajan shook his head."
    },
    {
      "i": 28,
      "start": 100.0,
      "end": 102.0,
      "text": "We're doomed."
    },
    {
      "i": 29,
      "start": 102.0,
      "end": 108.0,
      "text": "Wukong saw it through the air until he came to Mount Portalaka."
    },
    {
      "i": 30,
      "start": 108.0,
      "end": 112.0,
      "text": "Guanyin was meditating in her pagoda."
    },
    {
      "i": 31,
      "start": 112.0,
      "end": 113.0,
      "text": "What does that mean?"
    },
    {
      "i": 32,
      "start": 113.0,
      "end": 115.0,
      "text": "Cride the monkey."
    },
    {
      "i": 33,
      "start": 115.0,
      "end": 116.0,
      "text": "I need your help."
    },
    {
      "i": 34,
      "start": 116.0,
      "end": 119.0,
      "text": "A dallas named the great immortal is going to fry the Tang monk."
    },
    {
      "i": 35,
      "start": 119.0,
      "end": 123.0,
      "text": "I haven't till the end of the day to fix his ginseng tree."
    },
    {
      "i": 36,
      "start": 123.0,
      "end": 126.0,
      "text": "What happened to the tree?"
    },
    {
      "i": 37,
      "start": 126.0,
      "end": 127.0,
      "text": "Ask Guanyin."
    },
    {
      "i": 38,
      "start": 127.0,
      "end": 131.0,
      "text": "She gave the monkey a suspicious look."
    },
    {
      "i": 39,
      "start": 131.0,
      "end": 134.0,
      "text": "Bite, um. Knock it down."
    },
    {
      "i": 40,
      "start": 134.0,
      "end": 136.0,
      "text": "Said Wukong."
    },
    {
      "i": 41,
      "start": 136.0,
      "end": 139.0,
      "text": "That was a terrible thing to do, Wukong."
    },
    {
      "i": 42,
      "start": 139.0,
      "end": 141.0,
      "text": "Said Guanyin."
    },
    {
      "i": 43,
      "start": 141.0,
      "end": 146.0,
      "text": "The great immortal's ginseng tree is older than heaven and earth."
    },
    {
      "i": 44,
      "start": 146.0,
      "end": 148.0,
      "text": "It was a rare treasure."
    },
    {
      "i": 45,
      "start": 148.0,
      "end": 150.0,
      "text": "The monkey shrugged."
    }
  ]
}
