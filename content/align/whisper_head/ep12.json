{
  "episode": 12,
  "source": "assets/video/ep12.mp4",
  "model": "base",
  "duration": 333.7171875,
  "segments": [
    {
      "i": 1,
      "start": 0.0,
      "end": 7.0,
      "text": "Journey to the West, Chapter 12, The Bet."
    },
    {
      "i": 2,
      "start": 11.6,
      "end": 13.8,
      "text": "Buddha smiled at Wukong."
    },
    {
      "i": 3,
      "start": 13.8,
      "end": 17.8,
      "text": "How did you get so powerful?"
    },
    {
      "i": 4,
      "start": 17.8,
      "end": 19.8,
      "text": "A sage taught me secret formulas."
    },
    {
      "i": 5,
      "start": 19.8,
      "end": 21.8,
      "text": "Said Wukong."
    },
    {
      "i": 6,
      "start": 24.8,
      "end": 27.64,
      "text": "I practiced them for many years."
    },
    {
      "i": 7,
      "start": 27.64,
      "end": 30.76,
      "text": "I am now equal to the Jade Emperor."
    },
    {
      "i": 8,
      "start": 30.76,
      "end": 35.76,
      "text": "The Jade Emperor has been practicing the same formulas for many lifetimes."
    },
    {
      "i": 9,
      "start": 35.76,
      "end": 37.76,
      "text": "Said Buddha."
    },
    {
      "i": 10,
      "start": 37.76,
      "end": 41.04,
      "text": "How can you think you're equal to him?"
    },
    {
      "i": 11,
      "start": 41.04,
      "end": 45.48,
      "text": "Go back to your mountain now and behave yourself."
    },
    {
      "i": 12,
      "start": 45.48,
      "end": 46.48,
      "text": "Now."
    },
    {
      "i": 13,
      "start": 46.48,
      "end": 47.96,
      "text": "Said Wukong."
    },
    {
      "i": 14,
      "start": 47.96,
      "end": 51.64,
      "text": "I'm not leaving until I get to rule heaven."
    },
    {
      "i": 15,
      "start": 51.64,
      "end": 54.56,
      "text": "Buddha thought for a minute."
    },
    {
      "i": 16,
      "start": 54.56,
      "end": 59.72,
      "text": "Then Wukong, what powers do you have?"
    },
    {
      "i": 17,
      "start": 59.72,
      "end": 61.56,
      "text": "I can change into other animals."
    },
    {
      "i": 18,
      "start": 61.56,
      "end": 63.0,
      "text": "Said Wukong."
    },
    {
      "i": 19,
      "start": 63.0,
      "end": 65.76,
      "text": "I can soar through the sky on clouds."
    },
    {
      "i": 20,
      "start": 65.76,
      "end": 69.24,
      "text": "I can do anything I want."
    },
    {
      "i": 21,
      "start": 69.24,
      "end": 70.72,
      "text": "Then let's make a bet."
    },
    {
      "i": 22,
      "start": 70.72,
      "end": 72.32,
      "text": "Said Buddha."
    },
    {
      "i": 23,
      "start": 72.32,
      "end": 76.4,
      "text": "If you win, you can rule heaven."
    },
    {
      "i": 24,
      "start": 76.4,
      "end": 81.72,
      "text": "The Jade Emperor will come to live with me in the Western Paradise."
    },
    {
      "i": 25,
      "start": 81.72,
      "end": 86.6,
      "text": "But if you lose, you will be punished severely."
    },
    {
      "i": 26,
      "start": 86.6,
      "end": 87.6,
      "text": "What do I have to do?"
    },
    {
      "i": 27,
      "start": 87.6,
      "end": 90.12,
      "text": "Asked Wukong."
    },
    {
      "i": 28,
      "start": 90.12,
      "end": 91.12,
      "text": "It's simple."
    },
    {
      "i": 29,
      "start": 91.12,
      "end": 92.88,
      "text": "Said Buddha."
    },
    {
      "i": 30,
      "start": 92.88,
      "end": 95.68,
      "text": "He held out his hand."
    },
    {
      "i": 31,
      "start": 95.68,
      "end": 100.92,
      "text": "You just have to jump off my hand."
    },
    {
      "i": 32,
      "start": 100.92,
      "end": 103.64,
      "text": "Wukong laughed."
    },
    {
      "i": 33,
      "start": 103.64,
      "end": 104.64,
      "text": "That's easy."
    },
    {
      "i": 34,
      "start": 104.64,
      "end": 108.12,
      "text": "I can jump across entire oceans."
    },
    {
      "i": 35,
      "start": 108.12,
      "end": 109.64,
      "text": "Buddha smiled."
    },
    {
      "i": 36,
      "start": 109.64,
      "end": 117.88,
      "text": "Well then, let's see you do it."
    },
    {
      "i": 37,
      "start": 117.88,
      "end": 121.44,
      "text": "Wukong stepped up onto Buddha's palm."
    },
    {
      "i": 38,
      "start": 121.44,
      "end": 123.52,
      "text": "You're a fool."
    },
    {
      "i": 39,
      "start": 123.52,
      "end": 125.4,
      "text": "He said to Buddha."
    },
    {
      "i": 40,
      "start": 125.4,
      "end": 129.12,
      "text": "I'm going to jump farther than you could ever imagine."
    },
    {
      "i": 41,
      "start": 129.12,
      "end": 132.8,
      "text": "When I return, I'll be the ruler of heaven."
    },
    {
      "i": 42,
      "start": 132.8,
      "end": 139.56,
      "text": "Wukong leaped and soared through the air."
    },
    {
      "i": 43,
      "start": 139.56,
      "end": 144.52,
      "text": "After a long time, he saw five enormous pillars."
    },
    {
      "i": 44,
      "start": 144.52,
      "end": 147.48,
      "text": "He landed in front of them."
    },
    {
      "i": 45,
      "start": 147.48,
      "end": 149.04,
      "text": "This must be the end of the world."
    },
    {
      "i": 46,
      "start": 149.04,
      "end": 149.96,
      "text": "He said to himself."
    }
  ]
}
