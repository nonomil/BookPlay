{
  "episode": 24,
  "source": "assets/video/ep24.mp4",
  "model": "base",
  "duration": 335.1800625,
  "segments": [
    {
      "i": 1,
      "start": 0.0,
      "end": 7.0,
      "text": "Journey to the West, Chapter 24, the Great King Yellow Wind."
    },
    {
      "i": 2,
      "start": 12.0,
      "end": 17.0,
      "text": "Wukong and Bajie looked all around, but the Tang monk was gone."
    },
    {
      "i": 3,
      "start": 17.0,
      "end": 19.0,
      "text": "That tiger ate our master."
    },
    {
      "i": 4,
      "start": 19.0,
      "end": 23.0,
      "text": "Said Bajie. He shrugged."
    },
    {
      "i": 5,
      "start": 23.0,
      "end": 28.0,
      "text": "I guess we don't have to protect him anymore. Goodbye, Wukong."
    },
    {
      "i": 6,
      "start": 29.0,
      "end": 34.0,
      "text": "The pig started to walk away, but Wukong grabbed him."
    },
    {
      "i": 7,
      "start": 34.0,
      "end": 35.0,
      "text": "You're not leaving?"
    },
    {
      "i": 8,
      "start": 35.0,
      "end": 37.0,
      "text": "Said the monkey."
    },
    {
      "i": 9,
      "start": 37.0,
      "end": 39.0,
      "text": "We have to save our master."
    },
    {
      "i": 10,
      "start": 39.0,
      "end": 44.0,
      "text": "That tiger said he works for a demon, the Great King Yellow Wind."
    },
    {
      "i": 11,
      "start": 44.0,
      "end": 47.0,
      "text": "The king's cave must be nearby."
    },
    {
      "i": 12,
      "start": 50.0,
      "end": 53.0,
      "text": "The tiger entered his master's cave."
    },
    {
      "i": 13,
      "start": 53.0,
      "end": 57.0,
      "text": "The Tang monk was slumped over the tiger's shoulder."
    },
    {
      "i": 14,
      "start": 58.0,
      "end": 62.0,
      "text": "The Great King Yellow Wind was sitting on his throne."
    },
    {
      "i": 15,
      "start": 62.0,
      "end": 64.0,
      "text": "Great King."
    },
    {
      "i": 16,
      "start": 64.0,
      "end": 65.0,
      "text": "Cried the tiger."
    },
    {
      "i": 17,
      "start": 65.0,
      "end": 68.0,
      "text": "I found the Tang monk."
    },
    {
      "i": 18,
      "start": 68.0,
      "end": 72.0,
      "text": "The demon king looked surprised and happy."
    },
    {
      "i": 19,
      "start": 72.0,
      "end": 77.0,
      "text": "I have heard that anyone who eats the Tang monk will live forever."
    },
    {
      "i": 20,
      "start": 77.0,
      "end": 79.0,
      "text": "Was the monk alone?"
    },
    {
      "i": 21,
      "start": 79.0,
      "end": 82.0,
      "text": "He had two companions."
    },
    {
      "i": 22,
      "start": 82.0,
      "end": 83.0,
      "text": "Said the tiger."
    },
    {
      "i": 23,
      "start": 83.0,
      "end": 87.0,
      "text": "What is the pig? The other is a monkey."
    },
    {
      "i": 24,
      "start": 88.0,
      "end": 90.0,
      "text": "Yellow Wind trembled."
    },
    {
      "i": 25,
      "start": 90.0,
      "end": 92.0,
      "text": "A monkey."
    },
    {
      "i": 26,
      "start": 92.0,
      "end": 93.0,
      "text": "He said."
    },
    {
      "i": 27,
      "start": 93.0,
      "end": 95.0,
      "text": "He must be Shang Wukong."
    },
    {
      "i": 28,
      "start": 95.0,
      "end": 99.0,
      "text": "The monkey who caused all that trouble in heaven."
    },
    {
      "i": 29,
      "start": 99.0,
      "end": 100.0,
      "text": "Maybe."
    },
    {
      "i": 30,
      "start": 100.0,
      "end": 102.0,
      "text": "Said the tiger."
    },
    {
      "i": 31,
      "start": 102.0,
      "end": 104.0,
      "text": "But don't worry."
    },
    {
      "i": 32,
      "start": 104.0,
      "end": 108.0,
      "text": "I distracted them with a fake tiger skin."
    },
    {
      "i": 33,
      "start": 108.0,
      "end": 111.0,
      "text": "They'll never find us."
    },
    {
      "i": 34,
      "start": 111.0,
      "end": 115.0,
      "text": "The tiger padded his stomach and looked at the Tang monk."
    },
    {
      "i": 35,
      "start": 115.0,
      "end": 120.0,
      "text": "I'll tell the other demons to start a fire and prepare some spices."
    },
    {
      "i": 36,
      "start": 120.0,
      "end": 124.0,
      "text": "Yellow Wind held up his hand."
    },
    {
      "i": 37,
      "start": 124.0,
      "end": 127.0,
      "text": "Shang Wukong is powerful."
    },
    {
      "i": 38,
      "start": 127.0,
      "end": 131.0,
      "text": "He and that pig might come looking for the monk."
    },
    {
      "i": 39,
      "start": 131.0,
      "end": 134.0,
      "text": "They'll be angry if they find out we ate him."
    },
    {
      "i": 40,
      "start": 134.0,
      "end": 138.0,
      "text": "Let's wait until they leave the area."
    },
    {
      "i": 41,
      "start": 138.0,
      "end": 142.0,
      "text": "Then we'll be able to enjoy our meal."
    },
    {
      "i": 42,
      "start": 142.0,
      "end": 147.0,
      "text": "A small demon ran into the throne room."
    },
    {
      "i": 43,
      "start": 147.0,
      "end": 149.0,
      "text": "Great King!"
    },
    {
      "i": 44,
      "start": 149.0,
      "end": 150.0,
      "text": "Cry the demon."
    }
  ]
}
