{
  "episode": 37,
  "source": "assets/video/ep37.mp4",
  "model": "base",
  "duration": 305.7139375,
  "segments": [
    {
      "i": 1,
      "start": 0.0,
      "end": 7.0,
      "text": "Journey to the West, Chapter 37, Missing from Heaven."
    },
    {
      "i": 2,
      "start": 14.0,
      "end": 15.0,
      "text": "Who are you?"
    },
    {
      "i": 3,
      "start": 15.0,
      "end": 17.0,
      "text": "The monster asked the monkey."
    },
    {
      "i": 4,
      "start": 17.0,
      "end": 20.0,
      "text": "What are you doing here?"
    },
    {
      "i": 5,
      "start": 20.0,
      "end": 24.0,
      "text": "I am Sun Wu Kong, King of the Fruit and Flower Mountain."
    },
    {
      "i": 6,
      "start": 24.0,
      "end": 26.0,
      "text": "Said the monkey."
    },
    {
      "i": 7,
      "start": 26.0,
      "end": 29.0,
      "text": "I'm helping the Tang monk reach the Western Paradise."
    },
    {
      "i": 8,
      "start": 29.0,
      "end": 33.0,
      "text": "500 years ago, I caused a lot of trouble in Heaven."
    },
    {
      "i": 9,
      "start": 33.0,
      "end": 36.0,
      "text": "Now I'm here to cause a lot of trouble for you."
    },
    {
      "i": 10,
      "start": 36.0,
      "end": 39.0,
      "text": "I remember you."
    },
    {
      "i": 11,
      "start": 39.0,
      "end": 41.0,
      "text": "Said the monster."
    },
    {
      "i": 12,
      "start": 41.0,
      "end": 45.0,
      "text": "Wu Kong pulled out his iron bar and swung it."
    },
    {
      "i": 13,
      "start": 45.0,
      "end": 46.0,
      "text": "Koof!"
    },
    {
      "i": 14,
      "start": 46.0,
      "end": 49.0,
      "text": "The monster vanished."
    },
    {
      "i": 15,
      "start": 52.0,
      "end": 55.0,
      "text": "Wu Kong leaped into the air."
    },
    {
      "i": 16,
      "start": 56.0,
      "end": 60.0,
      "text": "He looked in every direction but didn't see the monster anywhere."
    },
    {
      "i": 17,
      "start": 60.0,
      "end": 62.0,
      "text": "That monster said he remembered me."
    },
    {
      "i": 18,
      "start": 62.0,
      "end": 64.0,
      "text": "Thought Wu Kong."
    },
    {
      "i": 19,
      "start": 66.0,
      "end": 68.0,
      "text": "He must be from Heaven."
    },
    {
      "i": 20,
      "start": 68.0,
      "end": 72.0,
      "text": "I'll go up there now to see if any spirits are missing."
    },
    {
      "i": 21,
      "start": 73.0,
      "end": 78.0,
      "text": "Wu Kong soared higher and higher until he reached the Southern Gate of Heaven."
    },
    {
      "i": 22,
      "start": 78.0,
      "end": 80.0,
      "text": "Greetings, Wu Kong."
    },
    {
      "i": 23,
      "start": 80.0,
      "end": 81.0,
      "text": "Said the guard."
    },
    {
      "i": 24,
      "start": 82.0,
      "end": 85.0,
      "text": "There's a monster on Earth causing trouble for the Tang monk."
    },
    {
      "i": 25,
      "start": 85.0,
      "end": 86.0,
      "text": "Said Wu Kong."
    },
    {
      "i": 26,
      "start": 86.0,
      "end": 90.0,
      "text": "I think the monster is a spirit who escaped from Heaven."
    },
    {
      "i": 27,
      "start": 90.0,
      "end": 92.0,
      "text": "Is anyone missing?"
    },
    {
      "i": 28,
      "start": 92.0,
      "end": 95.0,
      "text": "The guard sent a messenger to check."
    },
    {
      "i": 29,
      "start": 96.0,
      "end": 98.0,
      "text": "A moment later, the messenger returned."
    },
    {
      "i": 30,
      "start": 98.0,
      "end": 101.0,
      "text": "A god was with him."
    },
    {
      "i": 31,
      "start": 101.0,
      "end": 104.0,
      "text": "You found the Ward Wolf Star."
    },
    {
      "i": 32,
      "start": 104.0,
      "end": 106.0,
      "text": "Said the god."
    },
    {
      "i": 33,
      "start": 106.0,
      "end": 107.0,
      "text": "Who?"
    },
    {
      "i": 34,
      "start": 107.0,
      "end": 109.0,
      "text": "Asked Wu Kong."
    },
    {
      "i": 35,
      "start": 109.0,
      "end": 113.0,
      "text": "The Ward Wolf Star is a wolf spirit who lives in Heaven."
    },
    {
      "i": 36,
      "start": 113.0,
      "end": 114.0,
      "text": "Said the god."
    },
    {
      "i": 37,
      "start": 114.0,
      "end": 117.0,
      "text": "He escaped 13 days ago."
    },
    {
      "i": 38,
      "start": 117.0,
      "end": 120.0,
      "text": "And I've been looking all over for him."
    },
    {
      "i": 39,
      "start": 121.0,
      "end": 123.0,
      "text": "Wu Kong rubbed his chin."
    },
    {
      "i": 40,
      "start": 123.0,
      "end": 125.0,
      "text": "That makes sense."
    },
    {
      "i": 41,
      "start": 125.0,
      "end": 126.0,
      "text": "He said."
    },
    {
      "i": 42,
      "start": 126.0,
      "end": 129.0,
      "text": "The monster kidnapped a princess 13 years ago on Earth."
    },
    {
      "i": 43,
      "start": 129.0,
      "end": 133.0,
      "text": "13 years on Earth is equal to 13 days in Heaven."
    },
    {
      "i": 44,
      "start": 133.0,
      "end": 135.0,
      "text": "The god nodded."
    },
    {
      "i": 45,
      "start": 135.0,
      "end": 137.0,
      "text": "Yes, let's go."
    },
    {
      "i": 46,
      "start": 137.0,
      "end": 141.0,
      "text": "I'll help you catch the Ward Wolf Star."
    },
    {
      "i": 47,
      "start": 142.0,
      "end": 146.0,
      "text": "Wu Kong returned to Earth with the god."
    },
    {
      "i": 48,
      "start": 146.0,
      "end": 149.0,
      "text": "From the sky, the god called down."
    },
    {
      "i": 49,
      "start": 149.0,
      "end": 151.0,
      "text": "Ward Wolf."
    }
  ]
}
