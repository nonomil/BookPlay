{
  "episode": 23,
  "source": "assets/video/ep23.mp4",
  "model": "base",
  "duration": 309.4059375,
  "segments": [
    {
      "i": 1,
      "start": 0.0,
      "end": 3.76,
      "text": "Journey to the West."
    },
    {
      "i": 2,
      "start": 3.76,
      "end": 5.36,
      "text": "Chapter 23."
    },
    {
      "i": 3,
      "start": 5.36,
      "end": 13.04,
      "text": "Great Protectors."
    },
    {
      "i": 4,
      "start": 13.04,
      "end": 17.32,
      "text": "The creature had a pig snout and ears."
    },
    {
      "i": 5,
      "start": 17.32,
      "end": 19.96,
      "text": "But he ran on two legs like a person."
    },
    {
      "i": 6,
      "start": 19.96,
      "end": 22.28,
      "text": "He swung the rake again."
    },
    {
      "i": 7,
      "start": 22.28,
      "end": 25.24,
      "text": "Wukong blocked the rake with his iron bar."
    },
    {
      "i": 8,
      "start": 25.24,
      "end": 26.24,
      "text": "Clang!"
    },
    {
      "i": 9,
      "start": 26.24,
      "end": 29.56,
      "text": "Then he swung the bar at the pig's feet."
    },
    {
      "i": 10,
      "start": 30.56,
      "end": 32.0,
      "text": "Cride the pig."
    },
    {
      "i": 11,
      "start": 32.0,
      "end": 34.8,
      "text": "He fell face down in the dirt."
    },
    {
      "i": 12,
      "start": 34.8,
      "end": 36.48,
      "text": "He jumped back up."
    },
    {
      "i": 13,
      "start": 36.48,
      "end": 39.88,
      "text": "You'll wish you hadn't done that."
    },
    {
      "i": 14,
      "start": 39.88,
      "end": 44.12,
      "text": "Wukong leaked out of the way as the pig's rake slammed down,"
    },
    {
      "i": 15,
      "start": 44.12,
      "end": 45.16,
      "text": "smashing a boulder."
    },
    {
      "i": 16,
      "start": 49.16,
      "end": 51.52,
      "text": "The two fought, kicking up dust and rocks."
    },
    {
      "i": 17,
      "start": 54.72,
      "end": 57.76,
      "text": "The Tang monk hid behind his horse."
    },
    {
      "i": 18,
      "start": 57.76,
      "end": 59.56,
      "text": "Surrender now."
    },
    {
      "i": 19,
      "start": 59.56,
      "end": 62.68,
      "text": "Wukong swung his iron bar again."
    },
    {
      "i": 20,
      "start": 62.68,
      "end": 64.8,
      "text": "I am Sun Wukong."
    },
    {
      "i": 21,
      "start": 64.8,
      "end": 68.72,
      "text": "500 years ago, I caused lots of trouble in heaven."
    },
    {
      "i": 22,
      "start": 68.72,
      "end": 73.28,
      "text": "The Jade Emperor's entire army couldn't stop me."
    },
    {
      "i": 23,
      "start": 73.28,
      "end": 74.4,
      "text": "I've heard of you."
    },
    {
      "i": 24,
      "start": 74.4,
      "end": 75.8,
      "text": "Said the pig."
    },
    {
      "i": 25,
      "start": 75.8,
      "end": 78.6,
      "text": "But you don't seem so powerful to me."
    },
    {
      "i": 26,
      "start": 78.6,
      "end": 81.36,
      "text": "He lunged at the monkey again."
    },
    {
      "i": 27,
      "start": 81.36,
      "end": 83.8,
      "text": "Wukong jumped out of the way."
    },
    {
      "i": 28,
      "start": 83.8,
      "end": 85.48,
      "text": "I thought you were being punished."
    },
    {
      "i": 29,
      "start": 85.48,
      "end": 86.84,
      "text": "Said the pig."
    },
    {
      "i": 30,
      "start": 86.84,
      "end": 89.0,
      "text": "He swung his rake again."
    },
    {
      "i": 31,
      "start": 89.0,
      "end": 91.72,
      "text": "Where'd you trapped under a mountain?"
    },
    {
      "i": 32,
      "start": 91.72,
      "end": 92.8,
      "text": "I'm free now."
    },
    {
      "i": 33,
      "start": 92.8,
      "end": 94.32,
      "text": "Said Wukong."
    },
    {
      "i": 34,
      "start": 94.32,
      "end": 98.44,
      "text": "I'm going to the west with the Tang monk to the Tang monk."
    },
    {
      "i": 35,
      "start": 98.44,
      "end": 99.8,
      "text": "Cride the pig."
    },
    {
      "i": 36,
      "start": 99.8,
      "end": 102.08,
      "text": "He dropped his rake."
    },
    {
      "i": 37,
      "start": 102.08,
      "end": 104.6,
      "text": "I'm supposed to go with him too."
    },
    {
      "i": 38,
      "start": 104.6,
      "end": 105.48,
      "text": "You are?"
    },
    {
      "i": 39,
      "start": 105.48,
      "end": 107.92,
      "text": "Asked Wukong."
    },
    {
      "i": 40,
      "start": 107.92,
      "end": 110.28,
      "text": "I was sent to Earth as a punishment."
    },
    {
      "i": 41,
      "start": 110.28,
      "end": 111.72,
      "text": "Said the pig."
    },
    {
      "i": 42,
      "start": 111.72,
      "end": 115.68,
      "text": "My name is Zuba Jay."
    },
    {
      "i": 43,
      "start": 115.68,
      "end": 118.52,
      "text": "I caused trouble in heaven too."
    },
    {
      "i": 44,
      "start": 118.52,
      "end": 122.68,
      "text": "Guanyin said I would be forgiven if I helped protect the Tang monk."
    },
    {
      "i": 45,
      "start": 125.88,
      "end": 127.92,
      "text": "Wukong rubbed his chin."
    },
    {
      "i": 46,
      "start": 127.92,
      "end": 129.24,
      "text": "OK."
    },
    {
      "i": 47,
      "start": 129.24,
      "end": 134.32,
      "text": "He said, you can carry the bags."
    },
    {
      "i": 48,
      "start": 134.32,
      "end": 139.76,
      "text": "Zuba Jay joined the group and the three of them continued west."
    },
    {
      "i": 49,
      "start": 139.76,
      "end": 143.84,
      "text": "As they traveled, the pig kept complaining."
    },
    {
      "i": 50,
      "start": 143.84,
      "end": 147.44,
      "text": "These bags are so heavy."
    },
    {
      "i": 51,
      "start": 147.44,
      "end": 149.8,
      "text": "Do we really need to bring them?"
    }
  ]
}
