{
  "episode": 79,
  "source": "assets/video/ep79.mp4",
  "model": "base",
  "duration": 298.30675,
  "segments": [
    {
      "i": 1,
      "start": 0.0,
      "end": 7.0,
      "text": "Journey to the West, Chapter 79, The Mountain of Flames."
    },
    {
      "i": 2,
      "start": 13.5,
      "end": 15.3,
      "text": "Wukong was furious."
    },
    {
      "i": 3,
      "start": 15.3,
      "end": 18.0,
      "text": "The Bull Demon King tricked me!"
    },
    {
      "i": 4,
      "start": 19.0,
      "end": 22.3,
      "text": "The monkey rushed back to the cave and smashed the door."
    },
    {
      "i": 5,
      "start": 22.3,
      "end": 23.3,
      "text": "Crash!"
    },
    {
      "i": 6,
      "start": 25.1,
      "end": 27.4,
      "text": "The Bull Demon King ran outside."
    },
    {
      "i": 7,
      "start": 28.0,
      "end": 29.8,
      "text": "You villain!"
    },
    {
      "i": 8,
      "start": 29.8,
      "end": 30.8,
      "text": "He shouted."
    },
    {
      "i": 9,
      "start": 30.8,
      "end": 33.3,
      "text": "You destroyed my door!"
    },
    {
      "i": 10,
      "start": 33.3,
      "end": 35.8,
      "text": "Give me that fan right now!"
    },
    {
      "i": 11,
      "start": 35.8,
      "end": 37.3,
      "text": "Yeld Wukong."
    },
    {
      "i": 12,
      "start": 37.3,
      "end": 40.3,
      "text": "Or I'll destroy the rest of your mountain!"
    },
    {
      "i": 13,
      "start": 41.3,
      "end": 42.3,
      "text": "Never!"
    },
    {
      "i": 14,
      "start": 42.3,
      "end": 43.8,
      "text": "Said the demon."
    },
    {
      "i": 15,
      "start": 44.8,
      "end": 47.3,
      "text": "Wukong charged toward the demon."
    },
    {
      "i": 16,
      "start": 48.8,
      "end": 52.8,
      "text": "Hoof! The demon turned into a crane and flew away!"
    },
    {
      "i": 17,
      "start": 52.8,
      "end": 55.8,
      "text": "He's not the only one who can turn into other animals."
    },
    {
      "i": 18,
      "start": 55.8,
      "end": 57.8,
      "text": "Thought the monkey."
    },
    {
      "i": 19,
      "start": 58.8,
      "end": 62.3,
      "text": "Wukong turned into a Phoenix and shot after the crane."
    },
    {
      "i": 20,
      "start": 64.3,
      "end": 67.8,
      "text": "With his claws out, he swooped down at the crane."
    },
    {
      "i": 21,
      "start": 67.8,
      "end": 71.3,
      "text": "The crane dipped lower and Wukong missed."
    },
    {
      "i": 22,
      "start": 71.3,
      "end": 75.3,
      "text": "When Wukong looked back, the crane was gone."
    },
    {
      "i": 23,
      "start": 75.3,
      "end": 76.8,
      "text": "Where did he go?"
    },
    {
      "i": 24,
      "start": 76.8,
      "end": 78.3,
      "text": "Thought Wukong."
    },
    {
      "i": 25,
      "start": 78.3,
      "end": 81.8,
      "text": "He looked down and saw an antelope grazing in a field."
    },
    {
      "i": 26,
      "start": 81.8,
      "end": 83.3,
      "text": "That's him!"
    },
    {
      "i": 27,
      "start": 84.3,
      "end": 87.3,
      "text": "Wukong landed and turned into a tiger."
    },
    {
      "i": 28,
      "start": 87.8,
      "end": 89.8,
      "text": "He crept through the tall grass."
    },
    {
      "i": 29,
      "start": 91.3,
      "end": 93.8,
      "text": "When he got close to the antelope, he leaked."
    },
    {
      "i": 30,
      "start": 95.8,
      "end": 100.3,
      "text": "Light flashed and the antelope turned into a huge white bull."
    },
    {
      "i": 31,
      "start": 101.8,
      "end": 105.3,
      "text": "The bull flew up into the sky and Wukong followed."
    },
    {
      "i": 32,
      "start": 106.3,
      "end": 109.3,
      "text": "He had almost caught up to the bull when he heard a shout."
    },
    {
      "i": 33,
      "start": 109.8,
      "end": 111.3,
      "text": "Say back, Wukong!"
    },
    {
      "i": 34,
      "start": 112.6,
      "end": 114.3,
      "text": "It was a soldier from heaven."
    },
    {
      "i": 35,
      "start": 114.8,
      "end": 117.3,
      "text": "The J-Dembroider sent us to help you."
    },
    {
      "i": 36,
      "start": 117.8,
      "end": 120.3,
      "text": "More soldiers rushed toward the bull."
    },
    {
      "i": 37,
      "start": 120.8,
      "end": 124.8,
      "text": "With a snort, the bull spun around and flew the other way."
    },
    {
      "i": 38,
      "start": 124.8,
      "end": 128.8,
      "text": "But other soldiers appeared and blocked the bull's path."
    },
    {
      "i": 39,
      "start": 129.3,
      "end": 132.8,
      "text": "Wukong watched as soldiers surrounded the bull."
    },
    {
      "i": 40,
      "start": 133.3,
      "end": 134.8,
      "text": "They moved and closer."
    },
    {
      "i": 41,
      "start": 134.8,
      "end": 137.8,
      "text": "Their swords and spears all pointed at the bull."
    },
    {
      "i": 42,
      "start": 139.8,
      "end": 143.8,
      "text": "The bull demon king returned to his demon form."
    },
    {
      "i": 43,
      "start": 144.3,
      "end": 146.3,
      "text": "Please don't hurt me!"
    },
    {
      "i": 44,
      "start": 147.3,
      "end": 150.3,
      "text": "The irony mortal was rushing toward the soldier."
    }
  ]
}
