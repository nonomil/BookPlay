{
  "episode": 81,
  "source": "assets/video/ep81.mp4",
  "model": "base",
  "duration": 317.0916875,
  "segments": [
    {
      "i": 1,
      "start": 0.0,
      "end": 5.22,
      "text": "Journey to the West Chapter 81."
    },
    {
      "i": 2,
      "start": 5.22,
      "end": 13.96,
      "text": "Help from a Dragon."
    },
    {
      "i": 3,
      "start": 13.96,
      "end": 18.36,
      "text": "Bajay and Wu Xing swung their weapons at the demon."
    },
    {
      "i": 4,
      "start": 18.36,
      "end": 20.12,
      "text": "The demon laughed."
    },
    {
      "i": 5,
      "start": 20.12,
      "end": 23.2,
      "text": "I'm much too powerful for you."
    },
    {
      "i": 6,
      "start": 23.2,
      "end": 26.0,
      "text": "From inside the symbols, Wu Kong heard the fight."
    },
    {
      "i": 7,
      "start": 26.72,
      "end": 30.6,
      "text": "He heard grunts and the sounds of weapons clashing."
    },
    {
      "i": 8,
      "start": 30.6,
      "end": 32.12,
      "text": "The Tang monk cried."
    },
    {
      "i": 9,
      "start": 32.12,
      "end": 33.68,
      "text": "No."
    },
    {
      "i": 10,
      "start": 33.68,
      "end": 36.24,
      "text": "Then there was silence."
    },
    {
      "i": 11,
      "start": 36.24,
      "end": 38.24,
      "text": "What happened out there?"
    },
    {
      "i": 12,
      "start": 38.24,
      "end": 42.44,
      "text": "Shududu Kong, there was no answer."
    },
    {
      "i": 13,
      "start": 42.44,
      "end": 46.04,
      "text": "The monkey punched and kicked the inside of the symbols for hours."
    },
    {
      "i": 14,
      "start": 48.92,
      "end": 53.32,
      "text": "But the two symbols would not come apart."
    },
    {
      "i": 15,
      "start": 53.32,
      "end": 54.68,
      "text": "This is terrible."
    },
    {
      "i": 16,
      "start": 54.68,
      "end": 56.4,
      "text": "He said to himself,"
    },
    {
      "i": 17,
      "start": 56.4,
      "end": 59.2,
      "text": "how will I get out of here?"
    },
    {
      "i": 18,
      "start": 59.2,
      "end": 63.68,
      "text": "The monkey was about to strike the symbols again when he heard a voice."
    },
    {
      "i": 19,
      "start": 63.68,
      "end": 67.0,
      "text": "Wu Kong, are you in there?"
    },
    {
      "i": 20,
      "start": 67.0,
      "end": 68.0,
      "text": "Who is that?"
    },
    {
      "i": 21,
      "start": 68.0,
      "end": 69.88,
      "text": "Wu Kong asked."
    },
    {
      "i": 22,
      "start": 69.88,
      "end": 71.08,
      "text": "I'm the gold dragon."
    },
    {
      "i": 23,
      "start": 71.08,
      "end": 72.96,
      "text": "Said the voice."
    },
    {
      "i": 24,
      "start": 72.96,
      "end": 75.56,
      "text": "The Jade Emperor sent me to help you."
    },
    {
      "i": 25,
      "start": 75.56,
      "end": 78.56,
      "text": "I'll wedge my horn between the symbols and pry them apart."
    },
    {
      "i": 26,
      "start": 79.56,
      "end": 82.68,
      "text": "Please hurry."
    },
    {
      "i": 27,
      "start": 82.68,
      "end": 85.72,
      "text": "Said Wu Kong."
    },
    {
      "i": 28,
      "start": 85.72,
      "end": 89.36,
      "text": "Slowly the dragon's horn poked through."
    },
    {
      "i": 29,
      "start": 89.36,
      "end": 93.48,
      "text": "But the symbols were still tightly clasped together."
    },
    {
      "i": 30,
      "start": 93.48,
      "end": 95.6,
      "text": "Wu Kong groaned."
    },
    {
      "i": 31,
      "start": 95.6,
      "end": 97.48,
      "text": "I can't escape."
    },
    {
      "i": 32,
      "start": 97.48,
      "end": 100.24,
      "text": "Maybe we could find another way to pry the symbols apart."
    },
    {
      "i": 33,
      "start": 100.24,
      "end": 101.96,
      "text": "Said the dragon."
    },
    {
      "i": 34,
      "start": 101.96,
      "end": 103.96,
      "text": "Actually, I have a different idea."
    },
    {
      "i": 35,
      "start": 103.96,
      "end": 105.88,
      "text": "Said the monkey."
    },
    {
      "i": 36,
      "start": 105.88,
      "end": 111.08,
      "text": "Wu Kong turned his iron bar into a drill."
    },
    {
      "i": 37,
      "start": 111.08,
      "end": 113.24,
      "text": "He made a hole in the dragon's horn."
    },
    {
      "i": 38,
      "start": 116.92,
      "end": 122.28,
      "text": "Then he made himself tiny and climbed into the hole."
    },
    {
      "i": 39,
      "start": 122.28,
      "end": 123.64,
      "text": "Pull your horn out now."
    },
    {
      "i": 40,
      "start": 123.64,
      "end": 126.88,
      "text": "Said Wu Kong."
    },
    {
      "i": 41,
      "start": 126.88,
      "end": 132.8,
      "text": "The dragon pulled and pulled and finally got his horn out."
    },
    {
      "i": 42,
      "start": 132.8,
      "end": 137.8,
      "text": "The monkey jumped out of the hole and returned to his normal size."
    },
    {
      "i": 43,
      "start": 137.8,
      "end": 140.6,
      "text": "Thank you, said Wu Kong."
    },
    {
      "i": 44,
      "start": 140.6,
      "end": 143.08,
      "text": "Now we must free my friends."
    },
    {
      "i": 45,
      "start": 143.08,
      "end": 144.36,
      "text": "We have to be quiet."
    },
    {
      "i": 46,
      "start": 144.36,
      "end": 145.68,
      "text": "Said the dragon."
    },
    {
      "i": 47,
      "start": 145.68,
      "end": 148.12,
      "text": "The demon is sleeping."
    },
    {
      "i": 48,
      "start": 148.12,
      "end": 149.6,
      "text": "Wu Kong nodded."
    },
    {
      "i": 49,
      "start": 149.6,
      "end": 149.96,
      "text": "Then he turned."
    }
  ]
}
