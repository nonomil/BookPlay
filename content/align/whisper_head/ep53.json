{
  "episode": 53,
  "source": "assets/video/ep53.mp4",
  "model": "base",
  "duration": 307.1768125,
  "segments": [
    {
      "i": 1,
      "start": 0.0,
      "end": 12.56,
      "text": "Journey to the West, Chapter 53, The Man in the Canoe."
    },
    {
      "i": 2,
      "start": 12.56,
      "end": 16.88,
      "text": "From behind Guanyin, Wukong peaked at Red Boy."
    },
    {
      "i": 3,
      "start": 16.88,
      "end": 20.92,
      "text": "The demon was trapped by the swords all pointed at his face."
    },
    {
      "i": 4,
      "start": 20.92,
      "end": 23.2,
      "text": "Get these swords away from me!"
    },
    {
      "i": 5,
      "start": 23.2,
      "end": 24.84,
      "text": "Cry the demon."
    },
    {
      "i": 6,
      "start": 24.84,
      "end": 26.44,
      "text": "You must become a Buddhist."
    },
    {
      "i": 7,
      "start": 26.44,
      "end": 27.44,
      "text": "Said Guanyin."
    },
    {
      "i": 8,
      "start": 27.64,
      "end": 29.44,
      "text": "Then I'll release you."
    },
    {
      "i": 9,
      "start": 30.44,
      "end": 31.24,
      "text": "I promise!"
    },
    {
      "i": 10,
      "start": 31.24,
      "end": 32.44,
      "text": "Cryed Red Boy."
    },
    {
      "i": 11,
      "start": 32.44,
      "end": 34.44,
      "text": "I'll do whatever you say!"
    },
    {
      "i": 12,
      "start": 35.8,
      "end": 39.44,
      "text": "Guanyin recited a spell, and the swords vanished."
    },
    {
      "i": 13,
      "start": 42.24,
      "end": 45.24,
      "text": "Red Boy's eyes flashed with anger."
    },
    {
      "i": 14,
      "start": 46.84,
      "end": 48.44,
      "text": "Bodhisattva, watch out!"
    },
    {
      "i": 15,
      "start": 48.44,
      "end": 49.84,
      "text": "Cryed Wukong."
    },
    {
      "i": 16,
      "start": 49.84,
      "end": 52.84,
      "text": "Red Boy charged toward Guanyin."
    },
    {
      "i": 17,
      "start": 53.84,
      "end": 56.84,
      "text": "Wukong jumped in front of him."
    },
    {
      "i": 18,
      "start": 56.84,
      "end": 62.84,
      "text": "The monkey was about to strike the demon when Guanyin held up five metal bands."
    },
    {
      "i": 19,
      "start": 62.84,
      "end": 64.84,
      "text": "She threw them at Red Boy."
    },
    {
      "i": 20,
      "start": 66.84,
      "end": 70.84,
      "text": "Instantly they clamped around his head, wrist and ankles."
    },
    {
      "i": 21,
      "start": 71.84,
      "end": 73.84,
      "text": "Evil demon!"
    },
    {
      "i": 22,
      "start": 73.84,
      "end": 74.84,
      "text": "Said Guanyin."
    },
    {
      "i": 23,
      "start": 74.84,
      "end": 76.84,
      "text": "How dare you try to attack me?"
    },
    {
      "i": 24,
      "start": 76.84,
      "end": 80.84,
      "text": "Unable to move, Red Boy glared at Guanyin."
    },
    {
      "i": 25,
      "start": 81.84,
      "end": 85.84,
      "text": "Wukong raised his iron bar to strike him."
    },
    {
      "i": 26,
      "start": 85.84,
      "end": 87.84,
      "text": "No, Wukong."
    },
    {
      "i": 27,
      "start": 87.84,
      "end": 88.84,
      "text": "Said Guanyin."
    },
    {
      "i": 28,
      "start": 88.84,
      "end": 90.84,
      "text": "Don't hurt the demon."
    },
    {
      "i": 29,
      "start": 90.84,
      "end": 94.84,
      "text": "I will take him back to Mount Potalaka to be my student."
    },
    {
      "i": 30,
      "start": 96.84,
      "end": 98.84,
      "text": "Yes, Bodhisattva."
    },
    {
      "i": 31,
      "start": 98.84,
      "end": 99.84,
      "text": "Said the monkey."
    },
    {
      "i": 32,
      "start": 100.84,
      "end": 103.84,
      "text": "Guanyin took the vase down to Earth."
    },
    {
      "i": 33,
      "start": 104.84,
      "end": 109.84,
      "text": "She recited a spell, and all the water flowed back into the vase."
    },
    {
      "i": 34,
      "start": 111.84,
      "end": 116.84,
      "text": "Wukong went into Red Boy's cave and freed the Tang monk."
    },
    {
      "i": 35,
      "start": 116.84,
      "end": 119.84,
      "text": "Then he found Bajai and freed him."
    },
    {
      "i": 36,
      "start": 119.84,
      "end": 124.84,
      "text": "The three of them went down the mountain and found Wu Jing."
    },
    {
      "i": 37,
      "start": 124.84,
      "end": 127.84,
      "text": "The group continued west."
    },
    {
      "i": 38,
      "start": 127.84,
      "end": 130.84,
      "text": "They traveled for weeks."
    },
    {
      "i": 39,
      "start": 130.84,
      "end": 134.84,
      "text": "The three of them went to the mountain and found Wu Jing."
    },
    {
      "i": 40,
      "start": 134.84,
      "end": 137.84,
      "text": "The group continued west."
    },
    {
      "i": 41,
      "start": 138.84,
      "end": 141.84,
      "text": "They traveled for weeks and then months."
    },
    {
      "i": 42,
      "start": 143.84,
      "end": 146.84,
      "text": "One day they came to a wide river."
    },
    {
      "i": 43,
      "start": 147.84,
      "end": 149.84,
      "text": "I can't believe we have to cross."
    }
  ]
}
