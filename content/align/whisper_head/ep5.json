  "segments": [
    {
      "i": 1,
      "start": 0.0,
      "end": 3.84,
      "text": "Journey to the West."
    },
    {
      "i": 2,
      "start": 3.84,
      "end": 5.12,
      "text": "Chapter 5."
    },
    {
      "i": 3,
      "start": 5.12,
      "end": 14.8,
      "text": "The Demon of Chaos."
    },
    {
      "i": 4,
      "start": 14.8,
      "end": 15.8,
      "text": "What happened here?"
    },
    {
      "i": 5,
      "start": 15.8,
      "end": 17.92,
      "text": "Wukong asked the given."
    },
    {
      "i": 6,
      "start": 17.92,
      "end": 22.52,
      "text": "A few more monkeys and apes gathered around Sun Wukong and the given."
    },
    {
      "i": 7,
      "start": 22.52,
      "end": 23.68,
      "text": "They looked scared."
    },
    {
      "i": 8,
      "start": 23.68,
      "end": 25.8,
      "text": "A demon attacked us."
    },
    {
      "i": 9,
      "start": 25.8,
      "end": 27.28,
      "text": "Said the given."
    },
    {
      "i": 10,
      "start": 27.28,
      "end": 30.6,
      "text": "We tried to fight him, but he was too powerful."
    },
    {
      "i": 11,
      "start": 30.6,
      "end": 34.44,
      "text": "He stole most of our things and kidnapped many of us."
    },
    {
      "i": 12,
      "start": 34.44,
      "end": 36.24,
      "text": "Wukong was furious."
    },
    {
      "i": 13,
      "start": 36.24,
      "end": 37.24,
      "text": "Who is he?"
    },
    {
      "i": 14,
      "start": 37.24,
      "end": 39.28,
      "text": "Where does he live?"
    },
    {
      "i": 15,
      "start": 39.28,
      "end": 41.24,
      "text": "He is called the demon of Chaos."
    },
    {
      "i": 16,
      "start": 41.24,
      "end": 42.76,
      "text": "Said the given."
    },
    {
      "i": 17,
      "start": 42.76,
      "end": 45.76,
      "text": "He came from the north."
    },
    {
      "i": 18,
      "start": 45.76,
      "end": 46.76,
      "text": "Wait here."
    },
    {
      "i": 19,
      "start": 46.76,
      "end": 47.76,
      "text": "Wukong ordered."
    },
    {
      "i": 20,
      "start": 47.76,
      "end": 50.56,
      "text": "I will handle the demon."
    },
    {
      "i": 21,
      "start": 50.56,
      "end": 52.12,
      "text": "The demon is very powerful."
    },
    {
      "i": 22,
      "start": 52.12,
      "end": 53.8,
      "text": "The given warned."
    },
    {
      "i": 23,
      "start": 53.8,
      "end": 55.92,
      "text": "I learned many things from a sage."
    },
    {
      "i": 24,
      "start": 55.92,
      "end": 57.92,
      "text": "Wukong replied."
    },
    {
      "i": 25,
      "start": 57.92,
      "end": 60.88,
      "text": "I am now as powerful as a god."
    },
    {
      "i": 26,
      "start": 60.88,
      "end": 63.44,
      "text": "I am not afraid of any demon."
    },
    {
      "i": 27,
      "start": 63.44,
      "end": 65.88,
      "text": "I will be back soon."
    },
    {
      "i": 28,
      "start": 65.88,
      "end": 70.84,
      "text": "He leaped into the air and flew north."
    },
    {
      "i": 29,
      "start": 70.84,
      "end": 73.64,
      "text": "His subjects stared in amazement."
    },
    {
      "i": 30,
      "start": 73.64,
      "end": 75.12,
      "text": "Our king can fly."
    },
    {
      "i": 31,
      "start": 75.12,
      "end": 77.8,
      "text": "Said the given."
    },
    {
      "i": 32,
      "start": 77.8,
      "end": 81.4,
      "text": "Wukong soon spotted a gloomy mountain."
    },
    {
      "i": 33,
      "start": 81.4,
      "end": 84.44,
      "text": "Dark clouds hung over it."
    },
    {
      "i": 34,
      "start": 84.44,
      "end": 86.08,
      "text": "It looks like a demon's home."
    },
    {
      "i": 35,
      "start": 86.08,
      "end": 89.56,
      "text": "He thought."
    },
    {
      "i": 36,
      "start": 89.56,
      "end": 93.12,
      "text": "Wukong landed on the mountain and found a cave."
    },
    {
      "i": 37,
      "start": 93.12,
      "end": 98.12,
      "text": "Two guards stood at the entrance, practicing sword fighting."
    },
    {
      "i": 38,
      "start": 98.12,
      "end": 100.56,
      "text": "I am king of the fruit and flower mountain."
    },
    {
      "i": 39,
      "start": 100.56,
      "end": 102.4,
      "text": "Yeldu, Wukong."
    },
    {
      "i": 40,
      "start": 102.4,
      "end": 105.24,
      "text": "The demon of Chaos attacked my subjects."
    },
    {
      "i": 41,
      "start": 105.24,
      "end": 111.0,
      "text": "I want revenge."
    },
    {
      "i": 42,
      "start": 111.0,
      "end": 115.2,
      "text": "The guard shrieked and ran into the cave."
    },
    {
      "i": 43,
      "start": 115.2,
      "end": 119.2,
      "text": "The demon of Chaos was sitting at a table, eating a meal."
    },
    {
      "i": 44,
      "start": 119.2,
      "end": 120.2,
      "text": "Disaster."
    },
    {
      "i": 45,
      "start": 120.2,
      "end": 122.36,
      "text": "One guard cried."
    },
    {
      "i": 46,
      "start": 122.36,
      "end": 124.6,
      "text": "What sort of disaster?"
    },
    {
      "i": 47,
      "start": 124.6,
      "end": 126.64,
      "text": "Asked the demon."
    },
    {
      "i": 48,
      "start": 126.64,
      "end": 128.36,
      "text": "There's a monkey outside."
    },
    {
      "i": 49,
      "start": 128.36,
      "end": 130.24,
      "text": "Said the other guard."
    },
    {
      "i": 50,
      "start": 130.24,
      "end": 133.44,
      "text": "He said he's king of the fruit and flower mountain."
    },
    {
      "i": 51,
      "start": 133.44,
      "end": 135.8,
      "text": "You attacked his subjects."
    },
    {
      "i": 52,
      "start": 135.8,
      "end": 139.0,
      "text": "Now he wants revenge."
    },
    {
      "i": 53,
      "start": 139.0,
      "end": 141.96,
      "text": "The monkeys and apes are spoken of a king."
    },
    {
      "i": 54,
      "start": 141.96,
      "end": 143.6,
      "text": "Said the demon."
    },
    {
      "i": 55,
      "start": 143.6,
      "end": 145.48,
      "text": "He left to find a sage."
    },
    {
      "i": 56,
      "start": 145.48,
      "end": 148.2,
      "text": "I guess he returned."
    },
    {
      "i": 57,
      "start": 148.2,
      "end": 149.2,
      "text": "The demon stood up."
    }
  ]
}
