{
  "episode": 107,
  "source": "assets/video/ep107.mp4",
  "model": "base",
  "duration": 322.85025,
  "segments": [
    {
      "i": 1,
      "start": 0.0,
      "end": 5.84,
      "text": "Journey to the West, Chapter 107."
    },
    {
      "i": 2,
      "start": 5.84,
      "end": 13.58,
      "text": "Nothing is perfect."
    },
    {
      "i": 3,
      "start": 13.58,
      "end": 17.78,
      "text": "The travelers laid the soaks' scrolls on some rocks."
    },
    {
      "i": 4,
      "start": 17.78,
      "end": 22.24,
      "text": "The sun will dry them out, said Wukong."
    },
    {
      "i": 5,
      "start": 22.24,
      "end": 24.72,
      "text": "The Tang monk moaned."
    },
    {
      "i": 6,
      "start": 24.72,
      "end": 27.0,
      "text": "What if they're ruined?"
    },
    {
      "i": 7,
      "start": 27.0,
      "end": 30.48,
      "text": "He sat down and put his head in his hands."
    },
    {
      "i": 8,
      "start": 30.48,
      "end": 35.32,
      "text": "I wish I'd remembered to ask Boota the turtle's question."
    },
    {
      "i": 9,
      "start": 35.32,
      "end": 37.8,
      "text": "Bajai snorted."
    },
    {
      "i": 10,
      "start": 37.8,
      "end": 40.84,
      "text": "Who cares if you forgot the turtle's question?"
    },
    {
      "i": 11,
      "start": 40.84,
      "end": 45.08,
      "text": "That turtle had no right to dump us in the water."
    },
    {
      "i": 12,
      "start": 45.08,
      "end": 47.16,
      "text": "Dumping us in the water was rude."
    },
    {
      "i": 13,
      "start": 47.16,
      "end": 49.0,
      "text": "Wukong agreed."
    },
    {
      "i": 14,
      "start": 49.0,
      "end": 51.48,
      "text": "Bajai sighed."
    },
    {
      "i": 15,
      "start": 51.48,
      "end": 56.44,
      "text": "The journey back east is becoming just as difficult as the journey west."
    },
    {
      "i": 16,
      "start": 56.44,
      "end": 57.44,
      "text": "Hello!"
    },
    {
      "i": 17,
      "start": 57.44,
      "end": 58.92,
      "text": "Crytah voice."
    },
    {
      "i": 18,
      "start": 58.92,
      "end": 63.44,
      "text": "The travelers turned and saw a man hurrying toward them."
    },
    {
      "i": 19,
      "start": 63.44,
      "end": 64.44,
      "text": "Chen."
    },
    {
      "i": 20,
      "start": 64.44,
      "end": 66.28,
      "text": "Said the Tang monk."
    },
    {
      "i": 21,
      "start": 66.28,
      "end": 68.92,
      "text": "He grasped the man's hands."
    },
    {
      "i": 22,
      "start": 68.92,
      "end": 71.48,
      "text": "It's good to see you again."
    },
    {
      "i": 23,
      "start": 71.48,
      "end": 73.12,
      "text": "It's good to see all of you."
    },
    {
      "i": 24,
      "start": 73.12,
      "end": 74.92,
      "text": "Chen smiled."
    },
    {
      "i": 25,
      "start": 74.92,
      "end": 77.68,
      "text": "Did you reach the western paradise?"
    },
    {
      "i": 26,
      "start": 77.68,
      "end": 78.68,
      "text": "Yes."
    },
    {
      "i": 27,
      "start": 78.68,
      "end": 80.12,
      "text": "Said the Tang monk."
    },
    {
      "i": 28,
      "start": 80.12,
      "end": 82.04,
      "text": "It was magnificent."
    },
    {
      "i": 29,
      "start": 82.04,
      "end": 85.12,
      "text": "The land is filled with beauty."
    },
    {
      "i": 30,
      "start": 85.12,
      "end": 90.56,
      "text": "Who noticed the scrolls lying on the rocks and his eyes went wide?"
    },
    {
      "i": 31,
      "start": 90.56,
      "end": 93.16,
      "text": "Are those the true scriptures?"
    },
    {
      "i": 32,
      "start": 93.16,
      "end": 94.64,
      "text": "He whispered."
    },
    {
      "i": 33,
      "start": 94.64,
      "end": 95.64,
      "text": "Yes."
    },
    {
      "i": 34,
      "start": 95.64,
      "end": 97.16,
      "text": "Said the monk."
    },
    {
      "i": 35,
      "start": 97.16,
      "end": 100.44,
      "text": "But as you can see, they got wet."
    },
    {
      "i": 36,
      "start": 100.44,
      "end": 104.64,
      "text": "A giant turtle dumped us in the river."
    },
    {
      "i": 37,
      "start": 104.64,
      "end": 107.16,
      "text": "Added Bajai with a sigh."
    },
    {
      "i": 38,
      "start": 107.16,
      "end": 109.32,
      "text": "Please come with me."
    },
    {
      "i": 39,
      "start": 109.32,
      "end": 110.64,
      "text": "Said Chen."
    },
    {
      "i": 40,
      "start": 110.64,
      "end": 113.76,
      "text": "You can dry the true scriptures by my fire."
    },
    {
      "i": 41,
      "start": 113.76,
      "end": 118.32,
      "text": "Everyone in the village will be excited to see the travelers who met Buddha."
    },
    {
      "i": 42,
      "start": 118.32,
      "end": 121.36,
      "text": "Wu-Jing started gathering the wet scriptures."
    },
    {
      "i": 43,
      "start": 121.36,
      "end": 123.4,
      "text": "I'll help you."
    },
    {
      "i": 44,
      "start": 123.4,
      "end": 125.28,
      "text": "Said Bajai."
    },
    {
      "i": 45,
      "start": 125.28,
      "end": 128.68,
      "text": "The pig grabbed a scroll and pulled."
    },
    {
      "i": 46,
      "start": 128.68,
      "end": 131.6,
      "text": "But it was stuck to a rock."
    },
    {
      "i": 47,
      "start": 131.6,
      "end": 132.76,
      "text": "Writh."
    },
    {
      "i": 48,
      "start": 132.76,
      "end": 138.48,
      "text": "The corner of the scroll tore off."
    },
    {
      "i": 49,
      "start": 138.48,
      "end": 140.08,
      "text": "The Tang monk gasped."
    },
    {
      "i": 50,
      "start": 140.08,
      "end": 142.48,
      "text": "Oh no!"
    },
    {
      "i": 51,
      "start": 142.48,
      "end": 146.88,
      "text": "Bajai stared at her at the torn scroll."
    },
    {
      "i": 52,
      "start": 146.88,
      "end": 148.52,
      "text": "Wu-Kang smiled."
    },
    {
      "i": 53,
      "start": 148.52,
      "end": 150.0,
      "text": "Don't worry, master."
    }
  ]
}
