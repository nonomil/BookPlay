{
  "episode": 18,
  "source": "assets/video/ep18.mp4",
  "model": "base",
  "duration": 329.4215,
  "segments": [
    {
      "i": 1,
      "start": 0.0,
      "end": 7.0,
      "text": "Journey to the West, Chapter 18, the robe."
    },
    {
      "i": 2,
      "start": 13.0,
      "end": 19.0,
      "text": "Wukong and Guanyin flew over the ocean and back to the wide river."
    },
    {
      "i": 3,
      "start": 19.0,
      "end": 22.0,
      "text": "From the sky, Guanyin called."
    },
    {
      "i": 4,
      "start": 22.0,
      "end": 25.0,
      "text": "Dragon, come out of the river at once."
    },
    {
      "i": 5,
      "start": 25.0,
      "end": 28.0,
      "text": "The Tang monk is here."
    },
    {
      "i": 6,
      "start": 31.0,
      "end": 34.0,
      "text": "The dragon rose from the river and bowed."
    },
    {
      "i": 7,
      "start": 36.0,
      "end": 37.0,
      "text": "Bordesatva."
    },
    {
      "i": 8,
      "start": 37.0,
      "end": 38.0,
      "text": "He said."
    },
    {
      "i": 9,
      "start": 38.0,
      "end": 42.0,
      "text": "I'm sorry. I didn't realize the monk had arrived."
    },
    {
      "i": 10,
      "start": 43.0,
      "end": 47.0,
      "text": "I was trying to rest. A nasty monkey was."
    },
    {
      "i": 11,
      "start": 48.0,
      "end": 52.0,
      "text": "The dragon stopped talking when he saw Wukong next to Guanyin."
    },
    {
      "i": 12,
      "start": 53.0,
      "end": 54.0,
      "text": "That's him."
    },
    {
      "i": 13,
      "start": 55.0,
      "end": 57.0,
      "text": "This is Sun Wukong."
    },
    {
      "i": 14,
      "start": 57.0,
      "end": 59.0,
      "text": "Said Guanyin."
    },
    {
      "i": 15,
      "start": 59.0,
      "end": 62.0,
      "text": "He is traveling with the Tang monk."
    },
    {
      "i": 16,
      "start": 63.0,
      "end": 65.0,
      "text": "The monkey didn't tell me that."
    },
    {
      "i": 17,
      "start": 65.0,
      "end": 66.0,
      "text": "Said the dragon."
    },
    {
      "i": 18,
      "start": 66.0,
      "end": 70.0,
      "text": "I even asked him who he was and he didn't answer."
    },
    {
      "i": 19,
      "start": 71.0,
      "end": 73.0,
      "text": "I know. Said Guanyin."
    },
    {
      "i": 20,
      "start": 74.0,
      "end": 76.0,
      "text": "She shot Wukong a look."
    },
    {
      "i": 21,
      "start": 77.0,
      "end": 80.0,
      "text": "From now on, you must tell people who you are."
    },
    {
      "i": 22,
      "start": 81.0,
      "end": 84.0,
      "text": "There are others waiting for you too."
    },
    {
      "i": 23,
      "start": 86.0,
      "end": 88.0,
      "text": "Okay. Said Wukong."
    },
    {
      "i": 24,
      "start": 89.0,
      "end": 91.0,
      "text": "Guanyin looked back at the dragon."
    },
    {
      "i": 25,
      "start": 92.0,
      "end": 95.0,
      "text": "You will carry the Tang monk to the western paradise."
    },
    {
      "i": 26,
      "start": 98.0,
      "end": 101.0,
      "text": "Sparkling light surrounded the dragon."
    },
    {
      "i": 27,
      "start": 103.0,
      "end": 106.0,
      "text": "When the light faded, a horse stood where the dragon had been."
    },
    {
      "i": 28,
      "start": 107.0,
      "end": 110.0,
      "text": "It looked exactly like the Tang monk's horse."
    },
    {
      "i": 29,
      "start": 113.0,
      "end": 117.0,
      "text": "After Guanyin left, Wukong led the horse to the Tang monk."
    },
    {
      "i": 30,
      "start": 119.0,
      "end": 121.0,
      "text": "You got the horse back."
    },
    {
      "i": 31,
      "start": 121.0,
      "end": 122.0,
      "text": "Said the monk."
    },
    {
      "i": 32,
      "start": 122.0,
      "end": 123.0,
      "text": "No."
    },
    {
      "i": 33,
      "start": 123.0,
      "end": 124.0,
      "text": "Said Wukong."
    },
    {
      "i": 34,
      "start": 125.0,
      "end": 126.0,
      "text": "Guanyin was here."
    },
    {
      "i": 35,
      "start": 126.0,
      "end": 128.0,
      "text": "She turned the dragon into a horse."
    },
    {
      "i": 36,
      "start": 128.0,
      "end": 130.0,
      "text": "He's supposed to come with us."
    },
    {
      "i": 37,
      "start": 134.0,
      "end": 137.0,
      "text": "The Tang monk fell to his knees and bowed."
    },
    {
      "i": 38,
      "start": 138.0,
      "end": 139.0,
      "text": "Wukong laughed."
    },
    {
      "i": 39,
      "start": 140.0,
      "end": 142.0,
      "text": "Stand up, master."
    },
    {
      "i": 40,
      "start": 142.0,
      "end": 145.0,
      "text": "The Bodhisattva is back on Mount Potalaka by now."
    },
    {
      "i": 41,
      "start": 146.0,
      "end": 147.0,
      "text": "Do you need a ride?"
    },
    {
      "i": 42,
      "start": 147.0,
      "end": 148.0,
      "text": "Call the voice."
    },
    {
      "i": 43,
      "start": 149.0,
      "end": 150.0,
      "text": "Wukong spun her..."
    }
  ]
}
