{
  "episode": 65,
  "source": "assets/video/ep65.mp4",
  "model": "base",
  "duration": 309.429125,
  "segments": [
    {
      "i": 1,
      "start": 0.0,
      "end": 11.52,
      "text": "Journey to the West Chapter 65, the Metal Ring"
    },
    {
      "i": 2,
      "start": 11.52,
      "end": 17.6,
      "text": "The demon tied up the Tang monk in a dark room."
    },
    {
      "i": 3,
      "start": 17.6,
      "end": 21.28,
      "text": "Thatened the demon dragged in Bajie and Wu Jing."
    },
    {
      "i": 4,
      "start": 21.28,
      "end": 27.12,
      "text": "They were still trapped in the Ves."
    },
    {
      "i": 5,
      "start": 27.12,
      "end": 31.52,
      "text": "The demon dumped them in a corner and approached the monk."
    },
    {
      "i": 6,
      "start": 31.52,
      "end": 34.68,
      "text": "I've been hoping you would pass my mountain."
    },
    {
      "i": 7,
      "start": 34.68,
      "end": 38.12,
      "text": "The demon said with an evil smile."
    },
    {
      "i": 8,
      "start": 38.12,
      "end": 39.32,
      "text": "Please let us go."
    },
    {
      "i": 9,
      "start": 39.32,
      "end": 40.96,
      "text": "Said the Tang monk."
    },
    {
      "i": 10,
      "start": 40.96,
      "end": 43.84,
      "text": "We're trying to reach the Western Paradise."
    },
    {
      "i": 11,
      "start": 43.84,
      "end": 46.24,
      "text": "I know where you're going."
    },
    {
      "i": 12,
      "start": 46.24,
      "end": 47.64,
      "text": "Said the demon."
    },
    {
      "i": 13,
      "start": 47.64,
      "end": 53.4,
      "text": "I also know that I'll live forever if I eat you."
    },
    {
      "i": 14,
      "start": 53.4,
      "end": 54.96,
      "text": "Who are you?"
    },
    {
      "i": 15,
      "start": 54.96,
      "end": 57.48,
      "text": "Said Wu Jing from the corner."
    },
    {
      "i": 16,
      "start": 57.48,
      "end": 59.28,
      "text": "The demon turned to face him."
    },
    {
      "i": 17,
      "start": 59.28,
      "end": 64.28,
      "text": "I am one horned buffalo."
    },
    {
      "i": 18,
      "start": 64.28,
      "end": 66.08,
      "text": "Our friend will find us soon."
    },
    {
      "i": 19,
      "start": 66.08,
      "end": 67.08,
      "text": "Said Bajie."
    },
    {
      "i": 20,
      "start": 67.08,
      "end": 69.52,
      "text": "He's very powerful."
    },
    {
      "i": 21,
      "start": 69.52,
      "end": 74.52,
      "text": "And when he learns that you kidnapped us, he'll destroy your entire mountain."
    },
    {
      "i": 22,
      "start": 74.52,
      "end": 76.96,
      "text": "One horned buffalo smirk."
    },
    {
      "i": 23,
      "start": 76.96,
      "end": 79.24,
      "text": "Who is your friend?"
    },
    {
      "i": 24,
      "start": 79.24,
      "end": 81.24,
      "text": "His name is Sun Wukong."
    },
    {
      "i": 25,
      "start": 81.24,
      "end": 82.72,
      "text": "Said Bajie."
    },
    {
      "i": 26,
      "start": 82.72,
      "end": 85.4,
      "text": "The demon smirk disappeared."
    },
    {
      "i": 27,
      "start": 85.4,
      "end": 88.76,
      "text": "Is he the Sun Wukong who caused trouble in Heaven?"
    },
    {
      "i": 28,
      "start": 88.76,
      "end": 90.96,
      "text": "The demon sounded nervous."
    },
    {
      "i": 29,
      "start": 90.96,
      "end": 93.16,
      "text": "Yes, he is."
    },
    {
      "i": 30,
      "start": 93.16,
      "end": 94.88,
      "text": "Said Wu Jing."
    },
    {
      "i": 31,
      "start": 94.88,
      "end": 98.32,
      "text": "Heaven's entire army couldn't defeat him."
    },
    {
      "i": 32,
      "start": 98.32,
      "end": 100.68,
      "text": "Even the Jade Emperor is afraid of him."
    },
    {
      "i": 33,
      "start": 100.68,
      "end": 102.76,
      "text": "Bajie added."
    },
    {
      "i": 34,
      "start": 102.76,
      "end": 105.92,
      "text": "One horned buffalo stood taller."
    },
    {
      "i": 35,
      "start": 105.92,
      "end": 109.56,
      "text": "Well I'm not afraid of him."
    },
    {
      "i": 36,
      "start": 109.56,
      "end": 114.08,
      "text": "The demon walked out of the room."
    },
    {
      "i": 37,
      "start": 114.08,
      "end": 117.88,
      "text": "Once he was away from the others though, he grew worried again."
    },
    {
      "i": 38,
      "start": 117.88,
      "end": 119.96,
      "text": "That monkey is powerful."
    },
    {
      "i": 39,
      "start": 119.96,
      "end": 121.64,
      "text": "He said to himself."
    },
    {
      "i": 40,
      "start": 121.64,
      "end": 125.76,
      "text": "I'm going to need my special weapon to defeat him."
    },
    {
      "i": 41,
      "start": 125.76,
      "end": 132.6,
      "text": "He lifted his sleeve, revealing a metal ring around his farm."
    },
    {
      "i": 42,
      "start": 132.6,
      "end": 138.28,
      "text": "Carrying food, Wu Kong returned to where he left his friends."
    },
    {
      "i": 43,
      "start": 138.28,
      "end": 141.68,
      "text": "When he didn't see them, he looked up toward the monastery."
    },
    {
      "i": 44,
      "start": 141.68,
      "end": 144.0,
      "text": "The building was gone."
    },
    {
      "i": 45,
      "start": 144.0,
      "end": 147.72,
      "text": "In its place was a dark cave."
    },
    {
      "i": 46,
      "start": 147.72,
      "end": 148.92,
      "text": "Wu Kong shook his head."
    }
  ]
}
