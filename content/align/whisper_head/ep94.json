{
  "episode": 94,
  "source": "assets/video/ep94.mp4",
  "model": "base",
  "duration": 327.192375,
  "segments": [
    {
      "i": 1,
      "start": 0.0,
      "end": 12.96,
      "text": "Journey to the West, Chapter 94, the Elephant Demon."
    },
    {
      "i": 2,
      "start": 12.96,
      "end": 15.64,
      "text": "The Lion Demon rubbed his aching mouth."
    },
    {
      "i": 3,
      "start": 15.64,
      "end": 19.72,
      "text": "Let's leave the Tangmunk alone."
    },
    {
      "i": 4,
      "start": 19.72,
      "end": 22.6,
      "text": "Wukong is dangerous."
    },
    {
      "i": 5,
      "start": 22.6,
      "end": 24.28,
      "text": "The Raptor nodded."
    },
    {
      "i": 6,
      "start": 24.28,
      "end": 25.28,
      "text": "Buh!"
    },
    {
      "i": 7,
      "start": 25.28,
      "end": 27.44,
      "text": "The Elephant Demon waved his hand."
    },
    {
      "i": 8,
      "start": 27.92,
      "end": 31.24,
      "text": "I'm not afraid of that silly monkey."
    },
    {
      "i": 9,
      "start": 31.24,
      "end": 36.6,
      "text": "I have a perfect plan to defeat him and capture the Tangmunk."
    },
    {
      "i": 10,
      "start": 36.6,
      "end": 38.52,
      "text": "The Lion shook his head."
    },
    {
      "i": 11,
      "start": 38.52,
      "end": 45.76,
      "text": "The last time you had a plan, I wound up with a broken tooth."
    },
    {
      "i": 12,
      "start": 45.76,
      "end": 47.68,
      "text": "The Elephant snorted."
    },
    {
      "i": 13,
      "start": 47.68,
      "end": 52.24,
      "text": "Just leave everything to me."
    },
    {
      "i": 14,
      "start": 52.24,
      "end": 55.44,
      "text": "Wukong returned to his companions."
    },
    {
      "i": 15,
      "start": 55.44,
      "end": 58.84,
      "text": "He heard Bajay and Wu-Jing arguing."
    },
    {
      "i": 16,
      "start": 58.84,
      "end": 60.44,
      "text": "We can't go home."
    },
    {
      "i": 17,
      "start": 60.44,
      "end": 62.24,
      "text": "Shattered Wu-Jing."
    },
    {
      "i": 18,
      "start": 62.24,
      "end": 65.4,
      "text": "We're on an important journey."
    },
    {
      "i": 19,
      "start": 65.4,
      "end": 68.16,
      "text": "But Wukong got eaten by the Lion Demon."
    },
    {
      "i": 20,
      "start": 68.16,
      "end": 70.76,
      "text": "Said Bajay."
    },
    {
      "i": 21,
      "start": 70.76,
      "end": 75.68,
      "text": "Without Wukong, we'll never get to the West in paradise."
    },
    {
      "i": 22,
      "start": 75.68,
      "end": 76.68,
      "text": "Here I am."
    },
    {
      "i": 23,
      "start": 76.68,
      "end": 78.28,
      "text": "Said Gamunky."
    },
    {
      "i": 24,
      "start": 78.28,
      "end": 80.76,
      "text": "Everyone spun around."
    },
    {
      "i": 25,
      "start": 80.76,
      "end": 82.08,
      "text": "You're alive!"
    },
    {
      "i": 26,
      "start": 82.08,
      "end": 83.44,
      "text": "Cried the Tangmunk."
    },
    {
      "i": 27,
      "start": 83.44,
      "end": 85.2,
      "text": "Yes, I am."
    },
    {
      "i": 28,
      "start": 85.2,
      "end": 86.2,
      "text": "Said Wu-Kong."
    },
    {
      "i": 29,
      "start": 86.2,
      "end": 90.4,
      "text": "I beat up that lion's insides and broke one of his teeth."
    },
    {
      "i": 30,
      "start": 90.4,
      "end": 92.8,
      "text": "The demons are scared of me now."
    },
    {
      "i": 31,
      "start": 92.8,
      "end": 96.44,
      "text": "They promised to let us cross their mountain safely."
    },
    {
      "i": 32,
      "start": 96.44,
      "end": 97.6,
      "text": "That's wonderful!"
    },
    {
      "i": 33,
      "start": 97.6,
      "end": 100.4,
      "text": "Said the Tangmunk."
    },
    {
      "i": 34,
      "start": 100.4,
      "end": 103.64,
      "text": "Wu-Jing helped the monk climb onto the horse."
    },
    {
      "i": 35,
      "start": 103.64,
      "end": 107.0,
      "text": "The other travelers started walking."
    },
    {
      "i": 36,
      "start": 107.0,
      "end": 114.08,
      "text": "They hadn't gone far when they saw a large figure ahead blocking the road."
    },
    {
      "i": 37,
      "start": 114.08,
      "end": 115.44,
      "text": "That's the elephant demon."
    },
    {
      "i": 38,
      "start": 115.44,
      "end": 118.08,
      "text": "Said Wu-Kong with a frown."
    },
    {
      "i": 39,
      "start": 118.08,
      "end": 120.32,
      "text": "What's he doing here?"
    },
    {
      "i": 40,
      "start": 120.32,
      "end": 122.28,
      "text": "We want the Tangmunk!"
    },
    {
      "i": 41,
      "start": 122.28,
      "end": 125.12,
      "text": "Shouded the elephant."
    },
    {
      "i": 42,
      "start": 125.12,
      "end": 127.6,
      "text": "The Tangmunk fainted."
    },
    {
      "i": 43,
      "start": 127.6,
      "end": 129.4,
      "text": "Wu-Kong turned to Bajay."
    },
    {
      "i": 44,
      "start": 129.4,
      "end": 133.8,
      "text": "I've been dealing with these demons all day."
    },
    {
      "i": 45,
      "start": 133.8,
      "end": 137.28,
      "text": "It's your turn to fight them."
    },
    {
      "i": 46,
      "start": 137.28,
      "end": 138.8,
      "text": "Bajay's side."
    },
    {
      "i": 47,
      "start": 138.8,
      "end": 139.8,
      "text": "Okay!"
    },
    {
      "i": 48,
      "start": 139.8,
      "end": 144.04,
      "text": "Waving his rake, the pig charged toward the elephant."
    },
    {
      "i": 49,
      "start": 144.04,
      "end": 147.84,
      "text": "You'll never harm my master!"
    },
    {
      "i": 50,
      "start": 147.84,
      "end": 149.52,
      "text": "The elephant blocked the rake."
    },
    {
      "i": 51,
      "start": 149.52,
      "end": 150.0,
      "text": "Spun around."
    }
  ]
}
