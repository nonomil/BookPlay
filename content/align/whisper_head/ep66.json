{
  "episode": 66,
  "source": "assets/video/ep66.mp4",
  "model": "base",
  "duration": 322.757375,
  "segments": [
    {
      "i": 1,
      "start": 0.0,
      "end": 5.0,
      "text": "Journey to the West, Chapter 66."
    },
    {
      "i": 2,
      "start": 5.0,
      "end": 14.16,
      "text": "Help from Heaven."
    },
    {
      "i": 3,
      "start": 14.16,
      "end": 18.92,
      "text": "One horn buffalo went back into his cave and slammed the door shut."
    },
    {
      "i": 4,
      "start": 18.92,
      "end": 21.0,
      "text": "He stole my iron bar!"
    },
    {
      "i": 5,
      "start": 21.0,
      "end": 22.0,
      "text": "Cryed, Wukong."
    },
    {
      "i": 6,
      "start": 22.0,
      "end": 24.64,
      "text": "What am I going to do?"
    },
    {
      "i": 7,
      "start": 24.64,
      "end": 26.0,
      "text": "He thought for a moment."
    },
    {
      "i": 8,
      "start": 26.0,
      "end": 29.2,
      "text": "But Demon said he remembered me."
    },
    {
      "i": 9,
      "start": 29.2,
      "end": 32.32,
      "text": "He also mentioned the Jade Emperor."
    },
    {
      "i": 10,
      "start": 32.32,
      "end": 35.8,
      "text": "Maybe that demon escaped from Heaven."
    },
    {
      "i": 11,
      "start": 35.8,
      "end": 41.28,
      "text": "The monkey shot into the sky and soon arrived at the southern gate of Heaven."
    },
    {
      "i": 12,
      "start": 41.28,
      "end": 44.76,
      "text": "He told the guard everything that had happened."
    },
    {
      "i": 13,
      "start": 44.76,
      "end": 50.96,
      "text": "The guard sent a messenger to see if any spirits were missing from Heaven."
    },
    {
      "i": 14,
      "start": 50.96,
      "end": 54.12,
      "text": "The messenger returned quickly with a warrior."
    },
    {
      "i": 15,
      "start": 54.12,
      "end": 57.72,
      "text": "The warrior held a large sword."
    },
    {
      "i": 16,
      "start": 57.72,
      "end": 59.5,
      "text": "The Emperor sent me."
    },
    {
      "i": 17,
      "start": 59.5,
      "end": 61.0,
      "text": "Said the warrior."
    },
    {
      "i": 18,
      "start": 61.0,
      "end": 63.24,
      "text": "Nobody is missing from Heaven."
    },
    {
      "i": 19,
      "start": 63.24,
      "end": 70.96,
      "text": "But I will arrest one horn buffalo for you."
    },
    {
      "i": 20,
      "start": 70.96,
      "end": 76.08,
      "text": "Wukong returned to Earth with the warrior."
    },
    {
      "i": 21,
      "start": 76.08,
      "end": 80.64,
      "text": "The warrior banged on the cave door."
    },
    {
      "i": 22,
      "start": 80.64,
      "end": 84.72,
      "text": "Open up one horn buffalo."
    },
    {
      "i": 23,
      "start": 84.72,
      "end": 88.36,
      "text": "The demon came outside and eyed the warrior."
    },
    {
      "i": 24,
      "start": 88.36,
      "end": 90.32,
      "text": "What do you want?"
    },
    {
      "i": 25,
      "start": 90.32,
      "end": 92.76,
      "text": "The warrior puffed out his chest."
    },
    {
      "i": 26,
      "start": 92.76,
      "end": 95.56,
      "text": "I'm here to arrest you."
    },
    {
      "i": 27,
      "start": 95.56,
      "end": 98.16,
      "text": "One horned buffalo snorted."
    },
    {
      "i": 28,
      "start": 98.16,
      "end": 100.48,
      "text": "Go away."
    },
    {
      "i": 29,
      "start": 100.48,
      "end": 102.52,
      "text": "How dare you tell me to go away?"
    },
    {
      "i": 30,
      "start": 102.52,
      "end": 103.84,
      "text": "Said the warrior."
    },
    {
      "i": 31,
      "start": 103.84,
      "end": 107.48,
      "text": "The Jade Emperor sent me."
    },
    {
      "i": 32,
      "start": 107.48,
      "end": 110.2,
      "text": "He pointed his sword at the demon."
    },
    {
      "i": 33,
      "start": 110.2,
      "end": 113.72,
      "text": "If you don't come with me, I'll have to."
    },
    {
      "i": 34,
      "start": 113.72,
      "end": 116.52,
      "text": "One horned buffalo held up the metal ring."
    },
    {
      "i": 35,
      "start": 116.52,
      "end": 118.12,
      "text": "And whoosh!"
    },
    {
      "i": 36,
      "start": 118.12,
      "end": 121.24,
      "text": "The warrior's sword flew into it."
    },
    {
      "i": 37,
      "start": 121.24,
      "end": 126.84,
      "text": "The warriors face fell as he looked at his empty hand."
    },
    {
      "i": 38,
      "start": 126.84,
      "end": 132.28,
      "text": "The demon laughed and went back into his cave."
    },
    {
      "i": 39,
      "start": 132.28,
      "end": 134.12,
      "text": "That metal ring is powerful."
    },
    {
      "i": 40,
      "start": 134.12,
      "end": 136.44,
      "text": "Said the warrior to Wukong."
    },
    {
      "i": 41,
      "start": 136.44,
      "end": 138.88,
      "text": "We need more help."
    },
    {
      "i": 42,
      "start": 138.88,
      "end": 143.04,
      "text": "They returned to Heaven and bowed before the Jade Emperor."
    },
    {
      "i": 43,
      "start": 143.04,
      "end": 144.88,
      "text": "I'm sorry, Your Majesty."
    },
    {
      "i": 44,
      "start": 144.88,
      "end": 146.32,
      "text": "Said the warrior."
    },
    {
      "i": 45,
      "start": 146.32,
      "end": 148.6,
      "text": "But the demons stole my sword."
    },
    {
      "i": 46,
      "start": 148.6,
      "end": 149.84,
      "text": "I need more help."
    }
  ]
}
