{
  "episode": 67,
  "source": "assets/video/ep67.mp4",
  "model": "base",
  "duration": 304.1581875,
  "segments": [
    {
      "i": 1,
      "start": 0.0,
      "end": 7.0,
      "text": "Journey to the West Chapter 67 The Master Thief"
    },
    {
      "i": 2,
      "start": 13.6,
      "end": 15.36,
      "text": "What are we going to do now?"
    },
    {
      "i": 3,
      "start": 15.36,
      "end": 16.84,
      "text": "Pride Wukong."
    },
    {
      "i": 4,
      "start": 16.84,
      "end": 21.0,
      "text": "One horned buffalo stole all our weapons."
    },
    {
      "i": 5,
      "start": 21.0,
      "end": 23.04,
      "text": "The warrior rubbed his chin."
    },
    {
      "i": 6,
      "start": 23.04,
      "end": 25.52,
      "text": "He looked very serious."
    },
    {
      "i": 7,
      "start": 25.52,
      "end": 28.16,
      "text": "We can't go back to the Jade Emperor."
    },
    {
      "i": 8,
      "start": 28.16,
      "end": 32.36,
      "text": "He'll be angry if he finds out we couldn't arrest the demon."
    },
    {
      "i": 9,
      "start": 32.36,
      "end": 33.16,
      "text": "You're right."
    },
    {
      "i": 10,
      "start": 33.16,
      "end": 34.92,
      "text": "Said the fire god."
    },
    {
      "i": 11,
      "start": 34.92,
      "end": 37.2,
      "text": "We need a different plan."
    },
    {
      "i": 12,
      "start": 37.2,
      "end": 39.88,
      "text": "It's getting dark out almost nighttime."
    },
    {
      "i": 13,
      "start": 39.88,
      "end": 44.4,
      "text": "Maybe one of us can sneak into the cave and steal that metal ring."
    },
    {
      "i": 14,
      "start": 44.4,
      "end": 46.2,
      "text": "The Thunder God smiled."
    },
    {
      "i": 15,
      "start": 46.2,
      "end": 49.32,
      "text": "I know who's perfect for that job."
    },
    {
      "i": 16,
      "start": 49.32,
      "end": 52.36,
      "text": "The others all looked at the god."
    },
    {
      "i": 17,
      "start": 52.36,
      "end": 54.8,
      "text": "One of us is a Master Thief."
    },
    {
      "i": 18,
      "start": 54.8,
      "end": 56.84,
      "text": "The Thunder God continued."
    },
    {
      "i": 19,
      "start": 56.84,
      "end": 62.04,
      "text": "He won't stole all the peaches from the royal peach garden."
    },
    {
      "i": 20,
      "start": 62.04,
      "end": 65.4,
      "text": "Now everyone looked at Wukong."
    },
    {
      "i": 21,
      "start": 65.4,
      "end": 67.64,
      "text": "The monkey pretended to laugh."
    },
    {
      "i": 22,
      "start": 67.64,
      "end": 70.44,
      "text": "Yes, it's true."
    },
    {
      "i": 23,
      "start": 70.44,
      "end": 74.88,
      "text": "I used to steal things but I know now that stealing is wrong."
    },
    {
      "i": 24,
      "start": 74.88,
      "end": 80.04,
      "text": "However, I will steal that metal ring because I need to save the Tang monk."
    },
    {
      "i": 25,
      "start": 80.04,
      "end": 81.72,
      "text": "You all wait here."
    },
    {
      "i": 26,
      "start": 81.72,
      "end": 87.08,
      "text": "The monkey turned himself into a tiny bug and flew into the cave."
    },
    {
      "i": 27,
      "start": 87.08,
      "end": 94.32,
      "text": "He went down a long dark tunnel followed by another tunnel."
    },
    {
      "i": 28,
      "start": 94.32,
      "end": 97.68,
      "text": "Then he heard one horned buffalo."
    },
    {
      "i": 29,
      "start": 97.68,
      "end": 100.32,
      "text": "Wukong flew toward the voice."
    },
    {
      "i": 30,
      "start": 100.32,
      "end": 104.92,
      "text": "The demon was sitting on the edge of a bed talking to himself."
    },
    {
      "i": 31,
      "start": 104.92,
      "end": 108.4,
      "text": "The metal ring was still on his arm."
    },
    {
      "i": 32,
      "start": 108.4,
      "end": 110.92,
      "text": "It's time for bed."
    },
    {
      "i": 33,
      "start": 110.92,
      "end": 112.92,
      "text": "I said the demon with a yawn."
    },
    {
      "i": 34,
      "start": 112.92,
      "end": 118.64,
      "text": "I hope I can eat the Tang monk tomorrow."
    },
    {
      "i": 35,
      "start": 118.64,
      "end": 125.4,
      "text": "I couldn't eat him today because of that annoying monkey and his friends from heaven."
    },
    {
      "i": 36,
      "start": 125.4,
      "end": 129.44,
      "text": "The demon lay down and was soon asleep."
    },
    {
      "i": 37,
      "start": 129.44,
      "end": 133.32,
      "text": "Wukong flew over and landed on the demon's arm."
    },
    {
      "i": 38,
      "start": 133.32,
      "end": 135.12,
      "text": "I'll bite his arm."
    },
    {
      "i": 39,
      "start": 135.12,
      "end": 136.12,
      "text": "Thought the monkey."
    },
    {
      "i": 40,
      "start": 136.12,
      "end": 139.76,
      "text": "He'll get itchy and have to take off the metal ring."
    },
    {
      "i": 41,
      "start": 139.76,
      "end": 144.0,
      "text": "Wukong bit the demon's arm again and again."
    },
    {
      "i": 42,
      "start": 144.0,
      "end": 146.76,
      "text": "The demon rolled over and mumbled in his sleep."
    },
    {
      "i": 43,
      "start": 146.76,
      "end": 147.76,
      "text": "Bugs."
    },
    {
      "i": 44,
      "start": 147.76,
      "end": 148.76,
      "text": "Hitchy."
    },
    {
      "i": 45,
      "start": 148.76,
      "end": 149.76,
      "text": "Hitchy."
    }
  ]
}
