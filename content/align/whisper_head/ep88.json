{
  "episode": 88,
  "source": "assets/video/ep88.mp4",
  "model": "base",
  "duration": 323.152125,
  "segments": [
    {
      "i": 1,
      "start": 0.0,
      "end": 7.0,
      "text": "Journey to the West Chapter 88, the Priest Plan"
    },
    {
      "i": 2,
      "start": 12.0,
      "end": 13.0,
      "text": "Help!"
    },
    {
      "i": 3,
      "start": 13.0,
      "end": 15.0,
      "text": "Cryed Bajay."
    },
    {
      "i": 4,
      "start": 15.0,
      "end": 20.0,
      "text": "Spider-web's now covered the pig so he couldn't move at all."
    },
    {
      "i": 5,
      "start": 20.0,
      "end": 22.0,
      "text": "Mukong quickly grew tall."
    },
    {
      "i": 6,
      "start": 22.0,
      "end": 26.0,
      "text": "He swung his iron barf furiously at the young woman."
    },
    {
      "i": 7,
      "start": 26.0,
      "end": 28.0,
      "text": "Oh no!"
    },
    {
      "i": 8,
      "start": 28.0,
      "end": 29.0,
      "text": "Cryed one woman."
    },
    {
      "i": 9,
      "start": 29.0,
      "end": 32.0,
      "text": "The monkey is a powerful spirit!"
    },
    {
      "i": 10,
      "start": 32.0,
      "end": 33.0,
      "text": "Cryed another."
    },
    {
      "i": 11,
      "start": 33.0,
      "end": 35.0,
      "text": "We must leave!"
    },
    {
      "i": 12,
      "start": 35.0,
      "end": 36.0,
      "text": "Cryed the third."
    },
    {
      "i": 13,
      "start": 36.0,
      "end": 37.0,
      "text": "Poof!"
    },
    {
      "i": 14,
      "start": 37.0,
      "end": 39.0,
      "text": "The women vanished."
    },
    {
      "i": 15,
      "start": 39.0,
      "end": 41.0,
      "text": "Mukong ran into the house."
    },
    {
      "i": 16,
      "start": 41.0,
      "end": 45.0,
      "text": "He saw a large form wrapped in spider webs in a corner."
    },
    {
      "i": 17,
      "start": 45.0,
      "end": 47.0,
      "text": "Master!"
    },
    {
      "i": 18,
      "start": 47.0,
      "end": 48.0,
      "text": "Cryed the monkey."
    },
    {
      "i": 19,
      "start": 48.0,
      "end": 51.0,
      "text": "He quickly pulled off the webs."
    },
    {
      "i": 20,
      "start": 51.0,
      "end": 53.0,
      "text": "Thank you, Mukong."
    },
    {
      "i": 21,
      "start": 53.0,
      "end": 55.0,
      "text": "Said the monk, breathlessly."
    },
    {
      "i": 22,
      "start": 55.0,
      "end": 58.0,
      "text": "Those women were planning to eat me."
    },
    {
      "i": 23,
      "start": 59.0,
      "end": 61.0,
      "text": "Those women are gone now."
    },
    {
      "i": 24,
      "start": 61.0,
      "end": 64.0,
      "text": "Said Mukong, then he smirked."
    },
    {
      "i": 25,
      "start": 64.0,
      "end": 66.0,
      "text": "Bajay scared them away."
    },
    {
      "i": 26,
      "start": 66.0,
      "end": 69.0,
      "text": "The pig was a real hero."
    },
    {
      "i": 27,
      "start": 71.0,
      "end": 72.0,
      "text": "Wonderful."
    },
    {
      "i": 28,
      "start": 72.0,
      "end": 75.0,
      "text": "Said the Tang monk as they went outside."
    },
    {
      "i": 29,
      "start": 75.0,
      "end": 77.0,
      "text": "Where is Bajay now?"
    },
    {
      "i": 30,
      "start": 77.0,
      "end": 78.0,
      "text": "He's right there."
    },
    {
      "i": 31,
      "start": 78.0,
      "end": 80.0,
      "text": "Mukong pointed and laughed."
    },
    {
      "i": 32,
      "start": 80.0,
      "end": 85.0,
      "text": "Bajay, the brave hero."
    },
    {
      "i": 33,
      "start": 86.0,
      "end": 91.0,
      "text": "Bajay was on the ground, still struggling to get out of the webs."
    },
    {
      "i": 34,
      "start": 91.0,
      "end": 94.0,
      "text": "He pretended to laugh."
    },
    {
      "i": 35,
      "start": 94.0,
      "end": 95.0,
      "text": "Ha ha!"
    },
    {
      "i": 36,
      "start": 95.0,
      "end": 98.0,
      "text": "Mukong, very funny."
    },
    {
      "i": 37,
      "start": 99.0,
      "end": 103.0,
      "text": "The road left the forest and headed up a mountain."
    },
    {
      "i": 38,
      "start": 103.0,
      "end": 107.0,
      "text": "The travelers arrived at a dauest abbey."
    },
    {
      "i": 39,
      "start": 107.0,
      "end": 109.0,
      "text": "Maybe we can rest here."
    },
    {
      "i": 40,
      "start": 109.0,
      "end": 111.0,
      "text": "Said Wu-Jing."
    },
    {
      "i": 41,
      "start": 111.0,
      "end": 113.0,
      "text": "The group entered the abbey."
    },
    {
      "i": 42,
      "start": 114.0,
      "end": 119.0,
      "text": "An old priest was inside, mixing a potion."
    },
    {
      "i": 43,
      "start": 119.0,
      "end": 121.0,
      "text": "Visitors."
    },
    {
      "i": 44,
      "start": 121.0,
      "end": 123.0,
      "text": "Said the priest."
    },
    {
      "i": 45,
      "start": 123.0,
      "end": 125.0,
      "text": "Come in and make yourselves at home."
    },
    {
      "i": 46,
      "start": 125.0,
      "end": 126.0,
      "text": "Thank you."
    },
    {
      "i": 47,
      "start": 126.0,
      "end": 128.0,
      "text": "Said the Tang monk."
    },
    {
      "i": 48,
      "start": 128.0,
      "end": 133.0,
      "text": "The priest led them to a sitting area."
    },
    {
      "i": 49,
      "start": 136.0,
      "end": 138.0,
      "text": "Your Buddhists."
    },
    {
      "i": 50,
      "start": 138.0,
      "end": 141.0,
      "text": "The priest observed as everyone sat down."
    },
    {
      "i": 51,
      "start": 142.0,
      "end": 144.0,
      "text": "The Tang monk opened his mouth to answer."
    },
    {
      "i": 52,
      "start": 144.0,
      "end": 147.0,
      "text": "But Wu-Kong spoke first."
    },
    {
      "i": 53,
      "start": 147.0,
      "end": 149.0,
      "text": "We're on our way to visit friends."
    },
    {
      "i": 54,
      "start": 149.0,
      "end": 150.0,
      "text": "Said the monkey."
    }
  ]
}
