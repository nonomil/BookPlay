  "duration": 339.7079375,
  "segments": [
    {
      "i": 1,
      "start": 0.0,
      "end": 3.6,
      "text": "Journey to the West."
    },
    {
      "i": 2,
      "start": 3.6,
      "end": 5.08,
      "text": "Chapter 43."
    },
    {
      "i": 3,
      "start": 5.08,
      "end": 7.0,
      "text": "A visit from Lausa."
    },
    {
      "i": 4,
      "start": 7.0,
      "end": 15.32,
      "text": "Golden Horn Scaled at Wukong."
    },
    {
      "i": 5,
      "start": 15.32,
      "end": 19.2,
      "text": "I doubt you have a good like mine."
    },
    {
      "i": 6,
      "start": 19.2,
      "end": 20.2,
      "text": "I do."
    },
    {
      "i": 7,
      "start": 20.2,
      "end": 22.28,
      "text": "Said Wukong."
    },
    {
      "i": 8,
      "start": 22.28,
      "end": 24.88,
      "text": "He held up the real gourd."
    },
    {
      "i": 9,
      "start": 24.88,
      "end": 27.88,
      "text": "The demon looked carefully at the gourd."
    },
    {
      "i": 10,
      "start": 27.88,
      "end": 31.28,
      "text": "It does look like my gourd."
    },
    {
      "i": 11,
      "start": 31.28,
      "end": 34.8,
      "text": "But my gourd is magical."
    },
    {
      "i": 12,
      "start": 34.8,
      "end": 36.52,
      "text": "My gourd is magical too."
    },
    {
      "i": 13,
      "start": 36.52,
      "end": 37.96,
      "text": "Said Wukong."
    },
    {
      "i": 14,
      "start": 37.96,
      "end": 39.96,
      "text": "The demon rubbed his chin."
    },
    {
      "i": 15,
      "start": 39.96,
      "end": 43.44,
      "text": "What can your gourd do?"
    },
    {
      "i": 16,
      "start": 43.44,
      "end": 44.92,
      "text": "It can hold a demon."
    },
    {
      "i": 17,
      "start": 44.92,
      "end": 46.44,
      "text": "Said Wukong."
    },
    {
      "i": 18,
      "start": 46.44,
      "end": 49.04,
      "text": "All I have to do is say the demon's name."
    },
    {
      "i": 19,
      "start": 49.04,
      "end": 52.88,
      "text": "The demon will get sucked in and then turn into liquid."
    },
    {
      "i": 20,
      "start": 52.88,
      "end": 55.56,
      "text": "Golden Horn raised his eyebrows."
    },
    {
      "i": 21,
      "start": 55.56,
      "end": 59.16,
      "text": "My gourd can do that too."
    },
    {
      "i": 22,
      "start": 59.16,
      "end": 62.56,
      "text": "Let's see who's gourd works better."
    },
    {
      "i": 23,
      "start": 62.56,
      "end": 67.44,
      "text": "I'll go first."
    },
    {
      "i": 24,
      "start": 67.44,
      "end": 70.52,
      "text": "I forgot your name."
    },
    {
      "i": 25,
      "start": 70.52,
      "end": 71.92,
      "text": "Kong Sun Woop."
    },
    {
      "i": 26,
      "start": 71.92,
      "end": 72.92,
      "text": "Said Wukong."
    },
    {
      "i": 27,
      "start": 72.92,
      "end": 73.92,
      "text": "Oh yes."
    },
    {
      "i": 28,
      "start": 73.92,
      "end": 77.4,
      "text": "Now I remember."
    },
    {
      "i": 29,
      "start": 77.4,
      "end": 79.72,
      "text": "Golden Horn held up his gourd."
    },
    {
      "i": 30,
      "start": 79.72,
      "end": 83.24,
      "text": "Kong Sun Woop."
    },
    {
      "i": 31,
      "start": 83.24,
      "end": 86.04,
      "text": "Something happened."
    },
    {
      "i": 32,
      "start": 86.04,
      "end": 88.04,
      "text": "Golden Horn looked at his gourd."
    },
    {
      "i": 33,
      "start": 88.04,
      "end": 93.24,
      "text": "I isn't my gourd working."
    },
    {
      "i": 34,
      "start": 93.24,
      "end": 94.48,
      "text": "Let me try mine."
    },
    {
      "i": 35,
      "start": 94.48,
      "end": 96.28,
      "text": "Said Wukong."
    },
    {
      "i": 36,
      "start": 96.28,
      "end": 98.88,
      "text": "Golden Horn."
    },
    {
      "i": 37,
      "start": 98.88,
      "end": 99.88,
      "text": "Slump."
    },
    {
      "i": 38,
      "start": 99.88,
      "end": 103.96,
      "text": "Instantly the demon was sucked into the gourd."
    },
    {
      "i": 39,
      "start": 103.96,
      "end": 104.96,
      "text": "Ha!"
    },
    {
      "i": 40,
      "start": 104.96,
      "end": 105.96,
      "text": "Wukong laughed."
    },
    {
      "i": 41,
      "start": 105.96,
      "end": 110.4,
      "text": "Golden Horn will soon be turned into liquid."
    },
    {
      "i": 42,
      "start": 110.4,
      "end": 114.48,
      "text": "He closed the gourd and ran into the cave."
    },
    {
      "i": 43,
      "start": 114.48,
      "end": 119.4,
      "text": "Several demons were inside."
    },
    {
      "i": 44,
      "start": 119.4,
      "end": 121.4,
      "text": "The monkey waved to Zyron Bartham."
    },
    {
      "i": 45,
      "start": 121.4,
      "end": 124.84,
      "text": "Get out of here before I clobber you all."
    },
    {
      "i": 46,
      "start": 124.84,
      "end": 127.96,
      "text": "He shouted."
    },
    {
      "i": 47,
      "start": 127.96,
      "end": 133.64,
      "text": "The demon screamed and ran out of the cave."
    },
    {
      "i": 48,
      "start": 133.64,
      "end": 140.04,
      "text": "After a quick search of the cave, Wukong found his companions."
    },
    {
      "i": 49,
      "start": 140.04,
      "end": 141.88,
      "text": "He thought you were trapped under mountains."
    },
    {
      "i": 50,
      "start": 141.88,
      "end": 144.0,
      "text": "Said the Tang monk."
    },
    {
      "i": 51,
      "start": 144.0,
      "end": 146.0,
      "text": "I was freed a couple of hours ago."
    },
    {
      "i": 52,
      "start": 146.0,
      "end": 148.48,
      "text": "Said Wukong."
    },
    {
      "i": 53,
      "start": 148.48,
      "end": 149.52,
      "text": "He untied the monk."
    }
  ]
}
