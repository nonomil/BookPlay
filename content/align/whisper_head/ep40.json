{
  "episode": 40,
  "source": "assets/video/ep40.mp4",
  "model": "base",
  "duration": 346.6275,
  "segments": [
    {
      "i": 1,
      "start": 0.0,
      "end": 24.36,
      "text": "Bajai was in the cave when the door opened."
    },
    {
      "i": 2,
      "start": 24.36,
      "end": 35.56,
      "text": "Two small demons entered, dragging Wu Jing and the Tang monk."
    },
    {
      "i": 3,
      "start": 35.56,
      "end": 36.72,
      "text": "What happened?"
    },
    {
      "i": 4,
      "start": 36.72,
      "end": 39.16,
      "text": "Pride Bajai after the demons left."
    },
    {
      "i": 5,
      "start": 39.16,
      "end": 41.2,
      "text": "A demon attacked us."
    },
    {
      "i": 6,
      "start": 41.2,
      "end": 42.52,
      "text": "Said Wu Jing."
    },
    {
      "i": 7,
      "start": 42.52,
      "end": 45.72,
      "text": "I tried to fight him but he was too powerful."
    },
    {
      "i": 8,
      "start": 45.72,
      "end": 46.72,
      "text": "I'm worried."
    },
    {
      "i": 9,
      "start": 46.72,
      "end": 48.36,
      "text": "Said the Tang monk."
    },
    {
      "i": 10,
      "start": 48.36,
      "end": 51.8,
      "text": "We don't know what happened to Wu Kong."
    },
    {
      "i": 11,
      "start": 51.8,
      "end": 57.72,
      "text": "In another room inside the cave, Golden Horn talked to some smaller demons."
    },
    {
      "i": 12,
      "start": 57.72,
      "end": 63.2,
      "text": "They all laughed when Golden Horn told the Wu Kong was trapped under three mountains."
    },
    {
      "i": 13,
      "start": 63.2,
      "end": 65.52,
      "text": "Let's celebrate."
    },
    {
      "i": 14,
      "start": 65.52,
      "end": 67.44,
      "text": "Said one demon."
    },
    {
      "i": 15,
      "start": 67.44,
      "end": 69.12,
      "text": "Not yet."
    },
    {
      "i": 16,
      "start": 69.12,
      "end": 70.84,
      "text": "Said Golden Horn."
    },
    {
      "i": 17,
      "start": 70.84,
      "end": 77.84,
      "text": "I'm afraid some Wu Kong might escape."
    },
    {
      "i": 18,
      "start": 77.84,
      "end": 81.16,
      "text": "He handed a gourd to one of the demons."
    },
    {
      "i": 19,
      "start": 81.16,
      "end": 85.16,
      "text": "This magic gourd to the monkey."
    },
    {
      "i": 20,
      "start": 85.16,
      "end": 89.68,
      "text": "Say his name and he will be sucked into the gourd."
    },
    {
      "i": 21,
      "start": 89.68,
      "end": 94.76,
      "text": "After an hour, he will turn into liquid."
    },
    {
      "i": 22,
      "start": 94.76,
      "end": 97.56,
      "text": "Yes master."
    },
    {
      "i": 23,
      "start": 97.56,
      "end": 104.12,
      "text": "Said the small demon."
    },
    {
      "i": 24,
      "start": 104.12,
      "end": 111.4,
      "text": "Wu Kong pushed as hard as he could but the mountains were too heavy."
    },
    {
      "i": 25,
      "start": 111.4,
      "end": 113.76,
      "text": "How will I ever get out of this?"
    },
    {
      "i": 26,
      "start": 113.76,
      "end": 116.2,
      "text": "Thought the monkey."
    },
    {
      "i": 27,
      "start": 116.2,
      "end": 123.44,
      "text": "He was about to push again when the mountains rose into the air."
    },
    {
      "i": 28,
      "start": 123.44,
      "end": 127.36,
      "text": "Wu Kong jumped to his feet and looked around."
    },
    {
      "i": 29,
      "start": 127.36,
      "end": 130.4,
      "text": "A spirit stood nearby."
    },
    {
      "i": 30,
      "start": 130.4,
      "end": 134.08,
      "text": "Wu Kong, I am the spirit of these mountains."
    },
    {
      "i": 31,
      "start": 134.08,
      "end": 135.4,
      "text": "Please forgive me."
    },
    {
      "i": 32,
      "start": 135.4,
      "end": 145.4,
      "text": "I tried to stop that demon from taking my mountains but he was too powerful."
    },
    {
      "i": 33,
      "start": 145.4,
      "end": 148.24,
      "text": "The spirit bowed and then vanished with the mountains."
    }
  ]
}
