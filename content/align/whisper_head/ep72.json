{
  "episode": 72,
  "source": "assets/video/ep72.mp4",
  "model": "base",
  "duration": 326.4958125,
  "segments": [
    {
      "i": 1,
      "start": 0.0,
      "end": 7.0,
      "text": "Journey to the West, Chapter 72, a surprise at the fruit and flower mountain."
    },
    {
      "i": 2,
      "start": 14.0,
      "end": 17.0,
      "text": "Wukong went straight to Mount Potolaka."
    },
    {
      "i": 3,
      "start": 19.0,
      "end": 22.0,
      "text": "The Bodhisattva Guanyin was in her garden."
    },
    {
      "i": 4,
      "start": 25.0,
      "end": 28.0,
      "text": "Hello, Wukong. How is the journey going?"
    },
    {
      "i": 5,
      "start": 29.0,
      "end": 31.0,
      "text": "Wukong threw up his hands."
    },
    {
      "i": 6,
      "start": 31.0,
      "end": 33.0,
      "text": "The Tang Monk is crazy."
    },
    {
      "i": 7,
      "start": 33.0,
      "end": 34.0,
      "text": "Why?"
    },
    {
      "i": 8,
      "start": 34.0,
      "end": 36.0,
      "text": "Ask the Bodhisattva."
    },
    {
      "i": 9,
      "start": 36.0,
      "end": 38.0,
      "text": "He told me to leave."
    },
    {
      "i": 10,
      "start": 38.0,
      "end": 40.0,
      "text": "Said the monkey."
    },
    {
      "i": 11,
      "start": 40.0,
      "end": 43.0,
      "text": "He was mad because I was going to hurt some robbers."
    },
    {
      "i": 12,
      "start": 43.0,
      "end": 45.0,
      "text": "Guanyin frowned."
    },
    {
      "i": 13,
      "start": 45.0,
      "end": 47.0,
      "text": "It's wrong to hurt people, Wukong."
    },
    {
      "i": 14,
      "start": 47.0,
      "end": 49.0,
      "text": "You know that."
    },
    {
      "i": 15,
      "start": 49.0,
      "end": 52.0,
      "text": "I hurt demons all the time."
    },
    {
      "i": 16,
      "start": 52.0,
      "end": 54.0,
      "text": "Said Wukong."
    },
    {
      "i": 17,
      "start": 54.0,
      "end": 55.0,
      "text": "That's different."
    },
    {
      "i": 18,
      "start": 55.0,
      "end": 57.0,
      "text": "Said Guanyin."
    },
    {
      "i": 19,
      "start": 57.0,
      "end": 62.0,
      "text": "Demons are evil, and you're doing a good thing when you get rid of them."
    },
    {
      "i": 20,
      "start": 62.0,
      "end": 65.0,
      "text": "But you must not hurt people."
    },
    {
      "i": 21,
      "start": 66.0,
      "end": 70.0,
      "text": "The monkey sat down and put his head in his hands."
    },
    {
      "i": 22,
      "start": 70.0,
      "end": 73.0,
      "text": "Oh Bodhisattva, you're right."
    },
    {
      "i": 23,
      "start": 73.0,
      "end": 75.0,
      "text": "He started to cry."
    },
    {
      "i": 24,
      "start": 75.0,
      "end": 77.0,
      "text": "This is terrible."
    },
    {
      "i": 25,
      "start": 77.0,
      "end": 81.0,
      "text": "Now I'll never reach the Western Paradise with the Tang Monk."
    },
    {
      "i": 26,
      "start": 81.0,
      "end": 84.0,
      "text": "I wanted to earn forgiveness."
    },
    {
      "i": 27,
      "start": 85.0,
      "end": 87.0,
      "text": "Don't cry, Wukong."
    },
    {
      "i": 28,
      "start": 87.0,
      "end": 88.0,
      "text": "Said Guanyin."
    },
    {
      "i": 29,
      "start": 88.0,
      "end": 92.0,
      "text": "You will still help the Tang Monk reach the Western Paradise."
    },
    {
      "i": 30,
      "start": 92.0,
      "end": 95.0,
      "text": "He will need your help soon."
    },
    {
      "i": 31,
      "start": 95.0,
      "end": 99.0,
      "text": "In the meantime, you may stay here with me."
    },
    {
      "i": 32,
      "start": 104.0,
      "end": 107.0,
      "text": "Bajay dropped the bags."
    },
    {
      "i": 33,
      "start": 107.0,
      "end": 109.0,
      "text": "Let's rest here."
    },
    {
      "i": 34,
      "start": 109.0,
      "end": 110.0,
      "text": "He said."
    },
    {
      "i": 35,
      "start": 110.0,
      "end": 112.0,
      "text": "I'm starving."
    },
    {
      "i": 36,
      "start": 113.0,
      "end": 117.0,
      "text": "The Tang Monk climbed down from his horse and stretched."
    },
    {
      "i": 37,
      "start": 119.0,
      "end": 123.0,
      "text": "The horse drank from a stream while Bajay looked in a bag."
    },
    {
      "i": 38,
      "start": 123.0,
      "end": 125.0,
      "text": "We're out of rice."
    },
    {
      "i": 39,
      "start": 125.0,
      "end": 127.0,
      "text": "Said the pig."
    },
    {
      "i": 40,
      "start": 127.0,
      "end": 129.0,
      "text": "We'll have to beg for food somewhere."
    },
    {
      "i": 41,
      "start": 129.0,
      "end": 130.0,
      "text": "Said Wu Zheng."
    },
    {
      "i": 42,
      "start": 130.0,
      "end": 132.0,
      "text": "He looked at the monk."
    },
    {
      "i": 43,
      "start": 132.0,
      "end": 136.0,
      "text": "Master, you wait here while Bajay and I find a village."
    },
    {
      "i": 44,
      "start": 137.0,
      "end": 141.0,
      "text": "The monk's two companions flew off."
    },
    {
      "i": 45,
      "start": 141.0,
      "end": 146.0,
      "text": "The monk sat down in the grass next to the road and closed his eyes."
    },
    {
      "i": 46,
      "start": 146.0,
      "end": 150.0,
      "text": "He had nearly dozed off when he heard a voice."
    }
  ]
}
