{
  "episode": 54,
  "source": "assets/video/ep54.mp4",
  "model": "base",
  "duration": 300.559125,
  "segments": [
    {
      "i": 1,
      "start": 0.0,
      "end": 7.0,
      "text": "Journey to the West, Chapter 54. The River God."
    },
    {
      "i": 2,
      "start": 13.3,
      "end": 15.9,
      "text": "Woo-kong stared at the river."
    },
    {
      "i": 3,
      "start": 15.9,
      "end": 20.4,
      "text": "I should have stopped Master from getting in that canoe."
    },
    {
      "i": 4,
      "start": 20.4,
      "end": 24.0,
      "text": "But whenever I warned him about someone, he doesn't believe me."
    },
    {
      "i": 5,
      "start": 24.0,
      "end": 26.0,
      "text": "Woo-jing nodded."
    },
    {
      "i": 6,
      "start": 26.0,
      "end": 29.5,
      "text": "I find out where that man took our friends."
    },
    {
      "i": 7,
      "start": 29.5,
      "end": 31.5,
      "text": "The purple spirit dived into the river."
    },
    {
      "i": 8,
      "start": 36.0,
      "end": 38.5,
      "text": "He soon came to a palace."
    },
    {
      "i": 9,
      "start": 38.5,
      "end": 40.5,
      "text": "A sign on the gate read,"
    },
    {
      "i": 10,
      "start": 40.5,
      "end": 43.5,
      "text": "Home of the Black River God."
    },
    {
      "i": 11,
      "start": 43.5,
      "end": 46.5,
      "text": "Woo-jing tapped on the door with his spear."
    },
    {
      "i": 12,
      "start": 46.5,
      "end": 48.5,
      "text": "Open up."
    },
    {
      "i": 13,
      "start": 48.5,
      "end": 51.5,
      "text": "The door opened, and a lizard peaked out."
    },
    {
      "i": 14,
      "start": 51.5,
      "end": 54.5,
      "text": "What do you want?"
    },
    {
      "i": 15,
      "start": 54.5,
      "end": 55.5,
      "text": "Ask the lizard."
    },
    {
      "i": 16,
      "start": 55.5,
      "end": 57.5,
      "text": "I'm looking for my companions."
    },
    {
      "i": 17,
      "start": 57.5,
      "end": 59.5,
      "text": "Said Woo-jing."
    },
    {
      "i": 18,
      "start": 59.5,
      "end": 61.5,
      "text": "One is a monk and the other is a pig."
    },
    {
      "i": 19,
      "start": 61.5,
      "end": 64.5,
      "text": "They were kidnapped by a man."
    },
    {
      "i": 20,
      "start": 64.5,
      "end": 67.5,
      "text": "They were kidnapped by me."
    },
    {
      "i": 21,
      "start": 67.5,
      "end": 69.5,
      "text": "Said the lizard."
    },
    {
      "i": 22,
      "start": 69.5,
      "end": 70.5,
      "text": "You?"
    },
    {
      "i": 23,
      "start": 70.5,
      "end": 72.5,
      "text": "Said Woo-jing."
    },
    {
      "i": 24,
      "start": 72.5,
      "end": 73.5,
      "text": "Yes."
    },
    {
      "i": 25,
      "start": 73.5,
      "end": 75.5,
      "text": "The lizard smiled."
    },
    {
      "i": 26,
      "start": 75.5,
      "end": 80.5,
      "text": "I plan to eat the Tang monk and live forever."
    },
    {
      "i": 27,
      "start": 80.5,
      "end": 84.5,
      "text": "Woo-jing struck the lizard with his spear."
    },
    {
      "i": 28,
      "start": 84.5,
      "end": 88.5,
      "text": "The lizard spun around, blocking the spear with his tail."
    },
    {
      "i": 29,
      "start": 88.5,
      "end": 91.5,
      "text": "The force nearly knocked Woo-jing over."
    },
    {
      "i": 30,
      "start": 91.5,
      "end": 94.5,
      "text": "Right away, the lizard was on top of him."
    },
    {
      "i": 31,
      "start": 94.5,
      "end": 96.5,
      "text": "Get off me!"
    },
    {
      "i": 32,
      "start": 96.5,
      "end": 97.5,
      "text": "Shotted Woo-jing."
    },
    {
      "i": 33,
      "start": 97.5,
      "end": 100.5,
      "text": "He shoved the lizard."
    },
    {
      "i": 34,
      "start": 100.5,
      "end": 102.5,
      "text": "The lizard attacked again."
    },
    {
      "i": 35,
      "start": 102.5,
      "end": 107.5,
      "text": "Woo-jing swung his spear and then swam upward."
    },
    {
      "i": 36,
      "start": 107.5,
      "end": 112.5,
      "text": "He splashed out of the river and landed next to Woo-kong."
    },
    {
      "i": 37,
      "start": 113.5,
      "end": 115.5,
      "text": "There's a lizard demon down there."
    },
    {
      "i": 38,
      "start": 115.5,
      "end": 118.5,
      "text": "Said Woo-jing, breathing heavily."
    },
    {
      "i": 39,
      "start": 118.5,
      "end": 121.5,
      "text": "He's very powerful."
    },
    {
      "i": 40,
      "start": 121.5,
      "end": 125.5,
      "text": "Woo-kong was about to respond when he noticed someone nearby."
    },
    {
      "i": 41,
      "start": 125.5,
      "end": 129.5,
      "text": "The man from the canoe was walking toward them."
    },
    {
      "i": 42,
      "start": 129.5,
      "end": 132.5,
      "text": "The monkey pulled out his iron bar."
    },
    {
      "i": 43,
      "start": 132.5,
      "end": 135.5,
      "text": "I'll dare you kidnap our friends."
    },
    {
      "i": 44,
      "start": 135.5,
      "end": 138.5,
      "text": "The man felt his knees shaking."
    },
    {
      "i": 45,
      "start": 138.5,
      "end": 139.5,
      "text": "It wasn't me."
    },
    {
      "i": 46,
      "start": 139.5,
      "end": 141.5,
      "text": "He cried."
    },
    {
      "i": 47,
      "start": 141.5,
      "end": 143.5,
      "text": "It was a lizard demon."
    },
    {
      "i": 48,
      "start": 143.5,
      "end": 146.5,
      "text": "I am the black river god and this is my river."
    },
    {
      "i": 49,
      "start": 146.5,
      "end": 149.5,
      "text": "But that lizard pretended he was me."
    },
    {
      "i": 50,
      "start": 149.5,
      "end": 151.5,
      "text": "Woo-kong."
    }
  ]
}
