{
  "episode": 108,
  "source": "assets/video/ep108.mp4",
  "model": "base",
  "duration": 391.372375,
  "segments": [
    {
      "i": 1,
      "start": 0.0,
      "end": 5.48,
      "text": "Journey to the West, Chapter 108."
    },
    {
      "i": 2,
      "start": 5.48,
      "end": 13.04,
      "text": "Rewards."
    },
    {
      "i": 3,
      "start": 13.04,
      "end": 18.16,
      "text": "The travelers flew through the sky over the Tang Empire."
    },
    {
      "i": 4,
      "start": 18.16,
      "end": 22.28,
      "text": "Tears of happiness rolled down the Tang Monks' cheeks."
    },
    {
      "i": 5,
      "start": 22.28,
      "end": 26.32,
      "text": "I see the Emperor's palace."
    },
    {
      "i": 6,
      "start": 26.32,
      "end": 36.16,
      "text": "I will wait here while you all deliver the true scriptures."
    },
    {
      "i": 7,
      "start": 36.16,
      "end": 39.64,
      "text": "Said the guard."
    },
    {
      "i": 8,
      "start": 39.64,
      "end": 46.56,
      "text": "The Tang Monk and his companions went down to Earth and entered the palace."
    },
    {
      "i": 9,
      "start": 46.56,
      "end": 48.96,
      "text": "The Emperor's eyes lit up."
    },
    {
      "i": 10,
      "start": 48.96,
      "end": 50.4,
      "text": "My brother."
    },
    {
      "i": 11,
      "start": 50.4,
      "end": 53.56,
      "text": "He embraced the monk."
    },
    {
      "i": 12,
      "start": 53.56,
      "end": 57.16,
      "text": "For many years I wondered if I'd ever see you again."
    },
    {
      "i": 13,
      "start": 57.16,
      "end": 59.24,
      "text": "Did you get the true scriptures?"
    },
    {
      "i": 14,
      "start": 59.24,
      "end": 60.24,
      "text": "Yes."
    },
    {
      "i": 15,
      "start": 60.24,
      "end": 61.44,
      "text": "Said the monk."
    },
    {
      "i": 16,
      "start": 61.44,
      "end": 63.04,
      "text": "But please forgive me."
    },
    {
      "i": 17,
      "start": 63.04,
      "end": 66.52,
      "text": "The journey took much longer than I expected."
    },
    {
      "i": 18,
      "start": 66.52,
      "end": 68.68,
      "text": "There's no need to apologize."
    },
    {
      "i": 19,
      "start": 68.68,
      "end": 70.2,
      "text": "Said the Emperor."
    },
    {
      "i": 20,
      "start": 70.2,
      "end": 73.04,
      "text": "Then he noticed the monk's companions."
    },
    {
      "i": 21,
      "start": 73.04,
      "end": 75.16,
      "text": "Who are they?"
    },
    {
      "i": 22,
      "start": 75.16,
      "end": 77.88,
      "text": "Wukong stepped forward."
    },
    {
      "i": 23,
      "start": 77.88,
      "end": 81.48,
      "text": "I am Sun Wukong, the monkey king."
    },
    {
      "i": 24,
      "start": 81.48,
      "end": 85.56,
      "text": "I once defeated Heaven's entire army."
    },
    {
      "i": 25,
      "start": 85.56,
      "end": 87.92,
      "text": "And I am Zuba J."
    },
    {
      "i": 26,
      "start": 87.92,
      "end": 89.72,
      "text": "Said the pig."
    },
    {
      "i": 27,
      "start": 89.72,
      "end": 91.56,
      "text": "My name is Shah Wu Jing."
    },
    {
      "i": 28,
      "start": 91.56,
      "end": 93.88,
      "text": "Said the purple spirit."
    },
    {
      "i": 29,
      "start": 93.88,
      "end": 95.52,
      "text": "They protected me during the journey."
    },
    {
      "i": 30,
      "start": 95.52,
      "end": 97.44,
      "text": "The monk explained."
    },
    {
      "i": 31,
      "start": 97.44,
      "end": 101.28,
      "text": "I couldn't have reached the Western paradise without them."
    },
    {
      "i": 32,
      "start": 101.28,
      "end": 105.24,
      "text": "The Emperor bowed to Wukong and the others."
    },
    {
      "i": 33,
      "start": 105.24,
      "end": 107.28,
      "text": "The monkey laughed."
    },
    {
      "i": 34,
      "start": 107.28,
      "end": 108.96,
      "text": "You don't need a bow."
    },
    {
      "i": 35,
      "start": 108.96,
      "end": 110.64,
      "text": "We were happy to help."
    },
    {
      "i": 36,
      "start": 110.64,
      "end": 112.12,
      "text": "Who Jing and I were?"
    },
    {
      "i": 37,
      "start": 112.12,
      "end": 115.92,
      "text": "Bajay complained the entire time."
    },
    {
      "i": 38,
      "start": 115.92,
      "end": 120.32,
      "text": "The pig snorted."
    },
    {
      "i": 39,
      "start": 120.32,
      "end": 123.2,
      "text": "There was a huge feast that night."
    },
    {
      "i": 40,
      "start": 123.2,
      "end": 127.56,
      "text": "The Emperor asked the monk many questions about the journey."
    },
    {
      "i": 41,
      "start": 127.56,
      "end": 130.2,
      "text": "He listened in amazement to the monk's stories."
    },
    {
      "i": 42,
      "start": 134.56,
      "end": 137.04,
      "text": "I will build a magnificent pagoda."
    },
    {
      "i": 43,
      "start": 137.04,
      "end": 139.36,
      "text": "The Emperor declared."
    },
    {
      "i": 44,
      "start": 139.36,
      "end": 144.44,
      "text": "The true scriptures will be kept safe inside it."
    },
    {
      "i": 45,
      "start": 144.44,
      "end": 147.4,
      "text": "He put his hand on the monk's shoulder."
    },
    {
      "i": 46,
      "start": 147.4,
      "end": 150.0,
      "text": "You will always be remembered as the brave..."
    }
  ]
}
