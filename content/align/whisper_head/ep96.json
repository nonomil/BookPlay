{
  "episode": 96,
  "source": "assets/video/ep96.mp4",
  "model": "base",
  "duration": 341.1475625,
  "segments": [
    {
      "i": 1,
      "start": 0.0,
      "end": 14.32,
      "text": "Journey to the West, Chapter 96, Wind and Fog"
    },
    {
      "i": 2,
      "start": 14.32,
      "end": 16.64,
      "text": "I hope we reach the Western Paradise soon."
    },
    {
      "i": 3,
      "start": 16.64,
      "end": 19.08,
      "text": "Said the Tang Monk."
    },
    {
      "i": 4,
      "start": 19.08,
      "end": 22.12,
      "text": "This journey has been very dangerous."
    },
    {
      "i": 5,
      "start": 22.12,
      "end": 23.12,
      "text": "Bajay nodded."
    },
    {
      "i": 6,
      "start": 23.12,
      "end": 28.32,
      "text": "Those three demons tried to pickle me!"
    },
    {
      "i": 7,
      "start": 28.32,
      "end": 31.6,
      "text": "Everybody laughed, even Bajay."
    },
    {
      "i": 8,
      "start": 31.6,
      "end": 34.0,
      "text": "Wukong, what happened to those demons?"
    },
    {
      "i": 9,
      "start": 34.0,
      "end": 35.8,
      "text": "Asked Wu-Jing."
    },
    {
      "i": 10,
      "start": 35.8,
      "end": 37.16,
      "text": "Buddha took them away."
    },
    {
      "i": 11,
      "start": 37.16,
      "end": 38.56,
      "text": "Said Wukong."
    },
    {
      "i": 12,
      "start": 38.56,
      "end": 41.4,
      "text": "I'm sure they were punished."
    },
    {
      "i": 13,
      "start": 41.4,
      "end": 43.2,
      "text": "Thank you again for saving us."
    },
    {
      "i": 14,
      "start": 43.2,
      "end": 45.04,
      "text": "Said the Tang Monk."
    },
    {
      "i": 15,
      "start": 45.04,
      "end": 47.04,
      "text": "Wukong waved his hand."
    },
    {
      "i": 16,
      "start": 47.04,
      "end": 49.48,
      "text": "It was nothing, master."
    },
    {
      "i": 17,
      "start": 49.48,
      "end": 53.96,
      "text": "Buddha did most of the work."
    },
    {
      "i": 18,
      "start": 53.96,
      "end": 58.28,
      "text": "The group felt a strong wind blow down from the mountains up ahead."
    },
    {
      "i": 19,
      "start": 58.28,
      "end": 63.52,
      "text": "A dark fog filled the sky and then disappeared."
    },
    {
      "i": 20,
      "start": 63.52,
      "end": 65.4,
      "text": "The Tang Monk was nervous."
    },
    {
      "i": 21,
      "start": 65.4,
      "end": 69.28,
      "text": "What caused that wind and fog?"
    },
    {
      "i": 22,
      "start": 69.28,
      "end": 71.88,
      "text": "Relax, master."
    },
    {
      "i": 23,
      "start": 71.88,
      "end": 73.48,
      "text": "Said Wukong."
    },
    {
      "i": 24,
      "start": 73.48,
      "end": 75.64,
      "text": "I'm sure it was something harmless."
    },
    {
      "i": 25,
      "start": 75.64,
      "end": 77.16,
      "text": "Maybe some small demons."
    },
    {
      "i": 26,
      "start": 77.16,
      "end": 82.84,
      "text": "I'll go check."
    },
    {
      "i": 27,
      "start": 82.84,
      "end": 87.52,
      "text": "The Monk walked up the road and around a bend."
    },
    {
      "i": 28,
      "start": 87.52,
      "end": 90.36,
      "text": "He heard laughter and looked up."
    },
    {
      "i": 29,
      "start": 90.36,
      "end": 96.04,
      "text": "High above the road, a fat monster was sitting on the edge of a cliff."
    },
    {
      "i": 30,
      "start": 96.04,
      "end": 99.76,
      "text": "Several little demons sat next to the monster."
    },
    {
      "i": 31,
      "start": 99.76,
      "end": 103.48,
      "text": "Wukong blew up to get a closer look."
    },
    {
      "i": 32,
      "start": 103.48,
      "end": 107.0,
      "text": "The fat monster appeared to be concentrating."
    },
    {
      "i": 33,
      "start": 107.0,
      "end": 112.8,
      "text": "Suddenly, a burp as loud as thunder blew down."
    },
    {
      "i": 34,
      "start": 112.8,
      "end": 119.8,
      "text": "The demon giggled and laughed."
    },
    {
      "i": 35,
      "start": 119.8,
      "end": 121.56,
      "text": "That was your best burp yet."
    },
    {
      "i": 36,
      "start": 121.56,
      "end": 123.08,
      "text": "Cride one demon."
    },
    {
      "i": 37,
      "start": 123.08,
      "end": 124.88,
      "text": "The monster padded his belly."
    },
    {
      "i": 38,
      "start": 124.88,
      "end": 128.52,
      "text": "Yes, I'm proud of that one."
    },
    {
      "i": 39,
      "start": 128.52,
      "end": 130.08,
      "text": "Show us the fog again."
    },
    {
      "i": 40,
      "start": 130.08,
      "end": 131.96,
      "text": "Said another demon."
    },
    {
      "i": 41,
      "start": 131.96,
      "end": 133.88,
      "text": "Coming right up."
    },
    {
      "i": 42,
      "start": 133.88,
      "end": 135.6,
      "text": "Said the monster."
    },
    {
      "i": 43,
      "start": 135.6,
      "end": 142.36,
      "text": "He covered one nostril with a finger, closed his eyes and blew hard."
    },
    {
      "i": 44,
      "start": 142.36,
      "end": 149.16,
      "text": "The dark fog poured out of his other nostril."
    },
    {
      "i": 45,
      "start": 149.16,
      "end": 149.96,
      "text": "The demon's clapped."
    }
  ]
}
