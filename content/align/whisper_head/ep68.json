{
  "episode": 68,
  "source": "assets/video/ep68.mp4",
  "model": "base",
  "duration": 327.471,
  "segments": [
    {
      "i": 1,
      "start": 0.0,
      "end": 7.0,
      "text": "Journey to the West, Chapter 68. The Woman in the Crowd."
    },
    {
      "i": 2,
      "start": 14.0,
      "end": 17.0,
      "text": "Wukong stared at the cave door shocked."
    },
    {
      "i": 3,
      "start": 17.0,
      "end": 22.0,
      "text": "I don't believe it. One horned buffalo stole our weapons again!"
    },
    {
      "i": 4,
      "start": 23.0,
      "end": 25.0,
      "text": "What will we do now?"
    },
    {
      "i": 5,
      "start": 25.0,
      "end": 27.0,
      "text": "Ask the fire god."
    },
    {
      "i": 6,
      "start": 28.0,
      "end": 31.0,
      "text": "This demon's powers are stronger than any I've seen before."
    },
    {
      "i": 7,
      "start": 31.0,
      "end": 32.0,
      "text": "Said Wukong."
    },
    {
      "i": 8,
      "start": 33.0,
      "end": 36.0,
      "text": "I know one person who can definitely defeat him."
    },
    {
      "i": 9,
      "start": 36.0,
      "end": 37.0,
      "text": "Buddha."
    },
    {
      "i": 10,
      "start": 37.0,
      "end": 39.0,
      "text": "I'll be back soon."
    },
    {
      "i": 11,
      "start": 39.0,
      "end": 44.0,
      "text": "The monkey leaped onto a cloud and soared toward the west."
    },
    {
      "i": 12,
      "start": 45.0,
      "end": 49.0,
      "text": "He arrived at the Thunder Clap monastery."
    },
    {
      "i": 13,
      "start": 49.0,
      "end": 52.0,
      "text": "A guard at the gate stopped him."
    },
    {
      "i": 14,
      "start": 53.0,
      "end": 54.0,
      "text": "I need to ask Buddha for help."
    },
    {
      "i": 15,
      "start": 54.0,
      "end": 56.0,
      "text": "Wukong told the guard."
    },
    {
      "i": 16,
      "start": 56.0,
      "end": 59.0,
      "text": "It's about the Tang monks journey."
    },
    {
      "i": 17,
      "start": 59.0,
      "end": 62.0,
      "text": "The guard waved the monkey through."
    },
    {
      "i": 18,
      "start": 62.0,
      "end": 66.0,
      "text": "Wukong entered the monastery and bowed before Buddha."
    },
    {
      "i": 19,
      "start": 66.0,
      "end": 68.0,
      "text": "Greetings, Buddha."
    },
    {
      "i": 20,
      "start": 68.0,
      "end": 69.0,
      "text": "Said the monkey."
    },
    {
      "i": 21,
      "start": 69.0,
      "end": 70.0,
      "text": "I need..."
    },
    {
      "i": 22,
      "start": 70.0,
      "end": 72.0,
      "text": "Buddha held up a hand."
    },
    {
      "i": 23,
      "start": 72.0,
      "end": 75.0,
      "text": "I know why you're here, Wukong."
    },
    {
      "i": 24,
      "start": 75.0,
      "end": 79.0,
      "text": "I also know who the demon is."
    },
    {
      "i": 25,
      "start": 79.0,
      "end": 82.0,
      "text": "You must go to Lausa for help."
    },
    {
      "i": 26,
      "start": 82.0,
      "end": 84.0,
      "text": "Oh, okay."
    },
    {
      "i": 27,
      "start": 84.0,
      "end": 85.0,
      "text": "Said the monkey."
    },
    {
      "i": 28,
      "start": 85.0,
      "end": 87.0,
      "text": "A bit surprised."
    },
    {
      "i": 29,
      "start": 87.0,
      "end": 88.0,
      "text": "Thank you."
    },
    {
      "i": 30,
      "start": 89.0,
      "end": 92.0,
      "text": "Wukong flew toward heaven."
    },
    {
      "i": 31,
      "start": 92.0,
      "end": 94.0,
      "text": "Lausa doesn't like me much."
    },
    {
      "i": 32,
      "start": 94.0,
      "end": 95.0,
      "text": "Thought the monkey."
    },
    {
      "i": 33,
      "start": 95.0,
      "end": 98.0,
      "text": "You won't be happy to see me."
    },
    {
      "i": 34,
      "start": 103.0,
      "end": 107.0,
      "text": "When Wukong arrived at Lausa's house, the sage frowned."
    },
    {
      "i": 35,
      "start": 107.0,
      "end": 109.0,
      "text": "What do you want, Wukong?"
    },
    {
      "i": 36,
      "start": 109.0,
      "end": 110.0,
      "text": "Asked Lausa."
    },
    {
      "i": 37,
      "start": 111.0,
      "end": 112.0,
      "text": "Buddha told me to come here."
    },
    {
      "i": 38,
      "start": 112.0,
      "end": 113.0,
      "text": "Said Wukong."
    },
    {
      "i": 39,
      "start": 113.0,
      "end": 118.0,
      "text": "The Tang monk was captured by a demon called one horned buffalo."
    },
    {
      "i": 40,
      "start": 118.0,
      "end": 119.0,
      "text": "Oh, dear."
    },
    {
      "i": 41,
      "start": 119.0,
      "end": 121.0,
      "text": "Said Lausa."
    },
    {
      "i": 42,
      "start": 121.0,
      "end": 122.0,
      "text": "Do you know him?"
    },
    {
      "i": 43,
      "start": 122.0,
      "end": 123.0,
      "text": "Asked the monkey."
    },
    {
      "i": 44,
      "start": 123.0,
      "end": 125.0,
      "text": "Lausa nodded."
    },
    {
      "i": 45,
      "start": 125.0,
      "end": 126.0,
      "text": "He's my green buffalo."
    },
    {
      "i": 46,
      "start": 126.0,
      "end": 129.0,
      "text": "I didn't realize he'd escaped."
    },
    {
      "i": 47,
      "start": 130.0,
      "end": 131.0,
      "text": "Well, he did."
    },
    {
      "i": 48,
      "start": 131.0,
      "end": 133.0,
      "text": "Said Wukong, getting annoyed."
    },
    {
      "i": 49,
      "start": 133.0,
      "end": 136.0,
      "text": "And he's planning to eat the Tang monk."
    },
    {
      "i": 50,
      "start": 137.0,
      "end": 140.0,
      "text": "Your buffalo also has a metal ring."
    },
    {
      "i": 51,
      "start": 141.0,
      "end": 144.0,
      "text": "Every time we try to fight him, the ring sucks in our weapons."
    },
    {
      "i": 52,
      "start": 145.0,
      "end": 147.0,
      "text": "Lausa held up his hands."
    },
    {
      "i": 53,
      "start": 147.0,
      "end": 148.0,
      "text": "Okay, okay."
    },
    {
      "i": 54,
      "start": 148.0,
      "end": 150.0,
      "text": "I can capture the buffalo."
    }
  ]
}
