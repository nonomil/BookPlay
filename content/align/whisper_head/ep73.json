{
  "episode": 73,
  "source": "assets/video/ep73.mp4",
  "model": "base",
  "duration": 324.6381875,
  "segments": [
    {
      "i": 1,
      "start": 0.0,
      "end": 7.0,
      "text": "Journey to the West, Chapter 73, two Wukong's."
    },
    {
      "i": 2,
      "start": 15.0,
      "end": 20.0,
      "text": "Wuzing watched as the fake Wuzing fed the horse some hay."
    },
    {
      "i": 3,
      "start": 20.0,
      "end": 23.0,
      "text": "I don't know how you made fake versions of a swu-kong."
    },
    {
      "i": 4,
      "start": 23.0,
      "end": 25.0,
      "text": "Said the purple spirit."
    },
    {
      "i": 5,
      "start": 25.0,
      "end": 29.0,
      "text": "But you won't get the true scriptures without the real Tang monk."
    },
    {
      "i": 6,
      "start": 30.0,
      "end": 32.0,
      "text": "Wukong folded his arms."
    },
    {
      "i": 7,
      "start": 32.0,
      "end": 34.0,
      "text": "Oh, yes I will."
    },
    {
      "i": 8,
      "start": 35.0,
      "end": 38.0,
      "text": "Wuzing leaped into the air and flew south."
    },
    {
      "i": 9,
      "start": 39.0,
      "end": 42.0,
      "text": "I'll tell the Bodhisattva what Wukong is doing."
    },
    {
      "i": 10,
      "start": 42.0,
      "end": 43.0,
      "text": "He thought."
    },
    {
      "i": 11,
      "start": 43.0,
      "end": 45.0,
      "text": "She can stop him."
    },
    {
      "i": 12,
      "start": 46.0,
      "end": 50.0,
      "text": "When Wuzing arrived at Mount Potalaka, he was even more shocked."
    },
    {
      "i": 13,
      "start": 51.0,
      "end": 55.0,
      "text": "Wukong was meditating in the Bodhisattva's garden."
    },
    {
      "i": 14,
      "start": 56.0,
      "end": 57.0,
      "text": "Wukong!"
    },
    {
      "i": 15,
      "start": 57.0,
      "end": 58.0,
      "text": "cried Wuzing."
    },
    {
      "i": 16,
      "start": 58.0,
      "end": 60.0,
      "text": "How did you get here so fast?"
    },
    {
      "i": 17,
      "start": 61.0,
      "end": 62.0,
      "text": "What are you talking about?"
    },
    {
      "i": 18,
      "start": 62.0,
      "end": 63.0,
      "text": "Ask the monkey."
    },
    {
      "i": 19,
      "start": 63.0,
      "end": 66.0,
      "text": "Guanyin came out of her pagoda."
    },
    {
      "i": 20,
      "start": 69.0,
      "end": 71.0,
      "text": "Wuzing, what are you doing here?"
    },
    {
      "i": 21,
      "start": 71.0,
      "end": 73.0,
      "text": "The purple spirit bowed."
    },
    {
      "i": 22,
      "start": 74.0,
      "end": 76.0,
      "text": "Bodhisattva, I must speak with you."
    },
    {
      "i": 23,
      "start": 77.0,
      "end": 81.0,
      "text": "Wukong has made fake versions of me, Barjay and the Tang monk."
    },
    {
      "i": 24,
      "start": 81.0,
      "end": 84.0,
      "text": "He's planning to make the journey without us."
    },
    {
      "i": 25,
      "start": 84.0,
      "end": 85.0,
      "text": "What?"
    },
    {
      "i": 26,
      "start": 85.0,
      "end": 86.0,
      "text": "Shattered Wukong."
    },
    {
      "i": 27,
      "start": 87.0,
      "end": 89.0,
      "text": "Wuzing glanced at the monkey."
    },
    {
      "i": 28,
      "start": 89.0,
      "end": 92.0,
      "text": "Like just saw him on the fruit and flower mountain."
    },
    {
      "i": 29,
      "start": 92.0,
      "end": 95.0,
      "text": "I don't know how he got here before me."
    },
    {
      "i": 30,
      "start": 97.0,
      "end": 98.0,
      "text": "You're lying."
    },
    {
      "i": 31,
      "start": 98.0,
      "end": 100.0,
      "text": "Yeld Wukong."
    },
    {
      "i": 32,
      "start": 100.0,
      "end": 101.0,
      "text": "Guanyin smiled."
    },
    {
      "i": 33,
      "start": 102.0,
      "end": 104.0,
      "text": "You're mistaken, Wuzing."
    },
    {
      "i": 34,
      "start": 104.0,
      "end": 106.0,
      "text": "Wukong has been here the whole time."
    },
    {
      "i": 35,
      "start": 107.0,
      "end": 109.0,
      "text": "Wuzing was surprised."
    },
    {
      "i": 36,
      "start": 109.0,
      "end": 110.0,
      "text": "Yes."
    },
    {
      "i": 37,
      "start": 111.0,
      "end": 112.0,
      "text": "Guanyin nodded."
    },
    {
      "i": 38,
      "start": 113.0,
      "end": 115.0,
      "text": "Wukong made a fist."
    },
    {
      "i": 39,
      "start": 115.0,
      "end": 117.0,
      "text": "Someone is pretending to be me."
    },
    {
      "i": 40,
      "start": 117.0,
      "end": 119.0,
      "text": "And he's living on my mountain."
    },
    {
      "i": 41,
      "start": 120.0,
      "end": 122.0,
      "text": "I'm going there right now."
    },
    {
      "i": 42,
      "start": 122.0,
      "end": 124.0,
      "text": "I'm going to destroy him."
    },
    {
      "i": 43,
      "start": 124.0,
      "end": 126.0,
      "text": "I'll go with you."
    },
    {
      "i": 44,
      "start": 126.0,
      "end": 127.0,
      "text": "Said Wuzing."
    },
    {
      "i": 45,
      "start": 131.0,
      "end": 135.0,
      "text": "Wukong and Wuzing soon arrived on the fruit and flower mountain."
    },
    {
      "i": 46,
      "start": 135.0,
      "end": 142.0,
      "text": "The monkey's eyes burned with anger when he saw the fake Wukong."
    },
    {
      "i": 47,
      "start": 142.0,
      "end": 144.0,
      "text": "Who are you?"
    },
    {
      "i": 48,
      "start": 144.0,
      "end": 145.0,
      "text": "Demanded Wukong."
    },
    {
      "i": 49,
      "start": 146.0,
      "end": 148.0,
      "text": "Who are you?"
    },
    {
      "i": 50,
      "start": 148.0,
      "end": 150.0,
      "text": "Ask the fake Wukong."
    }
  ]
}
