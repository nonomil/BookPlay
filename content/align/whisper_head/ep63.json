{
  "episode": 63,
  "source": "assets/video/ep63.mp4",
  "model": "base",
  "duration": 295.61325,
  "segments": [
    {
      "i": 1,
      "start": 0.0,
      "end": 3.6,
      "text": "Journey to the West"
    },
    {
      "i": 2,
      "start": 3.6,
      "end": 5.0,
      "text": "Chapter 63"
    },
    {
      "i": 3,
      "start": 5.0,
      "end": 7.0,
      "text": "A question for Buddha"
    },
    {
      "i": 4,
      "start": 13.2,
      "end": 18.2,
      "text": "The Tangmung jumped to his feet as the villagers hid behind trees"
    },
    {
      "i": 5,
      "start": 18.2,
      "end": 22.2,
      "text": "Wukong woo-ching and Bajai pulled out their weapons"
    },
    {
      "i": 6,
      "start": 22.2,
      "end": 25.8,
      "text": "A large shell rose from the water"
    },
    {
      "i": 7,
      "start": 25.8,
      "end": 27.4,
      "text": "It's a giant turtle"
    },
    {
      "i": 8,
      "start": 27.4,
      "end": 29.2,
      "text": "Said Bajai"
    },
    {
      "i": 9,
      "start": 29.4,
      "end": 32.4,
      "text": "The turtle bowed its head toward Wukong"
    },
    {
      "i": 10,
      "start": 32.4,
      "end": 36.0,
      "text": "That demon had taken over my house and river"
    },
    {
      "i": 11,
      "start": 36.0,
      "end": 38.8,
      "text": "Thank you for getting rid of him"
    },
    {
      "i": 12,
      "start": 38.8,
      "end": 41.8,
      "text": "The turtle then looked at the villagers"
    },
    {
      "i": 13,
      "start": 41.8,
      "end": 44.8,
      "text": "You don't need to make a boat"
    },
    {
      "i": 14,
      "start": 44.8,
      "end": 48.4,
      "text": "I can take the travelers across the river"
    },
    {
      "i": 15,
      "start": 48.4,
      "end": 49.4,
      "text": "That's wonderful"
    },
    {
      "i": 16,
      "start": 49.4,
      "end": 51.0,
      "text": "Said the Tangmung"
    },
    {
      "i": 17,
      "start": 51.0,
      "end": 53.4,
      "text": "I'm from the Tang Empire and"
    },
    {
      "i": 18,
      "start": 53.4,
      "end": 55.0,
      "text": "I know who you are"
    },
    {
      "i": 19,
      "start": 55.0,
      "end": 57.0,
      "text": "Interrupted the turtle"
    },
    {
      "i": 20,
      "start": 57.0,
      "end": 62.0,
      "text": "You're traveling to the Western Paradise to get scriptures from Buddha"
    },
    {
      "i": 21,
      "start": 62.0,
      "end": 65.6,
      "text": "I knew you would cross my river eventually"
    },
    {
      "i": 22,
      "start": 65.6,
      "end": 67.6,
      "text": "Climb onto my shell"
    },
    {
      "i": 23,
      "start": 67.6,
      "end": 71.6,
      "text": "Wukong eyed the turtle suspiciously"
    },
    {
      "i": 24,
      "start": 71.6,
      "end": 74.4,
      "text": "How do we know he can trust you?"
    },
    {
      "i": 25,
      "start": 74.4,
      "end": 79.2,
      "text": "Demons all along the way are waiting for my master to pass by"
    },
    {
      "i": 26,
      "start": 79.2,
      "end": 80.8,
      "text": "They all want to eat him"
    },
    {
      "i": 27,
      "start": 80.8,
      "end": 82.8,
      "text": "Added Bajai"
    },
    {
      "i": 28,
      "start": 82.8,
      "end": 85.8,
      "text": "I promise I won't hurt the Tangmung"
    },
    {
      "i": 29,
      "start": 85.8,
      "end": 88.0,
      "text": "Said the turtle"
    },
    {
      "i": 30,
      "start": 88.0,
      "end": 95.0,
      "text": "I want to help him reach the Western Paradise"
    },
    {
      "i": 31,
      "start": 95.0,
      "end": 98.0,
      "text": "After a little more hesitation, the travelers"
    },
    {
      "i": 32,
      "start": 98.0,
      "end": 101.2,
      "text": "Stucked onto the turtle's shell"
    },
    {
      "i": 33,
      "start": 101.2,
      "end": 104.2,
      "text": "The turtle began to paddle"
    },
    {
      "i": 34,
      "start": 104.2,
      "end": 108.2,
      "text": "The villagers came out from behind the trees and waved"
    },
    {
      "i": 35,
      "start": 108.2,
      "end": 109.2,
      "text": "Goodbye"
    },
    {
      "i": 36,
      "start": 109.2,
      "end": 111.0,
      "text": "Called a woman"
    },
    {
      "i": 37,
      "start": 111.0,
      "end": 113.2,
      "text": "Please visit us on your way home"
    },
    {
      "i": 38,
      "start": 113.2,
      "end": 115.2,
      "text": "Shout at someone else"
    },
    {
      "i": 39,
      "start": 115.4,
      "end": 116.8,
      "text": "We will I promise"
    },
    {
      "i": 40,
      "start": 116.8,
      "end": 118.8,
      "text": "Called the monk"
    },
    {
      "i": 41,
      "start": 118.8,
      "end": 122.2,
      "text": "Soon the turtle was far from shore"
    },
    {
      "i": 42,
      "start": 122.2,
      "end": 124.4,
      "text": "Bajai fell asleep"
    },
    {
      "i": 43,
      "start": 124.4,
      "end": 127.4,
      "text": "The turtle glanced back at the Tangmung"
    },
    {
      "i": 44,
      "start": 127.4,
      "end": 131.4,
      "text": "Excuse me, but can you do me a favor?"
    },
    {
      "i": 45,
      "start": 131.4,
      "end": 132.4,
      "text": "Of course"
    },
    {
      "i": 46,
      "start": 132.4,
      "end": 133.8,
      "text": "Said the monk"
    },
    {
      "i": 47,
      "start": 133.8,
      "end": 136.0,
      "text": "What do you need me to do?"
    },
    {
      "i": 48,
      "start": 136.0,
      "end": 139.4,
      "text": "I have been a good Buddhist for over a thousand years"
    },
    {
      "i": 49,
      "start": 139.4,
      "end": 140.8,
      "text": "Said the turtle"
    },
    {
      "i": 50,
      "start": 140.8,
      "end": 144.4,
      "text": "But sadly I'm still just a turtle"
    },
    {
      "i": 51,
      "start": 144.4,
      "end": 148.2,
      "text": "Can you ask Buddha when I will be reborn as a human?"
    },
    {
      "i": 52,
      "start": 148.2,
      "end": 149.8,
      "text": "The Tangmung nodded"
    },
    {
      "i": 53,
      "start": 149.8,
      "end": 150.8,
      "text": "I..."
    }
  ]
}
