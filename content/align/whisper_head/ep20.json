{
  "episode": 20,
  "source": "assets/video/ep20.mp4",
  "model": "base",
  "duration": 304.5529375,
  "segments": [
    {
      "i": 1,
      "start": 0.0,
      "end": 7.0,
      "text": "Journey to the West, Chapter 20, The Black Bear Spirit."
    },
    {
      "i": 2,
      "start": 14.0,
      "end": 17.0,
      "text": "Wukong glared at the two scared priests."
    },
    {
      "i": 3,
      "start": 18.0,
      "end": 19.0,
      "text": "The robe is gone."
    },
    {
      "i": 4,
      "start": 19.0,
      "end": 20.0,
      "text": "He cried."
    },
    {
      "i": 5,
      "start": 21.0,
      "end": 22.0,
      "text": "Where did it go?"
    },
    {
      "i": 6,
      "start": 23.0,
      "end": 24.0,
      "text": "We don't know."
    },
    {
      "i": 7,
      "start": 24.0,
      "end": 25.0,
      "text": "Said one priest."
    },
    {
      "i": 8,
      "start": 26.0,
      "end": 27.0,
      "text": "We tried to find it."
    },
    {
      "i": 9,
      "start": 27.0,
      "end": 28.0,
      "text": "Added the other."
    },
    {
      "i": 10,
      "start": 29.0,
      "end": 31.0,
      "text": "The robe was in a room that didn't get burned at all."
    },
    {
      "i": 11,
      "start": 32.0,
      "end": 33.0,
      "text": "But it's not there anymore."
    },
    {
      "i": 12,
      "start": 34.0,
      "end": 38.0,
      "text": "His iron bar instantly appeared from inside his ear."
    },
    {
      "i": 13,
      "start": 39.0,
      "end": 40.0,
      "text": "Glow!"
    },
    {
      "i": 14,
      "start": 40.0,
      "end": 41.0,
      "text": "Commanded Wukong."
    },
    {
      "i": 15,
      "start": 42.0,
      "end": 45.0,
      "text": "The monkey swung it toward the two priests."
    },
    {
      "i": 16,
      "start": 46.0,
      "end": 49.0,
      "text": "But before the bar hit them, it dropped from the monkey's hands."
    },
    {
      "i": 17,
      "start": 51.0,
      "end": 54.0,
      "text": "Wukong fell to the ground crying in pain."
    },
    {
      "i": 18,
      "start": 54.0,
      "end": 56.0,
      "text": "It hurts, it hurts."
    },
    {
      "i": 19,
      "start": 56.0,
      "end": 57.0,
      "text": "He cried."
    },
    {
      "i": 20,
      "start": 58.0,
      "end": 61.0,
      "text": "The Tang monk was quietly reciting the tight headband spell."
    },
    {
      "i": 21,
      "start": 62.0,
      "end": 65.0,
      "text": "Wukong rolled around kicking and screaming."
    },
    {
      "i": 22,
      "start": 66.0,
      "end": 68.0,
      "text": "The two priests jumped up and backed away."
    },
    {
      "i": 23,
      "start": 69.0,
      "end": 70.0,
      "text": "Stop reciting the spell!"
    },
    {
      "i": 24,
      "start": 71.0,
      "end": 72.0,
      "text": "Wukong yelled at the Tang monk."
    },
    {
      "i": 25,
      "start": 73.0,
      "end": 76.0,
      "text": "I beggin you, I won't hurt the priests."
    },
    {
      "i": 26,
      "start": 77.0,
      "end": 80.0,
      "text": "The Tang monk stopped and Wukong stood up."
    },
    {
      "i": 27,
      "start": 81.0,
      "end": 88.0,
      "text": "The monkey took a deep breath and put the iron bar back in his ear."
    },
    {
      "i": 28,
      "start": 89.0,
      "end": 91.0,
      "text": "The Tang monk looked at the two priests."
    },
    {
      "i": 29,
      "start": 92.0,
      "end": 94.0,
      "text": "You really don't know where the robe is?"
    },
    {
      "i": 30,
      "start": 95.0,
      "end": 96.0,
      "text": "No."
    },
    {
      "i": 31,
      "start": 96.0,
      "end": 97.0,
      "text": "Said one priest."
    },
    {
      "i": 32,
      "start": 98.0,
      "end": 100.0,
      "text": "The head priest ran away last night."
    },
    {
      "i": 33,
      "start": 100.0,
      "end": 102.0,
      "text": "He didn't have it with him."
    },
    {
      "i": 34,
      "start": 103.0,
      "end": 104.0,
      "text": "Wukong tapped his chin."
    },
    {
      "i": 35,
      "start": 105.0,
      "end": 107.0,
      "text": "A monster or demon might have stolen it."
    },
    {
      "i": 36,
      "start": 108.0,
      "end": 111.0,
      "text": "Are there any monsters or demons living near here?"
    },
    {
      "i": 37,
      "start": 112.0,
      "end": 115.0,
      "text": "Some people believe there's a monster in the mountains nearby."
    },
    {
      "i": 38,
      "start": 115.0,
      "end": 116.0,
      "text": "Said the other priest."
    },
    {
      "i": 39,
      "start": 117.0,
      "end": 119.0,
      "text": "They say it's a black bear spirit."
    },
    {
      "i": 40,
      "start": 120.0,
      "end": 122.0,
      "text": "I'll go see if the bear took the robe."
    },
    {
      "i": 41,
      "start": 122.0,
      "end": 123.0,
      "text": "Said Wukong."
    },
    {
      "i": 42,
      "start": 124.0,
      "end": 125.0,
      "text": "I'll be back soon."
    },
    {
      "i": 43,
      "start": 126.0,
      "end": 129.0,
      "text": "Wukong leaped into the air and landed up in mountains."
    },
    {
      "i": 44,
      "start": 129.0,
      "end": 136.0,
      "text": "He walked for a bit and then heard voices."
    },
    {
      "i": 45,
      "start": 138.0,
      "end": 142.0,
      "text": "Peeking over a boulder, he saw a group of spirits talking."
    },
    {
      "i": 46,
      "start": 143.0,
      "end": 145.0,
      "text": "One was a large black bear."
    },
    {
      "i": 47,
      "start": 147.0,
      "end": 148.0,
      "text": "The bear laughed."
    }
  ]
}
