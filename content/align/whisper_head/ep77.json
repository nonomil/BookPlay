{
  "episode": 77,
  "source": "assets/video/ep77.mp4",
  "model": "base",
  "duration": 327.1691875,
  "segments": [
    {
      "i": 1,
      "start": 0.0,
      "end": 7.0,
      "text": "Journey to the West, Chapter 77, The Magic Fan"
    },
    {
      "i": 2,
      "start": 13.0,
      "end": 18.0,
      "text": "For over a day, the wind from the fan carried Wukong"
    },
    {
      "i": 3,
      "start": 18.0,
      "end": 24.0,
      "text": "When he finally landed, he was far from the irony Mordel's mountain"
    },
    {
      "i": 4,
      "start": 25.0,
      "end": 30.0,
      "text": "Wukong looked around and saw a mountain nearby. It looked familiar"
    },
    {
      "i": 5,
      "start": 31.0,
      "end": 33.0,
      "text": "Mount Sumeru said Wukong"
    },
    {
      "i": 6,
      "start": 34.0,
      "end": 36.0,
      "text": "The Bodhisattva Linge lives there"
    },
    {
      "i": 7,
      "start": 36.0,
      "end": 39.0,
      "text": "Maybe he can help me deal with the iron and Mordel"
    },
    {
      "i": 8,
      "start": 39.0,
      "end": 43.0,
      "text": "He was able to stop the great King Yellow Winds wind magic"
    },
    {
      "i": 9,
      "start": 45.0,
      "end": 48.0,
      "text": "The monkey went to Linge's pagoda"
    },
    {
      "i": 10,
      "start": 50.0,
      "end": 53.0,
      "text": "The Bodhisattva was sitting in his garden"
    },
    {
      "i": 11,
      "start": 53.0,
      "end": 55.0,
      "text": "Greetings Bodhisattva"
    },
    {
      "i": 12,
      "start": 55.0,
      "end": 56.0,
      "text": "said Wukong"
    },
    {
      "i": 13,
      "start": 57.0,
      "end": 58.0,
      "text": "Hello Wukong"
    },
    {
      "i": 14,
      "start": 58.0,
      "end": 60.0,
      "text": "said Linge"
    },
    {
      "i": 15,
      "start": 60.0,
      "end": 62.0,
      "text": "It's good to see you again"
    },
    {
      "i": 16,
      "start": 62.0,
      "end": 64.0,
      "text": "I was just about to have tea"
    },
    {
      "i": 17,
      "start": 66.0,
      "end": 70.0,
      "text": "Wukong and Linge sat outside drinking tea"
    },
    {
      "i": 18,
      "start": 70.0,
      "end": 75.0,
      "text": "The monkey told the Bodhisattva everything that had happened with the irony Mordel"
    },
    {
      "i": 19,
      "start": 75.0,
      "end": 79.0,
      "text": "The Bodhisattva handed a small stone to Wukong"
    },
    {
      "i": 20,
      "start": 80.0,
      "end": 82.0,
      "text": "Keep this magic stone in your pocket"
    },
    {
      "i": 21,
      "start": 82.0,
      "end": 85.0,
      "text": "It will stop the wind from blowing you away"
    },
    {
      "i": 22,
      "start": 86.0,
      "end": 88.0,
      "text": "Thank you Bodhisattva"
    },
    {
      "i": 23,
      "start": 88.0,
      "end": 89.0,
      "text": "Said the monkey"
    },
    {
      "i": 24,
      "start": 89.0,
      "end": 92.0,
      "text": "Would you like to stay for lunch?"
    },
    {
      "i": 25,
      "start": 92.0,
      "end": 93.0,
      "text": "Astalingji"
    },
    {
      "i": 26,
      "start": 93.0,
      "end": 94.0,
      "text": "No thank you"
    },
    {
      "i": 27,
      "start": 94.0,
      "end": 96.0,
      "text": "Said Wukong"
    },
    {
      "i": 28,
      "start": 96.0,
      "end": 98.0,
      "text": "I must get back to my companions"
    },
    {
      "i": 29,
      "start": 99.0,
      "end": 103.0,
      "text": "I need to get that fan from the iron and Mordel so we can continue west"
    },
    {
      "i": 30,
      "start": 104.0,
      "end": 107.0,
      "text": "Wukong returned to the irony Mordel's cave door"
    },
    {
      "i": 31,
      "start": 109.0,
      "end": 110.0,
      "text": "Open up"
    },
    {
      "i": 32,
      "start": 110.0,
      "end": 111.0,
      "text": "He shouted"
    },
    {
      "i": 33,
      "start": 111.0,
      "end": 113.0,
      "text": "I need your fan"
    },
    {
      "i": 34,
      "start": 117.0,
      "end": 120.0,
      "text": "The irony Mordel came out and wrinkled her nose"
    },
    {
      "i": 35,
      "start": 121.0,
      "end": 123.0,
      "text": "I thought I got rid of you"
    },
    {
      "i": 36,
      "start": 123.0,
      "end": 125.0,
      "text": "He raised her fan"
    },
    {
      "i": 37,
      "start": 125.0,
      "end": 128.0,
      "text": "I'll just have to wave harder this time"
    },
    {
      "i": 38,
      "start": 129.0,
      "end": 131.0,
      "text": "The woman waved the fan furiously"
    },
    {
      "i": 39,
      "start": 133.0,
      "end": 135.0,
      "text": "A terrible wind Wukong passed Wukong"
    },
    {
      "i": 40,
      "start": 136.0,
      "end": 138.0,
      "text": "But the monkey didn't move"
    },
    {
      "i": 41,
      "start": 139.0,
      "end": 142.0,
      "text": "The irony Mordel's eyes burned with anger"
    },
    {
      "i": 42,
      "start": 142.0,
      "end": 143.0,
      "text": "How did you?"
    },
    {
      "i": 43,
      "start": 145.0,
      "end": 148.0,
      "text": "The Bodhisattva Linge gave me a magic stone"
    },
    {
      "i": 44,
      "start": 148.0,
      "end": 149.0,
      "text": "Said Wukong"
    }
  ]
}
