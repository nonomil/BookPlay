{
  "episode": 89,
  "source": "assets/video/ep89.mp4",
  "model": "base",
  "duration": 316.580875,
  "segments": [
    {
      "i": 1,
      "start": 0.0,
      "end": 3.6,
      "text": "Journey to the West."
    },
    {
      "i": 2,
      "start": 3.6,
      "end": 5.44,
      "text": "Chapter 89."
    },
    {
      "i": 3,
      "start": 5.44,
      "end": 14.96,
      "text": "Many Eyes."
    },
    {
      "i": 4,
      "start": 14.96,
      "end": 19.2,
      "text": "Wukong gasped as his companions began to look ill."
    },
    {
      "i": 5,
      "start": 19.2,
      "end": 25.08,
      "text": "The Tang monks head bobbed forward and his teacup dropped from his hand."
    },
    {
      "i": 6,
      "start": 25.08,
      "end": 27.48,
      "text": "And then, thumped."
    },
    {
      "i": 7,
      "start": 27.48,
      "end": 29.76,
      "text": "The monk toppled to the floor."
    },
    {
      "i": 8,
      "start": 29.76,
      "end": 38.4,
      "text": "A moment later, Wu Xing and Ba Jie passed out, too."
    },
    {
      "i": 9,
      "start": 38.4,
      "end": 42.28,
      "text": "Wukong jumped to his feet and pulled out his iron bar."
    },
    {
      "i": 10,
      "start": 42.28,
      "end": 44.6,
      "text": "The priest backed away."
    },
    {
      "i": 11,
      "start": 44.6,
      "end": 50.44,
      "text": "Just then, a door burst open and the three women ran into the room."
    },
    {
      "i": 12,
      "start": 50.44,
      "end": 51.44,
      "text": "You again?"
    },
    {
      "i": 13,
      "start": 51.44,
      "end": 53.08,
      "text": "Cried the monkey."
    },
    {
      "i": 14,
      "start": 53.08,
      "end": 56.8,
      "text": "He leaped out of the way as the women shot webs at him."
    },
    {
      "i": 15,
      "start": 56.8,
      "end": 62.16,
      "text": "He jumped up, did a flip in the air and landed directly behind the women."
    },
    {
      "i": 16,
      "start": 62.16,
      "end": 65.36,
      "text": "Furiously, he slammed his iron bar down."
    },
    {
      "i": 17,
      "start": 65.36,
      "end": 66.36,
      "text": "WAM!"
    },
    {
      "i": 18,
      "start": 66.36,
      "end": 69.6,
      "text": "There was a puff of smoke."
    },
    {
      "i": 19,
      "start": 69.6,
      "end": 74.88,
      "text": "When it cleared, a dead spider lay where one of the women had been."
    },
    {
      "i": 20,
      "start": 74.88,
      "end": 77.8,
      "text": "The other two women stared in horror."
    },
    {
      "i": 21,
      "start": 77.8,
      "end": 79.64,
      "text": "He destroyed our sister."
    },
    {
      "i": 22,
      "start": 79.64,
      "end": 80.64,
      "text": "Cried one."
    },
    {
      "i": 23,
      "start": 80.64,
      "end": 82.36,
      "text": "He's a monster."
    },
    {
      "i": 24,
      "start": 82.36,
      "end": 84.8,
      "text": "Cry the other."
    },
    {
      "i": 25,
      "start": 84.8,
      "end": 87.04,
      "text": "Wukong charged toward them."
    },
    {
      "i": 26,
      "start": 87.04,
      "end": 90.36,
      "text": "He knocked flying webs out of his way and then..."
    },
    {
      "i": 27,
      "start": 90.36,
      "end": 91.36,
      "text": "Cwack!"
    },
    {
      "i": 28,
      "start": 91.36,
      "end": 92.36,
      "text": "Bam!"
    },
    {
      "i": 29,
      "start": 92.36,
      "end": 96.28,
      "text": "Both women were gone."
    },
    {
      "i": 30,
      "start": 96.28,
      "end": 100.48,
      "text": "In their places, lay dead spiders."
    },
    {
      "i": 31,
      "start": 100.48,
      "end": 102.92,
      "text": "Those spider spirits were my dear friends."
    },
    {
      "i": 32,
      "start": 102.92,
      "end": 104.92,
      "text": "Cried the priest."
    },
    {
      "i": 33,
      "start": 104.92,
      "end": 107.84,
      "text": "His eyes burned with fury."
    },
    {
      "i": 34,
      "start": 107.84,
      "end": 111.08,
      "text": "You regret destroying them."
    },
    {
      "i": 35,
      "start": 111.08,
      "end": 115.8,
      "text": "The priest opened his rope, revealing a body covered in eyes."
    },
    {
      "i": 36,
      "start": 115.8,
      "end": 120.08,
      "text": "Suddenly, blinding light shot from the many eyes."
    },
    {
      "i": 37,
      "start": 120.08,
      "end": 121.08,
      "text": "Ah!"
    },
    {
      "i": 38,
      "start": 121.08,
      "end": 124.88,
      "text": "The light is too bright!"
    },
    {
      "i": 39,
      "start": 124.88,
      "end": 126.84,
      "text": "Cried the monkey."
    },
    {
      "i": 40,
      "start": 126.84,
      "end": 131.16,
      "text": "He covered his own eyes and ran all over the room."
    },
    {
      "i": 41,
      "start": 131.16,
      "end": 134.28,
      "text": "But he couldn't escape the blinding light."
    },
    {
      "i": 42,
      "start": 134.28,
      "end": 139.32,
      "text": "Finally, he slammed his iron bar into the Abby Stone floor."
    },
    {
      "i": 43,
      "start": 139.32,
      "end": 142.56,
      "text": "A huge hole opened up."
    },
    {
      "i": 44,
      "start": 142.56,
      "end": 147.08,
      "text": "The monkey jumped in and turned into a mole."
    },
    {
      "i": 45,
      "start": 147.08,
      "end": 150.04,
      "text": "Using his claws, he tunneled until he was short."
    }
  ]
}
