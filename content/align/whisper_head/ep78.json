{
  "episode": 78,
  "source": "assets/video/ep78.mp4",
  "model": "base",
  "duration": 315.30375,
  "segments": [
    {
      "i": 1,
      "start": 0.0,
      "end": 7.0,
      "text": "Journey to the West, Chapter 78, tricked again and again."
    },
    {
      "i": 2,
      "start": 14.0,
      "end": 15.0,
      "text": "Oh no!"
    },
    {
      "i": 3,
      "start": 15.0,
      "end": 17.0,
      "text": "U-Kong looked at the fan."
    },
    {
      "i": 4,
      "start": 17.0,
      "end": 19.0,
      "text": "This fan doesn't work!"
    },
    {
      "i": 5,
      "start": 20.0,
      "end": 23.0,
      "text": "The iron immortal must have tricked me!"
    },
    {
      "i": 6,
      "start": 24.0,
      "end": 28.0,
      "text": "The travellers backed away as the fire burned hotter."
    },
    {
      "i": 7,
      "start": 29.0,
      "end": 30.0,
      "text": "What will we do?"
    },
    {
      "i": 8,
      "start": 30.0,
      "end": 31.0,
      "text": "Ask the Tang monk."
    },
    {
      "i": 9,
      "start": 31.0,
      "end": 33.0,
      "text": "We can't go through that fire."
    },
    {
      "i": 10,
      "start": 34.0,
      "end": 36.0,
      "text": "Bajje threw his hands up."
    },
    {
      "i": 11,
      "start": 36.0,
      "end": 38.0,
      "text": "Glass just go home!"
    },
    {
      "i": 12,
      "start": 38.0,
      "end": 41.0,
      "text": "We'll write a letter to Buddha explaining what happened."
    },
    {
      "i": 13,
      "start": 42.0,
      "end": 44.0,
      "text": "Bajje, we can't do that!"
    },
    {
      "i": 14,
      "start": 44.0,
      "end": 46.0,
      "text": "The Tang monk scolded."
    },
    {
      "i": 15,
      "start": 46.0,
      "end": 48.0,
      "text": "U-Kong spoke up."
    },
    {
      "i": 16,
      "start": 48.0,
      "end": 52.0,
      "text": "I used to be friends with the iron immortal's husband, the bold demon king."
    },
    {
      "i": 17,
      "start": 52.0,
      "end": 54.0,
      "text": "I have an idea."
    },
    {
      "i": 18,
      "start": 55.0,
      "end": 59.0,
      "text": "The iron immortal was in her cave when she heard a knock."
    },
    {
      "i": 19,
      "start": 60.0,
      "end": 61.0,
      "text": "Oh no!"
    },
    {
      "i": 20,
      "start": 61.0,
      "end": 63.0,
      "text": "She said to herself."
    },
    {
      "i": 21,
      "start": 63.0,
      "end": 65.0,
      "text": "That monkey is back."
    },
    {
      "i": 22,
      "start": 67.0,
      "end": 71.0,
      "text": "She walked quietly to the door and peaked outside."
    },
    {
      "i": 23,
      "start": 73.0,
      "end": 78.0,
      "text": "When she saw the bold demon king, she smiled and opened the door."
    },
    {
      "i": 24,
      "start": 79.0,
      "end": 80.0,
      "text": "I'm glad you're back."
    },
    {
      "i": 25,
      "start": 80.0,
      "end": 82.0,
      "text": "Said the iron immortal."
    },
    {
      "i": 26,
      "start": 82.0,
      "end": 84.0,
      "text": "Sun Wu Kong was here."
    },
    {
      "i": 27,
      "start": 85.0,
      "end": 87.0,
      "text": "I used to be friends with him."
    },
    {
      "i": 28,
      "start": 87.0,
      "end": 89.0,
      "text": "The demon smiled."
    },
    {
      "i": 29,
      "start": 89.0,
      "end": 92.0,
      "text": "It would have been nice to see him again."
    },
    {
      "i": 30,
      "start": 93.0,
      "end": 95.0,
      "text": "His wife was confused."
    },
    {
      "i": 31,
      "start": 95.0,
      "end": 96.0,
      "text": "What do you mean?"
    },
    {
      "i": 32,
      "start": 97.0,
      "end": 100.0,
      "text": "You told me that you never really liked him."
    },
    {
      "i": 33,
      "start": 101.0,
      "end": 102.0,
      "text": "Oh really?"
    },
    {
      "i": 34,
      "start": 102.0,
      "end": 103.0,
      "text": "Said the demon."
    },
    {
      "i": 35,
      "start": 104.0,
      "end": 105.0,
      "text": "He was very rude."
    },
    {
      "i": 36,
      "start": 105.0,
      "end": 107.0,
      "text": "Said the woman."
    },
    {
      "i": 37,
      "start": 107.0,
      "end": 110.0,
      "text": "He demanded I let him borrow my fan."
    },
    {
      "i": 38,
      "start": 111.0,
      "end": 112.0,
      "text": "You didn't give it to him."
    },
    {
      "i": 39,
      "start": 112.0,
      "end": 113.0,
      "text": "Did you?"
    },
    {
      "i": 40,
      "start": 113.0,
      "end": 114.0,
      "text": "Ask the demon."
    },
    {
      "i": 41,
      "start": 115.0,
      "end": 116.0,
      "text": "Of course not."
    },
    {
      "i": 42,
      "start": 116.0,
      "end": 117.0,
      "text": "Said his wife."
    },
    {
      "i": 43,
      "start": 117.0,
      "end": 121.0,
      "text": "I gave him a fake fan that looks just like the real one."
    },
    {
      "i": 44,
      "start": 123.0,
      "end": 125.0,
      "text": "The demon began pacing."
    },
    {
      "i": 45,
      "start": 128.0,
      "end": 132.0,
      "text": "U-Kong is very smart and very powerful."
    },
    {
      "i": 46,
      "start": 132.0,
      "end": 133.0,
      "text": "He said."
    },
    {
      "i": 47,
      "start": 133.0,
      "end": 137.0,
      "text": "He'll realize you tricked him and then he'll come back here."
    },
    {
      "i": 48,
      "start": 137.0,
      "end": 139.0,
      "text": "What should we do?"
    },
    {
      "i": 49,
      "start": 139.0,
      "end": 141.0,
      "text": "Ask the iron immortal."
    },
    {
      "i": 50,
      "start": 141.0,
      "end": 142.0,
      "text": "Give me the fan."
    },
    {
      "i": 51,
      "start": 142.0,
      "end": 143.0,
      "text": "Said the demon."
    },
    {
      "i": 52,
      "start": 143.0,
      "end": 145.0,
      "text": "I'll keep it safe."
    },
    {
      "i": 53,
      "start": 148.0,
      "end": 150.0,
      "text": "The iron immortal."
    }
  ]
}
