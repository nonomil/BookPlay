{
  "episode": 50,
  "source": "assets/video/ep50.mp4",
  "model": "base",
  "duration": 319.7155625,
  "segments": [
    {
      "i": 1,
      "start": 0.0,
      "end": 7.0,
      "text": "Journey to the West, Chapter 50, Magic Fire."
    },
    {
      "i": 2,
      "start": 13.0,
      "end": 18.0,
      "text": "Woo Kong and his companions ran back down the mountain, escaping the fire."
    },
    {
      "i": 3,
      "start": 21.0,
      "end": 23.0,
      "text": "Red boys' fire is powerful!"
    },
    {
      "i": 4,
      "start": 23.0,
      "end": 24.0,
      "text": "Said the monkey."
    },
    {
      "i": 5,
      "start": 24.0,
      "end": 26.0,
      "text": "We were nearly roasted."
    },
    {
      "i": 6,
      "start": 26.0,
      "end": 27.0,
      "text": "Said, Bajay."
    },
    {
      "i": 7,
      "start": 28.0,
      "end": 30.0,
      "text": "Woojing looked up at the mountain peak."
    },
    {
      "i": 8,
      "start": 31.0,
      "end": 33.0,
      "text": "The fire is dying down now."
    },
    {
      "i": 9,
      "start": 34.0,
      "end": 35.0,
      "text": "Yes!"
    },
    {
      "i": 10,
      "start": 35.0,
      "end": 39.0,
      "text": "Said Woo Kong, looking at the last few whips of smoke."
    },
    {
      "i": 11,
      "start": 40.0,
      "end": 43.0,
      "text": "But he'll use it again if we go back up there."
    },
    {
      "i": 12,
      "start": 43.0,
      "end": 44.0,
      "text": "We need water."
    },
    {
      "i": 13,
      "start": 45.0,
      "end": 46.0,
      "text": "Said Woojing."
    },
    {
      "i": 14,
      "start": 46.0,
      "end": 49.0,
      "text": "Then if he makes fire again, we can just push it out."
    },
    {
      "i": 15,
      "start": 50.0,
      "end": 51.0,
      "text": "Woo Kong nodded."
    },
    {
      "i": 16,
      "start": 52.0,
      "end": 53.0,
      "text": "You two wait here."
    },
    {
      "i": 17,
      "start": 53.0,
      "end": 55.0,
      "text": "I know who can help us."
    },
    {
      "i": 18,
      "start": 57.0,
      "end": 59.0,
      "text": "The monkey shot into the air and flew away."
    },
    {
      "i": 19,
      "start": 63.0,
      "end": 67.0,
      "text": "When he returned, the dragon king of the eastern sea was with him."
    },
    {
      "i": 20,
      "start": 68.0,
      "end": 72.0,
      "text": "Woo Kong introduced the dragon king to Bajay and Woojing."
    },
    {
      "i": 21,
      "start": 73.0,
      "end": 75.0,
      "text": "I can summon rain clouds."
    },
    {
      "i": 22,
      "start": 76.0,
      "end": 77.0,
      "text": "Said the dragon king."
    },
    {
      "i": 23,
      "start": 78.0,
      "end": 82.0,
      "text": "Go back up the mountain and get Red Boy to come out."
    },
    {
      "i": 24,
      "start": 82.0,
      "end": 87.0,
      "text": "As soon as he makes his fire, I'll create a huge rainstorm."
    },
    {
      "i": 25,
      "start": 88.0,
      "end": 91.0,
      "text": "The dragon king flew up into the sky."
    },
    {
      "i": 26,
      "start": 93.0,
      "end": 95.0,
      "text": "Woo Kong and the others returned to the cave."
    },
    {
      "i": 27,
      "start": 96.0,
      "end": 97.0,
      "text": "Open up Red Boy."
    },
    {
      "i": 28,
      "start": 98.0,
      "end": 100.0,
      "text": "The monkey pounded on the cave door."
    },
    {
      "i": 29,
      "start": 101.0,
      "end": 104.0,
      "text": "The door flew open and Red Boy ran outside."
    },
    {
      "i": 30,
      "start": 105.0,
      "end": 108.0,
      "text": "Release the Tang monk right now."
    },
    {
      "i": 31,
      "start": 108.0,
      "end": 109.0,
      "text": "Shattered Woo Kong."
    },
    {
      "i": 32,
      "start": 110.0,
      "end": 111.0,
      "text": "Never!"
    },
    {
      "i": 33,
      "start": 111.0,
      "end": 112.0,
      "text": "Shattered the demon."
    },
    {
      "i": 34,
      "start": 113.0,
      "end": 116.0,
      "text": "He made a fist and punched himself in the nose."
    },
    {
      "i": 35,
      "start": 117.0,
      "end": 120.0,
      "text": "Smoke and fire poured from his face again."
    },
    {
      "i": 36,
      "start": 122.0,
      "end": 124.0,
      "text": "Dragon King called the monkey."
    },
    {
      "i": 37,
      "start": 125.0,
      "end": 126.0,
      "text": "Make your rain!"
    },
    {
      "i": 38,
      "start": 128.0,
      "end": 131.0,
      "text": "Thunder rumbled as dark clouds filled the sky."
    },
    {
      "i": 39,
      "start": 132.0,
      "end": 133.0,
      "text": "Rain poured down."
    },
    {
      "i": 40,
      "start": 134.0,
      "end": 136.0,
      "text": "The fire, however, didn't go out."
    },
    {
      "i": 41,
      "start": 138.0,
      "end": 140.0,
      "text": "Instead it grew bigger and bigger."
    },
    {
      "i": 42,
      "start": 141.0,
      "end": 142.0,
      "text": "The smoke became thick."
    },
    {
      "i": 43,
      "start": 143.0,
      "end": 147.0,
      "text": "Caughting and unable to breathe, Woo Kong covered his face."
    },
    {
      "i": 44,
      "start": 148.0,
      "end": 150.0,
      "text": "He saw Bajay and Woojing running away."
    }
  ]
}
