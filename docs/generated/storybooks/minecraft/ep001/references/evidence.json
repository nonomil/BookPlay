  "sentences": [
    {
      "id": "mc-b1-p01-s01",
      "page_no": 1,
      "text_en": "Emmy and Birch were ready for adventure!",
      "zh": "Emmy 和 Birch 已经准备好去冒险了！",
      "start_ms": 158350.0,
      "end_ms": 165170.0,
      "audio": "assets/minecraft/escape-from-the-nether/sentences/page-01-sentence-01.mp3",
      "audio_exists": true,
      "audio_sha256": "7f342768830e8890f9cecb964648fb142ee77d0f042bcb6d23f84df18b404ef1",
      "glossary_terms": [
        "adventure"
      ],
      "speaker": null
    },
    {
      "id": "mc-b1-p01-s02",
      "page_no": 1,
      "text_en": "Emmy had a brand-new helmet and matching boots made of yellow gold.",
      "zh": "Emmy 戴着崭新的头盔，穿着配套的黄色金靴。",
      "start_ms": 165170.0,
      "end_ms": 174310.0,
      "audio": "assets/minecraft/escape-from-the-nether/sentences/page-01-sentence-02.mp3",
      "audio_exists": true,
      "audio_sha256": "2cf07bbbd9047f7ed47d2d0ce54acde221a9d36c99a0655b47f41f22ca86f766",
      "glossary_terms": [
        "helmet"
      ],
      "speaker": null
    },
    {
      "id": "mc-b1-p01-s03",
      "page_no": 1,
      "text_en": "Birch had a brand-new sword made of iron.",
      "zh": "Birch 有一把崭新的铁剑。",
      "start_ms": 174890.0,
      "end_ms": 180090.0,
      "audio": "assets/minecraft/escape-from-the-nether/sentences/page-01-sentence-03.mp3",
      "audio_exists": true,
      "audio_sha256": "9e30660f0308b565a221c32e6dea3ed220eab58394986ff63046624aa3e4b9b4",
      "glossary_terms": [
        "iron"
      ],
      "speaker": null
    },
    {
      "id": "mc-b1-p02-s01",
      "page_no": 2,
      "text_en": "Byte, their loyal wolf, just wanted to play.",
      "zh": "他们忠诚的狼 Byte 只想玩耍。",
      "start_ms": 181050.0,
      "end_ms": 186370.0,
      "audio": "assets/minecraft/escape-from-the-nether/sentences/page-02-sentence-01.mp3",
      "audio_exists": true,
      "audio_sha256": "f77b3fdae34d5d19b2015d1c2e0361f0433e054a22f683630e9fd173fb86b92a",
      "glossary_terms": [
        "loyal",
        "wolf"
      ],
      "speaker": null
    },
    {
      "id": "mc-b1-p02-s02",
      "page_no": 2,
      "text_en": "\"We can play fetch,\" said Emmy.",
      "zh": "“我们可以玩接球，”Emmy 说。",
      "start_ms": 186370.0,
      "end_ms": 190730.0,
      "audio": "assets/minecraft/escape-from-the-nether/sentences/page-02-sentence-02.mp3",
      "audio_exists": true,
      "audio_sha256": "fec4c993a3d6a3f177e3c3d302d9cc4b308f787bec0ecab24b27a70776e5df23",
      "glossary_terms": [
        "fetch"
      ],
      "speaker": null
    },
    {
      "id": "mc-b1-p02-s03",
      "page_no": 2,
      "text_en": "\"Ready, boy?\" asked Birch.",
      "zh": "“准备好了吗，小家伙？”Birch 问。",
      "start_ms": 191450.0,
      "end_ms": 194550.0,
      "audio": "assets/minecraft/escape-from-the-nether/sentences/page-02-sentence-03.mp3",
      "audio_exists": true,
      "audio_sha256": "c9f03840433dd17066330af534fdfe40e98437b2b041c7d0b35513be4c206a89",
      "glossary_terms": [],
      "speaker": null
    },
    {
      "id": "mc-b1-p03-s01",
      "page_no": 3,
      "text_en": "Byte ran after the stick.",
      "zh": "Byte 追着木棍跑去。",
      "start_ms": 196970.0,
      "end_ms": 199630.0,
      "audio": "assets/minecraft/escape-from-the-nether/sentences/page-03-sentence-01.mp3",
      "audio_exists": true,
      "audio_sha256": "ee5dda44f2936442b5cac7610354de14ee5a4f3910a43c6d02593aee822070cc",
      "glossary_terms": [],
      "speaker": null
    },
    {
      "id": "mc-b1-p03-s02",
      "page_no": 3,
      "text_en": "But he did not return.",
      "zh": "可是它没有回来。",
      "start_ms": 200230.0,
      "end_ms": 202870.0,
      "audio": "assets/minecraft/escape-from-the-nether/sentences/page-03-sentence-02.mp3",
      "audio_exists": true,
      "audio_sha256": "e786ed3a1fc6e1d9060ce954b4ab0c4dc512c95a6fcfbee72ea7c561525a6f56",
      "glossary_terms": [
        "return"
      ],
      "speaker": null
    },
    {
      "id": "mc-b1-p03-s03",
      "page_no": 3,
      "text_en": "\"Where did he go?\" asked Birch.",
      "zh": "“它去哪儿了？”Birch 问。",
      "start_ms": 203890.0,
      "end_ms": 207630.0,
      "audio": "assets/minecraft/escape-from-the-nether/sentences/page-03-sentence-03.mp3",
      "audio_exists": true,
      "audio_sha256": "0732304e7c13a863f39918dafc77c5291b5ee15a21805aba17804a5a6bc0cc55",
      "glossary_terms": [],
      "speaker": null
    },
    {
      "id": "mc-b1-p03-s04",
      "page_no": 3,
      "text_en": "They both called him.",
      "zh": "他们俩一起呼唤它。",
      "start_ms": 208290.0,
      "end_ms": 209890.0,
      "audio": "assets/minecraft/escape-from-the-nether/sentences/page-03-sentence-04.mp3",
      "audio_exists": true,
      "audio_sha256": "94483c2aac8c2d3542f0836fd30193258a46313dfa4f7c703ee0ea41a9f1f6e1",
      "glossary_terms": [],
      "speaker": null
    },
    {
      "id": "mc-b1-p03-s05",
      "page_no": 3,
      "text_en": "They did not find Byte, but they saw something strange.",
      "zh": "他们没有找到 Byte，却看见了奇怪的东西。",
      "start_ms": 210580.0,
      "end_ms": 216090.0,
      "audio": "assets/minecraft/escape-from-the-nether/sentences/page-03-sentence-05.mp3",
      "audio_exists": true,
      "audio_sha256": "f61ce9c859f8c9ac14f4734de70705436327dbd150b2d83cd590bbfb423137fd",
      "glossary_terms": [],
      "speaker": null
    },
    {
      "id": "mc-b1-p03-s06",
      "page_no": 3,
      "text_en": "Beneath the trees, they found a rectangle of blocks made of black obsidian.",
      "zh": "在树下，他们发现了一块由黑曜石方块组成的长方形。",
      "start_ms": 217170.0,
      "end_ms": 225110.0,
      "audio": "assets/minecraft/escape-from-the-nether/sentences/page-03-sentence-06.mp3",
      "audio_exists": true,
      "audio_sha256": "757f67ca71767e42718019331d7738806436e3dd343a189993fe18e43aaadc8d",
      "glossary_terms": [
        "rectangle",
        "obsidian"
      ],
      "speaker": null
    },
    {
      "id": "mc-b1-p03-s07",
      "page_no": 3,
      "text_en": "The air glowed purple inside it.",
      "zh": "里面的空气泛着紫光。",
      "start_ms": 225890.0,
      "end_ms": 229470.0,
      "audio": "assets/minecraft/escape-from-the-nether/sentences/page-03-sentence-07.mp3",
      "audio_exists": true,
      "audio_sha256": "e2673d391307295ec236ad67ca017d42b35862839559f2590b60f792c89da0bc",
      "glossary_terms": [],
      "speaker": null
    },
    {
      "id": "mc-b1-p04-s01",
      "page_no": 4,
      "text_en": "It's a portal to the Nether,\" said Emmy.",
      "zh": "“这是通往下界的传送门，”Emmy 说。",
      "start_ms": 230420.0,
      "end_ms": 234550.0,
      "audio": "assets/minecraft/escape-from-the-nether/sentences/page-04-sentence-01.mp3",
      "audio_exists": true,
      "audio_sha256": "3c0c5452220824f6dd6e39e77af1a80505d235346104f2e5a2def958e55971d9",
      "glossary_terms": [
        "portal"
      ],
      "speaker": null
    },
    {
      "id": "mc-b1-p04-s02",
      "page_no": 4,
      "text_en": "She put her hand into the purple light.",
      "zh": "她把手伸进紫色的光里。",
      "start_ms": 235350.0,
      "end_ms": 239150.0,
      "audio": "assets/minecraft/escape-from-the-nether/sentences/page-04-sentence-02.mp3",
      "audio_exists": true,
      "audio_sha256": "7ef77458649821d38b73e0fabe040a4896131f6b5baa471365a7ed4fd28b94b0",
      "glossary_terms": [
        "purple"
      ],
      "speaker": null
    },
    {
      "id": "mc-b1-p04-s03",
      "page_no": 4,
      "text_en": "Her hand disappeared!",
      "zh": "她的手消失了！",
      "start_ms": 240030.0,
      "end_ms": 241570.0,
      "audio": "assets/minecraft/escape-from-the-nether/sentences/page-04-sentence-03.mp3",
      "audio_exists": true,
      "audio_sha256": "2ed321b5d1bfc9dbfb0883f3ce890774e8d22be7f0614a441bcbfa1d951e5ba3",
      "glossary_terms": [
        "disappeared"
      ],
      "speaker": null
    },
    {
      "id": "mc-b1-p04-s04",
      "page_no": 4,
      "text_en": "\"Do you think Byte went through the portal?\" asked Birch.",
      "zh": "“你觉得 Byte 穿过传送门了吗？”Birch 问。",
      "start_ms": 242830.0,
      "end_ms": 248410.0,
      "audio": "assets/minecraft/escape-from-the-nether/sentences/page-04-sentence-04.mp3",
      "audio_exists": true,
      "audio_sha256": "3b2b2e1a1fdf6a88e91682a9a35d5f903424d8aadd65fd3c8e0715f80ece577e",
      "glossary_terms": [],
      "speaker": null
    },
    {
      "id": "mc-b1-p04-s05",
      "page_no": 4,
      "text_en": "There is only one way to find out,\" said Emmy.",
      "zh": "“只有一个办法能知道，”Emmy 说。",
      "start_ms": 249370.0,
      "end_ms": 254650.0,
      "audio": "assets/minecraft/escape-from-the-nether/sentences/page-04-sentence-05.mp3",
      "audio_exists": true,
      "audio_sha256": "31b301917a52a0a3df64c9e651fa80438c9fe779e50b92fae53c0fef97177948",
      "glossary_terms": [],
      "speaker": null
    },
    {
      "id": "mc-b1-p04-s06",
      "page_no": 4,
      "text_en": "\"Come on!\"",
      "zh": "“走吧！”",
      "start_ms": 255450.0,
      "end_ms": 256130.0,
      "audio": "assets/minecraft/escape-from-the-nether/sentences/page-04-sentence-06.mp3",
      "audio_exists": true,
      "audio_sha256": "7a55a038f23328df15b730b74655729ee095ad04cf9966e7094e6d2d8cc4f234",
      "glossary_terms": [],
      "speaker": null
    },
    {
      "id": "mc-b1-p05-s01",
      "page_no": 5,
      "text_en": "The two friends leaped into the portal.",
      "zh": "两个朋友跳进了传送门。",
      "start_ms": 257130.0,
      "end_ms": 261329.99999999997,
      "audio": "assets/minecraft/escape-from-the-nether/sentences/page-05-sentence-01.mp3",
      "audio_exists": true,
      "audio_sha256": "18e56c54c286c60ad62e5c6d7e5b42df91ab33d752af9341a808404554574c05",
      "glossary_terms": [
        "leaped"
      ],
      "speaker": null
    },
    {
      "id": "mc-b1-p05-s02",
      "page_no": 5,
      "text_en": "At first, Birch thought they were still in the forest.",
      "zh": "一开始，Birch 以为他们还在森林里。",
      "start_ms": 262190.0,
      "end_ms": 266970.0,
      "audio": "assets/minecraft/escape-from-the-nether/sentences/page-05-sentence-02.mp3",
      "audio_exists": true,
      "audio_sha256": "7c03a8aa0faf85331fb6f12ac5a07394939edcccf1004cf0f492d8c6ed2fcf77",
      "glossary_terms": [
        "forest"
      ],
      "speaker": null
    },
    {
      "id": "mc-b1-p05-s03",
      "page_no": 5,
      "text_en": "Then he saw that the trees were blue-green.",
      "zh": "后来他发现树木是蓝绿色的。",
      "start_ms": 267970.0,
      "end_ms": 272910.0,
      "audio": "assets/minecraft/escape-from-the-nether/sentences/page-05-sentence-03.mp3",
      "audio_exists": true,
      "audio_sha256": "8baf4ef4f28305839040ff6a9965e7f1781aecafb05aad342e5cd5cb65d6811e",
      "glossary_terms": [],
      "speaker": null
    },
    {
      "id": "mc-b1-p05-s04",
      "page_no": 5,
      "text_en": "So was the grass.",
      "zh": "草也是蓝绿色的。",
      "start_ms": 273850.0,
      "end_ms": 275450.0,
      "audio": "assets/minecraft/escape-from-the-nether/sentences/page-05-sentence-04.mp3",
      "audio_exists": true,
      "audio_sha256": "9de5ae1e8510408e8f98099f5eaa3449f886ac7c21ba38e137b3dd1ac4b416b6",
      "glossary_terms": [
        "grass"
      ],
      "speaker": null
    },
    {
      "id": "mc-b1-p06-s01",
      "page_no": 6,
      "text_en": "Birch and Emmy climbed a pair of vines to get a better view of the Nether.",
      "zh": "Birch 和 Emmy 爬上两根藤蔓，好看清下界的景象。",
      "start_ms": 276670.0,
      "end_ms": 283710.0,
      "audio": "assets/minecraft/escape-from-the-nether/sentences/page-06-sentence-01.mp3",
      "audio_exists": true,
      "audio_sha256": "14bf27c0440df8bb80b0eabe3d63bcf6e2876133409d088f601ef36d339f3290",
      "glossary_terms": [
        "vines"
      ],
      "speaker": null
    },
    {
      "id": "mc-b1-p06-s02",
      "page_no": 6,
      "text_en": "Birch gasped in surprise.",
      "zh": "Birch 惊讶地倒吸了一口气。",
      "start_ms": 283710.0,
      "end_ms": 286890.0,
      "audio": "assets/minecraft/escape-from-the-nether/sentences/page-06-sentence-02.mp3",
      "audio_exists": true,
      "audio_sha256": "1a22db79e02ab95f14e415db3ddfe2aa8ebc623ced993b481ddf99913455ef3f",
      "glossary_terms": [],
      "speaker": null
    },
    {
      "id": "mc-b1-p06-s03",
      "page_no": 6,
      "text_en": "He saw a gray desert.",
      "zh": "他看见了一片灰色的沙漠。",
      "start_ms": 288150.0,
      "end_ms": 290570.0,
      "audio": "assets/minecraft/escape-from-the-nether/sentences/page-06-sentence-03.mp3",
      "audio_exists": true,
      "audio_sha256": "42997e423a0b3c4de64df09dc38f4c1dd308bbb3effa098a3908479417125f96",
      "glossary_terms": [
        "desert"
      ],
      "speaker": null
    },
    {
      "id": "mc-b1-p06-s04",
      "page_no": 6,
      "text_en": "He saw a red woodland.",
      "zh": "他看见了一片红色的林地。",
      "start_ms": 291330.0,
      "end_ms": 294370.0,
      "audio": "assets/minecraft/escape-from-the-nether/sentences/page-06-sentence-04.mp3",
      "audio_exists": true,
      "audio_sha256": "7f2e630dbc5da22c1922184c61189b06b23c8ae49a155f5d373d620e106415db",
      "glossary_terms": [],
      "speaker": null
    },
    {
      "id": "mc-b1-p06-s05",
      "page_no": 6,
      "text_en": "And he saw an ocean of lava.",
      "zh": "他还看见了一片岩浆海。",
      "start_ms": 294810.0,
      "end_ms": 298550.0,
      "audio": "assets/minecraft/escape-from-the-nether/sentences/page-06-sentence-05.mp3",
      "audio_exists": true,
      "audio_sha256": "09a33d8da4ffe5c8e4ca00c6f5237d8dffe4ec8083aa118500bfe19bea5a9747",
      "glossary_terms": [
        "lava"
      ],
      "speaker": null
    },
    {
      "id": "mc-b1-p07-s01",
      "page_no": 7,
      "text_en": "Birch had never seen any place like this in Minecraft.",
      "zh": "在 Minecraft 里，Birch 从没见过这样的地方。",
      "start_ms": 299710.0,
      "end_ms": 305010.0,
      "audio": "assets/minecraft/escape-from-the-nether/sentences/page-07-sentence-01.mp3",
      "audio_exists": true,
      "audio_sha256": "e70635ce14f55084441f587971d0e2c099868cf830bae85e0b6008c1cd618546",
      "glossary_terms": [],
      "speaker": null
    },
    {
      "id": "mc-b1-p07-s02",
      "page_no": 7,
      "text_en": "\"Even the mushrooms are strange!\" Emmy told him with a laugh.",
      "zh": "“连蘑菇都很奇怪！”Emmy 笑着告诉他。",
      "start_ms": 305930.0,
      "end_ms": 312270.0,
      "audio": "assets/minecraft/escape-from-the-nether/sentences/page-07-sentence-02.mp3",
      "audio_exists": true,
      "audio_sha256": "1c7271223e2b09063301ae9b7c33ed4f6b47df14ef4e1ca88789bb4683b17771",
      "glossary_terms": [
        "mushrooms"
      ],
      "speaker": null
    },
    {
      "id": "mc-b1-p07-s03",
      "page_no": 7,
      "text_en": "She put two blue-green fungi in her inventory.",
      "zh": "她把两株蓝绿色真菌放进了物品栏。",
      "start_ms": 312270.0,
      "end_ms": 318050.0,
      "audio": "assets/minecraft/escape-from-the-nether/sentences/page-07-sentence-03.mp3",
      "audio_exists": true,
      "audio_sha256": "608a54ed0254dda53701c86464d8a98c9ec9c200ea07b4bea66bfe4ae22a12c4",
      "glossary_terms": [
        "fungi",
        "inventory"
      ],
      "speaker": null
    },
    {
      "id": "mc-b1-p07-s04",
      "page_no": 7,
      "text_en": "Setting out to find Byte, they started walking.",
      "zh": "他们出发去寻找 Byte，开始向前走。",
      "start_ms": 319090.0,
      "end_ms": 323370.0,
      "audio": "assets/minecraft/escape-from-the-nether/sentences/page-07-sentence-04.mp3",
      "audio_exists": true,
      "audio_sha256": "3fa378baef102447313c5ad37110d579deafb153e1847724021a00db4005b96c",
      "glossary_terms": [],
      "speaker": null
    },
    {
      "id": "mc-b1-p07-s05",
      "page_no": 7,
      "text_en": "The strange blue-green forest became a strange red forest.",
      "zh": "奇怪的蓝绿色森林变成了奇怪的红色森林。",
      "start_ms": 324250.0,
      "end_ms": 330550.0,
      "audio": "assets/minecraft/escape-from-the-nether/sentences/page-07-sentence-05.mp3",
      "audio_exists": true,
      "audio_sha256": "c347c1d04f3d086f0333850a5dde56ac4454e9968072869ae15aabebca69e1b5",
      "glossary_terms": [],
      "speaker": null
    },
    {
      "id": "mc-b1-p08-s01",
      "page_no": 8,
      "text_en": "Birch raised his hand.",
      "zh": "Birch 举起了手。",
      "start_ms": 331470.0,
      "end_ms": 333470.0,
      "audio": "assets/minecraft/escape-from-the-nether/sentences/page-08-sentence-01.mp3",
      "audio_exists": true,
      "audio_sha256": "200a3385d4e037190000e2f48dced91888a73575f639a36b13538aadc48cd30f",
      "glossary_terms": [],
      "speaker": null
    },
    {
      "id": "mc-b1-p08-s02",
      "page_no": 8,
      "text_en": "They were being watched.",
      "zh": "有人正在监视他们。",
      "start_ms": 334150.0,
      "end_ms": 335570.0,
      "audio": "assets/minecraft/escape-from-the-nether/sentences/page-08-sentence-02.mp3",
      "audio_exists": true,
      "audio_sha256": "0529b0d415806df34c4a1760bf3186b31825217121a600da1a3c257b81381a33",
      "glossary_terms": [],
      "speaker": null
    },
    {
      "id": "mc-b1-p08-s03",
      "page_no": 8,
      "text_en": "Birch's warning was too late.",
      "zh": "可是 Birch 的警告来得太晚了。",
      "start_ms": 336410.0,
      "end_ms": 338950.0,
      "audio": "assets/minecraft/escape-from-the-nether/sentences/page-08-sentence-03.mp3",
      "audio_exists": true,
      "audio_sha256": "495f9cbf51fbaa3caeb6d70945f0770bfd1438477b0ea5ca54bb65f76f1b801a",
      "glossary_terms": [
        "warning"
      ],
      "speaker": null
    },
    {
      "id": "mc-b1-p08-s04",
      "page_no": 8,
      "text_en": "Strange mobs surrounded them.",
      "zh": "奇怪的生物把他们包围了。",
      "start_ms": 338950.0,
      "end_ms": 342210.0,
      "audio": "assets/minecraft/escape-from-the-nether/sentences/page-08-sentence-04.mp3",
      "audio_exists": true,
      "audio_sha256": "79da27eff7ac34d668edd545229bef8e98742e35453fe08a03fb17ac334e9da9",
      "glossary_terms": [
        "surrounded"
      ],
      "speaker": null
    },
    {
      "id": "mc-b1-p08-s05",
      "page_no": 8,
      "text_en": "\"Piglins!\" cried Emmy.",
      "zh": "“猪灵！”Emmy 喊道。",
      "start_ms": 343130.0,
      "end_ms": 345430.0,
      "audio": "assets/minecraft/escape-from-the-nether/sentences/page-08-sentence-05.mp3",
      "audio_exists": true,
      "audio_sha256": "437e3823c9020abf48a4f818750074e2abb545641082b7ecff27c667d71f20a8",
      "glossary_terms": [
        "piglins"
      ],
      "speaker": null
    },
    {
      "id": "mc-b1-p08-s06",
      "page_no": 8,
      "text_en": "The piglins attacked Birch!",
      "zh": "猪灵们向 Birch 发起了攻击！",
      "start_ms": 346490.0,
      "end_ms": 349370.0,
      "audio": "assets/minecraft/escape-from-the-nether/sentences/page-08-sentence-06.mp3",
      "audio_exists": true,
      "audio_sha256": "f066369d4d2ee169e1bb1d3e58bfa5a43b8aa93b16b4692266ca1d4bad964675",
      "glossary_terms": [],
      "speaker": null
    },
    {
      "id": "mc-b1-p08-s07",
      "page_no": 8,
      "text_en": "But they left Emmy alone.",
      "zh": "但它们没有碰 Emmy。",
      "start_ms": 349930.0,
      "end_ms": 352050.0,
      "audio": "assets/minecraft/escape-from-the-nether/sentences/page-08-sentence-07.mp3",
      "audio_exists": true,
      "audio_sha256": "7ad2691d006ad8f5039ad688082c5eccbb5df09ecc5b930ad14f295a6cffaddd",
      "glossary_terms": [],
      "speaker": null
    },
    {
      "id": "mc-b1-p08-s08",
      "page_no": 8,
      "text_en": "They liked her gold helmet and gold boots.",
      "zh": "它们喜欢 Emmy 的金头盔和金靴子。",
      "start_ms": 352890.0,
      "end_ms": 356790.0,
      "audio": "assets/minecraft/escape-from-the-nether/sentences/page-08-sentence-08.mp3",
      "audio_exists": true,
      "audio_sha256": "956025cf0c1d3121e8ae1aef827bfa224d1b428d4b9a95ab700e7bf30a6d5222",
      "glossary_terms": [],
      "speaker": null
    },
    {
      "id": "mc-b1-p09-s01",
      "page_no": 9,
      "text_en": "Emmy had an idea!",
      "zh": "Emmy 想到了一个办法！",
      "start_ms": 357870.0,
      "end_ms": 359910.0,
      "audio": "assets/minecraft/escape-from-the-nether/sentences/page-09-sentence-01.mp3",
      "audio_exists": true,
      "audio_sha256": "7f00e0c41d51aba255f1e53937e09b0c30ce4a3e1859bd83694214389f108638",
      "glossary_terms": [],
      "speaker": null
    },
    {
      "id": "mc-b1-p09-s02",
      "page_no": 9,
      "text_en": "She took off her gold helmet and put it on Birch's head.",
      "zh": "她摘下自己的金头盔，戴到了 Birch 头上。",
      "start_ms": 360590.0,
      "end_ms": 365750.0,
      "audio": "assets/minecraft/escape-from-the-nether/sentences/page-09-sentence-02.mp3",
      "audio_exists": true,
      "audio_sha256": "61906fbbe4a1b75689df2efcd56dcffeb66ff03096f5dc561b0fc9af62024b81",
      "glossary_terms": [],
      "speaker": null
    },
    {
      "id": "mc-b1-p09-s03",
      "page_no": 9,
      "text_en": "The piglins stopped fighting Birch.",
      "zh": "猪灵们停止攻击 Birch。",
      "start_ms": 365750.0,
      "end_ms": 369650.0,
      "audio": "assets/minecraft/escape-from-the-nether/sentences/page-09-sentence-03.mp3",
      "audio_exists": true,
      "audio_sha256": "560cb7b224f0d3f17a9d047071941a9f010d60c486cac39aa29d823b8b4a8e6f",
      "glossary_terms": [],
      "speaker": null
    },
    {
      "id": "mc-b1-p09-s04",
      "page_no": 9,
      "text_en": "The mobs oinked with happiness.",
      "zh": "这些生物开心地哼哼起来。",
      "start_ms": 370410.0,
      "end_ms": 372690.0,
      "audio": "assets/minecraft/escape-from-the-nether/sentences/page-09-sentence-04.mp3",
      "audio_exists": true,
      "audio_sha256": "52b5274f4e192d7dc4f5860faab40b78bf500a51144f1596969b577551b78ae1",
      "glossary_terms": [
        "happiness"
      ],
      "speaker": null
    },
    {
      "id": "mc-b1-p09-s05",
      "page_no": 9,
      "text_en": "Emmy and Birch followed them to a huge fortress.",
      "zh": "Emmy 和 Birch 跟着它们来到一座巨大的堡垒。",
      "start_ms": 373790.0,
      "end_ms": 378410.0,
      "audio": "assets/minecraft/escape-from-the-nether/sentences/page-09-sentence-05.mp3",
      "audio_exists": true,
      "audio_sha256": "176a677bb68f46c654aa5e76c87cb6dcec18cfdb153bf1cc62a0b350f746756d",
      "glossary_terms": [
        "fortress",
        "followed"
      ],
      "speaker": null
    },
    {
      "id": "mc-b1-p10-s01",
      "page_no": 10,
      "text_en": "In the fortress, they found a treasure room filled with gold.",
      "zh": "在堡垒里，他们找到了一间堆满黄金的宝藏室。",
      "start_ms": 379610.0,
      "end_ms": 385930.0,
      "audio": "assets/minecraft/escape-from-the-nether/sentences/page-10-sentence-01.mp3",
      "audio_exists": true,
      "audio_sha256": "fb01ac86f21104ffe2540d554ad8982448be3d978518d749551f6e2902ab78fa",
      "glossary_terms": [
        "treasure"
      ],
      "speaker": null
    },
    {
      "id": "mc-b1-p10-s02",
      "page_no": 10,
      "text_en": "Birch opened a chest.",
      "zh": "Birch 打开了一个箱子。",
      "start_ms": 386690.0,
      "end_ms": 388750.0,
      "audio": "assets/minecraft/escape-from-the-nether/sentences/page-10-sentence-02.mp3",
      "audio_exists": true,
      "audio_sha256": "3a2f0b187279df28929171b43de0e5d6bb286289f740f1d4447f6a9416981107",
      "glossary_terms": [
        "chest"
      ],
      "speaker": null
    },
    {
      "id": "mc-b1-p10-s03",
      "page_no": 10,
      "text_en": "The piglins drew their swords and made angry noises!",
      "zh": "猪灵们拔出剑，发出了愤怒的声音！",
      "start_ms": 389730.0,
      "end_ms": 394590.0,
      "audio": "assets/minecraft/escape-from-the-nether/sentences/page-10-sentence-03.mp3",
      "audio_exists": true,
      "audio_sha256": "e95be624bd2d53632460cc25bde1d887c86ea2d3d1a4969aa11061fdd8182f46",
      "glossary_terms": [],
      "speaker": null
    },
    {
      "id": "mc-b1-p10-s04",
      "page_no": 10,
      "text_en": "Emmy and Birch escaped the mobs by smashing a big hole in the wall.",
      "zh": "Emmy 和 Birch 砸穿墙壁上的大洞，逃离了这些生物。",
      "start_ms": 394590.0,
      "end_ms": 402890.0,
      "audio": "assets/minecraft/escape-from-the-nether/sentences/page-10-sentence-04.mp3",
      "audio_exists": true,
      "audio_sha256": "98def912611be8018aa268cc380ea26529e05a6489e6c348c0371d0e6573cc7c",
      "glossary_terms": [
        "smashing"
      ],
      "speaker": null
    },
    {
      "id": "mc-b1-p10-s05",
      "page_no": 10,
      "text_en": "On the other side was a desert.",
      "zh": "墙的另一边是一片沙漠。",
      "start_ms": 403570.0,
      "end_ms": 406450.0,
      "audio": "assets/minecraft/escape-from-the-nether/sentences/page-10-sentence-05.mp3",
      "audio_exists": true,
      "audio_sha256": "bf52c3b54966e40b4523a91e6133ffec0fdf899a9f6bfe552ce3a9e61afd29df",
      "glossary_terms": [],
      "speaker": null
    },
    {
      "id": "mc-b1-p11-s01",
      "page_no": 11,
      "text_en": "Piglins chased them.",
      "zh": "猪灵们追了上来。",
      "start_ms": 407410.0,
      "end_ms": 408970.0,
      "audio": "assets/minecraft/escape-from-the-nether/sentences/page-11-sentence-01.mp3",
      "audio_exists": true,
      "audio_sha256": "491aa33f29c98a66e6279cc63fee18eb62fdc6125d69f78d3a073e9db1c6db4f",
      "glossary_terms": [],
      "speaker": null
    },
    {
      "id": "mc-b1-p11-s02",
      "page_no": 11,
      "text_en": "It was very difficult to run.",
      "zh": "跑起来非常困难。",
      "start_ms": 409690.0,
      "end_ms": 413050.0,
      "audio": "assets/minecraft/escape-from-the-nether/sentences/page-11-sentence-02.mp3",
      "audio_exists": true,
      "audio_sha256": "b12a4772bab54d4abbd8ec69abd95e4043fb5ebc46a6226f03b3806f1571850d",
      "glossary_terms": [
        "difficult"
      ],
      "speaker": null
    },
    {
      "id": "mc-b1-p11-s03",
      "page_no": 11,
      "text_en": "\"This is not ordinary sand,\" said Emmy.",
      "zh": "“这不是普通的沙子，”Emmy 说。",
      "start_ms": 413850.0,
      "end_ms": 418470.0,
      "audio": "assets/minecraft/escape-from-the-nether/sentences/page-11-sentence-03.mp3",
      "audio_exists": true,
      "audio_sha256": "9af2c16e44723ca5ea3e9f8f8b6b36194ed72afe50799bbdec67ec909830c861",
      "glossary_terms": [
        "ordinary"
      ],
      "speaker": null
    },
    {
      "id": "mc-b1-p11-s04",
      "page_no": 11,
      "text_en": "\"It is soul sand!\" Skeletons also started firing arrows at them!",
      "zh": "“这是灵魂沙！”骷髅也开始向他们射箭！",
      "start_ms": 419350.0,
      "end_ms": 426830.0,
      "audio": "assets/minecraft/escape-from-the-nether/sentences/page-11-sentence-04.mp3",
      "audio_exists": true,
      "audio_sha256": "b323a023299b652ecce3eba1f5f4f6a6d95a99b641e4d6152c9de9b2dbb10dbc",
      "glossary_terms": [
        "skeletons"
      ],
      "speaker": null
    },
    {
      "id": "mc-b1-p11-s05",
      "page_no": 11,
      "text_en": "Emmy and Birch ran faster.",
      "zh": "Emmy 和 Birch 跑得更快了。",
      "start_ms": 427610.0,
      "end_ms": 430450.0,
      "audio": "assets/minecraft/escape-from-the-nether/sentences/page-11-sentence-05.mp3",
      "audio_exists": true,
      "audio_sha256": "94ef67b769e9707f5afa82e49f01c155edc0384025eecf78cf214ab8d07b9711",
      "glossary_terms": [],
      "speaker": null
    },
    {
      "id": "mc-b1-p11-s06",
      "page_no": 11,
      "text_en": "They could see a portal on the other side of a river of lava!",
      "zh": "他们看见岩浆河的另一边有一座传送门！",
      "start_ms": 431190.0,
      "end_ms": 437330.0,
      "audio": "assets/minecraft/escape-from-the-nether/sentences/page-11-sentence-06.mp3",
      "audio_exists": true,
      "audio_sha256": "883cd8f0565be6052522b97f1b8f50c6cc5e30551bec82b0829d83b1dd589e39",
      "glossary_terms": [],
      "speaker": null
    },
    {
      "id": "mc-b1-p12-s01",
      "page_no": 12,
      "text_en": "\"We're trapped,\" said Birch.",
      "zh": "“我们被困住了，”Birch 说。",
      "start_ms": 438230.0,
      "end_ms": 441450.0,
      "audio": "assets/minecraft/escape-from-the-nether/sentences/page-12-sentence-01.mp3",
      "audio_exists": true,
      "audio_sha256": "e93dbee4414f26e324961afd9f75f1d4f1fced2d816cc9b8777e85494793c843",
      "glossary_terms": [
        "trapped"
      ],
      "speaker": null
    },
    {
      "id": "mc-b1-p12-s02",
      "page_no": 12,
      "text_en": "Emmy pointed at two striders with red skin and stringy hair.",
      "zh": "Emmy 指着两只红皮肤、长着细长头发的炽足兽。",
      "start_ms": 442050.0,
      "end_ms": 448370.0,
      "audio": "assets/minecraft/escape-from-the-nether/sentences/page-12-sentence-02.mp3",
      "audio_exists": true,
      "audio_sha256": "e49afb7d55c195f60b03794246ba8417986c5ac448eb0d4729bc3077b2251f4b",
      "glossary_terms": [
        "striders"
      ],
      "speaker": null
    },
    {
      "id": "mc-b1-p12-s03",
      "page_no": 12,
      "text_en": "\"We can't cross the lava,\" said Emmy, \"but striders can!\" Emmy saddled the striders.",
      "zh": "“我们过不了岩浆，”Emmy 说，“但炽足兽可以！”Emmy 给炽足兽装上了鞍。",
      "start_ms": 448370.0,
      "end_ms": 458350.0,
      "audio": "assets/minecraft/escape-from-the-nether/sentences/page-12-sentence-03.mp3",
      "audio_exists": true,
      "audio_sha256": "a3e52b14653c29116475e7d003295852c6ca9c4a6751cfd11fe9e5fc4f67cbca",
      "glossary_terms": [],
      "speaker": null
    },
    {
      "id": "mc-b1-p12-s04",
      "page_no": 12,
      "text_en": "She and Birch climbed onto the passive mobs, but the striders stood there, chirping.",
      "zh": "她和 Birch 爬上这些被动型生物，可炽足兽只是站在那里啾啾叫。",
      "start_ms": 459190.0,
      "end_ms": 467330.0,
      "audio": "assets/minecraft/escape-from-the-nether/sentences/page-12-sentence-04.mp3",
      "audio_exists": true,
      "audio_sha256": "a102c883a199dc4f63634609a7a396fb7ca6c7e691f60e4ff16d29242a8c595b",
      "glossary_terms": [
        "chirping"
      ],
      "speaker": null
    },
    {
      "id": "mc-b1-p13-s01",
      "page_no": 13,
      "text_en": "Emmy offered them carrots.",
      "zh": "Emmy 给它们胡萝卜。",
      "start_ms": 468390.0,
      "end_ms": 470490.0,
      "audio": "assets/minecraft/escape-from-the-nether/sentences/page-13-sentence-01.mp3",
      "audio_exists": true,
      "audio_sha256": "bf3995cd2e70a2f7a40894dc5688192067a8fb2a333fa78525a85aafc9b1f593",
      "glossary_terms": [
        "carrots"
      ],
      "speaker": null
    },
    {
      "id": "mc-b1-p13-s02",
      "page_no": 13,
      "text_en": "They just kept chirping.",
      "zh": "它们只是继续啾啾叫。",
      "start_ms": 471250.0,
      "end_ms": 472570.0,
      "audio": "assets/minecraft/escape-from-the-nether/sentences/page-13-sentence-02.mp3",
      "audio_exists": true,
      "audio_sha256": "64a37e47de95819f204052a904a2db872ae162fb00065b16217b01110a9e4f37",
      "glossary_terms": [],
      "speaker": null
    },
    {
      "id": "mc-b1-p13-s03",
      "page_no": 13,
      "text_en": "Birch had an idea.",
      "zh": "Birch 想到了一个办法。",
      "start_ms": 473550.0,
      "end_ms": 475650.0,
      "audio": "assets/minecraft/escape-from-the-nether/sentences/page-13-sentence-03.mp3",
      "audio_exists": true,
      "audio_sha256": "89ca1688623a0a88b750a58f3728376498690fca56286c5c3691cb721d06b8ea",
      "glossary_terms": [],
      "speaker": null
    },
    {
      "id": "mc-b1-p13-s04",
      "page_no": 13,
      "text_en": "Carrots did not grow in the Nether.",
      "zh": "下界里不会生长胡萝卜。",
      "start_ms": 475650.0,
      "end_ms": 479650.0,
      "audio": "assets/minecraft/escape-from-the-nether/sentences/page-13-sentence-04.mp3",
      "audio_exists": true,
      "audio_sha256": "4f8456af576a3ea1e02198b50c3137eb9cd6840c63aa74d9f9f67fef531c9eff",
      "glossary_terms": [],
      "speaker": null
    },
    {
      "id": "mc-b1-p13-s05",
      "page_no": 13,
      "text_en": "Maybe striders did not eat them.",
      "zh": "也许炽足兽根本不吃胡萝卜。",
      "start_ms": 480350.0,
      "end_ms": 483370.0,
      "audio": "assets/minecraft/escape-from-the-nether/sentences/page-13-sentence-05.mp3",
      "audio_exists": true,
      "audio_sha256": "d03752a0e50c324f642848bb49b5770faf7a3160673cdf9090ac72c132862e8c",
      "glossary_terms": [],
      "speaker": null
    },
    {
      "id": "mc-b1-p13-s06",
      "page_no": 13,
      "text_en": "\"Quick! Offer them the blue-green fungi,' Birch shouted as a floating ghast joined the skeletons and piglins.",
      "zh": "“快！把蓝绿色真菌给它们！”Birch 喊道。这时，一只漂浮的恶魂加入了骷髅和猪灵的队伍。",
      "start_ms": 484370.0,
      "end_ms": 496210.0,
      "audio": "assets/minecraft/escape-from-the-nether/sentences/page-13-sentence-06.mp3",
      "audio_exists": true,
      "audio_sha256": "a3fa0eb8e060d02e20400133aa66d673cbd6df0d2aa770b9128e19beac214e2f",
      "glossary_terms": [
        "ghast",
        "floating"
      ],
      "speaker": null
    },
    {
      "id": "mc-b1-p14-s01",
      "page_no": 14,
      "text_en": "When the striders saw the fungi, they started running!",
      "zh": "炽足兽看见真菌后，开始奔跑！",
      "start_ms": 497230.0,
      "end_ms": 502070.0,
      "audio": "assets/minecraft/escape-from-the-nether/sentences/page-14-sentence-01.mp3",
      "audio_exists": true,
      "audio_sha256": "6f8dd6fb93d24be9790cbc81e0b3593f7587a7c404955d43937db8f4d63bfae3",
      "glossary_terms": [],
      "speaker": null
    },
    {
      "id": "mc-b1-p14-s02",
      "page_no": 14,
      "text_en": "Emmy and Birch raced toward the portal.",
      "zh": "Emmy 和 Birch 朝传送门冲去。",
      "start_ms": 502070.0,
      "end_ms": 506950.0,
      "audio": "assets/minecraft/escape-from-the-nether/sentences/page-14-sentence-02.mp3",
      "audio_exists": true,
      "audio_sha256": "f651c23ee9ef573cf6e0fb9b4fa67d27ba4e27fd242b795decdaa69b57a03cd3",
      "glossary_terms": [
        "raced"
      ],
      "speaker": null
    },
    {
      "id": "mc-b1-p14-s03",
      "page_no": 14,
      "text_en": "On the other side of the portal, they could see Byte.",
      "zh": "在传送门的另一边，他们看见了 Byte。",
      "start_ms": 508010.0,
      "end_ms": 512110.0,
      "audio": "assets/minecraft/escape-from-the-nether/sentences/page-14-sentence-03.mp3",
      "audio_exists": true,
      "audio_sha256": "7fcc0d60296636ba048a147fe3bb68d41c15ad2d43b279b75331beb61807db8e",
      "glossary_terms": [],
      "speaker": null
    },
    {
      "id": "mc-b1-p14-s04",
      "page_no": 14,
      "text_en": "He was waiting for them.",
      "zh": "它正在等他们。",
      "start_ms": 513010.0,
      "end_ms": 514809.99999999994,
      "audio": "assets/minecraft/escape-from-the-nether/sentences/page-14-sentence-04.mp3",
      "audio_exists": true,
      "audio_sha256": "8d0018c31c9b881c641efcf77ddc25e05a11c12b2b352d5a11f84c195efacd86",
      "glossary_terms": [],
      "speaker": null
    },
    {
      "id": "mc-b1-p14-s05",
      "page_no": 14,
      "text_en": "He had his stick in his mouth.",
      "zh": "它嘴里叼着那根木棍。",
      "start_ms": 515429.99999999994,
      "end_ms": 518610.0,
      "audio": "assets/minecraft/escape-from-the-nether/sentences/page-14-sentence-05.mp3",
      "audio_exists": true,
      "audio_sha256": "ada6ebd83cde537eddb5144fcb0c3660f365caafe89aa0670c0d4244184f4a01",
      "glossary_terms": [
        "mouth",
        "stick"
      ],
      "speaker": null
    },
    {
      "id": "mc-b1-p14-s06",
      "page_no": 14,
      "text_en": "They were going to make it!",
      "zh": "他们就要成功了！",
      "start_ms": 519330.00000000006,
      "end_ms": 521510.0,
      "audio": "assets/minecraft/escape-from-the-nether/sentences/page-14-sentence-06.mp3",
      "audio_exists": true,
      "audio_sha256": "cb54e3f83d33a4b9180c641c4de95e7edaf1236f72193ead0e0c372725c7d687",
      "glossary_terms": [],
      "speaker": null
    },
    {
      "id": "mc-b1-p15-s01",
      "page_no": 15,
      "text_en": "Safe in the Overworld, Emmy threw the stick.",
      "zh": "回到安全的主世界后，Emmy 把木棍扔了出去。",
      "start_ms": 522330.00000000006,
      "end_ms": 526770.0,
      "audio": "assets/minecraft/escape-from-the-nether/sentences/page-15-sentence-01.mp3",
      "audio_exists": true,
      "audio_sha256": "2caf9898a235047d2143c2d009a243e9658d21e73e310165cea6f7686bdd16e7",
      "glossary_terms": [
        "safe"
      ],
      "speaker": null
    },
    {
      "id": "mc-b1-p15-s02",
      "page_no": 15,
      "text_en": "Byte fetched it, and then Birch threw it.",
      "zh": "Byte 把木棍捡回来，然后 Birch 又把它扔了出去。",
      "start_ms": 527590.0,
      "end_ms": 530990.0,
      "audio": "assets/minecraft/escape-from-the-nether/sentences/page-15-sentence-02.mp3",
      "audio_exists": true,
      "audio_sha256": "3f44c6d4f8c743d701e3180411592239445ffb227c23dc9bf85f6ab1074223ed",
      "glossary_terms": [
        "fetched"
      ],
      "speaker": null
    },
    {
      "id": "mc-b1-p15-s03",
      "page_no": 15,
      "text_en": "Playing with Byte was a great end to a great adventure!",
      "zh": "和 Byte 玩耍，为这场精彩的冒险画上了完美句号！",
      "start_ms": 530990.0,
      "end_ms": 537150.0,
      "audio": "assets/minecraft/escape-from-the-nether/sentences/page-15-sentence-03.mp3",
      "audio_exists": true,
      "audio_sha256": "b08bd260a1d7778bce73bff995f49b296a16c47daa3909de6c3a4eaae44e1592",
      "glossary_terms": [
        "adventure"
      ],
      "speaker": null
    }
