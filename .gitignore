# Dependencies and tool caches
/node_modules/
/.worktrees/
/.pytest_cache/
/.playwright-mcp/
/.agent-control/
**/__pycache__/
*.py[cod]
*.log

# Raw sources and generated runtime content are tracked when each file stays
# under GitHub's comfortable size. Videos, archives, and secrets stay local.
# prj/assets and prj/data are Windows junctions into content/.
# Tracking them would upload the same files a second time.
/prj/assets/
/prj/data/

# Generated and release outputs
/dist/
/output/
/release/
/tmp/
*.apk
*.aab
*.zip
*.7z
*.rar
*.tar
*.gz
*.partial
*.jar
!/android/gradle/wrapper/gradle-wrapper.jar

